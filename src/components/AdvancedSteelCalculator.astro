---
---

<!--
  نکته: id="steel-calculator" عمداً از این کامپوننت برداشته شده است.
  همان id روی section بیرونی در index.astro هست و دو id تکراری باعث تداخل می‌شد.
  اسکریپت و استایل این کامپوننت با data-steel-calc کار می‌کنند.
-->
<section
  data-steel-calc
  dir="rtl"
  class="relative w-full overflow-hidden rounded-3xl border border-slate-700/60 bg-slate-950/80 p-4 shadow-2xl shadow-black/20 backdrop-blur-xl sm:p-5 lg:p-6"
>
  <!-- Decorative Background -->
  <div class="pointer-events-none absolute -right-32 -top-32 h-72 w-72 rounded-full bg-blue-600/10 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-32 -left-32 h-72 w-72 rounded-full bg-blue-500/5 blur-3xl"></div>

  <!-- Header -->
  <div class="relative z-10 max-w-3xl">
    <div class="mb-3 inline-flex items-center gap-2 rounded-full border border-blue-500/20 bg-blue-500/10 px-3 py-1.5 text-xs font-bold text-blue-400">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6M9 11h6M9 15h3m-8 6h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2z" />
      </svg>
      محاسبه آنلاین وزن و قیمت
    </div>

    <h2 class="text-xl font-black tracking-tight text-white sm:text-2xl lg:text-3xl">
      محاسبه‌گر پیشرفته وزن و هزینه مقاطع فولادی
    </h2>

    <p class="mt-1 text-xs leading-5 text-slate-400 sm:text-sm">
      مشخصات مقطع فولادی را وارد کنید تا وزن تقریبی، تناژ و هزینه کل بار
      به‌صورت لحظه‌ای محاسبه شود.
    </p>
  </div>

  <!-- Main Calculator -->
  <div class="relative z-10 mt-4 grid items-stretch gap-4 lg:grid-cols-12 lg:gap-5">
    <!-- Form -->
    <div class="rounded-2xl border border-slate-700/70 bg-slate-900/70 p-5 shadow-xl sm:p-6 lg:col-span-7">
      <div class="mb-5 flex items-center gap-3">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-500/10 text-blue-400">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" />
          </svg>
        </div>
        <div>
          <h3 class="font-bold text-white">مشخصات مقطع</h3>
          <p class="mt-0.5 text-xs text-slate-500">نوع محصول و ابعاد را انتخاب کنید</p>
        </div>
      </div>

      <!-- Type Selector -->
      <div>
        <span class="mb-2 block text-xs font-bold text-slate-300">نوع مقطع فولادی را انتخاب کنید:</span>

        <div class="grid grid-cols-3 gap-2 sm:gap-3" role="group" aria-label="نوع مقطع فولادی">
          <button
            type="button"
            id="calcBtn-rebar"
            data-type="rebar"
            aria-pressed="true"
            class="calc-type-btn flex flex-col items-center justify-center rounded-xl border border-blue-500/30 bg-blue-600 px-2 py-3 font-bold text-white shadow-lg shadow-blue-600/10 transition-all duration-200 hover:bg-blue-500"
          >
            <svg class="mb-1.5 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" />
            </svg>
            <span class="text-xs">میلگرد</span>
          </button>

          <button
            type="button"
            id="calcBtn-sheet"
            data-type="sheet"
            aria-pressed="false"
            class="calc-type-btn flex flex-col items-center justify-center rounded-xl border border-slate-700 bg-slate-800/80 px-2 py-3 font-bold text-slate-300 transition-all duration-200 hover:border-slate-600 hover:bg-slate-700"
          >
            <svg class="mb-1.5 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5" />
            </svg>
            <span class="text-xs">ورق فولادی</span>
          </button>

          <button
            type="button"
            id="calcBtn-pipe"
            data-type="pipe"
            aria-pressed="false"
            class="calc-type-btn flex flex-col items-center justify-center rounded-xl border border-slate-700 bg-slate-800/80 px-2 py-3 font-bold text-slate-300 transition-all duration-200 hover:border-slate-600 hover:bg-slate-700"
          >
            <svg class="mb-1.5 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="7" stroke-width="1.8"></circle>
              <circle cx="12" cy="12" r="3" stroke-width="1.8"></circle>
            </svg>
            <span class="text-xs">لوله / قوطی</span>
          </button>
        </div>
      </div>

      <!-- Dynamic Inputs -->
      <div id="calcInputsContainer" class="mt-5 space-y-4"></div>

      <!-- هشدار ورودی نامعتبر -->
      <p
        id="calcWarning"
        role="alert"
        class="mt-3 hidden rounded-lg border border-amber-500/30 bg-amber-500/10 px-3 py-2 text-[11px] leading-5 text-amber-300"
      ></p>

      <!-- Price & Quantity -->
      <div class="mt-5 border-t border-slate-800 pt-5">
        <div class="mb-3 flex items-center gap-2">
          <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-slate-800 text-slate-400">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8c-2.5 0-4 1-4 2.5S9.5 13 12 13s4 1 4 2.5S14.5 18 12 18m0-13v14M19 5H5" />
            </svg>
          </div>
          <span class="text-xs font-bold text-slate-300">قیمت و تعداد</span>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="calcUnitPrice" class="mb-1.5 block text-xs font-semibold text-slate-400">قیمت پایه هر کیلو</label>
            <div class="relative">
              <input
                type="text"
                id="calcUnitPrice"
                value="32500"
                inputmode="decimal"
                autocomplete="off"
                class="w-full rounded-xl border border-slate-700 bg-slate-950/70 px-3 py-3 pl-16 text-sm font-bold text-blue-400 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/10"
              />
              <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-[10px] font-medium text-slate-500">تومان / کیلو</span>
            </div>
          </div>

          <div>
            <label for="calcQuantity" class="mb-1.5 block text-xs font-semibold text-slate-400">تعداد شاخه / رول</label>
            <input
              type="text"
              id="calcQuantity"
              value="100"
              inputmode="numeric"
              autocomplete="off"
              class="w-full rounded-xl border border-slate-700 bg-slate-950/70 px-3 py-3 text-sm font-bold text-white outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/10"
            />
            <p class="mt-1 text-[10px] text-slate-600">تعداد مورد نیاز خود را وارد کنید.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Result Card -->
    <div class="flex flex-col justify-between rounded-2xl border border-slate-700/70 bg-gradient-to-b from-slate-800/90 to-slate-950/90 p-5 shadow-xl sm:p-6 lg:col-span-5">
      <div>
        <div class="flex items-center justify-between border-b border-slate-700/80 pb-4">
          <div>
            <h3 class="text-lg font-black text-white">نتایج محاسبه</h3>
            <p class="mt-1 text-[11px] text-slate-500">نتیجه بر اساس اطلاعات واردشده</p>
          </div>
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-500/10 text-blue-400">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 19V5m0 14h16M8 16v-5m4 5V7m4 9v-8" />
            </svg>
          </div>
        </div>

        <div class="mt-5 space-y-4" aria-live="polite">
          <div class="flex items-center justify-between gap-4 rounded-xl border border-slate-800 bg-slate-950/40 p-3.5">
            <span class="text-xs text-slate-400">وزن یک شاخه / واحد</span>
            <span id="resSingleWeight" class="text-sm font-black text-white">—</span>
          </div>

          <div class="flex items-center justify-between gap-4 rounded-xl border border-blue-500/10 bg-blue-500/5 p-3.5">
            <span class="text-xs text-slate-400">وزن کل بار</span>
            <span id="resTotalWeight" class="text-lg font-black text-blue-400">—</span>
          </div>

          <div class="flex items-center justify-between gap-4 px-1">
            <span class="text-xs text-slate-400">معادل تن</span>
            <span id="resTonnage" class="text-sm font-bold text-slate-200">—</span>
          </div>

          <div class="mt-2 border-t border-slate-700/80 pt-4">
            <div class="flex items-end justify-between gap-4">
              <div>
                <span class="block text-xs font-semibold text-slate-400">هزینه کل برآوردی</span>
                <span class="mt-1 block text-[10px] text-slate-600">بدون احتساب مالیات ارزش افزوده</span>
              </div>
              <span id="resTotalPrice" class="text-xl font-black text-blue-400 sm:text-2xl">—</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Add To Proforma -->
      <div class="mt-7">
        <button
          id="addCalculatedToProforma"
          type="button"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-blue-600 px-4 py-3.5 text-sm font-black text-white shadow-lg shadow-blue-600/20 transition-all duration-200 hover:bg-blue-500 hover:shadow-blue-500/25 active:scale-[0.98]"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14M5 12h14" />
          </svg>
          افزودن این محاسبه به پیش‌فاکتور
        </button>

        <p id="calcStatus" role="status" aria-live="polite" class="mt-2 min-h-[1rem] text-center text-[10px] text-slate-600">
          مشخصات و هزینه محاسبه‌شده به پیش‌فاکتور شما اضافه می‌شود.
        </p>
      </div>
    </div>
  </div>

  <!-- Simple Help -->
  <div class="relative z-10 mt-5 flex flex-col gap-3 rounded-2xl border border-slate-800 bg-slate-900/40 p-4 sm:flex-row sm:items-center">
    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-slate-800 text-slate-400">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 17h.01M12 14a2.5 2.5 0 10-2.5-2.5M12 14v-1" />
        <circle cx="12" cy="12" r="9" stroke-width="1.8"></circle>
      </svg>
    </div>
    <div>
      <p class="text-xs font-bold text-slate-300">راهنمای محاسبه</p>
      <p class="mt-1 text-[11px] leading-6 text-slate-500">
        قیمت هر کیلو و تعداد مورد نیاز را وارد کنید. وزن و هزینه کل
        به‌صورت خودکار محاسبه می‌شود. این محاسبات تخمینی هستند و
        ممکن است با وزن واقعی کارخانه کمی اختلاف داشته باشند.
      </p>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-steel-calc]");

  if (root) {
    type CalcType = "rebar" | "sheet" | "pipe";
    type PipeShape = "round" | "box";

    const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
      root.querySelector<T>(`#${id}`);

    let currentType: CalcType = "rebar";
    let pipeShape: PipeShape = "round";

    let singleWeight = 0;
    let totalWeight = 0;
    let totalPrice = 0;

    // ───────────── ابزارها ─────────────

    const numberFa = (value: number, maximumFractionDigits = 2) =>
      value.toLocaleString("fa-IR", { maximumFractionDigits, minimumFractionDigits: 0 });

    // ارقام فارسی/عربی، ممیز فارسی و «/» (که در فارسی به‌جای اعشار تایپ می‌شود) پشتیبانی می‌شوند
    const toLatin = (value: string) =>
      value
        .replace(/[۰-۹]/g, (d) => String("۰۱۲۳۴۵۶۷۸۹".indexOf(d)))
        .replace(/[٠-٩]/g, (d) => String("٠١٢٣٤٥٦٧٨٩".indexOf(d)))
        .replace(/[٫\/]/g, ".")
        .replace(/[٬،,\s]/g, "");

    const getNumber = (id: string, fallback = 0) => {
      const el = $<HTMLInputElement>(id);
      if (!el) return fallback;
      const n = Number(toLatin(el.value));
      return Number.isFinite(n) ? n : fallback;
    };

    const getQuantity = () => Math.max(1, Math.round(getNumber("calcQuantity", 1)));

    const createInput = (o: {
      id: string;
      label: string;
      value: string;
      unit: string;
      help: string;
    }) => `
      <div>
        <label for="${o.id}" class="mb-1.5 block text-xs font-semibold text-slate-300">${o.label}</label>
        <div class="relative">
          <input
            type="text"
            id="${o.id}"
            value="${o.value}"
            inputmode="decimal"
            autocomplete="off"
            class="w-full rounded-xl border border-slate-700 bg-slate-950/70 px-3 py-3 pl-16 text-sm font-bold text-white outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/10"
          />
          <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-[10px] font-medium text-slate-500">${o.unit}</span>
        </div>
        <p class="mt-1 text-[10px] leading-5 text-slate-600">${o.help}</p>
      </div>`;

    const shapeButton = (shape: PipeShape, label: string) => {
      const active = pipeShape === shape;
      return `
        <button
          type="button"
          data-shape="${shape}"
          aria-pressed="${active}"
          class="rounded-lg border px-3 py-2 text-xs font-bold transition-all duration-200 ${
            active
              ? "border-blue-500/40 bg-blue-600 text-white"
              : "border-slate-700 bg-slate-800/80 text-slate-300 hover:border-slate-600 hover:bg-slate-700"
          }"
        >${label}</button>`;
    };

    // ───────────── نمایش فرم هر نوع مقطع ─────────────

    const renderInputs = () => {
      const container = $("calcInputsContainer");
      if (!container) return;

      if (currentType === "rebar") {
        container.innerHTML = `
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            ${createInput({ id: "rebarDia", label: "سایز میلگرد", value: "16", unit: "میلی‌متر", help: "مثال: برای میلگرد ۱۶ عدد ۱۶ را وارد کنید." })}
            ${createInput({ id: "rebarLen", label: "طول هر شاخه", value: "12", unit: "متر", help: "طول استاندارد بسیاری از شاخه‌ها ۱۲ متر است." })}
          </div>`;
      }

      if (currentType === "sheet") {
        container.innerHTML = `
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
            ${createInput({ id: "sheetThick", label: "ضخامت ورق", value: "2", unit: "میلی‌متر", help: "مثال: ورق ۲ میلی‌متر." })}
            ${createInput({ id: "sheetWidth", label: "عرض ورق", value: "125", unit: "سانتی‌متر", help: "مثال: عرض ۱۲۵ سانتی‌متر." })}
            ${createInput({ id: "sheetLen", label: "طول ورق", value: "250", unit: "سانتی‌متر", help: "مثال: طول ۲۵۰ سانتی‌متر." })}
          </div>`;
      }

      if (currentType === "pipe") {
        const fields =
          pipeShape === "round"
            ? `
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                ${createInput({ id: "pipeDia", label: "قطر بیرونی", value: "40", unit: "میلی‌متر", help: "قطر خارجی لوله." })}
                ${createInput({ id: "pipeThick", label: "ضخامت دیواره", value: "2", unit: "میلی‌متر", help: "مثال: ضخامت ۲ میلی‌متر." })}
                ${createInput({ id: "pipeLen", label: "طول شاخه", value: "6", unit: "متر", help: "طول شاخه را برحسب متر وارد کنید." })}
              </div>`
            : `
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                ${createInput({ id: "boxW", label: "عرض قوطی", value: "40", unit: "میلی‌متر", help: "برای قوطی مربع، عرض و ارتفاع یکی است." })}
                ${createInput({ id: "boxH", label: "ارتفاع قوطی", value: "40", unit: "میلی‌متر", help: "ضلع دیگر قوطی." })}
                ${createInput({ id: "pipeThick", label: "ضخامت دیواره", value: "2", unit: "میلی‌متر", help: "مثال: ضخامت ۲ میلی‌متر." })}
                ${createInput({ id: "pipeLen", label: "طول شاخه", value: "6", unit: "متر", help: "طول شاخه را برحسب متر وارد کنید." })}
              </div>`;

        container.innerHTML = `
          <div>
            <span class="mb-1.5 block text-xs font-semibold text-slate-300">شکل مقطع</span>
            <div class="grid grid-cols-2 gap-2" role="group" aria-label="شکل مقطع">
              ${shapeButton("round", "لوله گرد")}
              ${shapeButton("box", "قوطی / پروفیل")}
            </div>
          </div>
          ${fields}`;
      }
    };

    const setCalcType = (type: CalcType) => {
      currentType = type;

      root.querySelectorAll<HTMLElement>(".calc-type-btn").forEach((button) => {
        const active = button.dataset.type === type;

        button.setAttribute("aria-pressed", String(active));

        button.classList.toggle("bg-blue-600", active);
        button.classList.toggle("text-white", active);
        button.classList.toggle("border-blue-500/30", active);
        button.classList.toggle("shadow-lg", active);
        button.classList.toggle("shadow-blue-600/10", active);

        button.classList.toggle("bg-slate-800/80", !active);
        button.classList.toggle("text-slate-300", !active);
        button.classList.toggle("border-slate-700", !active);
      });

      renderInputs();
      runCalculator();
    };

    // ───────────── محاسبه ─────────────

    /*
     * فرمول‌های تقریبی (فولاد با چگالی ۷٫۸۵):
     *  - میلگرد:  قطر² ÷ ۱۶۲  (کیلوگرم بر متر)
     *  - ورق:     ضخامت(mm) × عرض(m) × طول(m) × ۷٫۸۵
     *  - لوله:    ۰٫۰۲۴۶۶ × t × (D − t)  (کیلوگرم بر متر)
     *  - قوطی:    ۰٫۰۱۵۷ × t × (W + H − ۲٫۸۶ t)  (کیلوگرم بر متر، با احتساب گوشه‌های گرد)
     */
    const computeUnitWeight = (): { weight: number; warning: string } => {
      if (currentType === "rebar") {
        const dia = Math.max(0, getNumber("rebarDia"));
        const len = Math.max(0, getNumber("rebarLen"));
        return { weight: (dia * dia * len) / 162, warning: "" };
      }

      if (currentType === "sheet") {
        const thick = Math.max(0, getNumber("sheetThick"));
        const widthM = Math.max(0, getNumber("sheetWidth")) / 100;
        const lenM = Math.max(0, getNumber("sheetLen")) / 100;
        return { weight: thick * widthM * lenM * 7.85, warning: "" };
      }

      const t = Math.max(0, getNumber("pipeThick"));
      const len = Math.max(0, getNumber("pipeLen"));

      if (pipeShape === "round") {
        const d = Math.max(0, getNumber("pipeDia"));
        if (t * 2 >= d && d > 0) {
          return { weight: 0, warning: "ضخامت دیواره باید کمتر از نصف قطر لوله باشد." };
        }
        return { weight: 0.02466 * t * (d - t) * len, warning: "" };
      }

      const w = Math.max(0, getNumber("boxW"));
      const h = Math.max(0, getNumber("boxH"));
      if (t * 2 >= Math.min(w, h) && Math.min(w, h) > 0) {
        return { weight: 0, warning: "ضخامت دیواره باید کمتر از نصف کوچک‌ترین ضلع قوطی باشد." };
      }
      return { weight: 0.0157 * t * (w + h - 2.86 * t) * len, warning: "" };
    };

    const setText = (id: string, text: string) => {
      const el = $(id);
      if (el) el.textContent = text;
    };

    const runCalculator = () => {
      const unitPrice = Math.max(0, getNumber("calcUnitPrice"));
      const quantity = getQuantity();

      const { weight, warning } = computeUnitWeight();

      singleWeight = Math.max(0, weight);
      totalWeight = singleWeight * quantity;
      totalPrice = totalWeight * unitPrice;

      setText("resSingleWeight", `${numberFa(singleWeight, 2)} کیلوگرم`);
      setText("resTotalWeight", `${numberFa(totalWeight, 1)} کیلوگرم`);
      setText("resTonnage", `${numberFa(totalWeight / 1000, 2)} تن`);
      setText("resTotalPrice", `${numberFa(Math.round(totalPrice), 0)} تومان`);

      const warningEl = $("calcWarning");
      if (warningEl) {
        warningEl.textContent = warning;
        warningEl.classList.toggle("hidden", !warning);
      }
    };

    // ───────────── پیش‌فاکتور ─────────────

    const getCalcName = () => {
      if (currentType === "rebar") {
        return `میلگرد ${numberFa(getNumber("rebarDia"), 1)} — طول ${numberFa(getNumber("rebarLen"), 1)} متر`;
      }

      if (currentType === "sheet") {
        return `ورق فولادی ${numberFa(getNumber("sheetThick"), 1)} میلی‌متر — ${numberFa(getNumber("sheetWidth"), 1)}×${numberFa(getNumber("sheetLen"), 1)} سانتی‌متر`;
      }

      const thick = numberFa(getNumber("pipeThick"), 1);
      const len = numberFa(getNumber("pipeLen"), 1);

      if (pipeShape === "round") {
        return `لوله ${numberFa(getNumber("pipeDia"), 1)} میلی‌متر — ضخامت ${thick} — طول ${len} متر`;
      }

      return `قوطی ${numberFa(getNumber("boxW"), 1)}×${numberFa(getNumber("boxH"), 1)} میلی‌متر — ضخامت ${thick} — طول ${len} متر`;
    };

    const setStatus = (message: string, isError = false) => {
      const el = $("calcStatus");
      if (!el) return;
      el.textContent = message;
      el.classList.toggle("text-red-400", isError);
      el.classList.toggle("text-slate-600", !isError);
    };

    const addCalculatedToProforma = () => {
      runCalculator();

      if (totalWeight <= 0) {
        setStatus("ابتدا مشخصات مقطع را کامل و درست وارد کنید.", true);
        return;
      }

      const item = {
        id: `calc-${Date.now()}`,
        name: getCalcName(),
        pricePerKg: Math.max(0, getNumber("calcUnitPrice")),
        weightKg: totalWeight,
        quantity: getQuantity(),
        totalPrice: Math.round(totalPrice),
        source: "steel-calculator",
      };

      document.dispatchEvent(new CustomEvent("asin:add-to-proforma", { detail: { item } }));

      setStatus("به پیش‌فاکتور اضافه شد.");

      setTimeout(() => {
        document.dispatchEvent(new CustomEvent("asin:open-proforma"));
      }, 100);
    };

    // ───────────── رویدادها (یک بار، با event delegation) ─────────────

    root.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;

      const typeButton = target.closest<HTMLElement>(".calc-type-btn");
      if (typeButton?.dataset.type) {
        setCalcType(typeButton.dataset.type as CalcType);
        return;
      }

      const shapeButtonEl = target.closest<HTMLElement>("[data-shape]");
      if (shapeButtonEl?.dataset.shape) {
        pipeShape = shapeButtonEl.dataset.shape as PipeShape;
        renderInputs();
        runCalculator();
        return;
      }

      if (target.closest("#addCalculatedToProforma")) {
        addCalculatedToProforma();
      }
    });

    root.addEventListener("input", (event) => {
      if ((event.target as HTMLElement).matches("input")) {
        setStatus("مشخصات و هزینه محاسبه‌شده به پیش‌فاکتور شما اضافه می‌شود.");
        runCalculator();
      }
    });

    setCalcType("rebar");
  }
</script>

<style>
  [data-steel-calc],
  [data-steel-calc] input,
  [data-steel-calc] button {
    font-family: Vazirmatn, sans-serif;
  }
  
</style>
