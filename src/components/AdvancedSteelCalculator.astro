  #steel-calculator,
  #steel-calculator input,
  #steel-calculator button {
    font-family: Vazirmatn, sans-serif;
  }

  #steel-calculator input::-webkit-outer-spin-button,
  #steel-calculator input::-webkit-inner-spin-button {
    margin: 0;
    -webkit-appearance: none;
  }

  #steel-calculator input[type="number"] {
    -moz-appearance: textfield;
  }
</style>