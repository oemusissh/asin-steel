---
import { getListing } from '../lib/news';
import { FEEDS } from '../data/news-sources.js';

interface Props {
  page?: number;
}

const { page = 1 } = Astro.props;
const { slides, items, pages, current, empty } = getListing(page);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// وقتی لوگوی شرکت آماده شد، فایلش را در public/images/ بگذار و مسیرش را اینجا بنویس.
// مثال: const logo = `${base}/images/logo.png`;
const logo = '';
const sources = [...new Set(FEEDS.map((f) => f.name))];

const fa = (n: number) => n.toLocaleString('fa-IR');
const dateFmt = new Intl.DateTimeFormat('fa-IR-u-ca-persian', { year: 'numeric', month: 'long', day: 'numeric' });
const linkTo = (n: any) => `${base}/news/industry/${n.id}`;
const href = (p: number) => (p === 1 ? `${base}/news/industry` : `${base}/news/industry/page/${p}`);

const nums: (number | '…')[] = [];
for (let p = 1; p <= pages; p++) {
  if (p === 1 || p === pages || Math.abs(p - current) <= 1) nums.push(p);
  else if (nums[nums.length - 1] !== '…') nums.push('…');
}
---

<main class="news">
  <div class="news__inner">
    <header class="news__head">
      {logo
        ? <img class="news__logo" src={logo} alt="آسین استیل" />
        : <div class="news__logo news__logo--empty" aria-hidden="true">جای لوگو</div>}
      <div class="news__titles">
        <span class="news__bar" aria-hidden="true"></span>
        <h1>اخبار صنعت فولاد</h1>
        <p>تازه‌ترین خبرهای بازار آهن، فولاد و معدن</p>
      </div>
    </header>

    {slides.length > 0 && (
      <section class="slider" data-slider aria-label="خبرهای مهم">
        {slides.map((n, i) => (
          <a class:list={['slide', { 'is-active': i === 0 }]} href={linkTo(n)}>
            <img src={n.image} alt="" referrerpolicy="no-referrer" loading={i === 0 ? 'eager' : 'lazy'} />
            <div class="slide__cap">
              <div class="meta"><span class="chip">{n.source}</span><time datetime={new Date(n.date).toISOString()}>{dateFmt.format(n.date)}</time></div>
              <h2>{n.title}</h2>
              {n.excerpt && <p>{n.excerpt}</p>}
            </div>
          </a>
        ))}
        {slides.length > 1 && (
          <>
            <button class="slider__nav slider__nav--next" type="button" aria-label="خبر بعدی">‹</button>
            <button class="slider__nav slider__nav--prev" type="button" aria-label="خبر قبلی">›</button>
            <div class="slider__dots">
              {slides.map((_, i) => <button type="button" class:list={[{ 'is-active': i === 0 }]} aria-label={`خبر ${fa(i + 1)}`}></button>)}
            </div>
          </>
        )}
      </section>
    )}

    <div class="news__grid">
      <div class="news__main">
        {empty ? (
          <p class="news__empty">فعلاً خبر جدیدی در دسترس نیست. کمی بعد دوباره سر بزنید.</p>
        ) : (
          <ul class="cards">
            {items.map((n) => (
              <li>
                <a class:list={['card', { 'card--noimg': !n.image }]} href={linkTo(n)}>
                  {n.image && (
                    <div class="card__media">
                      <img src={n.image} alt="" loading="lazy" referrerpolicy="no-referrer" />
                    </div>
                  )}
                  <div class="card__body">
                    <div class="meta"><span class="chip">{n.source}</span><time datetime={new Date(n.date).toISOString()}>{dateFmt.format(n.date)}</time></div>
                    <h3>{n.title}</h3>
                    {n.excerpt && <p>{n.excerpt}</p>}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )}

        {pages > 1 && (
          <nav class="pager" aria-label="صفحه‌بندی اخبار">
            {current > 1 ? <a href={href(current - 1)} rel="prev">قبلی</a> : <span class="off">قبلی</span>}
            {nums.map((p) =>
              p === '…' ? <span class="gap">…</span>
              : p === current ? <span class="cur" aria-current="page">{fa(p)}</span>
              : <a href={href(p)}>{fa(p)}</a>
            )}
            {current < pages ? <a href={href(current + 1)} rel="next">بعدی</a> : <span class="off">بعدی</span>}
          </nav>
        )}
      </div>

      <aside class="side">
        <section class="side__box side__box--cta">
          <h3>قیمت روز مقاطع فولادی</h3>
          <p>برای استعلام قیمت و ثبت سفارش با کارشناسان آسین استیل تماس بگیرید.</p>
          <a class="side__phone" href="tel:+982166915307" dir="ltr">۰۲۱-۶۶۹۱۵۳۰۷</a>
        </section>
        {sources.length > 0 && (
          <section class="side__box">
            <h3>منابع خبرها</h3>
            <ul>{sources.map((n) => <li>{n}</li>)}</ul>
          </section>
        )}
      </aside>
    </div>
  </div>
</main>


<script>
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.slide'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('.slider__dots button'));
    if (slides.length < 2) return;
    let i = 0;
    let timer: number | undefined;

    const show = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => s.classList.toggle('is-active', k === i));
      dots.forEach((d, k) => d.classList.toggle('is-active', k === i));
    };
    const stop = () => window.clearInterval(timer);
    const start = () => {
      stop();
      timer = window.setInterval(() => show(i + 1), 5500);
    };

    root.querySelector('.slider__nav--next')?.addEventListener('click', () => { show(i + 1); start(); });
    root.querySelector('.slider__nav--prev')?.addEventListener('click', () => { show(i - 1); start(); });
    dots.forEach((d, k) => d.addEventListener('click', () => { show(k); start(); }));
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);

    let x0 = 0;
    root.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    root.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) { show(dx < 0 ? i + 1 : i - 1); start(); }
    });

    start();
  });
</script>

<style>
  .news { width: 100%; min-height: 70vh; padding: 56px 20px 80px; background: #fff; color: #1b2430; direction: rtl; }
  .news__inner { max-width: 1180px; margin: 0 auto; }

  .news__head { display: flex; align-items: center; gap: 22px; margin-bottom: 28px; padding-bottom: 22px; border-bottom: 1px solid #e6e9ed; }
  .news__logo { flex: none; height: 72px; width: auto; max-width: 200px; object-fit: contain; }
  .news__logo--empty { display: grid; place-items: center; width: 140px; border: 2px dashed #c9d3df; border-radius: 8px; color: #8795a8; font-size: .9rem; font-weight: 700; }
  .news__bar { display: block; width: 44px; height: 4px; background: #1f4e8c; border-radius: 2px; margin-bottom: 14px; }
  .news__head h1 { margin: 0 0 6px; font-size: 2rem; font-weight: 800; color: #14202e; }
  .news__head p { margin: 0; color: #5d6875; }

  .meta { display: flex; align-items: center; gap: 10px; font-size: .8rem; color: #7b8592; margin-bottom: 10px; }
  .chip { background: #e9f0f9; color: #1f4e8c; font-weight: 700; padding: 3px 10px; border-radius: 99px; font-size: .78rem; }

  /* اسلایدر خبرهای مهم */
  .slider { position: relative; height: clamp(320px, 42vw, 480px); margin-bottom: 44px; border-radius: 10px; overflow: hidden; background: #14202e; }
  .slide { position: absolute; inset: 0; display: block; color: #fff; text-decoration: none; opacity: 0; visibility: hidden; transition: opacity .8s ease, visibility .8s; }
  .slide.is-active { opacity: 1; visibility: visible; }
  .slide img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scale(1.07); transition: transform 7s ease-out; }
  .slide.is-active img { transform: scale(1); }
  .slide__cap { position: absolute; inset-inline: 0; bottom: 0; padding: 26px 34px 56px; background: linear-gradient(to top, rgba(14, 24, 38, .92) 55%, rgba(14, 24, 38, .0));
    transform: translateY(100%); transition: transform .7s cubic-bezier(.2, .8, .2, 1) .2s; }
  .slide.is-active .slide__cap { transform: translateY(0); }
  .slide .meta { color: #c4cedb; margin-bottom: 8px; }
  .slide .chip { background: #1f4e8c; color: #fff; }
  .slide h2 { margin: 0 0 8px; font-size: clamp(1.15rem, 2.2vw, 1.65rem); line-height: 1.9; font-weight: 800; max-width: 900px; }
  .slide p { margin: 0; max-width: 820px; font-size: .95rem; line-height: 2; color: #dbe3ee; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  .slider__nav { position: absolute; top: 38%; z-index: 3; width: 42px; height: 42px; border: 0; border-radius: 50%; background: rgba(255, 255, 255, .85); color: #14202e;
    font-size: 1.6rem; line-height: 1; cursor: pointer; transition: background .2s; }
  .slider__nav:hover { background: #fff; }
  .slider__nav--next { left: 16px; }
  .slider__nav--prev { right: 16px; }
  .slider__dots { position: absolute; z-index: 3; bottom: 18px; left: 34px; display: flex; gap: 8px; }
  .slider__dots button { width: 9px; height: 9px; padding: 0; border: 0; border-radius: 99px; background: rgba(255, 255, 255, .45); cursor: pointer; transition: width .3s, background .3s; }
  .slider__dots button.is-active { width: 26px; background: #fff; }

  .news__grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 44px; align-items: start; }

  /* کارت‌ها با عکس بزرگ */
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26px; }
  .card { display: flex; flex-direction: column; height: 100%; background: #fff; border: 1px solid #e6e9ed; border-radius: 10px; overflow: hidden;
    color: inherit; text-decoration: none; transition: transform .2s, box-shadow .2s, border-color .2s; }
  .card__media { aspect-ratio: 16 / 10; background: #eef1f4; overflow: hidden; }
  .card__media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s; }
  .card__body { padding: 18px 20px 22px; }
  .card h3 { margin: 0 0 8px; font-size: 1.05rem; line-height: 1.95; font-weight: 700; color: #14202e; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .card p { margin: 0; font-size: .88rem; line-height: 2; color: #5d6875; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .card--noimg { border-top: 3px solid #1f4e8c; }
  .card:hover { transform: translateY(-3px); box-shadow: 0 12px 26px rgba(20, 32, 46, .09); border-color: #b9cce4; }
  .card:hover h3 { color: #1f4e8c; }
  .card:hover .card__media img { transform: scale(1.04); }

  .news__empty { padding: 56px 0; text-align: center; color: #5d6875; }

  .pager { display: flex; justify-content: center; gap: 6px; margin-top: 40px; flex-wrap: wrap; }
  .pager a, .pager span { min-width: 38px; height: 38px; padding: 0 12px; display: inline-flex; align-items: center; justify-content: center;
    border: 1px solid #dfe3e8; border-radius: 6px; font-size: .9rem; color: #1b2430; text-decoration: none; background: #fff; }
  .pager a:hover { border-color: #1f4e8c; color: #1f4e8c; }
  .pager .cur { background: #1f4e8c; border-color: #1f4e8c; color: #fff; }
  .pager .off { color: #b3bac3; background: #f7f8fa; }
  .pager .gap { border: 0; min-width: 20px; padding: 0; }

  .side { position: sticky; top: 24px; display: grid; gap: 20px; }
  .side__box { border: 1px solid #e3e7ec; border-top: 3px solid #1f4e8c; border-radius: 6px; padding: 20px; background: #fff; }
  .side__box h3 { margin: 0 0 10px; font-size: 1rem; font-weight: 800; color: #14202e; }
  .side__box p { margin: 0 0 14px; font-size: .9rem; line-height: 2; color: #4a5562; }
  .side__box ul { margin: 0; padding: 0; list-style: none; font-size: .9rem; color: #4a5562; line-height: 2.2; }
  .side__box li { border-bottom: 1px dashed #e6e9ed; }
  .side__box li:last-child { border-bottom: 0; }
  .side__box--cta { background: #f4f7fb; }
  .side__phone { display: block; text-align: center; padding: 10px; background: #1f4e8c; color: #fff; font-weight: 700; text-decoration: none; border-radius: 6px; }
  .side__phone:hover { background: #173d70; }

  @media (max-width: 960px) {
    .news__grid { grid-template-columns: 1fr; gap: 36px; }
    .side { position: static; }
  }
  @media (max-width: 700px) {
    .slider { height: 400px; margin-bottom: 32px; }
    .slide__cap { padding: 20px 18px 50px; }
    .slide p { display: none; }
    .slider__nav { display: none; }
    .slider__dots { left: 18px; }
    .cards { grid-template-columns: 1fr; }
    .news__head h1 { font-size: 1.6rem; }
    .news__logo { height: 56px; }
    .news__logo--empty { width: 100px; }
  }
</style>
