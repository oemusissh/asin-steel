
---
import { getActiveProducts } from "../data/products";

const base = import.meta.env.BASE_URL;
const priceList = `${base}products`;
const contact = `${base}contact`;

const products = getActiveProducts();
const railProducts = [...products, ...products];

const brand = {
  nameFa: "آسین استیل",
  nameEn: "ASIN STILL",
  logo: `${base}logo.svg`,
  phone: "۰۲۱-۶۶۹۱۵۳۰۷",
  phoneLink: "tel:+02166915307",
  instagram: "https://instagram.com/asinstill",
  telegram: "https://t.me/asinstill",
  address: "تهران، خیابان جمالزاده، خیابان توحید، بن بست حاج رضایی، پلاک ۱۶",
  postalCode: "۱۴۱۹۷۱۳۷۴۰",
};

// نقشه گوگل (بدون نیاز به کلید API)
// پین نقشه فعلاً از روی نام خیابان‌ها پیدا می‌شود. برای پین دقیقاً روی دفتر:
// در گوگل مپ روی محل دفتر راست‌کلیک کنید (در موبایل: لمس طولانی)، مختصات را کپی کنید
// و بین گیومه‌های mapCoords بگذارید. مثال: "35.70123, 51.38456"
const mapCoords = "";
const mapQuery = encodeURIComponent(
  mapCoords.replace(/\s+/g, "") ||
    "تهران، خیابان جمالزاده، خیابان توحید، بن بست حاج رضایی"
);
const mapEmbedUrl = `https://maps.google.com/maps?q=${mapQuery}&hl=fa&z=17&output=embed`;
const mapOpenUrl = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;
const mapRouteUrl = `https://www.google.com/maps/dir/?api=1&destination=${mapQuery}`;




const heroSlides = [
  {
    src: "/images/hero-steel.png",
    alt: "مقاطع فولادی در فضای صنعتی",
    label: "STEEL INDUSTRY",
  },
  {
    src: "/images/hero-steel-2.jpg",
    alt: "ورق‌ها و کلاف‌های فولادی",
    label: "STEEL SHEETS",
  },
  {
    src: "/images/hero-steel-3.jpg",
    alt: "تیرآهن و مقاطع فولادی در انبار",
    label: "STEEL PROFILES",
  },
];

;

---

<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css"
/>

<main class="as" dir="rtl">

  <!-- لوگو -->
  <div class="as-logo">
    <img
      src={brand.logo}
      alt={brand.nameFa}
      onerror="this.style.display='none'"
    />
    <div>
      <strong>{brand.nameFa}</strong>
      <span>{brand.nameEn}</span>
    </div>
  </div>

  <!-- معرفی -->
  <section class="as-intro">

    <div class="as-intro-text">
      <span class="as-tag">تأمین و بازرگانی مقاطع فولادی</span>

      <h1>
        پایه‌های <em>محکم</em>
        برای سازه‌های ماندگار
      </h1>

<div class="as-intro-details">
  <div class="as-intro-main">
    <p>
      از انتخاب مقطع مناسب تا تحویل در محل پروژه، همراه شما هستیم.
      کیفیت تضمینی، ارسال سریع به سراسر ایران.
    </p>

    <div class="as-actions">
      <a href={priceList} class="as-btn as-btn-primary">
        مشاهده محصولات
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
      </a>

      <a href={priceList} class="as-btn as-btn-primary">
        استعلام قیمت
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
      </a>

      <a href="#steel-calculator" class="as-btn as-btn-ghost">
        محاسبه وزن و هزینه
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
      </a>
    </div>

    <div class="as-contact-panel">
      <a class="as-contact-phone" href={brand.phoneLink}>
        <span class="as-contact-icon as-phone-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M22 16.9v3a2 2 0 0 1-2.2 2A19.8 19.8 0 0 1 11.2 19a19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.2-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.8 2.1Z"/>
          </svg>
        </span>

        <span class="as-phone-content">
          <span class="as-contact-caption">برای مشاوره و استعلام قیمت</span>
          <strong>{brand.phone}</strong>
        </span>

        <span class="as-phone-arrow" aria-hidden="true">←</span>
      </a>

      <div class="as-contact-socials">
        <a class="as-social-link as-instagram" href={brand.instagram} target="_blank" rel="noopener noreferrer" aria-label="صفحه اینستاگرام آسین استیل">
          <span class="as-social-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <rect x="3" y="3" width="18" height="18" rx="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
            </svg>
          </span>
          <span>
            <strong>اینستاگرام</strong>
            <small>ما را دنبال کنید</small>
          </span>
          <span class="as-social-arrow" aria-hidden="true">↗</span>
        </a>

        <a class="as-social-link as-telegram" href={brand.telegram} target="_blank" rel="noopener noreferrer" aria-label="کانال تلگرام آسین استیل">
          <span class="as-social-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="m21.5 3.5-3.2 17c-.2 1.2-.9 1.5-1.9.9l-5.3-3.9-2.6 2.5c-.3.3-.6.6-1.2.6l.4-5.4 9.8-8.9c.4-.4-.1-.6-.6-.2L4.8 13.7-.4 12c-1.1-.4-1.1-1.1.2-1.6L20 2.9c.9-.3 1.7.2 1.5.6Z" transform="translate(2 0) scale(.9)"/>
            </svg>
          </span>
          <span>
            <strong>تلگرام</strong>
            <small>ارتباط با آسین استیل</small>
          </span>
          <span class="as-social-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>

  <div class="as-address-card">
    <div class="as-address-map-preview">
      <iframe
        src={mapEmbedUrl}
        title="موقعیت آسین استیل روی نقشه گوگل"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        tabindex="-1"
      ></iframe>

      <!-- کل نقشه یک لینک است و گوگل مپ را در تب جدید باز می‌کند -->
      <a
        href={mapOpenUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="as-map-hit"
        aria-label="مشاهده موقعیت آسین استیل در گوگل مپ"
      >
        <span class="as-map-hit-badge" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M7 7h10v10" />
            <path d="M7 17 17 7" />
          </svg>
        </span>
      </a>
    </div>

    <div class="as-address-body">
      <div class="as-address-head">
        <span class="as-address-pin" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
        </span>
        <strong>آدرس شرکت</strong>
      </div>

      <address class="as-address-text">{brand.address}</address>

      <div class="as-address-postal">
        <span>کدپستی</span>
        <span class="as-address-postal-code" dir="ltr">{brand.postalCode}</span>
      </div>
    </div>

    <a
      href={mapRouteUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="as-address-map"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <polygon points="3 11 22 2 13 21 11 13 3 11" />
      </svg>
      مسیریابی در گوگل مپ
    </a>
  </div>
</div>


    </div>

    <!-- اسلایدر تصاویر هیرو -->
    <div
      class="as-intro-photo"
      data-hero-slider
      aria-label="تصاویر مقاطع فولادی"
      tabindex="0"
    >
      <div class="as-slides">
        {heroSlides.map((slide, index) => (
          <img
            src={slide.src}
            alt={slide.alt}
            class:list={["as-hero-slide", index === 0 && "is-active"]}
            data-slide-index={index}
            loading={index === 0 ? "eager" : "lazy"}
            fetchpriority={index === 0 ? "high" : "auto"}
            decoding="async"
          />
        ))}
      </div>

      <div class="as-photo-shade"></div>

      <div class="as-photo-overlay">
        <span class="as-photo-label" data-slide-label>
          {heroSlides[0].label}
        </span>
      </div>

      <!-- کنترل‌های اسلایدر -->
      <div class="as-slider-controls">

        <button
          type="button"
          class="as-slider-arrow"
          data-slider-prev
          aria-label="تصویر قبلی"
          title="تصویر قبلی"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m15 18-6-6 6-6" />
          </svg>
        </button>

        <div class="as-slider-dots" aria-label="انتخاب تصویر">
          {heroSlides.map((slide, index) => (
            <button
              type="button"
              class:list={[
                "as-slider-dot",
                index === 0 && "is-active",
              ]}
              data-slide-to={index}
              aria-label={`نمایش تصویر ${index + 1}`}
              aria-pressed={index === 0 ? "true" : "false"}
            ></button>
          ))}
        </div>

        <button
          type="button"
          class="as-slider-arrow"
          data-slider-next
          aria-label="تصویر بعدی"
          title="تصویر بعدی"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </button>

      </div>

      <span class="as-slider-counter" aria-hidden="true">
        <span data-slider-current>01</span>
        <span class="as-counter-divider">/</span>
        <span>{String(heroSlides.length).padStart(2, "0")}</span>
      </span>
    </div>

  </section>

  <!-- ریل محصولات -->
  <section class="as-rail-section">
    <div class="as-rail-head">
      <h2>محصولات ما</h2>
      <a href={priceList}>مشاهده همه ←</a>
    </div>

    <div class="as-rail-window">
      <div class="as-rail-track">
        {railProducts.map((p, i) => (
          <a
            href={`${base}product/${p.id}`}
            class="as-rail-card"
            tabindex={i >= products.length ? -1 : 0}
          >
            <div class="as-card-img">
              {p.image && (
                <img
                  src={p.image}
                  alt={p.name}
                  loading="lazy"
                  onerror="this.style.display='none'"
                />
              )}
            </div>

            <div class="as-card-body">
              <h3>{p.name}</h3>

              {p.factory && (
                <span class="as-card-size">{p.factory}</span>
              )}

              {p.specifications && p.specifications.length > 0 && (
                <div class="as-card-specs">
                  {p.specifications.slice(0, 2).map((spec) => (
                    <span class="as-card-spec">
                      {spec.label}: {spec.value}
                    </span>
                  ))}
                </div>
              )}

              <div class="as-card-price">
                <span class="as-price-value">استعلام قیمت</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</main>

<style>
  .as,
  .as * {
    font-family: "Vazirmatn", "Tahoma", sans-serif;
    box-sizing: border-box;
  }

  .as {
    isolation: isolate;
    position: relative;
    width: 100%;
    min-width: 0;

    --bg: #f1f3f7;
    --surface: #fff;
    --ink: #0f1a2b;
    --ink-soft: #4a5568;
    --muted: #8b95a5;
    --line: #e2e7ef;
    --blue: #1e3a8a;
    --blue-light: #2d4dab;
    --blue-soft: #e8eef9;
    --blue-glow: rgba(30, 58, 138, 0.25);

    min-height: auto;
    display: flex;
    flex-direction: column;
    padding: 18px clamp(18px, 3vw, 40px) 24px;
    background: var(--bg);
    color: var(--ink);
    overflow: hidden;
    gap: 16px;
  }

  .as a {
    color: inherit;
    text-decoration: none;
  }

  /* لوگو */
  .as-logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .as-logo img {
    width: 42px;
    height: 42px;
    object-fit: contain;
    border-radius: 12px;
    background: var(--surface);
    padding: 6px;
    box-shadow: 0 1px 3px rgba(15, 26, 43, 0.06);
  }

  .as-logo strong {
    display: block;
    font-size: 16px;
    font-weight: 900;
    line-height: 1.1;
    color: var(--ink);
  }

  .as-logo span {
    display: block;
    font-size: 9px;
    letter-spacing: 2.5px;
    color: var(--muted);
    direction: ltr;
    font-weight: 700;
    margin-top: 1px;
  }

  /* معرفی */
  .as-intro {
    flex: 1;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(20px, 3vw, 48px);
    align-items: center;
    min-height: 340px;
  }

  .as-intro-text {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .as-tag {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--blue-soft);
    color: var(--blue);
    font-size: 11px;
    font-weight: 800;
  }

  .as-intro-text h1 {
    margin: 0;
    font-size: clamp(28px, 3.4vw, 48px);
    font-weight: 900;
    line-height: 1.3;
    letter-spacing: -1.5px;
    color: var(--ink);
  }

  .as-intro-text h1 em {
    font-style: normal;
    color: var(--blue);
    position: relative;
    display: inline-block;
  }

  .as-intro-text h1 em::after {
    content: "";
    position: absolute;
    bottom: 5px;
    right: -3px;
    left: -3px;
    height: 8px;
    background: var(--blue-soft);
    z-index: -1;
    border-radius: 4px;
  }

  .as-intro-text p {
    margin: 0;
    font-size: 14px;
    line-height: 2;
    color: var(--ink-soft);
    max-width: 460px;
  }

  .as-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 4px;
  }

  .as-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 24px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 800;
    transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .as-btn-primary {
    background: var(--blue);
    color: #fff !important;
  }

  .as-btn-primary:hover {
    background: var(--blue-light);
    transform: translateY(-2px);
    box-shadow: 0 12px 24px -8px var(--blue-glow);
  }

  .as-btn-primary:hover svg {
    transform: translateX(-3px);
  }

  .as-btn-primary svg {
    transition: transform 0.3s ease;
  }

  .as-btn-ghost {
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--line);
  }

  .as-btn-ghost:hover {
    border-color: var(--blue);
    color: var(--blue);
    transform: translateY(-2px);
  }

  .as-contact {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    color: var(--muted);
    margin-top: 6px;
  }

  .as-contact a {
    color: var(--ink-soft);
    font-weight: 700;
    transition: color 0.2s ease;
  }

  .as-contact a:hover {
    color: var(--blue);
  }

  /* قاب اسلایدر */
  .as-intro-photo {
    position: relative;
    isolation: isolate;
    height: 100%;
    max-height: 400px;
    min-height: 300px;
    border-radius: 24px;
    overflow: hidden;
    background: linear-gradient(
      135deg,
      var(--blue-soft) 0%,
      #d4dff3 100%
    );
  }

  .as-slides {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #d4dff3;
  }

  .as-intro-photo img.as-hero-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    visibility: hidden;
    transform: scale(1.015);
    transition:
      opacity 900ms ease,
      transform 6s ease,
      visibility 900ms ease;
    will-change: opacity;
  }

  .as-intro-photo img.as-hero-slide.is-active {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
    z-index: 1;
  }

  .as-intro-photo:hover img.as-hero-slide.is-active {
    transform: scale(1.035);
  }

  .as-photo-shade {
    position: absolute;
    z-index: 2;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(8, 20, 43, 0.04) 35%,
      rgba(8, 20, 43, 0.32) 100%
    );
  }

  .as-intro-photo.as-photo-fallback {
    background: linear-gradient(
      135deg,
      var(--blue-soft) 0%,
      #d4dff3 100%
    );
  }

  .as-intro-photo.as-photo-fallback::before {
    content: "＋";
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 46px;
    font-weight: 300;
    color: var(--blue);
    opacity: 0.5;
  }

  .as-intro-photo.as-photo-fallback::after {
    content: "جایگاه تصویر صنعتی";
    position: absolute;
    z-index: 3;
    top: 58%;
    right: 0;
    left: 0;
    text-align: center;
    font-size: 13px;
    font-weight: 700;
    color: var(--blue);
    opacity: 0.7;
  }

  .as-photo-overlay {
    position: absolute;
    z-index: 3;
    bottom: 16px;
    right: 16px;
    padding: 8px 13px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    pointer-events: none;
  }

  .as-photo-label {
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 2.5px;
    color: var(--blue);
    direction: ltr;
  }

  /* دکمه‌ها و نشانگرها */
  .as-slider-controls {
    position: absolute;
    z-index: 4;
    left: 16px;
    bottom: 15px;
    display: flex;
    align-items: center;
    gap: 9px;
    direction: ltr;
  }

  .as-slider-arrow {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 50%;
    color: #fff;
    background: rgba(10, 25, 50, 0.42);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    cursor: pointer;
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  .as-slider-arrow svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .as-slider-arrow:hover {
    background: var(--blue);
    transform: scale(1.06);
  }

  .as-slider-arrow:focus-visible,
  .as-slider-dot:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .as-slider-dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .as-slider-dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.62);
    cursor: pointer;
    transition:
      width 0.3s ease,
      background 0.3s ease;
  }

  .as-slider-dot.is-active {
    width: 22px;
    background: #fff;
  }

  .as-slider-counter {
    position: absolute;
    z-index: 4;
    top: 16px;
    left: 16px;
    display: flex;
    align-items: center;
    gap: 6px;
    direction: ltr;
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.4);
    pointer-events: none;
  }

  .as-counter-divider {
    opacity: 0.6;
  }

  /* ریل محصولات */
  .as-rail-section {
