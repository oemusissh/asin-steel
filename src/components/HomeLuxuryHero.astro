</style>

<script>
  const slider = document.querySelector("[data-hero-slider]");

  if (slider && !slider.hasAttribute("data-slider-ready")) {
    slider.setAttribute("data-slider-ready", "true");

    const slides = Array.from(
      slider.querySelectorAll("[data-slide-index]")
    );

    const dots = Array.from(
      slider.querySelectorAll("[data-slide-to]")
    );

    const label = slider.querySelector("[data-slide-label]");
    const counter = slider.querySelector("[data-slider-current]");
    const previousButton = slider.querySelector("[data-slider-prev]");
    const nextButton = slider.querySelector("[data-slider-next]");

    const labels = [
      "STEEL INDUSTRY",
      "STEEL SHEETS",
      "STEEL PROFILES",
    ];

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    );

    let currentIndex = 0;
    let timer = null;
    let touchStartX = 0;

    const intervalDuration = 6000;

    function showSlide(index) {
      if (!slides.length) return;

      currentIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, i) => {
        const active = i === currentIndex;

        slide.classList.toggle("is-active", active);
        slide.setAttribute("aria-hidden", active ? "false" : "true");
      });

      dots.forEach((dot, i) => {
        const active = i === currentIndex;

        dot.classList.toggle("is-active", active);
        dot.setAttribute("aria-pressed", active ? "true" : "false");
      });

      if (label) {
        label.textContent = labels[currentIndex] || "ASIN STILL";
      }

      if (counter) {
        counter.textContent = String(currentIndex + 1).padStart(2, "0");
      }
    }

    function stopAutoPlay() {
      if (timer !== null) {
        window.clearInterval(timer);
        timer = null;
      }
    }

    function startAutoPlay() {
      stopAutoPlay();

      if (reduceMotion.matches || slides.length < 2) return;

      timer = window.setInterval(() => {
        showSlide(currentIndex + 1);
      }, intervalDuration);
    }

    function goToSlide(index) {
      showSlide(index);
      startAutoPlay();
    }

    previousButton?.addEventListener("click", () => {
      goToSlide(currentIndex - 1);
    });

    nextButton?.addEventListener("click", () => {
      goToSlide(currentIndex + 1);
    });

    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => {
        goToSlide(index);
      });
    });

    // توقف موقت هنگام قرار گرفتن نشانگر ماوس روی تصویر
    slider.addEventListener("mouseenter", stopAutoPlay);
    slider.addEventListener("mouseleave", startAutoPlay);

    // با ورود صفحه‌کلید به اسلایدر، حرکت خودکار متوقف می‌شود
    slider.addEventListener("focusin", stopAutoPlay);
    slider.addEventListener("focusout", (event) => {
      if (!slider.contains(event.relatedTarget)) {
        startAutoPlay();
      }
    });

    // پشتیبانی از کشیدن انگشت روی تصویر در موبایل
    slider.addEventListener(
      "touchstart",
      (event) => {
        touchStartX = event.changedTouches[0]?.clientX ?? 0;
      },
      { passive: true }
    );

    slider.addEventListener(
      "touchend",
      (event) => {
        const touchEndX = event.changedTouches[0]?.clientX ?? 0;
        const difference = touchEndX - touchStartX;

        if (Math.abs(difference) < 45) return;

        // در چیدمان RTL، کشیدن به چپ تصویر بعدی را نمایش می‌دهد
        goToSlide(currentIndex + (difference < 0 ? 1 : -1));
      },
      { passive: true }
    );

    // اگر کاربر حرکت را کاهش داده باشد، پخش خودکار غیرفعال می‌شود
    reduceMotion.addEventListener?.("change", startAutoPlay);

    // اگر تب مرورگر مخفی شود، زمان‌سنج متوقف می‌شود
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        stopAutoPlay();
      } else if (!slider.matches(":hover") && !slider.contains(document.activeElement)) {
        startAutoPlay();
      }
    });

    // اگر یکی از تصاویر بارگذاری نشد، تصویر خراب حذف می‌شود
    slides.forEach((slide) => {
      slide.addEventListener("error", () => {
        slide.classList.remove("is-active");
        slide.style.display = "none";

        const visibleSlides = slides.filter(
          (item) => item.style.display !== "none"
        );

        if (visibleSlides.length === 0) {
          slider.classList.add("as-photo-fallback");
        } else {
          slider.classList.remove("as-photo-fallback");
        }

        if (slides[currentIndex] === slide && visibleSlides.length > 0) {
          const nextAvailableIndex = slides.findIndex(
            (item) => item.style.display !== "none"
          );

          showSlide(nextAvailableIndex);
        }
      });
    });

    showSlide(0);
    startAutoPlay();
  }
</script>
