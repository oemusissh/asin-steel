                allFactories: ['کیز ایران', 'میراب', 'سگال', 'وگ ایران', 'برندهای دیگر']
              },
              'اتصالات': {
                types: ['فلنج', 'زانو', 'سه‌راهی', 'تبدیل'],
                selectedSizes: ['1/2"', '1"', '2"', '3"', '4"', '6"'],
                selectedFactories: ['اتصالات گاز ایران', 'تولیدکننده منتخب ۲'],
                allFactories: ['اتصالات گاز ایران', 'تولیدکننده منتخب ۲', 'تولیدکننده منتخب ۳']
              },
