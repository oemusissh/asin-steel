                allFactories: ['فولاد آلیاژی ایران', 'اسفراین', 'فولاد آلیاژی پاسارگاد', 'فولاد آلیاژی اصفهان']
              }
            };

            const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}`;
            const priceListUrl = `${baseUrl}/price-list`;

            const typeContainer = document.getElementById('mega-types');
            const optionsContainer = document.getElementById('mega-options');
            const detailContainer = document.getElementById('mega-detail');
            const detailTitle = document.getElementById('mega-detail-title');
            const categoryButtons = document.querySelectorAll('.mega-category');

            let currentCategory = 'میلگرد';
            let currentType = 'میلگرد آجدار';
            let currentOption = 'sizes';

            const categoryMap = {
              'میلگرد': 'rebar',
              'تیرآهن': 'beam',
              'پروفیل': 'profile',
              'ورق گرم': 'sheet',
              'ورق سرد': 'sheet',
              'نبشی و ناودانی': 'angle'
            };

            const arrowSvg = `
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>`;

            function makeProductUrl({ category, type = '', size = '', factory = '' }) {
              const categoryId = categoryMap[category];
              const params = new URLSearchParams();

              if (categoryId) params.set('category', categoryId);
              if (type) params.set('type', type);
              if (size) params.set('size', size);
              if (factory) params.set('factory', factory);

              // دسته‌هایی که category ندارند، حداقل با search فیلتر می‌شوند
              if (!categoryId && !type && !size && !factory) {
                params.set('search', category);
              }

              return `${priceListUrl}?${params.toString()}`;
            }

            function renderDetail(category, type, option) {
              const data = megaData[category];
              if (!data) return;

              let title = '';
              let items = [];

              if (option === 'sizes') {
                title = type ? `سایزهای ${type}` : 'سایزهای منتخب';
                items = data.selectedSizes;
              } else if (option === 'factories') {
                title = type ? `کارخانه‌های ${type}` : 'کارخانه‌های منتخب';
                items = data.selectedFactories;
              } else if (option === 'all-factories') {
                title = type ? `همه کارخانه‌های ${type}` : `همه کارخانه‌های ${category}`;
                items = data.allFactories;
              }

              detailTitle.textContent = title;
              detailContainer.className = 'space-y-0.5';

              if (option === 'sizes') {
                detailContainer.innerHTML = items
                  .map((item) => `
                    <a href="${makeProductUrl({ category, type, size: item })}" class="mega-detail-item">
                      <span>${item}</span>
                      ${arrowSvg}
                    </a>`)
                  .join('');
                return;
              }

              detailContainer.innerHTML = items
                .map((item) => `
                  <a href="${makeProductUrl({ category, type, factory: item })}" class="mega-detail-link">
                    <span>${item}</span>
                    ${arrowSvg}
                  </a>`)
                .join('');
            }

            function renderOptions(category) {
              const data = megaData[category];
              if (!data) return;

              optionsContainer.innerHTML = `
                <button type="button" class="mega-option" data-option="sizes">
                  <span>سایزهای منتخب</span>${arrowSvg}
                </button>
                <button type="button" class="mega-option" data-option="factories">
                  <span>کارخانه‌های منتخب</span>${arrowSvg}
                </button>
                <button type="button" class="mega-option" data-option="all-factories">
                  <span>همه کارخانه‌های ${category}</span>${arrowSvg}
                </button>`;

              const optionButtons = optionsContainer.querySelectorAll('.mega-option');

              optionButtons.forEach((button) => {
                button.addEventListener('mouseenter', () => {
                  currentOption = button.dataset.option;
                  optionButtons.forEach((item) => item.classList.remove('active'));
                  button.classList.add('active');
                  renderDetail(currentCategory, currentType, currentOption);
                });
              });

              optionsContainer.querySelector('[data-option="sizes"]')?.classList.add('active');

              currentOption = 'sizes';
              renderDetail(currentCategory, currentType, currentOption);
            }

            function renderTypes(category) {
              const data = megaData[category];
              if (!data) return;

              typeContainer.innerHTML = data.types
                .map((type, index) => `
                  <a href="${makeProductUrl({ category, type })}" class="mega-type-item ${index === 0 ? 'active' : ''}" data-type="${type}">
                    <span>${type}</span>${arrowSvg}
                  </a>`)
                .join('');

              const typeButtons = typeContainer.querySelectorAll('.mega-type-item');

              typeButtons.forEach((button) => {
                button.addEventListener('mouseenter', () => {
                  currentType = button.dataset.type;
                  typeButtons.forEach((item) => item.classList.remove('active'));
                  button.classList.add('active');
                  renderDetail(currentCategory, currentType, currentOption);
                });
              });

              currentType = data.types[0] || '';
              renderOptions(category);
            }

            function updateMegaMenu(category) {
              const data = megaData[category];
              if (!data) return;

              currentCategory = category;
              currentOption = 'sizes';
              currentType = data.types[0] || '';

              renderTypes(category);

              categoryButtons.forEach((button) => {
                const isActive = button.dataset.category === category;
                button.classList.toggle('active', isActive);
                button.classList.toggle('bg-primary-50', isActive);
                button.classList.toggle('dark:bg-dark-800', isActive);
                button.classList.toggle('text-primary-600', isActive);
                button.classList.toggle('dark:text-primary-400', isActive);
              });
            }

            categoryButtons.forEach((button) => {
              button.addEventListener('mouseenter', () => updateMegaMenu(button.dataset.category));

              button.addEventListener('click', () => {
                const category = button.dataset.category;
                const categoryId = categoryMap[category];

                window.location.href = categoryId
                  ? `${priceListUrl}?category=${categoryId}`
                  : `${priceListUrl}?search=${encodeURIComponent(category)}`;
              });
            });

            updateMegaMenu('میلگرد');
          </script>

