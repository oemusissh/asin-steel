---
---

<header class="sticky top-0 z-50 w-full max-w-full bg-slate-900/75 dark:bg-slate-950/75 backdrop-blur-xl backdrop-saturate-150 border-b border-slate-700/50 transition-all duration-500 ease-in-out shadow-lg shadow-black/10">

  <!-- Top Bar - Mobile Optimized -->
  <div
    id="market-top-bar"
    class="bg-primary-600 dark:bg-primary-700 text-white py-2 text-xs sm:text-sm transition-all duration-500 ease-in-out overflow-hidden max-h-20 opacity-100"
  >
    <div class="asin-header-wrap flex items-center gap-2 sm:gap-4">

      <!-- Contact Info -->
      <div class="flex items-center gap-1 sm:gap-4 shrink-0">
        <span class="hidden sm:inline">📞 +021 669-15-307</span>
        <span class="sm:hidden">📞 Call Us</span>
        <span class="hidden md:inline">✉️ asinsteel@gmail.com</span>
      </div>

      <!-- Live Market News Ticker -->
      <div dir="rtl" class="flex-1 min-w-0 overflow-hidden text-[10px] sm:text-xs">
        <div class="overflow-hidden whitespace-nowrap">
          <div class="live-market-ticker inline-flex items-center gap-3 sm:gap-4">

            <div class="flex items-center gap-2 shrink-0 font-bold">
              <span class="relative flex h-2 w-2">
                <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-300 opacity-75 animate-ping"></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-300"></span>
              </span>
              <span>بازار زنده</span>
            </div>

            <span class="opacity-40">|</span>

            <div class="flex items-center gap-1.5 shrink-0">
              <span class="opacity-70">دلار آزاد:</span>
              <strong class="text-emerald-200">۹۴,۵۰۰</strong>
              <span class="opacity-60">تومان</span>
              <span class="text-emerald-200">▲</span>
            </div>

            <span class="opacity-40">|</span>

            <div class="flex items-center gap-1.5 shrink-0">
              <span class="opacity-70">شمش فولاد:</span>
              <strong class="text-red-200">۲۸,۴۰۰</strong>
              <span class="opacity-60">تومان</span>
              <span class="text-red-200">▼</span>
            </div>

            <span class="opacity-40">|</span>

            <div class="flex items-center gap-1.5 shrink-0">
              <span class="opacity-70">تیرآهن ذوب‌آهن:</span>
              <strong class="text-emerald-200">۳۶,۲۰۰</strong>
              <span class="opacity-60">تومان</span>
              <span class="text-emerald-200">▲</span>
            </div>

            <span class="opacity-40">|</span>

            <div class="flex items-center gap-1.5 shrink-0">
              <span class="opacity-70">میلگرد A3:</span>
              <strong class="text-emerald-200">۳۲,۴۰۰</strong>
              <span class="opacity-60">تومان</span>
              <span class="text-emerald-200">▲</span>
            </div>

            <span class="opacity-40">|</span>

            <div class="flex items-center gap-1.5 shrink-0">
              <span class="opacity-70">ورق سیاه:</span>
              <strong class="text-red-200">۴۱,۸۰۰</strong>
              <span class="opacity-60">تومان</span>
              <span class="text-red-200">▼</span>
            </div>

          </div>
        </div>
      </div>

      <!-- Top Links -->
      <div class="flex items-center gap-2 sm:gap-4 shrink-0">
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/track-order`} class="hover:text-primary-200 transition-colors">Track</a>
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/help`} class="hover:text-primary-200 transition-colors">Help</a>
      </div>

    </div>
  </div>

  <style>
    .live-market-ticker {
      display: inline-flex;
      animation: marketTicker 25s linear infinite;
      white-space: nowrap;
    }
    .live-market-ticker:hover {
      animation-play-state: paused;
    }
    @keyframes marketTicker {
      from { transform: translateX(100%); }
      to { transform: translateX(-100%); }
    }
  </style>

  <script>
    const marketTopBar = document.getElementById("market-top-bar");

    window.addEventListener(
      "scroll",
      () => {
        if (!marketTopBar) return;

        if (window.scrollY > 120) {
          marketTopBar.classList.remove("max-h-20", "opacity-100");
          marketTopBar.classList.add("max-h-0", "opacity-0", "py-0", "pointer-events-none");
        } else {
          marketTopBar.classList.remove("max-h-0", "opacity-0", "py-0", "pointer-events-none");
          marketTopBar.classList.add("max-h-20", "opacity-100");
        }
      },
      { passive: true }
    );
  </script>

  <!-- Main Header - Mobile Optimized -->
  <div class="asin-header-wrap py-3 sm:py-4">
    <div dir="rtl" class="flex w-full min-w-0 items-center justify-between gap-1 sm:gap-3 lg:gap-4">
      <div class="flex shrink-0 items-center gap-1 sm:gap-3">
        <!-- Mobile Menu Button -->
        <button id="mobile-menu-toggle" class="p-1.5 sm:p-2 hover:bg-gray-100 dark:hover:bg-dark-800 rounded-lg transition-colors" aria-label="Toggle menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <!-- Logo -->
        <a href={import.meta.env.BASE_URL} class="flex items-center gap-2 group">
          <div class="w-8 h-8 sm:w-10 sm:h-10 bg-primary-600 dark:bg-primary-500 rounded-lg flex items-center justify-center transform group-hover:scale-110 transition-transform duration-500 ease-in-out shadow-md group-hover:shadow-lg">
            <span class="text-white font-bold text-lg sm:text-xl">🏗️</span>
          </div>
          <span class="text-lg sm:text-xl font-bold text-gray-900 dark:text-white hidden lg:inline">ASIN STEEL</span>
        </a>
      </div>

      <!-- Smart Search Bar -->
      <div class="flex-1 min-w-0 max-w-2xl hidden sm:block">
        <form class="relative group" id="search-form" role="search">
          <input
            type="search"
            id="smart-search"
            dir="rtl"
            enterkeyhint="search"
            placeholder="محصول موردنظر خود را جستجو کنید..."
            autocomplete="off"
            class="w-full px-4 py-3 pl-12 pr-4 rounded-xl border-2 border-gray-200 dark:border-dark-700 bg-gray-50 dark:bg-dark-800 focus:border-primary-500 dark:focus:border-primary-500 focus:outline-none focus:ring-4 focus:ring-primary-500/20 focus:shadow-[0_0_20px_rgba(251,146,60,0.2)] transition-all duration-500 ease-in-out group-hover:border-gray-300 dark:group-hover:border-dark-600"
          />
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400 transition-all duration-500 ease-in-out group-focus-within:scale-110 group-focus-within:text-primary-500 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <!-- Autocomplete Dropdown -->
          <div id="search-results" class="hidden absolute top-full left-0 right-0 mt-2 bg-white dark:bg-dark-800 rounded-xl shadow-2xl border border-gray-200 dark:border-dark-700 max-h-96 overflow-y-auto z-50"></div>
        </form>
      </div>

      <!-- Mobile Search Button -->
      <button id="mobile-search-toggle" class="sm:hidden p-1.5 hover:bg-gray-100 dark:hover:bg-dark-800 rounded-lg transition-colors" aria-label="Search">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>

      <!-- Actions -->
      <div class="flex shrink-0 items-center gap-0.5 sm:gap-2 lg:gap-3">

        <!-- Proforma Invoice Button -->
        <button
          id="open-proforma"
          type="button"
          aria-label="پیش‌فاکتور"
          title="پیش‌فاکتور"
          class="relative h-10 sm:h-12 shrink-0 bg-dark-800 hover:bg-dark-700 text-primary-400 border border-dark-700 px-2 sm:px-3 lg:px-4 rounded-xl flex items-center gap-1.5 sm:gap-2 transition-all duration-300 hover:border-primary-500/40 hover:shadow-[0_4px_18px_rgba(37,99,235,0.12)] active:scale-[0.98]"
          style="font-family: 'Vazirmatn', sans-serif;"
        >
          <span class="flex items-center justify-center">
            <svg class="w-[19px] h-[19px]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 3h7l5 5v13H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M14 3v5h5M9 13h6M9 17h6M9 9h1" />
            </svg>
          </span>

          <span class="hidden md:inline font-bold text-sm text-slate-200 whitespace-nowrap">پیش‌فاکتور</span>

          <span id="proforma-count" class="bg-primary-500 text-white font-extrabold text-xs px-1.5 sm:px-2 py-0.5 rounded-full min-w-[20px] sm:min-w-[23px] text-center transition-transform duration-200">۰</span>

          <span id="proforma-active-dot" class="absolute -top-1 -right-1 w-2.5 h-2.5 rounded-full bg-primary-400 border-2 border-dark-900 opacity-0 scale-0 transition-all duration-300"></span>
        </button>

        <!-- Theme Toggle -->
        <button id="theme-toggle" class="p-1.5 sm:p-2.5 rounded-xl hover:bg-gray-100 dark:hover:bg-dark-800 transition-all duration-500 ease-in-out hover:scale-110 active:scale-95" aria-label="Toggle theme">
          <svg id="theme-toggle-dark-icon" class="w-5 h-5 hidden dark:block transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg id="theme-toggle-light-icon" class="w-5 h-5 block dark:hidden transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <!-- Wishlist -->
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/wishlist`} class="relative hidden sm:block p-2 sm:p-2.5 rounded-xl hover:bg-gray-100 dark:hover:bg-dark-800 transition-all duration-500 ease-in-out group">
          <svg class="w-5 h-5 group-hover:scale-110 group-hover:text-red-500 transition-all duration-500 ease-in-out" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
          <span data-wishlist-count class="absolute -top-1 -right-1 bg-red-500 text-white text-[10px] sm:text-xs rounded-full w-4 h-4 sm:w-5 sm:h-5 flex items-center justify-center font-semibold shadow-lg group-hover:scale-110 transition-all duration-500 ease-in-out">0</span>
        </a>

        <!-- Cart -->
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/cart`} class="relative p-1.5 sm:p-2.5 rounded-xl hover:bg-gray-100 dark:hover:bg-dark-800 transition-all duration-500 ease-in-out group">
          <svg class="w-5 h-5 group-hover:scale-110 group-hover:text-primary-600 transition-all duration-500 ease-in-out" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
          <span data-cart-count class="absolute -top-1 -right-1 bg-primary-600 text-white text-[10px] sm:text-xs rounded-full w-4 h-4 sm:w-5 sm:h-5 flex items-center justify-center font-semibold shadow-lg group-hover:scale-110 transition-all duration-500 ease-in-out">0</span>
        </a>

        <!-- Account -->
        <a id="header-account-link" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/account`} class="hidden sm:block p-2 sm:p-2.5 rounded-xl hover:bg-gray-100 dark:hover:bg-dark-800 transition-all duration-500 ease-in-out hover:scale-110 active:scale-95">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Mobile Search Overlay -->
    <div id="mobile-search-overlay" class="hidden sm:hidden fixed inset-0 z-[60]">
      <div data-backdrop class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>

      <div class="absolute top-0 left-0 right-0 bg-white dark:bg-dark-900 p-4 shadow-xl">
        <div class="flex items-center gap-2">
          <input
            type="search"
            dir="rtl"
            enterkeyhint="search"
            autocomplete="off"
            placeholder="جستجوی محصول…"
            class="flex-1 px-4 py-3 rounded-lg border-2 border-gray-200 dark:border-dark-700 bg-white dark:bg-dark-800 focus:border-primary-500 focus:outline-none text-base"
            id="mobile-search-input"
          />
          <button id="mobile-search-close" class="p-2 hover:bg-gray-100 dark:hover:bg-dark-800 rounded-lg transition-colors" aria-label="بستن جستجو">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <div id="mobile-search-results" class="hidden mt-2 bg-white dark:bg-dark-800 rounded-lg border border-gray-200 dark:border-dark-700 max-h-[60vh] overflow-y-auto"></div>
      </div>
    </div>

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu-overlay" class="hidden lg:hidden fixed inset-0 z-[60]" style="display: none;">
      <div data-backdrop class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>

      <div class="absolute left-0 top-0 h-full w-full sm:w-[420px] sm:max-w-[85vw] bg-white dark:bg-dark-900 shadow-2xl overflow-y-auto" style="min-height: 100vh;">
        <!-- Header -->
        <div class="sticky top-0 p-4 border-b border-gray-200 dark:border-dark-700 flex items-center justify-between bg-white dark:bg-dark-900 z-10">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 bg-primary-600 dark:bg-primary-500 rounded-lg flex items-center justify-center">
              <span class="text-white font-bold text-lg">🏗️</span>
            </div>
            <span class="font-bold text-lg text-gray-900 dark:text-white">ASIN STEEL</span>
          </div>
          <button id="mobile-menu-close" class="p-2 hover:bg-gray-100 dark:hover:bg-dark-800 rounded-lg transition-colors" aria-label="بستن منو">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Quick Actions -->
        <div class="p-4 border-b border-gray-200 dark:border-dark-700 bg-gray-50 dark:bg-dark-800/50">
          <div class="grid grid-cols-3 gap-3">
            <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/products`} class="flex flex-col items-center gap-2 p-3 rounded-lg hover:bg-white dark:hover:bg-dark-800 transition-colors">
              <div class="relative">
                <svg class="w-6 h-6 text-gray-700 dark:text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </div>
              <span class="text-xs font-medium text-gray-700 dark:text-gray-300">Search</span>
            </a>
            <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/cart`} class="flex flex-col items-center gap-2 p-3 rounded-lg hover:bg-white dark:hover:bg-dark-800 transition-colors">
              <div class="relative">
                <svg class="w-6 h-6 text-gray-700 dark:text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
                <span data-cart-count class="absolute -top-1 -right-1 bg-primary-600 text-white text-[10px] rounded-full w-4 h-4 flex items-center justify-center font-semibold">0</span>
              </div>
              <span class="text-xs font-medium text-gray-700 dark:text-gray-300">Cart</span>
            </a>
            <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/wishlist`} class="flex flex-col items-center gap-2 p-3 rounded-lg hover:bg-white dark:hover:bg-dark-800 transition-colors">
              <div class="relative">
                <svg class="w-6 h-6 text-gray-700 dark:text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
                <span data-wishlist-count class="absolute -top-1 -right-1 bg-red-500 text-white text-[10px] rounded-full w-4 h-4 flex items-center justify-center font-semibold">0</span>
              </div>
              <span class="text-xs font-medium text-gray-700 dark:text-gray-300">Wishlist</span>
            </a>
          </div>
        </div>

        <!-- Main Navigation -->
        <nav class="p-4" style="display: block; visibility: visible;">
          <div class="mb-2">
            <p class="px-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">Categories</p>
            <ul class="space-y-1" style="display: block; visibility: visible;">
              {[
                ['/products', '🏗️', 'لیست محصولات'],
                ['/categories/steel-metal', '⚙️', 'Steel & Metal'],
                ['/categories/lumber-wood', '🪵', 'Lumber & Wood'],
                ['/categories/tools-equipment', '🔨', 'Tools & Equipment'],
                ['/categories/electrical', '⚡', 'Electrical'],
                ['/categories/plumbing', '🚰', 'Plumbing'],
              ].map(([path, icon, label]) => (
                <li style="display: block;">
                  <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}${path}`} class="group flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-gray-100 dark:hover:bg-dark-800 font-medium transition-all text-gray-900 dark:text-white relative">
                    <span class="absolute left-0 top-0 bottom-0 w-1 bg-primary-600 rounded-r opacity-0 group-hover:opacity-100 transition-opacity"></span>
                    <span class="text-lg">{icon}</span>
                    <span class="text-sm">{label}</span>
                  </a>
                </li>
              ))}
              <li style="display: block;">
                <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/deals`} class="group flex items-center gap-3 px-3 py-2.5 rounded-lg bg-gradient-to-r from-red-50 to-orange-50 dark:from-red-900/20 dark:to-orange-900/20 hover:from-red-100 hover:to-orange-100 dark:hover:from-red-900/30 dark:hover:to-orange-900/30 font-bold transition-all text-red-600 dark:text-red-400 relative">
                  <span class="absolute left-0 top-0 bottom-0 w-1 bg-red-600 rounded-r"></span>
                  <span class="text-lg">🔥</span>
                  <span class="text-sm">Hot deals</span>
                  <span class="ml-auto px-2 py-0.5 bg-red-600 text-white text-[10px] rounded-full font-bold">NEW</span>
                </a>
              </li>
            </ul>
          </div>

          <!-- Account Section -->
          <div class="mt-6 pt-4 border-t border-gray-200 dark:border-dark-700">
            <p class="px-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">My Account</p>
            <ul class="space-y-1">
              <li>
                <a id="mobile-account-link" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/account`} class="group flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-gray-100 dark:hover:bg-dark-800 transition-all text-gray-900 dark:text-white relative">
                  <span class="absolute left-0 top-0 bottom-0 w-1 bg-primary-600 rounded-r opacity-0 group-hover:opacity-100 transition-opacity"></span>
                  <svg class="w-5 h-5 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                  </svg>
                  <span class="text-sm font-medium">Dashboard</span>
                </a>
              </li>
              <li>
                <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/account/orders`} class="group flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-gray-100 dark:hover:bg-dark-800 transition-all text-gray-900 dark:text-white relative">
                  <span class="absolute left-0 top-0 bottom-0 w-1 bg-primary-600 rounded-r opacity-0 group-hover:opacity-100 transition-opacity"></span>
                  <svg class="w-5 h-5 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                  </svg>
                  <span class="text-sm font-medium">My Orders</span>
                </a>
              </li>
              <li>
