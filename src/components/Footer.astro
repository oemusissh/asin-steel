---
// ───────────────────────────────────────────────
// اطلاعات قابل ویرایش: فقط این بخش را تغییر دهید
// ───────────────────────────────────────────────
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const company = {
  name: 'آسین استیل',
  addressLine: 'خیابان جمالزاده، خیابان توحید، کوچه حاج‌رضایی، پلاک ۱۶',
  postalCode: '۱۴۱۹۷۱۳۷۴۰',
  phoneDisplay: '۶۶۹۱۵۳۰۷',
  phoneHref: '02166915307', // پیش‌شماره تهران فرض شده است؛ در صورت نیاز اصلاح کنید
  hours: '[ساعت کاری]',
  email: '[ایمیل]',
};

const mapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  'تهران، ' + company.addressLine,
)}`;

const phoneDigits = [...company.phoneDisplay];

// لوگوی همه شبکه‌ها سفید است. برای دقت کامل، SVG رسمی هر برند را جایگزین کنید.
const socials = [
  { key: 'instagram', label: 'اینستاگرام', href: '[لینک اینستاگرام]' },
  { key: 'telegram', label: 'تلگرام', href: '[لینک تلگرام]' },
  { key: 'bale', label: 'بله', href: '[لینک بله]' },
  { key: 'linkedin', label: 'لینکدین', href: '[لینک لینکدین]' },
  { key: 'whatsapp', label: 'واتساپ', href: '[لینک واتساپ]' },
];

const socialPaths: Record<string, string> = {
  telegram:
    'M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z',
  linkedin:
    'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  whatsapp:
    'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z',
};

const products = [
  { label: 'تیرآهن', href: `${base}/products/ibeam` },
  { label: 'میلگرد', href: `${base}/products/rebar` },
  { label: 'ناودانی', href: `${base}/products/channel` },
  { label: 'نبشی', href: `${base}/products/angle` },
  { label: 'قوطی و پروفیل', href: `${base}/products/tube-profile` },
  { label: 'ورق', href: `${base}/products/sheet` },
];

const quickLinks = [
  { label: 'درباره ما', href: `${base}/about-us` },
  { label: 'تماس با ما', href: `${base}/contact` },
  { label: 'وبلاگ', href: `${base}/blog` },
  { label: 'قوانین و مقررات', href: `${base}/terms` },
];

const legalLinks = [
  { label: 'حریم خصوصی', href: `${base}/privacy` },
  { label: 'سیاست کوکی‌ها', href: `${base}/cookies` },
  { label: 'نقشه سایت', href: `${base}/sitemap` },
];

// رنگ تأکید هر ستون
const colors = { products: '#5AB0FF', quick: '#3DD9C4', contact: '#B4B9FF' };

const year = new Date().toLocaleDateString('fa-IR', { year: 'numeric' });

const focus =
  'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#8EC0FF] focus-visible:ring-offset-2 focus-visible:ring-offset-[#0F3562]';
const focusLight =
  'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0F3562] focus-visible:ring-offset-2 dark:focus-visible:ring-primary-400 dark:focus-visible:ring-offset-dark-950';
---

<footer dir="rtl" data-site-footer class=" text-[#BFD0E6]">
  <!-- نوار رنگی جداکننده از بالای سایت -->
  <div class="top-bar" aria-hidden="true">
    <span style="background:#2F7BE0"></span>
    <span style="background:#5AB0FF"></span>
    <span style="background:#3DD9C4"></span>
    <span style="background:#B4B9FF"></span>
  </div>

  <div class="bg-[#0F3562]">
    <div class="container mx-auto px-4">
      <!-- ردیف تماس سریع -->
      <div
        data-reveal
        style="--i:0"
        class="flex flex-col items-start justify-between gap-6 border-b border-white/15 py-8 md:flex-row md:items-center"
      >
        <div class="flex items-center gap-4">
          <span class="pulse-icon relative flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white text-[#0F3562]" aria-hidden="true">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
          </span>
          <div>
            <p class="text-sm">برای استعلام قیمت و مشاوره خرید تماس بگیرید</p>
            <a
              href={`tel:${company.phoneHref}`}
              aria-label={`تماس با ${company.phoneDisplay}`}
              class={`group inline-block rounded-md ${focus}`}
            >
              <span class="relative inline-block">
                <span dir="ltr" aria-hidden="true" class="inline-flex overflow-hidden py-0.5 text-3xl font-extrabold leading-[1.3] tracking-tight text-white sm:text-4xl">
                  {phoneDigits.map((digit, k) => (
                    <span class="digit inline-block" style={`--k:${k}`}>{digit}</span>
                  ))}
                </span>
                <span class="absolute inset-x-0 -bottom-0.5 h-0.5 origin-right scale-x-0 bg-[#5AB0FF] transition-transform duration-500 ease-out group-hover:scale-x-100 group-focus-visible:scale-x-100" aria-hidden="true"></span>
              </span>
            </a>
          </div>
        </div>

        <a
          href={`${base}/contact`}
          class={`btn-shine group relative inline-flex min-h-[48px] items-center justify-center gap-2 overflow-hidden rounded-lg bg-white px-6 text-[15px] font-bold text-[#0F3562] transition duration-300 ease-out hover:-translate-y-0.5 hover:shadow-[0_12px_24px_-12px_rgba(0,0,0,0.6)] active:translate-y-0 active:scale-[0.98] ${focus}`}
        >
          درخواست استعلام قیمت
          <svg class="h-4 w-4 transition-transform duration-300 ease-out group-hover:-translate-x-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 18l-6-6 6-6" />
          </svg>
        </a>
      </div>

      <!-- ستون‌ها -->
      <div class="grid grid-cols-1 gap-9 py-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1.2fr_0.9fr_1.4fr] lg:gap-10">
        <!-- برند و شبکه‌های اجتماعی -->
        <div data-reveal style="--i:0" class="sm:col-span-2 lg:col-span-1">
          <a href={`${base}/`} class={`inline-flex items-center gap-2.5 rounded-sm ${focus}`} aria-label="آسین استیل، صفحه اصلی">
            <svg class="h-7 w-7 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M4 4H20V7.5H13.75V16.5H20V20H4V16.5H10.25V7.5H4Z" />
            </svg>
            <span class="text-xl font-extrabold text-white">{company.name}</span>
          </a>
          <p class="mt-3 text-base font-bold text-white">کیفیت در ساخت، اعتماد در تحویل</p>
          <p class="mt-1.5 max-w-xs text-[15px] leading-7">
            عرضه مقاطع فولادی ساختمانی و صنعتی برای پیمانکاران و سازندگان.
          </p>

          <ul class="mt-5 flex flex-wrap gap-2.5" aria-label="شبکه‌های اجتماعی">
            {socials.map((s) => (
              <li class="relative">
                <a
                  href={s.href}
                  aria-label={s.label}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`social-btn group relative flex h-11 w-11 items-center justify-center rounded-full border border-white/50 text-white transition duration-300 ease-out hover:-translate-y-1 hover:border-white hover:bg-white hover:text-[#0F3562] active:scale-95 ${focus}`}
                >
                  {s.key === 'instagram' && (
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="5.5" />
                      <circle cx="12" cy="12" r="4.2" />
                      <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
                    </svg>
                  )}
                  {s.key === 'bale' && (
                    <span class="text-sm font-extrabold leading-none" aria-hidden="true">بله</span>
                  )}
                  {socialPaths[s.key] && (
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d={socialPaths[s.key]} />
                    </svg>
                  )}
                  <span class="pointer-events-none absolute -top-9 left-1/2 -translate-x-1/2 translate-y-1 whitespace-nowrap rounded-md bg-white px-2.5 py-1 text-xs font-bold text-[#0F3562] opacity-0 transition duration-300 ease-out group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100" aria-hidden="true">
                    {s.label}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- محصولات (دو ستونه برای جمع‌وجور ماندن) -->
        <nav data-reveal style={`--i:1;--c:${colors.products}`} aria-labelledby="footer-products">
          <h2 id="footer-products" class="text-base font-bold text-white">محصولات</h2>
          <span class="bar mb-2 mt-2 block h-[3px] w-8 origin-right rounded-full bg-[var(--c)]" aria-hidden="true"></span>
          <ul class="grid grid-cols-2 gap-x-4">
            {products.map((link) => (
              <li>
                <a
                  href={link.href}
                  class={`group inline-flex min-h-[44px] items-center rounded-sm text-[15px] transition duration-300 ease-out hover:-translate-x-1 hover:text-white lg:min-h-[38px] ${focus}`}
                >
                  <span class="relative">
                    {link.label}
                    <span class="absolute inset-x-0 -bottom-0.5 h-0.5 origin-right scale-x-0 bg-[var(--c)] transition-transform duration-300 ease-out group-hover:scale-x-100 group-focus-visible:scale-x-100" aria-hidden="true"></span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <!-- دسترسی سریع -->
        <nav data-reveal style={`--i:2;--c:${colors.quick}`} aria-labelledby="footer-quick">
          <h2 id="footer-quick" class="text-base font-bold text-white">دسترسی سریع</h2>
          <span class="bar mb-2 mt-2 block h-[3px] w-8 origin-right rounded-full bg-[var(--c)]" aria-hidden="true"></span>
          <ul>
            {quickLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class={`group inline-flex min-h-[44px] items-center rounded-sm text-[15px] transition duration-300 ease-out hover:-translate-x-1 hover:text-white lg:min-h-[38px] ${focus}`}
                >
                  <span class="relative">
                    {link.label}
                    <span class="absolute inset-x-0 -bottom-0.5 h-0.5 origin-right scale-x-0 bg-[var(--c)] transition-transform duration-300 ease-out group-hover:scale-x-100 group-focus-visible:scale-x-100" aria-hidden="true"></span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <!-- نشانی و تماس -->
        <div data-reveal style={`--i:3;--c:${colors.contact}`} class="sm:col-span-2 lg:col-span-1">
          <h2 class="text-base font-bold text-white">نشانی و تماس</h2>
          <span class="bar mb-3 mt-2 block h-[3px] w-8 origin-right rounded-full bg-[var(--c)]" aria-hidden="true"></span>
          <address class="not-italic">
            <ul class="space-y-2.5 text-[15px] leading-7">
              <li class="flex items-start gap-2.5">
                <svg class="mt-1.5 h-4 w-4 shrink-0 text-[var(--c)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
                <span>
                  <span class="sr-only">آدرس: </span>{company.addressLine}،
                  کدپستی <bdi class="text-white">{company.postalCode}</bdi>
                  <a
                    href={mapHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`group ms-1 inline-flex items-center gap-1 rounded-sm font-semibold text-white ${focus}`}
                  >
                    <span class="relative">
                      مسیریابی
                      <span class="absolute inset-x-0 -bottom-0.5 h-0.5 origin-right scale-x-100 bg-[var(--c)] transition-transform duration-300 ease-out group-hover:scale-x-0" aria-hidden="true"></span>
                    </span>
                    <svg class="h-3 w-3 transition-transform duration-300 ease-out group-hover:-translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M15 18l-6-6 6-6" />
                    </svg>
                  </a>
                </span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="mt-1.5 h-4 w-4 shrink-0 text-[var(--c)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
                <span>
                  <span class="sr-only">تلفن: </span>
                  <a href={`tel:${company.phoneHref}`} class={`rounded-sm font-bold text-white underline-offset-4 hover:underline ${focus}`}>
                    <bdi>{company.phoneDisplay}</bdi>
                  </a>
                </span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="mt-1.5 h-4 w-4 shrink-0 text-[var(--c)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" />
                  <polyline points="12 6 12 12 16 14" />
                </svg>
                <span><span class="sr-only">ساعت کاری: </span>{company.hours}</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="mt-1.5 h-4 w-4 shrink-0 text-[var(--c)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="4" width="20" height="16" rx="2" />
                  <path d="M22 7l-10 6L2 7" />
                </svg>
                <span>
                  <span class="sr-only">ایمیل: </span>
                  <a href={`mailto:${company.email}`} class={`rounded-sm text-white underline-offset-4 hover:underline ${focus}`}>
                    <bdi>{company.email}</bdi>
                  </a>
                </span>
              </li>
            </ul>
          </address>
        </div>
      </div>
    </div>
  </div>

  <!-- نوار پایانی سفید -->
  <div class="bg-white text-slate-600 dark:bg-dark-950 dark:text-gray-400">
    <div class="container mx-auto flex flex-col items-center justify-between gap-1 px-4 py-2 text-sm md:flex-row">
      <p class="text-center md:text-start">&copy; {year} {company.name}. تمامی حقوق محفوظ است.</p>
      <div class="flex flex-wrap items-center justify-center gap-x-1 md:justify-end">
        <ul class="flex flex-wrap items-center justify-center">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class={`inline-flex min-h-[44px] items-center rounded-sm px-3 transition-colors duration-300 ease-out hover:text-[#0F3562] dark:hover:text-white ${focusLight}`}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <button
          type="button"
          data-back-to-top
          aria-label="بازگشت به بالای صفحه"
          class={`hidden h-10 w-10 items-center justify-center rounded-full bg-[#0F3562] text-white transition duration-300 ease-out hover:-translate-y-1 hover:shadow-[0_10px_20px_-10px_rgba(15,53,98,0.9)] active:scale-95 dark:bg-primary-600 [&.is-ready]:inline-flex ${focusLight}`}
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 19V5M5 12l7-7 7 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</footer>

<style>
  /* نوار چهاررنگ بالای فوتر با یک درخشش که از رویش می‌گذرد */
  .top-bar {
    position: relative;
    display: flex;
    height: 5px;
    overflow: hidden;
  }
  .top-bar span {
    flex: 1;
  }
  .top-bar::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 18%;
    background: rgba(255, 255, 255, 0.55);
    transform: translateX(-100%);
    animation: shimmer 4.5s ease-in-out infinite;
  }
  @keyframes shimmer {
    0% {
      transform: translateX(-100%);
    }
    55%,
    100% {
      transform: translateX(650%);
    }
  }

  /* آیکن تلفن با حلقه‌های موج */
  .pulse-icon::before,
  .pulse-icon::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    border: 2px solid rgba(255, 255, 255, 0.7);
    opacity: 0;
    animation: pulse-ring 2.4s ease-out infinite;
  }
  .pulse-icon::after {
    animation-delay: 1.2s;
  }
  @keyframes pulse-ring {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    100% {
      transform: scale(1.8);
      opacity: 0;
    }
  }

  /* موج هنگام هاور آیکن‌های اجتماعی */
  .social-btn::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.8);
    opacity: 0;
    pointer-events: none;
  }
  .social-btn:hover::after,
  .social-btn:focus-visible::after {
    animation: ripple 1.2s ease-out infinite;
  }
  @keyframes ripple {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    100% {
      transform: scale(1.7);
      opacity: 0;
    }
  }

  /* درخشش روی دکمه اصلی */
  .btn-shine::after {
    content: '';
    position: absolute;
    inset: 0;
    transform: translateX(130%) skewX(-20deg);
    background: linear-gradient(90deg, transparent, rgba(15, 53, 98, 0.14), transparent);
    pointer-events: none;
  }
  .btn-shine:hover::after {
    transform: translateX(-130%) skewX(-20deg);
    transition: transform 800ms ease;
  }

  /* ورود هر بخش هنگام رسیدن به دید کاربر */
  @media (prefers-reduced-motion: no-preference) {
    .js-reveal [data-reveal] {
      opacity: 0;
      transform: translateY(18px);
    }
    .js-reveal [data-reveal].is-visible {
      opacity: 1;
      transform: none;
      transition:
        opacity 600ms ease-out,
        transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
      transition-delay: calc(var(--i, 0) * 90ms);
    }

    /* خط رنگی زیر عنوان ستون‌ها کشیده می‌شود */
    .js-reveal [data-reveal] .bar {
      transform: scaleX(0);
    }
    .js-reveal [data-reveal].is-visible .bar {
      transform: scaleX(1);
      transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
      transition-delay: calc(350ms + var(--i, 0) * 90ms);
    }

    /* ارقام تلفن یکی‌یکی از پایین بالا می‌آیند */
    .js-reveal [data-reveal] .digit {
      opacity: 0;
      transform: translateY(85%);
    }
    .js-reveal [data-reveal].is-visible .digit {
      opacity: 1;
      transform: none;
      transition:
        opacity 500ms ease-out,
        transform 650ms cubic-bezier(0.2, 0.8, 0.2, 1);
      transition-delay: calc(300ms + var(--k, 0) * 70ms);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-site-footer],
    [data-site-footer] * {
      transition: none !important;
      animation: none !important;
      transform: none !important;
    }
    .top-bar::after {
      display: none;
    }
  }
</style>

<script>
  const footer = document.querySelector<HTMLElement>('[data-site-footer]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (footer) {
    // هر بخش جداگانه و درست زمانی که کاربر به آن می‌رسد انیمیشن می‌گیرد
    if ('IntersectionObserver' in window && !reduceMotion) {
      const sections = footer.querySelectorAll<HTMLElement>('[data-reveal]');
      footer.classList.add('js-reveal');
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -6% 0px' }
      );
      sections.forEach((section) => observer.observe(section));
    }

    const toTop = footer.querySelector<HTMLButtonElement>('[data-back-to-top]');
    if (toTop) {
      toTop.classList.add('is-ready');
      toTop.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
      });
    }
  }
</script>
