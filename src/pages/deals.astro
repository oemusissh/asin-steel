---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

// پایان زمان تخفیف‌ها (اختیاری).
// اگر تاریخ پایان واقعی دارید اینجا بنویسید تا شمارنده معکوس نمایش داده شود.
// مثال: "2026-11-05T23:59:59+03:30"
// خالی بماند = شمارنده نمایش داده نمی‌شود.
const dealsEndDate = '';

const endTime = dealsEndDate ? new Date(dealsEndDate) : null;
const hasCountdown = endTime !== null && !Number.isNaN(endTime.getTime());
const endIso = hasCountdown && endTime ? endTime.toISOString() : '';

const countdownUnits = [
  { id: 'days', label: 'روز' },
  { id: 'hours', label: 'ساعت' },
  { id: 'minutes', label: 'دقیقه' },
  { id: 'seconds', label: 'ثانیه' }
];

// کارت‌های بالای لیست؛ هرکدام یک حالت مرتب‌سازی است و با منوی «مرتب‌سازی» هماهنگ می‌ماند.
const dealTabs = [
  { key: 'discount', name: 'بیشترین تخفیف', icon: '💰' },
  { key: 'newest', name: 'جدیدترین تخفیف‌ها', icon: '⚡' },
  { key: 'price-asc', name: 'کم‌ترین قیمت', icon: '🏷️' },
  { key: 'bestseller', name: 'پرفروش‌ها', icon: '📦' }
];

// جرقه‌های درخشان پس‌زمینه هیرو (آرام بالا می‌روند)
const embers = Array.from({ length: 22 }, (_, i) => ({
  left: (i * 37 + 8) % 100,
  size: 3 + ((i * 5) % 6),
  duration: 7 + ((i * 3) % 7),
  delay: -((i * 17) % 100) / 10,
  sway: (i % 2 === 0 ? 1 : -1) * (12 + ((i * 7) % 28))
}));
---

<BaseLayout title="تخفیف‌ها و پیشنهادهای ویژه | آسین استیل" description="تخفیف‌های ویژه مقاطع فولادی؛ میلگرد، تیرآهن، ورق و پروفیل با قیمت‌های مناسب از آسین استیل">
  <main dir="rtl" class="bg-white text-gray-900" style="color-scheme: light;">
    <!-- Hero Banner -->
    <section class="hero-shift relative bg-gradient-to-br from-red-700 via-red-800 to-red-900 text-white overflow-hidden">
      <!-- Subtle Film Grain for Depth (No Repeating Pattern) -->
      <div class="absolute inset-0 opacity-[0.015] mix-blend-overlay">
        <svg class="w-full h-full">
          <filter id="deals-grain">
            <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="4" stitchTiles="stitch"/>
          </filter>
          <rect width="100%" height="100%" filter="url(#deals-grain)"/>
        </svg>
      </div>

      <!-- Radial Glow Behind Headline (Very Subtle) -->
      <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-gradient-radial from-yellow-400/8 via-red-500/5 to-transparent rounded-full blur-[120px]"></div>

      <!-- Animated Background: soft drifting light, a steel-like sheen and rising sparks -->
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="fx-blob fx-blob-a"></div>
        <div class="fx-blob fx-blob-b"></div>
        <div class="fx-blob fx-blob-c"></div>
        <div class="fx-sheen"></div>
        {embers.map((e) => (
          <span class="fx-ember" style={`left:${e.left}%;width:${e.size}px;height:${e.size}px;animation-duration:${e.duration}s;animation-delay:${e.delay}s;--sway:${e.sway}px;`}></span>
        ))}
      </div>

      <!-- Soft Overlay -->
      <div class="absolute inset-0 bg-gradient-to-b from-white/5 via-transparent to-black/25"></div>

      <div class="container mx-auto px-4 py-16 md:py-20 relative z-10">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-sm mb-6 animate-fade-in">
          <a href={base} class="text-red-100 hover:text-white transition-colors duration-300">صفحه اصلی</a>
          <svg class="w-4 h-4 text-red-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5l-7 7 7 7" />
          </svg>
          <span class="text-white font-medium">تخفیف‌ها</span>
        </nav>

        <div class="flex items-center gap-10">
        <div class="max-w-4xl min-w-0 flex-1">
          <!-- Header with Strong Hierarchy -->
          <div class="flex items-start gap-6 mb-6" style="animation: fadeInUp 0.6s ease-in-out 0.1s both;">
            <div class="relative flex-shrink-0">
              <span class="text-7xl">🔥</span>
              <span class="absolute -top-2 -right-2 flex h-6 w-6">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-yellow-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-6 w-6 bg-yellow-500"></span>
              </span>
            </div>
            <div>
              <div class="inline-flex items-center gap-2 bg-yellow-500/20 backdrop-blur-sm px-4 py-2 rounded-full border border-yellow-300/50 mb-4">
                <span class="relative flex h-3 w-3">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-yellow-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-3 w-3 bg-yellow-500"></span>
                </span>
                <span class="text-sm font-bold text-yellow-100">پیشنهادهای ویژه</span>
              </div>

              <!-- Dominant Headline -->
              <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-black mb-4 leading-[1.4] tracking-normal">
                تخفیف‌ها و پیشنهادهای ویژه
              </h1>

              <!-- Subheadline (عدد تخفیف پس از دریافت اطلاعات از Supabase جایگزین می‌شود) -->
              <p id="deals-max-discount" class="text-xl md:text-2xl text-white font-semibold mb-2">
                تخفیف ویژه روی مقاطع فولادی
              </p>
              <p class="text-lg text-white/85">
                موجودی محدود • قیمت‌های ویژه{hasCountdown && ' • تا پایان فرصت'}
              </p>
            </div>
          </div>

          <!-- Countdown Timer (فقط وقتی تاریخ پایان در بالای فایل تنظیم شده باشد) -->
          {hasCountdown && (
            <div id="deals-countdown" data-end={endIso} class="flex gap-3 mb-8" style="animation: fadeInUp 0.6s ease-in-out 0.3s both;">
              {countdownUnits.map((unit) => (
                <div class="flex-1 max-w-[100px]">
                  <div class="relative bg-white/10 backdrop-blur-xl rounded-2xl p-4 border border-white/30 hover:border-yellow-300/60 transition-all duration-500 group">
                    <!-- Subtle Pulse Glow -->
                    <div class="absolute inset-0 bg-yellow-400/0 group-hover:bg-yellow-400/5 rounded-2xl transition-all duration-500"></div>
                    <div class="absolute -inset-1 bg-yellow-400/0 group-hover:bg-yellow-400/10 rounded-2xl blur-lg transition-all duration-500 -z-10"></div>

                    <span class="text-4xl font-black block text-center countdown-digit" id={`deals-${unit.id}`}>
                      ۰۰
                    </span>
                    <span class="text-xs text-white/90 font-semibold block text-center mt-1">{unit.label}</span>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>

        <!-- عکس‌های واقعی محصولات تخفیف‌دار به‌صورت سه‌بعدی (پس از دریافت از Supabase پر می‌شود) -->
        <div id="hero-visual" class="hv hidden lg:block" aria-hidden="true"></div>
        </div>
      </div>

      <!-- Wave Divider -->
      <div class="absolute bottom-0 left-0 right-0">
        <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
          <path d="M0 80L60 70C120 60 240 40 360 35C480 30 600 40 720 45C840 50 960 50 1080 45C1200 40 1320 30 1380 25L1440 20V80H1380C1320 80 1200 80 1080 80C960 80 840 80 720 80C600 80 480 80 360 80C240 80 120 80 60 80H0Z" class="fill-white"/>
        </svg>
      </div>
    </section>

    <!-- Deal Type Selector + Grid (with ambient moving background) -->
    <div class="relative overflow-hidden">
      <div class="amb pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="amb-dots"></div>
        <div class="amb-blob amb-a"></div>
        <div class="amb-blob amb-b"></div>
        <div class="amb-blob amb-c"></div>
      </div>
    <section class="container mx-auto px-4 py-12 relative z-10">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
        {dealTabs.map((tab, i) => (
          <button
            type="button"
            data-deal-tab={tab.key}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class={`group relative overflow-hidden rounded-2xl p-6 text-white bg-gradient-to-br from-primary-600 to-primary-700 transition-all duration-500 ease-in-out hover:shadow-[0_0_30px_rgba(59,130,246,0.4)] hover:scale-[1.03] hover:opacity-100 cursor-pointer ${i === 0 ? 'ring-2 ring-primary-400 shadow-[0_0_30px_rgba(59,130,246,0.3)]' : 'opacity-60'}`}
            style={`animation: fadeInUp 0.6s ease-in-out ${i * 0.1}s both;`}
          >
            <!-- Active Glow -->
            <div data-tab-glow class={`absolute -inset-1 bg-primary-500/20 rounded-2xl blur-xl -z-10 animate-pulse-slow ${i === 0 ? '' : 'hidden'}`}></div>

            <div class="relative z-10">
              <div class="text-4xl mb-2 transform group-hover:scale-110 transition-transform duration-500 ease-in-out">{tab.icon}</div>
              <h3 class="font-bold text-base leading-tight">{tab.name}</h3>
            </div>

            <!-- Subtle Pattern -->
            <div class="absolute -bottom-4 -right-4 text-7xl opacity-5 group-hover:opacity-10 transition-opacity duration-500">{tab.icon}</div>
          </button>
        ))}
      </div>

      <!-- Products Grid -->
      <div class="mb-8">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
          <div>
            <h2 class="text-3xl font-bold mb-1">بهترین تخفیف‌های امروز</h2>
            <p id="deals-showing" class="text-gray-600">در حال دریافت پیشنهادها...</p>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12" />
            </svg>
            <label for="deals-sort" class="text-sm font-medium text-gray-700">مرتب‌سازی:</label>
            <select id="deals-sort" class="px-4 py-2 rounded-xl border-2 border-gray-200 bg-white focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 transition-all duration-500 hover:border-gray-300 cursor-pointer">
              <option value="discount">بیشترین تخفیف</option>
              <option value="price-asc">قیمت: کم به زیاد</option>
              <option value="price-desc">قیمت: زیاد به کم</option>
              <option value="bestseller">پرفروش‌ترین</option>
              <option value="newest">جدیدترین</option>
            </select>
          </div>
        </div>

        <div id="deals-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 deals-grid"></div>
      </div>
    </section>
    </div>

    <!-- Why Shop Deals Section -->
    <section class="relative overflow-hidden bg-gradient-to-b from-gray-50 to-white py-16">
      <div class="amb pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="amb-dots"></div>
        <div class="amb-blob amb-a"></div>
        <div class="amb-blob amb-b"></div>
        <div class="amb-blob amb-c"></div>
      </div>
      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl mx-auto text-center mb-12">
          <h2 class="text-3xl font-bold mb-4">چرا از تخفیف‌های ما خرید کنید؟</h2>
          <p class="text-gray-600 text-lg">
            کیفیت مطمئن با قیمت‌های ویژه؛ مناسب پیمانکاران و پروژه‌های ساختمانی و صنعتی
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-10 max-w-5xl mx-auto">
          {[
            {
              icon: `<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
              title: 'تخفیف واقعی',
              desc: 'تخفیف روی کالای اصل، بدون بالا بردن قیمت قبلی'
            },
            {
              icon: `<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
              title: 'کیفیت تضمین‌شده',
              desc: 'همان کیفیت عالی، فقط با قیمت بهتر'
            },
            {
              icon: `<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
              title: 'فرصت محدود',
              desc: 'تخفیف‌هایی که ماندگار نیستند'
            }
          ].map((feature, i) => (
            <div class="group bg-white rounded-3xl p-8 text-center border border-gray-200 hover:border-primary-500 transition-all duration-500 ease-in-out hover:shadow-2xl hover:-translate-y-1.5" style={`animation: fadeInUp 0.6s ease-in-out ${i * 0.1}s both;`}>
              <!-- Animated Icon -->
              <div class="inline-flex items-center justify-center w-20 h-20 mb-5 rounded-2xl bg-gradient-to-br from-primary-600 to-primary-700 text-white transform group-hover:scale-110 group-hover:rotate-3 transition-all duration-500 ease-in-out shadow-lg group-hover:shadow-2xl animate-float-slow">
                <div class="transform group-hover:scale-110 transition-transform duration-500 ease-in-out" set:html={feature.icon} />
              </div>

              <h3 class="font-bold text-xl mb-3 group-hover:text-primary-600 transition-colors duration-300">{feature.title}</h3>
              <p class="text-gray-600 leading-relaxed">{feature.desc}</p>

              <!-- Glow Effect -->
              <div class="absolute -inset-1 bg-gradient-to-r from-primary-600 to-primary-700 rounded-3xl blur-xl opacity-0 group-hover:opacity-20 transition-opacity duration-500 ease-in-out -z-10"></div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* Smooth Countdown Digit Animation */
  .countdown-digit {
    transition: all 0.3s ease-in-out;
  }

  /* Deal Card Enhanced Hover (کارت‌ها با جاوااسکریپت ساخته می‌شوند، پس global است) */
  :global(.deal-card) {
    height: 100%;
    transition: all 0.5s ease-in-out;
  }

  /* Smooth Grid Transition on Sort */
  .deals-grid {
    transition: opacity 0.3s ease-in-out;
  }

  .deals-grid.sorting {
    opacity: 0.5;
  }

  /* ---------- Hero background animation ---------- */
  .hero-shift {
    background-size: 220% 220%;
    animation: fx-shift 14s ease-in-out infinite alternate;
  }

  .fx-blob {
    position: absolute;
    border-radius: 9999px;
    filter: blur(70px);
    will-change: transform;
  }

  .fx-blob-a {
    top: -120px;
    right: -80px;
    width: 520px;
    height: 520px;
    background: #f87171;
    opacity: 0.32;
    animation: fx-drift-a 12s ease-in-out infinite alternate;
  }

  .fx-blob-b {
    bottom: -120px;
    left: 4%;
    width: 460px;
    height: 460px;
    background: #450a0a;
    opacity: 0.6;
    animation: fx-drift-b 15s ease-in-out infinite alternate;
  }

  .fx-blob-c {
    top: 28%;
    left: 40%;
    width: 340px;
    height: 340px;
    background: #fca5a5;
    opacity: 0.14;
    animation: fx-drift-c 11s ease-in-out infinite alternate;
  }

  .fx-sheen {
    position: absolute;
    top: -20%;
    bottom: -20%;
    right: -40%;
    width: 34%;
    background: linear-gradient(100deg, transparent 0%, rgba(255, 255, 255, 0.18) 50%, transparent 100%);
    transform: skewX(-18deg);
    opacity: 0;
    animation: fx-sheen 7s ease-in-out infinite;
  }

  .fx-ember {
    position: absolute;
    bottom: -12px;
    border-radius: 9999px;
    background: radial-gradient(circle, #ffffff 0%, rgba(254, 240, 138, 0.9) 40%, rgba(254, 202, 202, 0) 70%);
    box-shadow: 0 0 10px 2px rgba(254, 240, 138, 0.55);
    opacity: 0;
    animation: fx-rise linear infinite;
  }

  @keyframes fx-shift {
    from { background-position: 0% 0%; }
    to { background-position: 100% 100%; }
  }

  @keyframes fx-drift-a {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(-140px, 90px, 0) scale(1.25); }
  }

  @keyframes fx-drift-b {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(150px, -80px, 0) scale(1.2); }
  }

  @keyframes fx-drift-c {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(-90px, -70px, 0) scale(0.85); }
  }

  @keyframes fx-sheen {
    0%, 40% { transform: translateX(0) skewX(-18deg); opacity: 0; }
    48% { opacity: 1; }
    100% { transform: translateX(-520%) skewX(-18deg); opacity: 0; }
  }

  @keyframes fx-rise {
    0% { transform: translate3d(0, 0, 0) scale(0.6); opacity: 0; }
    12% { opacity: 1; }
    80% { opacity: 0.6; }
    100% { transform: translate3d(var(--sway, 24px), -600px, 0) scale(1); opacity: 0; }
  }

  /* ---------- Ambient background for the light sections ---------- */
  .amb-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(100, 116, 139, 0.28) 1.3px, transparent 1.6px);
    background-size: 28px 28px;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 18%, #000 82%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 18%, #000 82%, transparent 100%);
    animation: amb-pan 28s linear infinite;
  }

  .amb-blob {
    position: absolute;
    border-radius: 9999px;
    filter: blur(80px);
    will-change: transform;
  }

  .amb-a {
    top: 2%;
    right: -120px;
    width: 440px;
    height: 440px;
    background: #fecdd3;
    opacity: 0.7;
    animation: amb-drift-a 18s ease-in-out infinite alternate;
  }

  .amb-b {
    top: 42%;
    left: -140px;
    width: 460px;
    height: 460px;
    background: #bae6fd;
    opacity: 0.7;
    animation: amb-drift-b 22s ease-in-out infinite alternate;
  }

  .amb-c {
    bottom: -80px;
    right: 30%;
    width: 380px;
    height: 380px;
    background: #e0e7ff;
    opacity: 0.8;
    animation: amb-drift-c 20s ease-in-out infinite alternate;
  }

  @keyframes amb-pan {
    from { background-position: 0 0; }
    to { background-position: 28px 28px; }
  }

  @keyframes amb-drift-a {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(-120px, 90px, 0) scale(1.2); }
  }

  @keyframes amb-drift-b {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(130px, -70px, 0) scale(1.15); }
  }

  @keyframes amb-drift-c {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(-100px, -60px, 0) scale(0.9); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-shift,
    .fx-blob,
    .fx-sheen,
    .amb-dots,
    .amb-blob {
      animation: none;
    }

    .fx-ember {
      display: none;
    }
  }
</style>

<style is:global>
  /* ---------- 3D product card: a steel plate that follows the cursor ---------- */
  @keyframes dc-in {
    from { opacity: 0; transform: perspective(900px) translateY(40px) rotateX(-24deg); }
    to { opacity: 1; transform: none; }
  }

  .deal-card {
    position: relative;
    height: 100%;
    perspective: 1100px;
    transition: none;
  }

  .deal-card:hover {
    z-index: 5;
  }

  .dc {
    --px: 0;
    --py: 0;
    --dc-navy: #0f172a;
    --dc-blue: #2563eb;
    --dc-sky: #38bdf8;
    --dc-red: #dc2626;
    position: relative;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateX(calc(var(--py) * -16deg)) rotateY(calc(var(--px) * 16deg));
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
    will-change: transform;
  }

  .dc:hover {
    transform: translateZ(30px) rotateX(calc(var(--py) * -16deg)) rotateY(calc(var(--px) * 16deg));
  }

  .dc.is-tilting {
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
  }

  /* ضخامت ورق فولادی: دو لایه پشت کارت که هنگام کج شدن لبه‌اش دیده می‌شود */
  .dc::before,
  .dc::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 22px;
    pointer-events: none;
  }

  .dc::before {
    background: linear-gradient(150deg, #cbd5e1, #64748b 55%, #334155);
    transform: translateZ(-7px);
  }

  .dc::after {
    background: linear-gradient(150deg, #94a3b8, #475569 60%, #1e293b);
    transform: translateZ(-16px);
    box-shadow:
      calc(var(--px) * -30px) calc(18px + var(--py) * -30px) 34px -10px rgba(15, 23, 42, 0.35);
    transition: box-shadow 0.5s ease;
  }

  .dc:hover::after {
    box-shadow:
      calc(var(--px) * -46px) calc(42px + var(--py) * -42px) 58px -14px rgba(15, 23, 42, 0.5);
  }

  .dc-face {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 10px;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 22px;
    background: linear-gradient(160deg, #ffffff 0%, #eef2f7 100%);
    transform-style: preserve-3d;
  }

  /* قاب تصویر: مثل یک صفحه جدا از کارت بالا می‌آید */
  .dc-media {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: 14px;
    background: #e2e8f0;
    box-shadow: 0 8px 16px -10px rgba(15, 23, 42, 0.35);
    transform-style: preserve-3d;
    transform: translateZ(12px);
    transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.7s ease;
  }

  .dc:hover .dc-media {
    transform: translateZ(34px);
    box-shadow: 0 28px 36px -14px rgba(15, 23, 42, 0.5);
  }

  .dc-clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
  }

  .dc-clip::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 55%;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.7), transparent);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  .dc:hover .dc-clip::after {
    opacity: 1;
  }

  .dc-img-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* پارالاکس: تصویر برخلاف حرکت موس کمی جابه‌جا می‌شود و عمق ایجاد می‌کند */
  .dc-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 0.35s ease-out;
  }

  .dc:hover .dc-img {
    transform: translate3d(calc(var(--px) * -18px), calc(var(--py) * -18px), 0) scale(1.16);
  }

  .dc-noimg {
    display: grid;
    height: 100%;
    place-items: center;
    color: #94a3b8;
    font-size: 13px;
  }

  /* انعکاس نور روی تصویر، دنبال موس */
  .dc-glare {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at calc(50% + var(--px) * 100%) calc(50% + var(--py) * 100%),
      rgba(255, 255, 255, 0.5),
      rgba(255, 255, 255, 0) 55%
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .dc:hover .dc-glare {
    opacity: 1;
  }

  /* براقی ورق: یک نوار نور که با کج شدن کارت روی آن می‌لغزد */
  .dc-sheen {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(105deg, rgba(255, 255, 255, 0) 35%, rgba(255, 255, 255, 0.55) 50%, rgba(255, 255, 255, 0) 65%);
    background-size: 300% 100%;
    background-position: calc(50% + var(--px) * 100%) 0;
    opacity: 0;
    pointer-events: none;
    transform: translateZ(1px);
    transition: opacity 0.4s ease;
  }

  .dc:hover .dc-sheen {
    opacity: 1;
  }

  .dc-off,
  .dc-tag {
    position: absolute;
    top: 10px;
    padding: 5px 11px;
    border-radius: 999px;
    color: #fff;
    font-size: 12px;
    font-weight: 800;
    line-height: 1.6;
    pointer-events: none;
    transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.7s ease;
  }

  .dc-off {
    inset-inline-start: 10px;
    background: var(--dc-red);
    box-shadow: 0 6px 12px -6px rgba(220, 38, 38, 0.6);
    transform: translateZ(18px);
  }

  .dc:hover .dc-off {
    box-shadow: 0 18px 22px -8px rgba(220, 38, 38, 0.55);
    transform: translateZ(36px);
  }

  .dc-tag {
    inset-inline-end: 10px;
    background: rgba(15, 23, 42, 0.82);
    font-size: 11px;
    font-weight: 700;
    transform: translateZ(14px);
  }

  .dc:hover .dc-tag {
    transform: translateZ(28px);
  }

  /* سه گزینه‌ای که با هاور از تصویر بیرون می‌آیند */
  .dc-actions {
    position: absolute;
    inset-inline: 10px;
    bottom: 10px;
    display: flex;
    gap: 8px;
    transform-style: preserve-3d;
  }

  .dc-act {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 10px 4px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 14px;
    color: #fff;
    background: rgba(15, 23, 42, 0.8);
    box-shadow: 0 12px 18px -8px rgba(0, 0, 0, 0.55);
    font: inherit;
    font-size: 11px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    opacity: 0;
    transform: translateZ(0) translateY(16px);
    transition: opacity 0.45s ease, transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1), background 0.25s ease, color 0.25s ease;
  }

  .dc-act:nth-child(2) { transition-delay: 0.06s; }
  .dc-act:nth-child(3) { transition-delay: 0.12s; }

  .dc:hover .dc-act,
  .dc:focus-within .dc-act {
    opacity: 1;
    transform: translateZ(40px);
  }

  .dc-act:hover {
    color: var(--dc-blue);
    background: #fff;
  }

  .dc-act svg {
    width: 21px;
    height: 21px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.3s ease;
  }

  .dc-act:hover svg {
    transform: scale(1.18);
  }

  .dc-act[aria-pressed="true"] svg {
    fill: #ef4444;
    stroke: #ef4444;
  }

  .dc-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 16px 8px 8px;
    transform-style: preserve-3d;
  }

  .dc-meta {
    margin: 0 0 4px;
    color: #64748b;
    font-size: 12px;
    font-weight: 500;
  }

  .dc-title {
    display: -webkit-box;
    min-height: 3.8em;
    margin: 0;
    overflow: hidden;
    color: var(--dc-navy);
    font-size: 16px;
    font-weight: 800;
    line-height: 1.9;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .dc:hover .dc-title {
    transform: translateZ(22px);
  }

  .dc-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .dc:hover .dc-title a {
    color: var(--dc-blue);
  }

  .dc-rate {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    color: #64748b;
    font-size: 12px;
  }

  .dc-stars {
    display: flex;
    gap: 2px;
  }

  .dc-star {
    width: 15px;
    height: 15px;
    fill: #e2e8f0;
  }

  .dc-star.on {
    fill: #f59e0b;
  }

  .dc-price {
    margin-top: auto;
    padding-top: 12px;
    transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .dc:hover .dc-price {
    transform: translateZ(30px);
  }

  .dc-prices {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
  }

  .dc-now {
    color: var(--dc-navy);
    font-size: 20px;
    font-weight: 900;
  }

  .dc-now small {
    color: #64748b;
    font-size: 12px;
    font-weight: 700;
  }

  .dc-old {
    color: #94a3b8;
    font-size: 13px;
  }

  .dc-save {
    margin: 4px 0 0;
    color: #475569;
    font-size: 12px;
  }

  .dc-cta {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 14px;
    padding: 12px 16px;
    overflow: hidden;
    border-radius: 12px;
    color: #fff;
    background: var(--dc-navy);
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.7s ease;
  }

  .dc:hover .dc-cta {
    box-shadow: 0 16px 20px -10px rgba(15, 23, 42, 0.6);
    transform: translateZ(18px);
  }

  /* پر شدن دکمه با رنگ آبی از سمت راست */
  .dc-cta::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, var(--dc-blue), var(--dc-sky));
    transform: translateX(101%);
    transition: transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .dc:hover .dc-cta::before {
    transform: none;
  }

  .dc-cta svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.3s ease;
  }

  .dc:hover .dc-cta svg {
    transform: translateX(-4px);
  }

  /* در گوشی (بدون موس) فقط ظاهر ساده نمایش داده می‌شود */
  @media (hover: none) {
    .dc-actions {
      display: none;
    }

    .dc:hover {
      transform: none;
    }

    .dc:hover .dc-media {
      transform: translateZ(12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .deal-card {
      animation: none !important;
    }

    .dc,
    .dc:hover {
      transform: none !important;
    }

    .dc *,
    .dc::after {
      transition: none !important;
    }
  }
</style>

