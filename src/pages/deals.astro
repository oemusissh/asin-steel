<script>
  import { supabase } from "../lib/supabase";

  type Product = {
    id: number | string;
    name: string;
    category: string;
    factory?: string | null;
    price?: number | string | null;
    price_on_request?: boolean;
    is_best_seller?: boolean;
    discount_enabled?: boolean;
    old_price?: number | string | null;
    inventory?: string;
    active?: boolean;
    description?: string | null;
    image?: string | null;
    gallery?: string[] | null;
    specifications?: { label: string; value: string }[] | null;
    slug?: string | null;
    created_at?: string | null;
    rating?: number | string | null;
    reviews?: number | string | null;
  };

  type Deal = {
    product: Product;
    price: number;
    oldPrice: number;
    percent: number;
  };

  type SortKey = "discount" | "newest" | "price-asc" | "price-desc" | "bestseller";

  const base = import.meta.env.BASE_URL;
  const faNumber = new Intl.NumberFormat("fa-IR");

  const grid = document.querySelector<HTMLElement>("#deals-grid");
  const sortSelect = document.querySelector<HTMLSelectElement>("#deals-sort");
  const showingText = document.querySelector<HTMLElement>("#deals-showing");
  const maxDiscountText = document.querySelector<HTMLElement>("#deals-max-discount");
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-deal-tab]"));

  const categoryNames: Record<string, string> = {
    rebar: "میلگرد",
    beam: "تیرآهن",
    sheet: "ورق فولادی",
    profile: "پروفیل",
    angle: "نبشی و ناودانی",
    pipe: "لوله",
    billet: "شمش فولادی",
    alloy: "فولاد آلیاژی",
    other: "سایر محصولات",
  };

  function escapeHtml(value: unknown): string {
    return String(value ?? "").replace(/[&<>"']/g, (char) => {
      const entities: Record<string, string> = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      };
      return entities[char];
    });
  }

  /* ---------- Countdown ---------- */

  const countdown = document.querySelector<HTMLElement>("#deals-countdown");
  const endAttr = countdown?.dataset.end;

  if (countdown && endAttr) {
    const endTime = new Date(endAttr).getTime();
    const twoDigits = new Intl.NumberFormat("fa-IR", { minimumIntegerDigits: 2, useGrouping: false });
    let timer: number | undefined;

    const updateDigit = (id: string, value: number) => {
      const el = document.getElementById(id);
      const text = twoDigits.format(value);
      if (el && el.textContent?.trim() !== text) {
        el.style.transform = "scale(1.1)";
        setTimeout(() => {
          el.textContent = text;
          el.style.transform = "scale(1)";
        }, 150);
      }
    };

    const tick = () => {
      const distance = endTime - Date.now();

      if (distance <= 0) {
        countdown.classList.add("hidden");
        if (timer) window.clearInterval(timer);
        return;
      }

      updateDigit("deals-days", Math.floor(distance / (1000 * 60 * 60 * 24)));
      updateDigit("deals-hours", Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)));
      updateDigit("deals-minutes", Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60)));
      updateDigit("deals-seconds", Math.floor((distance % (1000 * 60)) / 1000));
    };

    tick();
    timer = window.setInterval(tick, 1000);
  }

  /* ---------- Deals data ---------- */

  let allDeals: Deal[] = [];
  let loaded = false;

  function toDeal(product: Product): Deal | null {
    if (product.price_on_request === true) return null;
    if (product.discount_enabled !== true) return null;

    const price = Number(product.price);
    const oldPrice = Number(product.old_price);

    if (!Number.isFinite(price) || !Number.isFinite(oldPrice)) return null;
    if (price <= 0 || oldPrice <= price) return null;

    return {
      product,
      price,
      oldPrice,
      percent: Math.max(1, Math.round(((oldPrice - price) / oldPrice) * 100)),
    };
  }

  function sortDeals(deals: Deal[], key: SortKey): Deal[] {
    const list = [...deals];
    const time = (deal: Deal) => Date.parse(deal.product.created_at ?? "") || 0;

    switch (key) {
      case "price-asc":
        return list.sort((a, b) => a.price - b.price);
      case "price-desc":
        return list.sort((a, b) => b.price - a.price);
      case "newest":
        return list.sort((a, b) => time(b) - time(a));
      case "bestseller":
        return list.sort(
          (a, b) =>
            Number(b.product.is_best_seller === true) - Number(a.product.is_best_seller === true) ||
            b.percent - a.percent
        );
      default:
        return list.sort((a, b) => b.percent - a.percent);
    }
  }

  /* ---------- Rendering ---------- */

  const FAV_KEY = "asin-steel-favorites";

  function readFavs(): Set<string> {
    try {
      const raw = localStorage.getItem(FAV_KEY);
      return new Set<string>(raw ? JSON.parse(raw) : []);
    } catch {
      return new Set<string>();
    }
  }

  function writeFavs(favs: Set<string>) {
    try {
      localStorage.setItem(FAV_KEY, JSON.stringify([...favs]));
    } catch {
      /* ignore */
    }
  }

  function tagFor(deal: Deal): string {
    if (deal.product.is_best_seller === true) return "پرفروش";
    const created = Date.parse(deal.product.created_at ?? "");
    if (Number.isFinite(created) && Date.now() - created < 14 * 24 * 60 * 60 * 1000) return "جدید";
    return "";
  }

  function starsHtml(rating: number): string {
    const full = Math.round(rating);
    return Array.from({ length: 5 }, (_, i) => `
      <svg class="dc-star ${i < full ? "on" : ""}" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
      </svg>`).join("");
  }

  function cardHtml(deal: Deal, index: number, favs: Set<string>): string {
    const { product, price, oldPrice, percent } = deal;

    const name = escapeHtml(product.name);
    const categoryName = escapeHtml(categoryNames[product.category] || "سایر محصولات");
    const factory = product.factory ? ` • ${escapeHtml(product.factory)}` : "";
    const image = escapeHtml(product.image || "");
    const tag = tagFor(deal);
    const favOn = favs.has(String(product.id));

    const detailUrl = product.slug
      ? `${base}products/${encodeURIComponent(product.slug)}/`
      : `${base}products/detail/?id=${encodeURIComponent(String(product.id))}`;

    // ستاره و تعداد نظر فقط وقتی نمایش داده می‌شود که در جدول ستون rating و reviews داشته باشید
    const rating = Number(product.rating);
    const reviews = Number(product.reviews);
    const ratingHtml =
      Number.isFinite(rating) && rating > 0
        ? `
          <div class="dc-rate">
            <div class="dc-stars">${starsHtml(rating)}</div>
            <span>${faNumber.format(Math.round(rating * 10) / 10)}</span>
            ${Number.isFinite(reviews) && reviews > 0 ? `<span>(${faNumber.format(reviews)} نظر)</span>` : ""}
          </div>`
        : "";

    return `
      <div class="deal-card" style="animation: dc-in 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) ${index * 0.06}s both;">
        <article class="dc">
          <div class="dc-face">
            <div class="dc-media">
              <div class="dc-clip">
                <a class="dc-img-link" href="${detailUrl}" aria-label="مشاهده مشخصات ${name}">
                  ${
                    image
                      ? `<img class="dc-img" src="${image}" alt="${name}" loading="lazy" />`
                      : `<div class="dc-noimg">تصویر محصول ثبت نشده</div>`
                  }
                </a>
                <span class="dc-glare"></span>
              </div>

              <span class="dc-off">${faNumber.format(percent)}٪ تخفیف</span>
              ${tag ? `<span class="dc-tag">${tag}</span>` : ""}

              <div class="dc-actions">
                <button type="button" class="dc-act" data-fav="${escapeHtml(String(product.id))}" aria-pressed="${favOn}" aria-label="افزودن به علاقه‌مندی‌ها">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                  <span>علاقه‌مندی</span>
                </button>
                <a class="dc-act" href="${detailUrl}" aria-label="مشاهده سریع ${name}">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                  <span>مشاهده سریع</span>
                </a>
                <a class="dc-act" href="${base}contact" aria-label="استعلام قیمت ${name}">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 8V5z"/></svg>
                  <span>استعلام قیمت</span>
                </a>
              </div>
            </div>

            <div class="dc-body">
              <p class="dc-meta">${categoryName}${factory}</p>
              <h3 class="dc-title"><a href="${detailUrl}">${name}</a></h3>
              ${ratingHtml}

              <div class="dc-price">
                <div class="dc-prices">
                  <strong class="dc-now">${faNumber.format(price)} <small>تومان</small></strong>
                  <del class="dc-old">${faNumber.format(oldPrice)} تومان</del>
                </div>
                <p class="dc-save">صرفه‌جویی ${faNumber.format(oldPrice - price)} تومان</p>
              </div>

              <a class="dc-cta" href="${detailUrl}">
                <span>جزئیات محصول</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
              </a>
            </div>

            <span class="dc-sheen"></span>
          </div>
        </article>
      </div>
    `;
  }

  function setShowing(text: string) {
    if (showingText) showingText.textContent = text;
  }

  function renderDeals(deals: Deal[]) {
    if (!grid) return;

    if (deals.length === 0) {
      grid.innerHTML = `
        <div class="col-span-full rounded-2xl border border-dashed border-gray-300 px-6 py-16 text-center">
          <div class="mb-4 text-4xl">🏷️</div>
          <h3 class="text-lg font-extrabold">در حال حاضر محصول تخفیف‌داری ثبت نشده است</h3>
          <p class="mt-2 text-sm text-gray-500">برای دیدن همه محصولات و استعلام قیمت روز، به فهرست محصولات سر بزنید.</p>
          <a href="${base}products/" class="mt-5 inline-flex rounded-xl bg-primary-600 px-5 py-3 text-sm font-bold text-white transition hover:bg-primary-500">
            مشاهده همه محصولات
          </a>
        </div>
      `;
      setShowing("پیشنهادی برای نمایش وجود ندارد");
      return;
    }

    const favs = readFavs();
    grid.innerHTML = deals.map((deal, index) => cardHtml(deal, index, favs)).join("");
    bindTilt();
    setShowing(`نمایش ${faNumber.format(deals.length)} پیشنهاد ویژه`);
  }

  grid?.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-fav]");
    if (!button) return;

    const id = button.dataset.fav ?? "";
    const favs = readFavs();
    const on = !favs.has(id);

    if (on) favs.add(id);
    else favs.delete(id);
    writeFavs(favs);

    button.setAttribute("aria-pressed", String(on));
  });

  // کج شدن سه‌بعدی کارت به سمت موس (فقط روی دستگاه‌هایی که موس دارند)
  const canTilt =
    window.matchMedia("(hover: hover) and (pointer: fine)").matches &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function bindTilt() {
    if (!canTilt || !grid) return;

    grid.querySelectorAll<HTMLElement>(".dc").forEach((card) => {
      const host = card.parentElement ?? card; // اندازه‌گیری روی قاب بدون چرخش
      let frame = 0;

      card.addEventListener("pointerenter", () => card.classList.add("is-tilting"));

      card.addEventListener("pointermove", (event) => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const rect = host.getBoundingClientRect();
          const px = (event.clientX - rect.left) / rect.width - 0.5;
          const py = (event.clientY - rect.top) / rect.height - 0.5;
          card.style.setProperty("--px", px.toFixed(3));
          card.style.setProperty("--py", py.toFixed(3));
        });
      });

      card.addEventListener("pointerleave", () => {
        cancelAnimationFrame(frame);
        card.classList.remove("is-tilting");
        card.style.setProperty("--px", "0");
        card.style.setProperty("--py", "0");
      });
    });
  }

  /* ---------- Hero: 3D photos of real discounted products ---------- */

  const heroVisual = document.querySelector<HTMLElement>("#hero-visual");
  const heroSection = document.querySelector<HTMLElement>(".hero-shift");

  function renderHeroVisual(deals: Deal[]) {
    if (!heroVisual) return;

    const picks = [...deals]
      .filter((deal) => deal.product.image)
      .sort((a, b) => b.percent - a.percent)
      .slice(0, 3);

    if (picks.length === 0) return;

    // بهترین تخفیف جلو، بقیه پشت‌سرش
    const slots = ["hv-s3", "hv-s2", "hv-s1"];

    const cards = picks
      .map((deal, i) => {
        const product = deal.product;
        const url = product.slug
          ? `${base}products/${encodeURIComponent(product.slug)}/`
          : `${base}products/detail/?id=${encodeURIComponent(String(product.id))}`;

        return `
          <div class="hv-slot ${slots[i]}">
            <a class="hv-card" href="${url}" tabindex="-1">
              <img class="hv-img" src="${escapeHtml(product.image)}" alt="${escapeHtml(product.name)}" loading="lazy" />
              <span class="hv-pill">${faNumber.format(deal.percent)}٪ تخفیف</span>
              <span class="hv-name">${escapeHtml(product.name)}</span>
            </a>
          </div>`;
      })
      .reverse()
      .join("");

    heroVisual.innerHTML = `<div class="hv-stage">${cards}</div>`;
  }

  if (heroSection && heroVisual && canTilt) {
    heroSection.addEventListener("pointermove", (event) => {
      const rect = heroSection.getBoundingClientRect();
      heroVisual.style.setProperty("--hx", ((event.clientX - rect.left) / rect.width - 0.5).toFixed(3));
      heroVisual.style.setProperty("--hy", ((event.clientY - rect.top) / rect.height - 0.5).toFixed(3));
    });

    heroSection.addEventListener("pointerleave", () => {
      heroVisual.style.setProperty("--hx", "0");
      heroVisual.style.setProperty("--hy", "0");
    });
  }

  /* ---------- Tabs and sorting ---------- */

  const ACTIVE_TAB_CLASSES = ["ring-2", "ring-primary-400", "shadow-[0_0_30px_rgba(59,130,246,0.3)]"];

  function setActiveTab(key: string) {
    tabs.forEach((tab) => {
      const active = tab.dataset.dealTab === key;
      tab.classList.toggle("opacity-60", !active);
      ACTIVE_TAB_CLASSES.forEach((cls) => tab.classList.toggle(cls, active));
      tab.querySelector("[data-tab-glow]")?.classList.toggle("hidden", !active);
      tab.setAttribute("aria-pressed", String(active));
    });
  }

  function applySort(key: SortKey, animate = true) {
    if (sortSelect) sortSelect.value = key;
    setActiveTab(key);

    const sorted = sortDeals(allDeals, key);

    if (!animate) {
      renderDeals(sorted);
      return;
    }

    grid?.classList.add("sorting");
    window.setTimeout(() => {
      renderDeals(sorted);
      grid?.classList.remove("sorting");
      // Smooth scroll to top of grid
      grid?.scrollIntoView({ behavior: "smooth", block: "start" });
    }, 300);
  }

  if (sortSelect) {
    sortSelect.addEventListener("change", () => {
      if (!loaded) return;
      applySort(sortSelect.value as SortKey);
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      if (!loaded) return;
      applySort((tab.dataset.dealTab ?? "discount") as SortKey);
    });
  });

  /* ---------- Load from Supabase ---------- */

  async function loadDeals() {
    if (grid) {
      grid.innerHTML = `
        <div class="col-span-full py-12 text-center text-sm text-gray-500">
          در حال دریافت تخفیف‌ها...
        </div>
      `;
    }

    const { data, error } = await supabase
      .from("products")
      .select("*")
      .eq("active", true)
      .eq("discount_enabled", true)
      .order("created_at", { ascending: false });

    if (error) {
      console.error("خطا در دریافت تخفیف‌ها:", error);
      if (grid) {
        grid.innerHTML = `
          <div class="col-span-full rounded-2xl border border-red-200 bg-red-50 p-6 text-center text-sm leading-7 text-red-700">
            دریافت تخفیف‌ها با خطا مواجه شد. لطفاً کمی بعد دوباره تلاش کنید.
          </div>
        `;
      }
      setShowing("خطا در دریافت اطلاعات");
      return;
    }

    allDeals = ((data ?? []) as Product[])
      .map(toDeal)
      .filter((deal): deal is Deal => deal !== null);

    loaded = true;
    renderHeroVisual(allDeals);

    if (maxDiscountText && allDeals.length > 0) {
      const maxPercent = Math.max(...allDeals.map((deal) => deal.percent));
      maxDiscountText.textContent = `تا ${faNumber.format(maxPercent)}٪ تخفیف روی مقاطع فولادی`;
    }

    applySort("discount", false);
  }

  loadDeals();
</script>
