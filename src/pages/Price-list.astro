--- import BaseLayout from "../layouts/BaseLayout.astro"; const products = [ { name: "میلگرد ۱۴ آجدار A3", category: "rebar", categoryName: "میلگرد", factory: "ذوب آهن اصفهان", unit: "شاخه ۱۲ متری", weight: "۱۴.۵ کیلوگرم", price: 32400, change: "up", delivery: "انبار تهران / کارخانه", }, { name: "میلگرد ۱۶ آجدار A3", category: "rebar", categoryName: "میلگرد", factory: "ذوب آهن اصفهان", unit: "شاخه ۱۲ متری", weight: "۱۹ کیلوگرم", price: 32200, change: "same", delivery: "انبار تهران / کارخانه", }, { name: "میلگرد ۱۸ آجدار A3", category: "rebar", categoryName: "میلگرد", factory: "فولاد کویر یزد", unit: "شاخه ۱۲ متری", weight: "۲۴ کیلوگرم", price: 31800, change: "down", delivery: "درب کارخانه", }, { name: "تیرآهن ۱۴ IPE", category: "beam", categoryName: "تیرآهن", factory: "ذوب آهن اصفهان", unit: "شاخه ۱۲ متری", weight: "۱۵۵ کیلوگرم", price: 37200, change: "same", delivery: "انبار تهران", }, { name: "تیرآهن ۱۶ IPE", category: "beam", categoryName: "تیرآهن", factory: "ذوب آهن اصفهان", unit: "شاخه ۱۲ متری", weight: "۱۹۰ کیلوگرم", price: 38500, change: "up", delivery: "انبار تهران", }, { name: "ورق سیاه ۲ میل", category: "sheet", categoryName: "ورق", factory: "فولاد مبارکه", unit: "شیت ۱×۲ متر", weight: "۳۱.۴ کیلوگرم", price: 38200, change: "up", delivery: "انبار اصفهان", }, { name: "ورق گالوانیزه ۱.۵ میل", category: "sheet", categoryName: "ورق", factory: "فولاد مبارکه", unit: "رول", weight: "۵۰ کیلوگرم", price: 44500, change: "down", delivery: "انبار تهران", }, { name: "قوطی ۴۰×۴۰ ضخامت ۲ میل", category: "profile", categoryName: "قوطی و پروفیل", factory: "فولاد فایکو", unit: "شاخه ۶ متری", weight: "۱۴.۸ کیلوگرم", price: 39100, change: "same", delivery: "انبار تهران", }, { name: "نبشی ۵×۵×۵", category: "angle", categoryName: "نبشی و ناودانی", factory: "فولاد ناب تبریز", unit: "شاخه ۶ متری", weight: "۲۲.۵ کیلوگرم", price: 35600, change: "up", delivery: "درب کارخانه", }, ]; const categories = [ { id: "all", title: "همه محصولات" }, { id: "rebar", title: "میلگرد" }, { id: "beam", title: "تیرآهن" }, { id: "sheet", title: "ورق" }, { id: "profile", title: "قوطی و پروفیل" }, { id: "angle", title: "نبشی و ناودانی" }, ]; --- <BaseLayout title="قیمت روز آهن و فولاد | ASIN STILL" description="جدول قیمت روز مقاطع فولادی، میلگرد، تیرآهن، ورق، پروفیل، نبشی و ناودانی" > <main class="price-page"> <!-- Hero --> <section class="price-hero"> <div class="container"> <div class="hero-content"> <div class="hero-badge"> <span class="badge-dot"></span> قیمت روز مقاطع فولادی </div> <h1> جدول قیمت <span>مقاطع فولادی</span> </h1> <p> مشاهده و بررسی قیمت روز انواع محصولات فولادی از معتبرترین کارخانه‌های کشور </p> <div class="hero-meta"> <div> <strong>آخرین بروزرسانی</strong> <span>امروز، ۱۲:۳۰</span> </div> <div class="meta-line"></div> <div> <strong>واحد قیمت</strong> <span>تومان / کیلوگرم</span> </div> </div> </div> <div class="hero-decoration"> <div class="steel-ring ring-1"></div> <div class="steel-ring ring-2"></div> <div class="steel-ring ring-3"></div> <div class="steel-line"></div> </div> </div> </section> <!-- Main --> <section class="price-section"> <div class="container"> <!-- Filters --> <div class="filters-card"> <div class="search-wrapper"> <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" > <circle cx="11" cy="11" r="7"></circle> <path d="m20 20-3.5-3.5"></path> </svg> <input id="productSearch" type="text" placeholder="جستجوی محصول، سایز یا کارخانه..." /> </div> <div class="factory-wrapper"> <select id="factoryFilter"> <option value="all">همه کارخانه‌ها</option> <option value="ذوب آهن اصفهان">ذوب آهن اصفهان</option> <option value="فولاد مبارکه">فولاد مبارکه</option> <option value="فولاد فایکو">فولاد فایکو</option> <option value="فولاد کویر یزد">فولاد کویر یزد</option> <option value="فولاد ناب تبریز">فولاد ناب تبریز</option> </select> </div> </div> <!-- Categories --> <div class="categories" id="categories"> { categories.map((category, index) => ( <button class:list={[ "category-btn", { active: index === 0 } ]} data-category={category.id} > {category.title} </button> )) } </div> <!-- Table Card --> <div class="table-card"> <div class="table-header"> <div> <h2>قیمت روز محصولات فولادی</h2> <p> <span id="productCount">۹</span> محصول نمایش داده می‌شود </p> </div> <div class="live-status"> <span></span> بروزرسانی آنلاین </div> </div> <div class="table-scroll"> <table> <thead> <tr> <th>محصول</th> <th>کارخانه</th> <th>واحد / وزن</th> <th>قیمت هر کیلو</th> <th>روند قیمت</th> <th>محل تحویل</th> <th>استعلام</th> </tr> </thead> <tbody id="productRows"> { products.map((product) => ( <tr data-category={product.category} data-factory={product.factory} data-name={product.name} > <td> <div class="product-name"> <div class="product-icon"> {product.category === "rebar" && "میل"} {product.category === "beam" && "تیر"} {product.category === "sheet" && "ورق"} {product.category === "profile" && "پروف"} {product.category === "angle" && "نبش"} </div> <div> <strong>{product.name}</strong> <small>{product.categoryName}</small> </div> </div> </td> <td> <span class="factory-name"> {product.factory} </span> </td> <td> <div class="unit-info"> <span>{product.unit}</span> <small>{product.weight}</small> </div> </td> <td> <strong class="price"> {product.price.toLocaleString("fa-IR")} <small> تومان</small> </strong> </td> <td> { product.change === "up" && ( <span class="trend trend-up"> ↑ افزایشی </span> ) } { product.change === "down" && ( <span class="trend trend-down"> ↓ کاهشی </span> ) } { product.change === "same" && ( <span class="trend trend-same"> — ثابت </span> ) } </td> <td> <span class="delivery"> {product.delivery} </span> </td> <td> <button class="quote-btn" data-product={product.name} > استعلام قیمت </button> </td> </tr> )) } </tbody> </table> </div> <!-- Empty --> <div id="emptyState" class="empty-state hidden"> <div class="empty-icon">⌕</div> <h3>محصولی پیدا نشد</h3> <p> عبارت جستجو یا فیلتر کارخانه را تغییر دهید. </p> </div> </div> <!-- Bottom Note --> <div class="price-note"> <div class="note-icon">!</div> <div> <strong>توجه</strong> <p> قیمت‌های نمایش داده شده جهت نمونه و نمایش ساختار جدول هستند. قیمت نهایی پس از استعلام و تأیید واحد فروش اعلام خواهد شد. </p> </div> </div> </div> </section> </main> <div id="quoteToast" class="quote-toast"> <div class="toast-check">✓</div> <div> <strong>درخواست استعلام ثبت شد</strong> <span id="toastProduct"></span> </div> </div> <script> const searchInput = document.getElementById("productSearch"); const factoryFilter = document.getElementById("factoryFilter"); const rows = Array.from(document.querySelectorAll("#productRows tr")); const categoryButtons = Array.from(document.querySelectorAll(".category-btn")); const count = document.getElementById("productCount"); const emptyState = document.getElementById("emptyState"); let selectedCategory = "all"; function updateTable() { const search = searchInput.value.trim().toLowerCase(); const factory = factoryFilter.value; let visible = 0; rows.forEach((row) => { const category = row.dataset.category; const rowFactory = row.dataset.factory; const name = row.dataset.name.toLowerCase(); const categoryMatch = selectedCategory === "all" || category === selectedCategory; const factoryMatch = factory === "all" || rowFactory === factory; const searchMatch = !search || name.includes(search) || rowFactory.toLowerCase().includes(search); const show = categoryMatch && factoryMatch && searchMatch; row.style.display = show ? "" : "none"; if (show) visible++; }); count.textContent = visible.toLocaleString("fa-IR"); emptyState.classList.toggle( "hidden", visible !== 0 ); } searchInput.addEventListener( "input", updateTable ); factoryFilter.addEventListener( "change", updateTable ); categoryButtons.forEach((button) => { button.addEventListener( "click", () => { categoryButtons.forEach((item) => item.classList.remove("active") ); button.classList.add("active"); selectedCategory = button.dataset.category; updateTable(); } ); }); /* استعلام قیمت فعلاً Toast نمایش داده می‌شود. بعداً می‌توانیم آن را به فرم استعلام، واتساپ یا API فروش متصل کنیم. */ document .querySelectorAll(".quote-btn") .forEach((button) => { button.addEventListener( "click", () => { const product = button.dataset.product; document.getElementById( "toastProduct" ).textContent = `محصول «${product}»`; const toast = document.getElementById("quoteToast"); toast.classList.add("show"); setTimeout(() => { toast.classList.remove("show"); }, 3000); } ); }); </script> <style> .price-page { background: #f8fafc; min-height: 100vh; color: #0f172a; } .container { width: min(1400px, calc(100% - 32px)); margin-inline: auto; } /* HERO */ .price-hero { position: relative; overflow: hidden; background: radial-gradient( circle at 80% 30%, rgba(30, 64, 175, .18), transparent 35% ), linear-gradient( 135deg, #07111f 0%, #0b1728 55%, #101c2d 100% ); color: white; padding: 70px 0 75px; } .price-hero .container { position: relative; display: flex; align-items: center; min-height: 280px; } .hero-content { position: relative; z-index: 2; max-width: 760px; } .hero-badge { display: inline-flex; align-items: center; gap: 9px; padding: 8px 14px; border: 1px solid rgba(148,163,184,.2); border-radius: 999px; background: rgba(15,23,42,.65); color: #cbd5e1; font-size: 13px; margin-bottom: 22px; } .badge-dot { width: 7px; height: 7px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 12px rgba(34,197,94,.8); } .price-hero h1 { margin: 0; font-size: clamp(34px, 5vw, 58px); line-height: 1.25; font-weight: 900; letter-spacing: -1px; } .price-hero h1 span { display: block; color: #60a5fa; } .price-hero p { margin-top: 18px; color: #94a3b8; font-size: 16px; line-height: 2; } .hero-meta { display: flex; align-items: center; gap: 24px; margin-top: 30px; } .hero-meta div:not(.meta-line) { display: flex; flex-direction: column; gap: 4px; } .hero-meta strong { color: #64748b; font-size: 11px; font-weight: 600; } .hero-meta span { color: #e2e8f0; font-size: 13px; } .meta-line { width: 1px; height: 35px; background: #334155; } /* Decorative steel */ .hero-decoration { position: absolute; inset-inline-end: -100px; top: 50%; transform: translateY(-50%); width: 500px; height: 500px; opacity: .35; } .steel-ring { position: absolute; border: 1px solid #475569; border-radius: 50%; } .ring-1 { width: 480px; height: 480px; } .ring-2 { width: 350px; height: 350px; top: 65px; left: 65px; } .ring-3 { width: 220px; height: 220px; top: 130px; left: 130px; } .steel-line { position: absolute; width: 650px; height: 1px; background: #64748b; transform: rotate(-35deg); top: 245px; left: -70px; } /* MAIN */ .price-section { padding: 55px 0 80px; } .filters-card { display: grid; grid-template-columns: 1fr 260px; gap: 14px; background: white; border: 1px solid #e2e8f0; border-radius: 18px; padding: 14px; box-shadow: 0 8px 30px rgba(15,23,42,.05); } .search-wrapper { position: relative; } .search-wrapper svg { position: absolute; right: 17px; top: 50%; transform: translateY(-50%); color: #64748b; } .search-wrapper input, .factory-wrapper select { width: 100%; height: 52px; border: 1px solid #e2e8f0; border-radius: 12px; background: #f8fafc; padding: 0 48px 0 16px; font-family: inherit; color: #0f172a; outline: none; transition: .2s; } .factory-wrapper select { padding: 0 15px; } .search-wrapper input:focus, .factory-wrapper select:focus { border-color: #2563eb; background: white; box-shadow: 0 0 0 3px rgba(37,99,235,.08); } /* CATEGORIES */ .categories { display: flex; gap: 9px; overflow-x: auto; padding: 20px 2px; scrollbar-width: thin; } .category-btn { border: 1px solid #e2e8f0; background: white; color: #475569; padding: 10px 18px; border-radius: 10px; font-family: inherit; font-size: 13px; font-weight: 600; white-space: nowrap; cursor: pointer; transition: .2s; } .category-btn:hover { border-color: #94a3b8; } .category-btn.active { background: #0f2744; border-color: #0f2744; color: white; box-shadow: 0 5px 15px rgba(15,39,68,.15); } /* TABLE */ .table-card { background: white; border: 1px solid #e2e8f0; border-radius: 18px; overflow: hidden; box-shadow: 0 8px 35px rgba(15,23,42,.06); } .table-header { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 24px; border-bottom: 1px solid #e2e8f0; } .table-header h2 { margin: 0; font-size: 19px; font-weight: 800; color: #0f172a; } .table-header p { margin: 6px 0 0; color: #94a3b8; font-size: 12px; } .live-status { display: flex; align-items: center; gap: 8px; color: #64748b; font-size: 12px; white-space: nowrap; } .live-status span { width: 7px; height: 7px; border-radius: 50%; background: #22c55e; } .table-scroll { overflow-x: auto; } table { width: 100%; min-width: 1050px; border-collapse: collapse; text-align: right; } th { background: #f8fafc; color: #64748b; font-size: 11px; font-weight: 700; padding: 15px 18px; white-space: nowrap; border-bottom: 1px solid #e2e8f0; } td { padding: 17px 18px; border-bottom: 1px solid #f1f5f9; vertical-align: middle; font-size: 13px; } tbody tr { transition: background .15s; } tbody tr:hover { background: #f8fafc; } tbody tr:last-child td { border-bottom: none; } .product-name { display: flex; align-items: center; gap: 12px; min-width: 220px; } .product-icon { width: 42px; height: 42px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 10px; background: #eef4fb; color: #0f2744; font-size: 9px; font-weight: 900; border: 1px solid #dbe5f0; } .product-name strong { display: block; color: #0f172a; font-size: 13px; margin-bottom: 4px; } .product-name small { color: #94a3b8; font-size: 10px; } .factory-name { color: #475569; white-space: nowrap; font-size: 12px; } .unit-info { display: flex; flex-direction: column; gap: 4px; color: #475569; white-space: nowrap; } .unit-info small { color: #94a3b8; font-size: 10px; } .price { color: #0f2744; white-space: nowrap; font-size: 15px; font-weight: 900; } .price small { color: #94a3b8; font-size: 9px; font-weight: 500; } .trend { display: inline-flex; padding: 6px 9px; border-radius: 7px; font-size: 11px; font-weight: 700; white-space: nowrap; } .trend-up { background: #fff1f2; color: #e11d48; } .trend-down { background: #ecfdf5; color: #059669; } .trend-same { background: #f1f5f9; color: #64748b; } .delivery { color: #64748b; font-size: 11px; white-space: nowrap; } .quote-btn { border: 1px solid #0f2744; background: #0f2744; color: white; padding: 9px 13px; border-radius: 8px; font-family: inherit; font-size: 11px; font-weight: 700; cursor: pointer; white-space: nowrap; transition: .2s; } .quote-btn:hover { background: #173b64; transform: translateY(-1px); } /* EMPTY */ .empty-state { text-align: center; padding: 70px 20px; } .empty-state.hidden { display: none; } .empty-icon { margin: auto; width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #f1f5f9; color: #64748b; font-size: 28px; } .empty-state h3 { margin: 15px 0 6px; font-size: 17px; } .empty-state p { color: #94a3b8; font-size: 12px; } /* NOTE */ .price-note { display: flex; gap: 14px; margin-top: 18px; padding: 18px 20px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px; } .note-icon { width: 28px; height: 28px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #e2e8f0; color: #475569; font-weight: 900; } .price-note strong { font-size: 12px; } .price-note p { margin: 4px 0 0; color: #64748b; font-size: 11px; line-height: 1.9; } /* TOAST */ .quote-toast { position: fixed; bottom: 25px; left: 25px; display: flex; align-items: center; gap: 12px; min-width: 280px; padding: 15px 18px; background: #0f172a; color: white; border: 1px solid #334155; border-radius: 13px; box-shadow: 0 15px 40px rgba(0,0,0,.25); transform: translateY(120px); opacity: 0; pointer-events: none; transition: .3s; z-index: 100; } .quote-toast.show { transform: translateY(0); opacity: 1; } .toast-check { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #22c55e; color: white; font-weight: 900; } .quote-toast strong, .quote-toast span { display: block; } .quote-toast strong { font-size: 12px; } .quote-toast span { margin-top: 3px; color: #94a3b8; font-size: 10px; } /* RESPONSIVE */ @media (max-width: 800px) { .price-hero { padding: 45px 0; } .price-hero h1 { font-size: 34px; } .hero-decoration { opacity: .15; right: -240px; } .hero-meta { gap: 15px; } .filters-card { grid-template-columns: 1fr; } .table-header { align-items: flex-start; flex-direction: column; } .live-status { display: none; } .price-section { padding-top: 30px; } } @media (max-width: 500px) { .container { width: min(100% - 20px, 1400px); } .price-hero h1 { font-size: 30px; } .price-hero p { font-size: 13px; } .hero-meta { flex-wrap: wrap; } .meta-line { display: none; } .price-note { align-items: flex-start; } .quote-toast { left: 10px; right: 10px; bottom: 10px; min-width: 0; } } </style> </BaseLayout> 
