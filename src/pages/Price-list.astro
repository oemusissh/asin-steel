---
import BaseLayout from "../layouts/BaseLayout.astro";

const products = [
  {
    name: "میلگرد ۱۴ آجدار A3",
    category: "rebar",
    categoryName: "میلگرد",
    factory: "ذوب آهن اصفهان",
    unit: "شاخه ۱۲ متری",
    weight: "۱۴.۵ کیلوگرم",
    price: 32400,
    change: "up",
    delivery: "انبار تهران / کارخانه",
  },
  {
    name: "میلگرد ۱۶ آجدار A3",
    category: "rebar",
    categoryName: "میلگرد",
    factory: "ذوب آهن اصفهان",
    unit: "شاخه ۱۲ متری",
    weight: "۱۹ کیلوگرم",
    price: 32200,
    change: "same",
    delivery: "انبار تهران / کارخانه",
  },
  {
    name: "میلگرد ۱۸ آجدار A3",
    category: "rebar",
    categoryName: "میلگرد",
    factory: "فولاد کویر یزد",
    unit: "شاخه ۱۲ متری",
    weight: "۲۴ کیلوگرم",
    price: 31800,
    change: "down",
    delivery: "درب کارخانه",
  },
  {
    name: "تیرآهن ۱۴ IPE",
    category: "beam",
    categoryName: "تیرآهن",
    factory: "ذوب آهن اصفهان",
    unit: "شاخه ۱۲ متری",
    weight: "۱۵۵ کیلوگرم",
    price: 37200,
    change: "same",
    delivery: "انبار تهران",
  },
  {
    name: "تیرآهن ۱۶ IPE",
    category: "beam",
    categoryName: "تیرآهن",
    factory: "ذوب آهن اصفهان",
    unit: "شاخه ۱۲ متری",
    weight: "۱۹۰ کیلوگرم",
    price: 38500,
    change: "up",
    delivery: "انبار تهران",
  },
  {
    name: "ورق سیاه ۲ میل",
    category: "sheet",
    categoryName: "ورق",
    factory: "فولاد مبارکه",
    unit: "شیت ۱×۲ متر",
    weight: "۳۱.۴ کیلوگرم",
    price: 38200,
    change: "up",
    delivery: "انبار اصفهان",
  },
  {
    name: "ورق گالوانیزه ۱.۵ میل",
    category: "sheet",
    categoryName: "ورق",
    factory: "فولاد مبارکه",
    unit: "رول",
    weight: "۵۰ کیلوگرم",
    price: 44500,
    change: "down",
    delivery: "انبار تهران",
  },
  {
    name: "قوطی ۴۰×۴۰ ضخامت ۲ میل",
    category: "profile",
    categoryName: "قوطی و پروفیل",
    factory: "فولاد فایکو",
    unit: "شاخه ۶ متری",
    weight: "۱۴.۸ کیلوگرم",
    price: 39100,
    change: "same",
    delivery: "انبار تهران",
  },
  {
    name: "نبشی ۵×۵×۵",
    category: "angle",
    categoryName: "نبشی و ناودانی",
    factory: "فولاد ناب تبریز",
    unit: "شاخه ۶ متری",
    weight: "۲۲.۵ کیلوگرم",
    price: 35600,
    change: "up",
    delivery: "درب کارخانه",
  },
];

const categories = [
  { id: "all", title: "همه محصولات" },
  { id: "rebar", title: "میلگرد" },
  { id: "beam", title: "تیرآهن" },
  { id: "sheet", title: "ورق" },
  { id: "profile", title: "قوطی و پروفیل" },
  { id: "angle", title: "نبشی و ناودانی" },
];
---

<BaseLayout
  title="قیمت روز آهن و فولاد | ASIN STILL"
  description="جدول قیمت روز مقاطع فولادی، میلگرد، تیرآهن، ورق، پروفیل، نبشی و ناودانی"
>
  <main class="price-page" dir="rtl">

    <!-- =========================================
         HERO
    ========================================== -->

    <section class="price-hero">

      <div class="hero-grid"></div>

      <div class="hero-glow hero-glow-one"></div>
      <div class="hero-glow hero-glow-two"></div>

      <div class="hero-scan"></div>

      <div class="container hero-container">

        <div class="hero-content">

          <div class="hero-badge">
            <span class="pulse-dot"></span>
            <span>مرکز آنلاین قیمت آهن و فولاد</span>
            <span class="badge-arrow">←</span>
          </div>

          <h1>
            قیمت روز
            <span>مقاطع فولادی</span>
          </h1>

          <p>
            قیمت لحظه‌ای و به‌روز میلگرد، تیرآهن، ورق، پروفیل
            و سایر محصولات فولادی از معتبرترین کارخانه‌های کشور.
          </p>

          <div class="hero-actions">

            <a href="#price-table" class="hero-main-btn">
              مشاهده قیمت‌ها
              <span>↓</span>
            </a>

            <div class="hero-update">
              <span class="update-dot"></span>

              <div>
                <small>آخرین بروزرسانی</small>
                <strong>امروز، ۱۲:۳۰</strong>
              </div>
            </div>

          </div>

          <div class="hero-stats">

            <div class="hero-stat">
              <strong>+۱۲۰</strong>
              <span>محصول فولادی</span>
            </div>

            <div class="stat-line"></div>

            <div class="hero-stat">
              <strong>+۳۰</strong>
              <span>کارخانه معتبر</span>
            </div>

            <div class="stat-line"></div>

            <div class="hero-stat">
              <strong>روزانه</strong>
              <span>بروزرسانی قیمت</span>
            </div>

          </div>

        </div>


        <!-- HERO VISUAL -->

        <div class="hero-visual">

          <div class="visual-orbit orbit-one"></div>
          <div class="visual-orbit orbit-two"></div>
          <div class="visual-orbit orbit-three"></div>

          <div class="steel-symbol">

            <div class="symbol-lines">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <div class="symbol-text">
              <small>ASIN</small>
              <strong>STILL</strong>
            </div>

          </div>

          <div class="floating-card card-price">

            <span class="mini-label">قیمت بازار</span>

            <strong>
              ۳۲,۴۰۰
              <small>تومان</small>
            </strong>

            <span class="up-small">▲ ۰.۸٪</span>

          </div>

          <div class="floating-card card-market">

            <span class="market-icon">↗</span>

            <div>
              <small>وضعیت بازار</small>
              <strong>فعال</strong>
            </div>

          </div>

          <div class="visual-cross cross-one"></div>
          <div class="visual-cross cross-two"></div>

        </div>

      </div>
    </section>


    <!-- =========================================
         MAIN
    ========================================== -->

    <section class="price-section">

      <div class="container">

        <!-- FILTERS -->

        <div class="filters-card">

          <div class="filter-search">

            <div class="search-icon">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m20 20-3.5-3.5"></path>
              </svg>
            </div>

            <input
              id="productSearch"
              type="text"
              placeholder="جستجوی محصول، سایز یا کارخانه..."
            />

            <kbd>Ctrl K</kbd>

          </div>


          <div class="factory-filter">

            <span class="select-label">انتخاب کارخانه</span>

            <select id="factoryFilter">
              <option value="all">همه کارخانه‌ها</option>
              <option value="ذوب آهن اصفهان">ذوب آهن اصفهان</option>
              <option value="فولاد مبارکه">فولاد مبارکه</option>
              <option value="فولاد فایکو">فولاد فایکو</option>
              <option value="فولاد کویر یزد">فولاد کویر یزد</option>
              <option value="فولاد ناب تبریز">فولاد ناب تبریز</option>
            </select>

            <span class="select-arrow">⌄</span>

          </div>

        </div>


        <!-- CATEGORY FILTER -->

        <div class="category-wrapper">

          <div class="category-title">
            <span class="category-title-line"></span>
            دسته‌بندی محصولات
          </div>

          <div class="categories" id="categories">

            {categories.map((category, index) => (
              <button
                class:list={[
                  "category-btn",
                  { active: index === 0 },
                ]}
                data-category={category.id}
              >
                {category.title}

                {index === 0 && (
                  <span class="category-count">
                    ۹
                  </span>
                )}
              </button>
            ))}

          </div>

        </div>


        <!-- =========================================
             TABLE
        ========================================== -->

        <div class="table-card" id="price-table">

          <div class="table-header">

            <div class="table-heading">

              <div class="heading-icon">

                <svg
                  width="23"
                  height="23"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                >
                  <path d="M4 19V5"></path>
                  <path d="M4 19h16"></path>
                  <path d="m7 15 3-4 3 2 5-7"></path>
                </svg>

              </div>

              <div>

                <div class="heading-kicker">
                  <span></span>
                  بازار فولاد
                </div>

                <h2>قیمت روز محصولات</h2>

                <p>
                  آخرین قیمت‌های ثبت‌شده در بازار
                </p>

              </div>

            </div>


            <div class="table-status">

              <span class="status-live-dot"></span>

              <div>
                <small>وضعیت</small>
                <strong>بروزرسانی فعال</strong>
              </div>

            </div>

          </div>


          <!-- TABLE -->

          <div class="table-scroll">

            <table>

              <thead>

                <tr>
                  <th>محصول</th>
                  <th>کارخانه</th>
                  <th>مشخصات</th>
                  <th>قیمت</th>
                  <th>روند بازار</th>
                  <th>محل تحویل</th>
                  <th>عملیات</th>
                </tr>

              </thead>


              <tbody id="productRows">

                {products.map((product) => (

                  <tr
                    data-category={product.category}
                    data-factory={product.factory}
                    data-name={product.name}
                  >

                    <!-- PRODUCT -->

                    <td>

                      <div class="product-name">

                        <div class={`product-icon icon-${product.category}`}>

                          {product.category === "rebar" && "میل"}
                          {product.category === "beam" && "تیر"}
                          {product.category === "sheet" && "ورق"}
                          {product.category === "profile" && "پروف"}
                          {product.category === "angle" && "نبش"}

                        </div>

                        <div class="product-title">

                          <strong>
                            {product.name}
                          </strong>

                          <small>
                            {product.categoryName}
                          </small>

                        </div>

                      </div>

                    </td>


                    <!-- FACTORY -->

                    <td>

                      <div class="factory-name">

                        <span class="factory-logo">
                          <span></span>
                        </span>

                        {product.factory}

                      </div>

                    </td>


                    <!-- SPECIFICATIONS -->

                    <td>

                      <div class="unit-info">

                        <strong>
                          {product.unit}
                        </strong>

                        <span>
                          وزن تقریبی: {product.weight}
                        </span>

                      </div>

                    </td>


                    <!-- PRICE -->

                    <td>

                      <div class="price-box">

                        <strong>
                          {product.price.toLocaleString("fa-IR")}
                        </strong>

                        <span>
                          تومان
                        </span>

                      </div>

                    </td>


                    <!-- TREND -->

                    <td>

                      {product.change === "up" && (
                        <span class="trend trend-up">
                          <span class="trend-arrow">↗</span>
                          افزایشی
                        </span>
                      )}

                      {product.change === "down" && (
                        <span class="trend trend-down">
                          <span class="trend-arrow">↘</span>
                          کاهشی
                        </span>
                      )}

                      {product.change === "same" && (
                        <span class="trend trend-same">
                          <span class="trend-arrow">→</span>
                          ثابت
                        </span>
                      )}

                    </td>


                    <!-- DELIVERY -->

                    <td>

                      <div class="delivery">

                        <span class="delivery-pin">
                          ●
                        </span>

                        {product.delivery}

                      </div>

                    </td>


                    <!-- ACTION -->

                    <td>

                      <button
                        class="quote-btn"
                        data-product={product.name}
                      >

                        <span>
                          استعلام قیمت
                        </span>

                        <b>←</b>

                      </button>

                    </td>

                  </tr>

                ))}

              </tbody>

            </table>

          </div>


          <!-- EMPTY -->

          <div id="emptyState" class="empty-state hidden">

            <div class="empty-icon">

              <svg
                width="26"
                height="26"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
              >
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m20 20-3.5-3.5"></path>
              </svg>

            </div>

            <h3>
              محصولی پیدا نشد
            </h3>

            <p>
              عبارت جستجو یا فیلتر کارخانه را تغییر دهید.
            </p>

          </div>


          <!-- TABLE FOOTER -->

          <div class="table-footer">

            <div class="footer-info">

              <span class="footer-live"></span>

              قیمت‌ها به صورت دوره‌ای بروزرسانی می‌شوند.

            </div>

            <span class="unit-footer">
              واحد قیمت: تومان / کیلوگرم
            </span>

          </div>

        </div>


        <!-- NOTE -->

        <div class="price-note">

          <div class="note-icon">
            !
          </div>

          <div class="note-content">

            <strong>
              درباره قیمت‌های نمایش داده شده
            </strong>

            <p>
              قیمت‌های این صفحه در نسخه فعلی جهت نمایش ساختار
              سامانه هستند. قیمت نهایی پس از استعلام و تأیید
              واحد فروش اعلام خواهد شد.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- TOAST -->

    <div id="quoteToast" class="quote-toast">

      <div class="toast-check">
        ✓
      </div>

      <div class="toast-content">

        <strong>
          درخواست استعلام ثبت شد
        </strong>

        <span id="toastProduct"></span>

      </div>

      <button
        class="toast-close"
        aria-label="بستن"
      >
        ×
      </button>

    </div>

  </main>


  <script>

    const searchInput =
      document.getElementById("productSearch");

    const factoryFilter =
      document.getElementById("factoryFilter");

    const rows =
      Array.from(
        document.querySelectorAll("#productRows tr")
      );

    const categoryButtons =
      Array.from(
        document.querySelectorAll(".category-btn")
      );

    const count =
      document.getElementById("productCount");

    const emptyState =
      document.getElementById("emptyState");

    let selectedCategory = "all";


    function updateTable() {

      const search =
        searchInput.value
          .trim()
          .toLowerCase();

      const factory =
        factoryFilter.value;

      let visible = 0;


      rows.forEach((row) => {

        const category =
          row.dataset.category;

        const rowFactory =
          row.dataset.factory;

        const name =
          row.dataset.name.toLowerCase();


        const categoryMatch =
          selectedCategory === "all" ||
          category === selectedCategory;


        const factoryMatch =
          factory === "all" ||
          rowFactory === factory;


        const searchMatch =
          !search ||
          name.includes(search) ||
          rowFactory.toLowerCase().includes(search);


        const show =
          categoryMatch &&
          factoryMatch &&
          searchMatch;


        row.style.display =
          show ? "" : "none";


        if (show) {
          visible++;
        }

      });


      if (count) {
        count.textContent =
          visible.toLocaleString("fa-IR");
      }


      emptyState.classList.toggle(
        "hidden",
        visible !== 0
      );

    }


    searchInput.addEventListener(
      "input",
      updateTable
    );


    factoryFilter.addEventListener(
      "change",
      updateTable
    );


    categoryButtons.forEach((button) => {

      button.addEventListener(
        "click",
        () => {

          categoryButtons.forEach((item) => {
            item.classList.remove("active");
          });

          button.classList.add("active");

          selectedCategory =
            button.dataset.category;

          updateTable();

        }
      );

    });


    const toast =
      document.getElementById("quoteToast");

    const toastProduct =
      document.getElementById("toastProduct");

    const toastClose =
      document.querySelector(".toast-close");


    let toastTimer;


    document
      .querySelectorAll(".quote-btn")
      .forEach((button) => {

        button.addEventListener(
          "click",
          () => {

            const product =
              button.dataset.product;

            toastProduct.textContent =
              `محصول «${product}»`;


            toast.classList.add("show");


            clearTimeout(toastTimer);


            toastTimer =
              setTimeout(() => {
                toast.classList.remove("show");
              }, 4000);

          }
        );

      });


    toastClose.addEventListener(
      "click",
      () => {
        toast.classList.remove("show");
      }
    );


    /* CTRL + K SEARCH */

    document.addEventListener(
      "keydown",
      (event) => {

        if (
          (event.ctrlKey || event.metaKey) &&
          event.key.toLowerCase() === "k"
        ) {

          event.preventDefault();

          searchInput.focus();

        }

      }
    );


    updateTable();

  </script>


  <style>

    /* =====================================================
       BASE
    ===================================================== */

    .price-page {
      --navy-950: #040b14;
      --navy-900: #071321;
      --navy-800: #0b1b2d;
      --navy-700: #102a43;

      --steel-500: #3b82f6;
      --steel-400: #60a5fa;
      --steel-300: #93c5fd;

      --green: #10b981;
      --red: #ef4444;

      min-height: 100vh;
      background:
        linear-gradient(
          180deg,
          #f3f6fa 0%,
          #f8fafc 55%,
          #f1f5f9 100%
        );

      color: #0f172a;
      font-family: inherit;
      overflow: hidden;
    }

    .price-page *,
    .price-page *::before,
    .price-page *::after {
      box-sizing: border-box;
    }

    .container {
      width: min(1400px, calc(100% - 40px));
      margin-inline: auto;
    }


    /* =====================================================
       HERO
    ===================================================== */

    .price-hero {
      position: relative;
      min-height: 520px;
      overflow: hidden;

      background:
        radial-gradient(
          circle at 75% 30%,
          rgba(37,99,235,.16),
          transparent 26%
        ),
        radial-gradient(
          circle at 20% 70%,
          rgba(14,165,233,.08),
          transparent 28%
        ),
        linear-gradient(
          125deg,
          #030911 0%,
          #06111e 45%,
          #0b1d31 100%
        );

      color: white;
    }


    .hero-grid {
      position: absolute;
      inset: 0;

      background-image:
        linear-gradient(
          rgba(148,163,184,.075) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(148,163,184,.075) 1px,
          transparent 1px
        );

      background-size: 52px 52px;

      mask-image:
        linear-gradient(
          to left,
          black,
          transparent 80%
        );

      opacity: .8;
    }


    .hero-glow {
      position: absolute;
      border-radius: 50%;
      pointer-events: none;
      filter: blur(80px);
    }

    .hero-glow-one {
      width: 430px;
      height: 430px;
      left: -160px;
      top: -120px;
      background: rgba(37,99,235,.09);
    }

    .hero-glow-two {
      width: 350px;
      height: 350px;
      right: 15%;
      bottom: -220px;
      background: rgba(14,165,233,.07);
    }


    .hero-scan {
      position: absolute;
      width: 100%;
      height: 1px;
      top: 38%;
      left: 0;

      background:
        linear-gradient(
          90deg,
          transparent,
          rgba(96,165,250,.25),
          transparent
        );

      opacity: .6;
    }


    .hero-container {
      position: relative;
      min-height: 520px;

      display: flex;
      align-items: center;
      justify-content: space-between;
    }


    .hero-content {
      position: relative;
      z-index: 5;

      width: 650px;
      padding: 75px 0;
    }


    /* HERO BADGE */

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 9px;

      padding: 9px 13px;

      border: 1px solid rgba(148,163,184,.2);
      border-radius: 9px;

      background:
        linear-gradient(
          135deg,
          rgba(30,64,175,.16),
          rgba(15,23,42,.3)
        );

      color: #b6c5d8;

      font-size: 12px;
      font-weight: 500;
      line-height: 1.7;

      box-shadow:
        inset 0 1px 0 rgba(255,255,255,.04),
        0 10px 35px rgba(0,0,0,.1);
    }


    .pulse-dot {
      width: 7px;
      height: 7px;

      border-radius: 50%;

      background: #22c55e;

      box-shadow:
        0 0 0 4px rgba(34,197,94,.08),
        0 0 15px rgba(34,197,94,.7);
    }


    .badge-arrow {
      color: #60a5fa;
      font-size: 15px;
    }


    /* HERO TITLE */

    .price-hero h1 {
      margin: 25px 0 0;

      font-size: clamp(42px, 5.3vw, 70px);
      line-height: 1.25;

      letter-spacing: -.5px;

      font-weight: 800;
    }


    .price-hero h1 span {
      display: block;

      margin-top: 4px;

      background:
        linear-gradient(
          90deg,
          #ffffff 0%,
          #93c5fd 45%,
          #60a5fa 100%
        );

      -webkit-background-clip: text;
      background-clip: text;

      color: transparent;
    }


    .hero-content > p {
      max-width: 620px;

      margin: 22px 0 0;

      color: #91a4b9;

      font-size: 15px;
      font-weight: 400;
      line-height: 2.1;
    }


    /* HERO ACTIONS */

    .hero-actions {
      display: flex;
      align-items: center;
      gap: 17px;

      margin-top: 31px;
    }


    .hero-main-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 13px;

      height: 48px;
      padding: 0 21px;

      border: 1px solid rgba(147,197,253,.25);
      border-radius: 10px;

      background:
        linear-gradient(
          135deg,
          #2563eb,
          #174ea6
        );

      color: white;

      font-family: inherit;
      font-size: 13px;
      font-weight: 700;

      text-decoration: none;

      box-shadow:
        0 10px 30px rgba(37,99,235,.22);

      transition: .25s;
    }


    .hero-main-btn span {
      font-size: 17px;
      transition: .25s;
    }


    .hero-main-btn:hover {
      transform: translateY(-2px);

      box-shadow:
        0 15px 38px rgba(37,99,235,.3);
    }


    .hero-main-btn:hover span {
      transform: translateY(3px);
    }


    .hero-update {
      display: flex;
      align-items: center;
      gap: 10px;
    }


    .update-dot {
      width: 8px;
      height: 8px;

      border-radius: 50%;

      background: #22c55e;

      box-shadow:
        0 0 13px rgba(34,197,94,.7);
    }


    .hero-update small,
    .hero-update strong {
      display: block;
    }


    .hero-update small {
      color: #64748b;
      font-size: 10px;
      line-height: 1.7;
    }


    .hero-update strong {
      margin-top: 2px;
      color: #cbd5e1;
      font-size: 12px;
      font-weight: 600;
      line-height: 1.7;
    }


    /* HERO STATS */

    .hero-stats {
      display: flex;
      align-items: center;

      margin-top: 45px;
    }


    .hero-stat {
      display: flex;
      flex-direction: column;
      gap: 4px;

      min-width: 110px;
    }


    .hero-stat strong {
      color: #e5edf7;
      font-size: 19px;
      font-weight: 800;
      line-height: 1.6;
    }


    .hero-stat span {
      color: #66788d;
      font-size: 10px;
      line-height: 1.7;
    }


    .stat-line {
      width: 1px;
      height: 32px;
      margin: 0 25px;

      background:
        linear-gradient(
          to bottom,
          transparent,
          #34475d,
          transparent
        );
    }


    /* =====================================================
       HERO VISUAL
    ===================================================== */

    .hero-visual {
      position: relative;

      width: 500px;
      height: 500px;

      flex-shrink: 0;
    }


    .visual-orbit {
      position: absolute;

      border: 1px solid rgba(96,165,250,.12);

      border-radius: 50%;
    }


    .orbit-one {
      width: 460px;
      height: 460px;

      top: 20px;
      left: 20px;
    }


    .orbit-two {
      width: 335px;
      height: 335px;

      top: 82px;
      left: 82px;

      border-color:
        rgba(96,165,250,.2);
    }


    .orbit-three {
      width: 210px;
      height: 210px;

      top: 144px;
      left: 144px;

      border-color:
        rgba(96,165,250,.3);

      box-shadow:
        0 0 70px rgba(37,99,235,.07);
    }


    .steel-symbol {
      position: absolute;

      width: 145px;
      height: 145px;

      top: 177px;
      left: 177px;

      display: flex;
      align-items: center;
      justify-content: center;

      border: 1px solid rgba(147,197,253,.32);
      border-radius: 50%;

      background:
        radial-gradient(
          circle,
          rgba(30,64,175,.16),
          rgba(4,11,20,.9)
        );

      box-shadow:
        0 0 70px rgba(37,99,235,.12),
        inset 0 0 35px rgba(96,165,250,.04);
    }


    .symbol-lines {
      position: absolute;
      inset: 20px;

      display: flex;
      align-items: center;
      justify-content: center;
      gap: 7px;

      opacity: .45;
    }


    .symbol-lines span {
      display: block;

      width: 1px;
      height: 70px;

      background:
        linear-gradient(
          to bottom,
          transparent,
          #60a5fa,
          transparent
        );

      transform: rotate(38deg);
    }


    .symbol-lines span:nth-child(2) {
      height: 90px;
    }


    .symbol-text {
      position: relative;
      z-index: 2;

      display: flex;
      flex-direction: column;
      align-items: center;
    }


    .symbol-text small {
      color: #94a3b8;

      font-size: 12px;
      letter-spacing: 3px;
      line-height: 1.7;
    }


    .symbol-text strong {
      color: #60a5fa;

      font-size: 22px;
      font-weight: 800;

      letter-spacing: 4px;
      line-height: 1.7;
    }


    /* FLOATING CARDS */

    .floating-card {
      position: absolute;

      display: flex;

      border: 1px solid rgba(148,163,184,.17);
      border-radius: 11px;

      background:
        linear-gradient(
          135deg,
          rgba(14,29,47,.94),
          rgba(6,15,26,.9)
        );

      box-shadow:
        0 18px 45px rgba(0,0,0,.2),
        inset 0 1px 0 rgba(255,255,255,.035);

      backdrop-filter: blur(12px);
    }


    .card-price {
      top: 85px;
      right: 5px;

      width: 165px;

      flex-direction: column;

      padding: 14px 16px;
    }


    .mini-label {
      color: #718398;

      font-size: 9px;
      line-height: 1.7;
    }


    .card-price strong {
      margin-top: 4px;

      color: #e8f1fb;

      font-size: 20px;
      font-weight: 800;
      line-height: 1.7;
    }


    .card-price strong small {
      color: #718398;

      font-size: 9px;
      font-weight: 400;
    }


    .up-small {
      margin-top: 4px;

      color: #34d399;

      font-size: 9px;
      font-weight: 600;
    }


    .card-market {
      left: 5px;
      bottom: 100px;

      align-items: center;
      gap: 10px;

      padding: 12px 15px;
    }


    .market-icon {
      width: 32px;
      height: 32px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 8px;

      background:
        rgba(16,185,129,.09);

      color: #34d399;

      font-size: 18px;
    }


    .card-market small,
    .card-market strong {
      display: block;
    }


    .card-market small {
      color: #64748b;
      font-size: 9px;
    }


    .card-market strong {
      margin-top: 2px;

      color: #dbeafe;

      font-size: 11px;
      font-weight: 600;
    }


    /* CROSS */

    .visual-cross {
      position: absolute;

      width: 9px;
      height: 9px;
    }


    .visual-cross::before,
    .visual-cross::after {
      content: "";

      position: absolute;

      background: #60a5fa;
      opacity: .5;
    }


    .visual-cross::before {
      width: 1px;
      height: 9px;
      left: 4px;
    }


    .visual-cross::after {
      width: 9px;
      height: 1px;
      top: 4px;
    }


    .cross-one {
      top: 50px;
      left: 150px;
    }


    .cross-two {
      right: 90px;
      bottom: 80px;
    }


    /* =====================================================
       MAIN
    ===================================================== */

    .price-section {
      padding: 65px 0 90px;
    }


    /* =====================================================
       FILTERS
    ===================================================== */

    .filters-card {
      display: grid;

      grid-template-columns:
        minmax(0, 1fr)
        290px;

      gap: 10px;

      padding: 9px;

      border: 1px solid #dfe6ef;
      border-radius: 16px;

      background:
        rgba(255,255,255,.92);

      box-shadow:
        0 15px 45px rgba(15,23,42,.055);
    }


    .filter-search,
    .factory-filter {
      position: relative;
    }


    .filter-search {
      display: flex;
      align-items: center;
    }


    .search-icon {
      position: absolute;

      right: 17px;

      color: #64748b;

      pointer-events: none;
    }


    .filter-search input,
    .factory-filter select {
      width: 100%;
      height: 58px;

      border: 1px solid #e3e8ef;
      border-radius: 11px;

      outline: none;

      background: #f7f9fb;

      color: #0f172a;

      font-family: inherit;

      font-size: 13px;
      font-weight: 400;

      transition: .2s;
    }


    .filter-search input {
      padding:
        0 53px 0 75px;
    }


    .filter-search input::placeholder {
      color: #94a3b8;
    }


    .filter-search input:focus,
    .factory-filter select:focus {
      border-color: #60a5fa;

      background: white;

      box-shadow:
        0 0 0 4px rgba(37,99,235,.07);
    }


    kbd {
      position: absolute;

      left: 13px;

      padding: 3px 7px;

      border: 1px solid #d9e0e8;
      border-bottom-width: 2px;
      border-radius: 5px;

      background: white;

      color: #94a3b8;

      font-family: inherit;
      font-size: 9px;
    }


    .factory-filter select {
      appearance: none;

      padding: 0 17px 0 42px;

      cursor: pointer;
    }


    .select-label {
      position: absolute;

      top: 9px;
      right: 17px;

      color: #94a3b8;

      font-size: 9px;

      pointer-events: none;
    }


    .factory-filter select {
      padding-top: 12px;
    }


    .select-arrow {
      position: absolute;

      left: 16px;
      bottom: 15px;

      color: #64748b;

      font-size: 15px;

      pointer-events: none;
    }


    /* =====================================================
       CATEGORIES
    ===================================================== */

    .category-wrapper {
      padding: 25px 0 17px;
    }


    .category-title {
      display: flex;
      align-items: center;
      gap: 8px;

      margin-bottom: 12px;

      color: #64748b;

      font-size: 11px;
      font-weight: 600;
    }


    .category-title-line {
      width: 5px;
      height: 5px;

      border-radius: 50%;

      background: #2563eb;
    }


    .categories {
      display: flex;
      gap: 8px;

      overflow-x: auto;

      scrollbar-width: none;
    }


    .categories::-webkit-scrollbar {
      display: none;
    }


    .category-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;

      height: 45px;

      flex-shrink: 0;

      padding: 0 17px;

      border: 1px solid #dfe6ee;
      border-radius: 9px;

      background: white;

      color: #64748b;

      font-family: inherit;

      font-size: 12px;
      font-weight: 600;

      cursor: pointer;

      transition: .2s;
    }


    .category-btn:hover {
      border-color: #9fb2c7;

      color: #102a43;

      transform: translateY(-1px);
    }


    .category-btn.active {
      border-color: #173b64;

      background:
        linear-gradient(
          135deg,
          #102a43,
          #173b64
        );

      color: white;

      box-shadow:
        0 9px 25px rgba(16,42,67,.16);
    }


    .category-count {
      min-width: 21px;
      height: 21px;

      display: inline-flex;
      align-items: center;
      justify-content: center;

      border-radius: 6px;

      background: rgba(255,255,255,.12);

      color: #bfdbfe;

      font-size: 9px;
    }


    /* =====================================================
       TABLE CARD
    ===================================================== */

    .table-card {
      overflow: hidden;

      border: 1px solid #dfe6ef;
      border-radius: 18px;

      background: white;

      box-shadow:
        0 20px 60px rgba(15,23,42,.065);
    }


    .table-header {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 20px;

      padding: 25px 27px;

      border-bottom: 1px solid #e9eef4;

      background:
        linear-gradient(
          180deg,
          #ffffff,
          #fbfcfe
        );
    }


    .table-heading {
      display: flex;
      align-items: center;
      gap: 13px;
    }


    .heading-icon {
      width: 48px;
      height: 48px;

      display: flex;
      align-items: center;
      justify-content: center;

      border: 1px solid #dbe7f5;
      border-radius: 11px;

      background:
        linear-gradient(
          135deg,
          #eff6ff,
          #f8fbff
        );

      color: #2563eb;
    }


    .heading-kicker {
      display: flex;
      align-items: center;
      gap: 7px;

      margin-bottom: 3px;

      color: #2563eb;

      font-size: 10px;
      font-weight: 700;
    }


    .heading-kicker span {
      width: 5px;
      height: 5px;

      border-radius: 50%;

      background: #2563eb;
    }


    .table-header h2 {
      margin: 0;

      color: #0b1728;

      font-size: 21px;
      font-weight: 800;

      line-height: 1.7;
    }


    .table-header p {
      margin: 3px 0 0;

      color: #94a3b8;

      font-size: 11px;

      line-height: 1.7;
    }


    /* STATUS */

    .table-status {
      display: flex;
      align-items: center;
      gap: 9px;

      padding: 9px 13px;

      border: 1px solid #d8eee4;
      border-radius: 9px;

      background: #f5fcf8;
    }


    .status-live-dot {
      width: 7px;
      height: 7px;

      border-radius: 50%;

      background: #10b981;

      box-shadow:
        0 0 0 4px rgba(16,185,129,.08),
        0 0 12px rgba(16,185,129,.5);
    }


    .table-status small,
    .table-status strong {
      display: block;
    }


    .table-status small {
      color: #94a3b8;
      font-size: 8px;
    }


    .table-status strong {
      margin-top: 2px;

      color: #047857;

      font-size: 10px;
      font-weight: 600;
    }


    /* =====================================================
       TABLE
    ===================================================== */

    .table-scroll {
      overflow-x: auto;
    }


    table {
      width: 100%;

      min-width: 1120px;

      border-collapse: collapse;

      text-align: right;
    }


    th {
      padding: 15px 18px;

      border-bottom: 1px solid #e6ebf1;

      background:
        linear-gradient(
          180deg,
          #f8fafc,
          #f4f7fa
        );

      color: #64748b;

      font-size: 12px;
      font-weight: 700;

      line-height: 1.8;

      white-space: nowrap;
    }


    th:first-child {
      padding-right: 25px;
    }


    td {
      position: relative;

      padding: 19px 18px;

      border-bottom: 1px solid #eef2f6;

      font-size: 13px;

      line-height: 1.8;

      vertical-align: middle;

      transition: .2s;
    }


    td:first-child {
      padding-right: 25px;
    }


    tbody tr {
      transition: .2s;
    }


    tbody tr:hover {
      background:
        linear-gradient(
          90deg,
          #ffffff,
          #f8fbff
        );
    }


    tbody tr:hover td:first-child::before {
      content: "";

      position: absolute;

      right: 0;
      top: 12px;
      bottom: 12px;

      width: 3px;

      border-radius: 5px;

      background:
        linear-gradient(
          to bottom,
          #2563eb,
          #60a5fa
        );
    }


    tbody tr:last-child td {
      border-bottom: none;
    }


    /* =====================================================
       PRODUCT
    ===================================================== */

    .product-name {
      display: flex;
      align-items: center;
      gap: 12px;

      min-width: 250px;
    }


    .product-icon {
      width: 43px;
      height: 43px;

      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border: 1px solid #dce6f1;
      border-radius: 10px;

      background:
        linear-gradient(
          135deg,
          #f5f8fc,
          #edf3f9
        );

      color: #173b64;

      font-size: 8px;
      font-weight: 800;

      transition: .2s;
    }


    tbody tr:hover .product-icon {
      border-color: #b8d1ee;

      background: #eff6ff;

      color: #2563eb;

      transform: scale(1.04);
    }


    .product-title strong {
      display: block;

      margin-bottom: 4px;

      color: #172033;

      font-size: 14px;
      font-weight: 700;

      line-height: 1.8;
    }


    .product-title small {
      color: #94a3b8;

      font-size: 10px;
      font-weight: 400;

      line-height: 1.7;
    }


    /* =====================================================
       FACTORY
    ===================================================== */

    .factory-name {
      display: flex;
      align-items: center;
      gap: 8px;

      color: #334155;

      font-size: 12px;
      font-weight: 500;

      line-height: 1.8;

      white-space: nowrap;
    }


    .factory-logo {
      width: 25px;
      height: 25px;

      display: flex;
      align-items: center;
      justify-content: center;

      border: 1px solid #e0e7ef;
      border-radius: 7px;

      background: #f8fafc;
    }


    .factory-logo span {
      width: 7px;
      height: 7px;

      border: 2px solid #64748b;
      border-radius: 2px;

      transform: rotate(45deg);
    }


    /* =====================================================
       SPEC
    ===================================================== */

    .unit-info {
      display: flex;
      flex-direction: column;

      gap: 3px;

      white-space: nowrap;
    }


    .unit-info strong {
      color: #334155;

      font-size: 12px;
      font-weight: 600;

      line-height: 1.8;
    }


    .unit-info span {
      color: #94a3b8;

      font-size: 10px;
      font-weight: 400;

      line-height: 1.7;
    }


    /* =====================================================
       PRICE
    ===================================================== */

    .price-box {
      display: flex;
      align-items: baseline;

      gap: 5px;

      white-space: nowrap;
    }


    .price-box strong {
      color: #0d3155;

      font-size: 19px;
      font-weight: 800;

      line-height: 1.6;

      letter-spacing: 0;
    }


    .price-box span {
      color: #94a3b8;

      font-size: 9px;
      font-weight: 500;

      line-height: 1.7;
    }


    /* =====================================================
       TREND
    ===================================================== */

    .trend {
      display: inline-flex;
      align-items: center;
      gap: 6px;

      padding: 7px 10px;

      border-radius: 8px;

      font-size: 10px;
      font-weight: 700;

      line-height: 1.7;

      white-space: nowrap;
    }


    .trend-arrow {
      font-size: 13px;
      font-weight: 800;
    }


    .trend-up {
      border: 1px solid #fee2e2;

      background:
        linear-gradient(
          135deg,
          #fff5f5,
          #fff1f2
        );

      color: #dc2626;
    }


    .trend-down {
      border: 1px solid #d1fae5;

      background:
        linear-gradient(
          135deg,
          #f2fff9,
          #ecfdf5
        );

      color: #059669;
    }


    .trend-same {
      border: 1px solid #e2e8f0;

      background: #f8fafc;

      color: #64748b;
    }


    /* =====================================================
       DELIVERY
    ===================================================== */

    .delivery {
      display: flex;
      align-items: center;
      gap: 6px;

      color: #475569;

      font-size: 11px;
      font-weight: 500;

      white-space: nowrap;
    }


    .delivery-pin {
      color: #94a3b8;
      font-size: 7px;
    }


    /* =====================================================
       QUOTE BUTTON
    ===================================================== */

    .quote-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;

      height: 39px;

      padding: 0 14px;

      border: 1px solid #1d4f80;
      border-radius: 8px;

      background:
        linear-gradient(
          135deg,
          #102f50,
          #173f67
        );

      color: white;

      font-family: inherit;

      font-size: 11px;
      font-weight: 700;

      line-height: 1.7;

      cursor: pointer;

      white-space: nowrap;

      box-shadow:
        0 6px 16px rgba(16,42,67,.12);

      transition: .22s;
    }


    .quote-btn b {
      font-size: 14px;
      font-weight: 500;

      transition: .22s;
    }


    .quote-btn:hover {
      border-color: #2563eb;

      background:
        linear-gradient(
          135deg,
          #173f67,
          #1d4f80
        );

      transform: translateY(-2px);

      box-shadow:
        0 10px 23px rgba(16,42,67,.2);
    }


    .quote-btn:hover b {
      transform: translateX(-4px);
    }


    /* =====================================================
       TABLE FOOTER
    ===================================================== */

    .table-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 13px 22px;

      border-top: 1px solid #edf1f5;

      background: #fafbfd;
    }


    .footer-info {
      display: flex;
      align-items: center;
      gap: 7px;

      color: #94a3b8;

      font-size: 9px;
    }


    .footer-live {
      width: 5px;
      height: 5px;

      border-radius: 50%;

      background: #10b981;
    }


    .unit-footer {
      color: #94a3b8;

      font-size: 9px;
    }


    /* =====================================================
       EMPTY
    ===================================================== */

    .empty-state {
      padding: 80px 20px;

      text-align: center;
    }


    .empty-state.hidden {
      display: none;
    }


    .empty-icon {
      width: 60px;
      height: 60px;

      display: flex;
      align-items: center;
      justify-content: center;

      margin: auto;

      border: 1px solid #dfe6ef;
      border-radius: 50%;

      background: #f8fafc;

      color: #64748b;
    }


    .empty-state h3 {
      margin: 17px 0 5px;

      color: #1e293b;

      font-size: 17px;
      font-weight: 700;

      line-height: 1.8;
    }


    .empty-state p {
      margin: 0;

      color: #94a3b8;

      font-size: 11px;

      line-height: 1.9;
    }


