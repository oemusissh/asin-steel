---
import BaseLayout from "../layouts/BaseLayout.astro";

const categories = [
  { id: "all", title: "همه محصولات" },
  { id: "rebar", title: "میلگرد" },
  { id: "beam", title: "تیرآهن" },
  { id: "sheet", title: "ورق" },
  { id: "profile", title: "پروفیل" },
  { id: "angle", title: "نبشی و ناودانی" },
  { id: "pipe", title: "لوله" },
  { id: "billet", title: "شمش فولادی" },
  { id: "alloy", title: "فولاد آلیاژی" },
  { id: "other", title: "سایر محصولات" },
];
---

<BaseLayout
  title="قیمت روز آهن و فولاد | ASIN STILL"
  description="جدول قیمت روز مقاطع فولادی، میلگرد، تیرآهن، ورق، پروفیل، نبشی و ناودانی"
>
  <main class="price-page" dir="rtl">

    <!-- ================= HERO ================= -->
    <section class="price-hero">
      <div class="hero-grid"></div>
      <div class="hero-glow hero-glow-one"></div>
      <div class="hero-glow hero-glow-two"></div>
      <div class="hero-scan"></div>

      <div class="container hero-container">
        <div class="hero-content">
          <div class="hero-badge">
            <span class="pulse-dot"></span>
            <span>مرکز آنلاین قیمت آهن و فولاد</span>
            <span class="badge-arrow">←</span>
          </div>

          <h1>
            قیمت روز
            <span>مقاطع فولادی</span>
          </h1>

          <p>
            قیمت لحظه‌ای و به‌روز میلگرد، تیرآهن، ورق، پروفیل
            و سایر محصولات فولادی از معتبرترین کارخانه‌های کشور.
          </p>

          <div class="hero-actions">
            <a href="#price-table" class="hero-main-btn">
              مشاهده قیمت‌ها
              <span>↓</span>
            </a>

            <div class="hero-update">
              <span class="update-dot"></span>
              <div>
                <small>آخرین بروزرسانی</small>
                <strong id="lastUpdate">—</strong>
              </div>
            </div>
          </div>

          <div class="hero-stats">
            <div class="hero-stat">
              <strong>+۱۲۰</strong>
              <span>محصول فولادی</span>
            </div>
            <div class="stat-line"></div>
            <div class="hero-stat">
              <strong>+۳۰</strong>
              <span>کارخانه معتبر</span>
            </div>
            <div class="stat-line"></div>
            <div class="hero-stat">
              <strong>روزانه</strong>
              <span>بروزرسانی قیمت</span>
            </div>
          </div>
        </div>

        <!-- HERO VISUAL -->
        <div class="hero-visual">
          <div class="visual-orbit orbit-one"></div>
          <div class="visual-orbit orbit-two"></div>
          <div class="visual-orbit orbit-three"></div>

          <div class="steel-symbol">
            <div class="symbol-lines">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <div class="symbol-text">
              <small>ASIN</small>
              <strong>STILL</strong>
            </div>
          </div>

          <div class="floating-card card-price">
            <span class="mini-label" id="heroName">قیمت بازار</span>
            <strong>
              <span id="heroPrice">—</span>
              <small>تومان</small>
            </strong>
            <span class="up-small is-same" id="heroTrend"></span>
          </div>

          <div class="floating-card card-market">
            <span class="market-icon">↗</span>
            <div>
              <small>وضعیت بازار</small>
              <strong>فعال</strong>
            </div>
          </div>

          <div class="visual-cross cross-one"></div>
          <div class="visual-cross cross-two"></div>
        </div>
      </div>
    </section>

    <!-- ================= MAIN ================= -->
    <section class="price-section">
      <div class="container">

        <!-- FILTERS -->
        <div class="filters-card">
          <div class="filter-search">
            <div class="search-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m20 20-3.5-3.5"></path>
              </svg>
            </div>
            <input
              id="productSearch"
              type="text"
              placeholder="جستجوی محصول، سایز یا کارخانه..."
            />
            <kbd>Ctrl K</kbd>
          </div>

          <div class="factory-filter">
            <span class="select-label">انتخاب کارخانه</span>
            <select id="factoryFilter">
              <option value="all">همه کارخانه‌ها</option>
            </select>
            <span class="select-arrow">⌄</span>
          </div>
        </div>

        <!-- CATEGORY FILTER -->
        <div class="category-wrapper">
          <div class="category-title">
            <span class="category-title-line"></span>
            دسته‌بندی محصولات
          </div>

          <div class="categories" id="categories">
            {categories.map((category, index) => (
              <button
                class:list={["category-btn", { active: index === 0 }]}
                data-category={category.id}
              >
                {category.title}
                {index === 0 && (
                  <span class="category-count" id="productCount">۰</span>
                )}
              </button>
            ))}
          </div>
        </div>

        <!-- TABLE -->
        <div class="table-card" id="price-table">
          <div class="table-header">
            <div class="table-heading">
              <div class="heading-icon">
                <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M4 19V5"></path>
                  <path d="M4 19h16"></path>
                  <path d="m7 15 3-4 3 2 5-7"></path>
                </svg>
              </div>
              <div>
                <div class="heading-kicker">
                  <span></span>
                  بازار فولاد
                </div>
                <h2>قیمت روز محصولات</h2>
                <p>آخرین قیمت‌های ثبت‌شده در بازار</p>
              </div>
            </div>

            <div class="table-status">
              <span class="status-live-dot"></span>
              <div>
                <small>وضعیت</small>
                <strong>بروزرسانی فعال</strong>
              </div>
            </div>
          </div>

          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th>محصول</th>
                  <th>کارخانه</th>
                  <th>مشخصات</th>
                  <th>قیمت</th>
                  <th>روند بازار</th>
                  <th>محل تحویل</th>
                  <th>عملیات</th>
                </tr>
              </thead>

              <tbody id="productRows">
                <tr>
                  <td colspan="7" style="text-align:center;padding:40px;color:#94a3b8">
                    در حال دریافت قیمت‌ها...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- EMPTY -->
          <div id="emptyState" class="empty-state hidden">
            <div class="empty-icon">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m20 20-3.5-3.5"></path>
              </svg>
            </div>
            <h3>محصولی پیدا نشد</h3>
            <p>عبارت جستجو یا فیلتر کارخانه را تغییر دهید.</p>
          </div>

          <!-- TABLE FOOTER -->
          <div class="table-footer">
            <div class="footer-info">
              <span class="footer-live"></span>
              قیمت‌ها به صورت دوره‌ای بروزرسانی می‌شوند.
            </div>
            <span class="unit-footer">واحد قیمت: تومان / کیلوگرم</span>
          </div>
        </div>

        <!-- NOTE -->
        <div class="price-note">
          <div class="note-icon">!</div>
          <div class="note-content">
            <strong>درباره قیمت‌های نمایش داده شده</strong>
            <p>
              قیمت نهایی پس از استعلام و تأیید واحد فروش اعلام خواهد شد.
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- TOAST -->
    <div id="quoteToast" class="quote-toast">
      <div class="toast-check">✓</div>
      <div class="toast-content">
        <strong>درخواست استعلام ثبت شد</strong>
        <span id="toastProduct"></span>
      </div>
      <button class="toast-close" aria-label="بستن">×</button>
    </div>

  </main>

  <script>
    import { supabase } from "../lib/supabase";

    type Spec = { label: string; value: string };
    type Dir = "up" | "down" | "same";
    type Product = {
      id: number | string;
      name: string;
      category: string;
      factory?: string | null;
      price?: number | string | null;
      previous_price?: number | string | null; // اختیاری، اگر در جدول باشد استفاده می‌شود
      price_on_request?: boolean;
      price_updated_at?: string | null;
      updated_at?: string | null;
      delivery?: string | null;
      type?: string | null;
      size?: string | null;
      active?: boolean;
      specifications?: Spec[] | null;
    };
    type Memory = Record<string, { last: number; prev: number | null; at: string | null }>;

    // ---------- elements ----------
    const searchInput = document.getElementById("productSearch") as HTMLInputElement;
    const factoryFilter = document.getElementById("factoryFilter") as HTMLSelectElement;
    const rowsEl = document.getElementById("productRows") as HTMLElement;
    const countEl = document.getElementById("productCount");
    const emptyState = document.getElementById("emptyState");
    const lastUpdateEl = document.getElementById("lastUpdate");
    const heroName = document.getElementById("heroName");
    const heroPrice = document.getElementById("heroPrice");
    const heroTrend = document.getElementById("heroTrend");
    const categoryButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".category-btn")
    );

    const categoryNames: Record<string, string> = {
      rebar: "میلگرد",
      beam: "تیرآهن",
      sheet: "ورق",
      profile: "پروفیل",
      angle: "نبشی و ناودانی",
      pipe: "لوله",
      billet: "شمش فولادی",
      alloy: "فولاد آلیاژی",
      other: "سایر محصولات",
    };

    const categoryIcons: Record<string, string> = {
      rebar: "میل",
      beam: "تیر",
      sheet: "ورق",
      profile: "پروف",
      angle: "نبش",
      pipe: "لوله",
      billet: "شمش",
      alloy: "آلیاژ",
      other: "سایر",
    };

    // ---------- URL params ----------
    const params = new URLSearchParams(window.location.search);
    let selectedCategory = params.get("category") || "all";
    const urlType = params.get("type") || "";
    const urlSize = params.get("size") || "";
    const urlFactory = params.get("factory") || "";

    let allProducts: Product[] = [];

    // ---------- helpers ----------
    function escapeHtml(value: unknown): string {
      return String(value ?? "").replace(/[&<>"']/g, (c) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] as string)
      );
    }

    // یکسان‌سازی متن برای جستجو و فیلتر (ارقام فارسی/عربی و ی/ک)
    const norm = (v: unknown) =>
      String(v ?? "")
        .trim()
        .toLowerCase()
        .replace(/[۰-۹]/g, (d) => String("۰۱۲۳۴۵۶۷۸۹".indexOf(d)))
        .replace(/[٠-٩]/g, (d) => String("٠١٢٣٤٥٦٧٨٩".indexOf(d)))
        .replace(/ي/g, "ی")
        .replace(/ك/g, "ک");

    const fa = (n: number, digits = 0) =>
      new Intl.NumberFormat("fa-IR", { maximumFractionDigits: digits }).format(n);

    function getSpec(p: Product, labels: string[]): string {
      const specs = Array.isArray(p.specifications) ? p.specifications : [];
      const found = specs.find((s) => labels.some((l) => s.label?.includes(l)));
      return found?.value ?? "";
    }

    function hasPrice(p: Product): boolean {
      const price = Number(p.price);
      return p.price_on_request !== true && Number.isFinite(price) && price > 0;
    }

    // ---------- تشخیص افزایش/کاهش قیمت (بدون تغییر در دیتابیس) ----------
    // آخرین قیمتِ دیده‌شده برای هر محصول در مرورگر ذخیره می‌شود.
    // هر بار که قیمت جدید از Supabase می‌آید، با قیمت قبلی مقایسه و روند ثبت می‌شود.
    const MEM_KEY = "asin_price_memory_v1";

    function readMemory(): Memory {
      try {
        return JSON.parse(localStorage.getItem(MEM_KEY) || "{}") as Memory;
      } catch {
        return {};
      }
    }

    function writeMemory() {
      try {
        localStorage.setItem(MEM_KEY, JSON.stringify(memory));
      } catch {
        /* حافظه مرورگر در دسترس نیست؛ فقط در همین نشست کار می‌کند */
      }
    }

    let memory: Memory = readMemory();
    const changedNow = new Set<string>();

    function syncMemory(products: Product[]) {
      const now = new Date().toISOString();
      changedNow.clear();

      products.forEach((p) => {
        if (!hasPrice(p)) return;
        const id = String(p.id);
        const price = Number(p.price);
        const saved = memory[id];

        if (!saved) {
          memory[id] = { last: price, prev: null, at: null };
        } else if (saved.last !== price) {
          memory[id] = { last: price, prev: saved.last, at: now };
          changedNow.add(id);
        }
      });

      writeMemory();
    }

    function getTrend(p: Product): { dir: Dir; percent: number } {
      if (!hasPrice(p)) return { dir: "same", percent: 0 };

      const cur = Number(p.price);
      let prev = Number(p.previous_price);

      if (!(Number.isFinite(prev) && prev > 0 && prev !== cur)) {
        const saved = memory[String(p.id)]?.prev;
        prev = saved == null ? NaN : saved;
      }

      if (!Number.isFinite(prev) || prev <= 0 || prev === cur) {
        return { dir: "same", percent: 0 };
      }

      return {
        dir: cur > prev ? "up" : "down",
        percent: Math.abs(((cur - prev) / prev) * 100),
      };
    }

    function trendHtml(p: Product) {
      if (!hasPrice(p)) return `<span class="trend trend-same">—</span>`;

      const { dir, percent } = getTrend(p);
      const pct = percent ? ` <small>${fa(percent, 1)}٪</small>` : "";

      if (dir === "up")
        return `<span class="trend trend-up"><span class="trend-arrow">↗</span>افزایشی${pct}</span>`;
      if (dir === "down")
        return `<span class="trend trend-down"><span class="trend-arrow">↘</span>کاهشی${pct}</span>`;
      return `<span class="trend trend-same"><span class="trend-arrow">→</span>ثابت</span>`;
    }

    function priceHtml(p: Product) {
      if (!hasPrice(p)) {
        return `<div class="price-box"><strong style="font-size:14px">استعلام قیمت</strong></div>`;
      }
      return `<div class="price-box"><strong>${fa(Number(p.price))}</strong><span>تومان</span></div>`;
    }

    // ---------- render ----------
    function renderRows() {
      rowsEl.innerHTML = allProducts
        .map((p) => {
          const name = escapeHtml(p.name);
          const factory = escapeHtml(p.factory || "—");
          const unit = escapeHtml(getSpec(p, ["واحد"]) || "—");
          const weight = getSpec(p, ["وزن"]);
          const delivery = escapeHtml(p.delivery || getSpec(p, ["تحویل"]) || "—");
          const type = p.type || getSpec(p, ["نوع"]);
          const size = p.size || getSpec(p, ["سایز", "اندازه"]);
          const catName = categoryNames[p.category] || "سایر محصولات";
          const icon = categoryIcons[p.category] ?? "فول";
          const search = norm(`${p.name} ${p.factory ?? ""} ${type} ${size} ${catName}`);

          return `
          <tr
            data-id="${escapeHtml(p.id)}"
            data-category="${escapeHtml(p.category)}"
            data-type="${escapeHtml(type)}"
            data-size="${escapeHtml(size)}"
            data-factory="${escapeHtml(p.factory || "")}"
            data-name="${name}"
            data-search="${escapeHtml(search)}"
          >
            <td>
              <div class="product-name">
                <div class="product-icon icon-${escapeHtml(p.category)}">${icon}</div>
                <div class="product-title">
                  <strong>${name}</strong>
                  <small>${escapeHtml(catName)}</small>
                </div>
              </div>
            </td>
            <td>
              <div class="factory-name">
                <span class="factory-logo"><span></span></span>
                ${factory}
              </div>
            </td>
            <td>
              <div class="unit-info">
                <strong>${unit}</strong>
                ${weight ? `<span>وزن تقریبی: ${escapeHtml(weight)}</span>` : ""}
              </div>
            </td>
            <td>${priceHtml(p)}</td>
            <td>${trendHtml(p)}</td>
            <td>
              <div class="delivery"><span class="delivery-pin">●</span>${delivery}</div>
            </td>
            <td>
              <button class="quote-btn" data-product="${name}">
                <span>استعلام قیمت</span><b>←</b>
              </button>
            </td>
          </tr>`;
        })
        .join("");

      // چشمک زدن ردیف‌هایی که همین الان قیمتشان تغییر کرده
      changedNow.forEach((id) => {
        const p = allProducts.find((x) => String(x.id) === id);
        const row = rowsEl.querySelector(`tr[data-id="${CSS.escape(id)}"]`);
        if (!p || !row) return;
        const { dir } = getTrend(p);
        if (dir !== "same") row.classList.add(dir === "up" ? "flash-up" : "flash-down");
      });

      if (countEl) countEl.textContent = fa(allProducts.length);
      updateTable();
    }

    function fillFactories() {
      const factories = Array.from(
        new Set(allProducts.map((p) => p.factory).filter(Boolean) as string[])
      );
      const current = factoryFilter.value !== "all" ? factoryFilter.value : urlFactory || "all";
      factoryFilter.innerHTML =
        `<option value="all">همه کارخانه‌ها</option>` +
        factories
          .map((f) => `<option value="${escapeHtml(f)}">${escapeHtml(f)}</option>`)
          .join("");
      factoryFilter.value = factories.includes(current) ? current : "all";
    }

    function setLastUpdate() {
      if (!lastUpdateEl) return;

      const times = allProducts
        .map((p) => p.price_updated_at || p.updated_at)
        .filter(Boolean)
        .map((d) => new Date(d as string).getTime())
        .filter((t) => Number.isFinite(t));

      const changes = Object.values(memory).map((m) => (m.at ? new Date(m.at).getTime() : 0));

      const t = times.length ? Math.max(...times) : Math.max(0, ...changes) || Date.now();

      lastUpdateEl.textContent = new Intl.DateTimeFormat("fa-IR", {
        dateStyle: "medium",
        timeStyle: "short",
      }).format(new Date(t));
    }

    function setHero() {
      if (!heroName || !heroPrice || !heroTrend) return;

      const priced = allProducts.filter(hasPrice);
      if (!priced.length) return;

      // محصولی که آخرین تغییر قیمت را داشته؛ اگر نبود، اولین محصول
      const changedAt = (p: Product) => memory[String(p.id)]?.at || "";
      const pick = [...priced].sort((a, b) => changedAt(b).localeCompare(changedAt(a)))[0];
      const { dir, percent } = getTrend(pick);

      heroName.textContent = pick.name;
      heroPrice.textContent = fa(Number(pick.price));
      heroTrend.className = `up-small is-${dir}`;
      heroTrend.textContent =
        dir === "same" ? "● ثابت" : `${dir === "up" ? "▲" : "▼"} ${fa(percent, 1)}٪`;
    }

    // ---------- filter ----------
    function updateTable() {
      const search = norm(searchInput.value);
      const factory = factoryFilter.value;
      const type = norm(urlType);
      const size = norm(urlSize);
      let visible = 0;

      Array.from(rowsEl.querySelectorAll<HTMLTableRowElement>("tr[data-name]")).forEach(
        (row) => {
          const d = row.dataset;
          const hay = d.search ?? "";

          const typeMatch = !type || norm(d.type) === type || hay.includes(type);
          const sizeMatch =
            !size ||
            norm(d.size) === size ||
            hay.split(/[\s×x*\-/]+/).includes(size);

          const show =
            (selectedCategory === "all" || d.category === selectedCategory) &&
            typeMatch &&
            sizeMatch &&
            (factory === "all" || d.factory === factory) &&
            (!search || hay.includes(search));

          row.style.display = show ? "" : "none";
          if (show) visible++;
        }
      );

      emptyState?.classList.toggle("hidden", visible !== 0);
    }

    function setActiveCategory(id: string) {
      selectedCategory = id;
      categoryButtons.forEach((b) =>
        b.classList.toggle("active", b.dataset.category === id)
      );
    }

    // ---------- load ----------
    let lastRaw = "";
    let loading = false;

    async function loadProducts() {
      if (loading) return;
      loading = true;

      try {
        const { data, error } = await supabase
          .from("products")
          .select("*")
          .eq("active", true)
          .order("category", { ascending: true })
          .order("name", { ascending: true });

        if (error) {
          console.error("خطا در دریافت قیمت‌ها:", error);
          if (!allProducts.length) {
            rowsEl.innerHTML = `<tr><td colspan="7" style="text-align:center;padding:40px;color:#b91c1c">
              دریافت قیمت‌ها با خطا مواجه شد. لطفاً کمی بعد دوباره تلاش کنید.</td></tr>`;
          }
          return;
        }

        // اگر چیزی تغییر نکرده، دوباره رندر نکن
        const raw = JSON.stringify(data ?? []);
        if (raw === lastRaw) return;
        lastRaw = raw;

        allProducts = (data ?? []) as Product[];
        syncMemory(allProducts);
        fillFactories();
        setLastUpdate();
        setHero();
        renderRows();
      } finally {
        loading = false;
      }
    }

    // ---------- events ----------
    searchInput.addEventListener("input", updateTable);
    factoryFilter.addEventListener("change", updateTable);

    categoryButtons.forEach((btn) =>
      btn.addEventListener("click", () => {
        setActiveCategory(btn.dataset.category || "all");
        updateTable();
      })
    );

    // Toast (ردیف‌ها داینامیک هستند، پس از event delegation استفاده شده)
    const toast = document.getElementById("quoteToast") as HTMLElement;
    const toastProduct = document.getElementById("toastProduct") as HTMLElement;
    const toastClose = document.querySelector(".toast-close") as HTMLElement;
    let toastTimer: number | undefined;

    rowsEl.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".quote-btn");
      if (!btn) return;
      toastProduct.textContent = `محصول «${btn.dataset.product}»`;
      toast.classList.add("show");
      clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => toast.classList.remove("show"), 4000);
    });

    toastClose.addEventListener("click", () => toast.classList.remove("show"));

    document.addEventListener("keydown", (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        searchInput.focus();
      }
    });

    // ---------- init ----------
    setActiveCategory(selectedCategory);
    loadProducts();

    // بروزرسانی زنده ۱: اگر Realtime فعال باشد، با هر تغییر جدول فوراً بروز می‌شود
    let realtimeTimer: number | undefined;
    supabase
      .channel("price-page-products")
      .on("postgres_changes", { event: "*", schema: "public", table: "products" }, () => {
        clearTimeout(realtimeTimer);
        realtimeTimer = window.setTimeout(loadProducts, 400);
      })
      .subscribe();

    // بروزرسانی زنده ۲: اگر Realtime فعال نباشد هم، هر ۳۰ ثانیه خودکار چک می‌شود
    setInterval(() => {
      if (!document.hidden) loadProducts();
    }, 30000);

    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) loadProducts();
    });
  </script>

