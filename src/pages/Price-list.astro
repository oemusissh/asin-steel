---
import BaseLayout from "../layouts/BaseLayout.astro";

const products = [
  {
    name: "میلگرد ۱۴ آجدار A3",
    category: "rebar",
    categoryName: "میلگرد",
    factory: "ذوب آهن اصفهان",
    unit: "شاخه ۱۲ متری",
    weight: "۱۴.۵ کیلوگرم",
    price: 32400,
    change: "up",
    delivery: "انبار تهران / کارخانه",
  },
  {
    name: "میلگرد ۱۶ آجدار A3",
    category: "rebar",
    categoryName: "میلگرد",
    factory: "ذوب آهن اصفهان",
    unit: "شاخه ۱۲ متری",
    weight: "۱۹ کیلوگرم",
    price: 32200,
    change: "same",
    delivery: "انبار تهران / کارخانه",
  },
  {
    name: "میلگرد ۱۸ آجدار A3",
    category: "rebar",
    categoryName: "میلگرد",
    factory: "فولاد کویر یزد",
    unit: "شاخه ۱۲ متری",
    weight: "۲۴ کیلوگرم",
    price: 31800,
    change: "down",
    delivery: "درب کارخانه",
  },
  {
    name: "تیرآهن ۱۴ IPE",
    category: "beam",
    categoryName: "تیرآهن",
    factory: "ذوب آهن اصفهان",
    unit: "شاخه ۱۲ متری",
    weight: "۱۵۵ کیلوگرم",
    price: 37200,
    change: "same",
    delivery: "انبار تهران",
  },
  {
    name: "تیرآهن ۱۶ IPE",
    category: "beam",
    categoryName: "تیرآهن",
    factory: "ذوب آهن اصفهان",
    unit: "شاخه ۱۲ متری",
    weight: "۱۹۰ کیلوگرم",
    price: 38500,
    change: "up",
    delivery: "انبار تهران",
  },
  {
    name: "ورق سیاه ۲ میل",
    category: "sheet",
    categoryName: "ورق",
    factory: "فولاد مبارکه",
    unit: "شیت ۱×۲ متر",
    weight: "۳۱.۴ کیلوگرم",
    price: 38200,
    change: "up",
    delivery: "انبار اصفهان",
  },
  {
    name: "ورق گالوانیزه ۱.۵ میل",
    category: "sheet",
    categoryName: "ورق",
    factory: "فولاد مبارکه",
    unit: "رول",
    weight: "۵۰ کیلوگرم",
    price: 44500,
    change: "down",
    delivery: "انبار تهران",
  },
  {
    name: "قوطی ۴۰×۴۰ ضخامت ۲ میل",
    category: "profile",
    categoryName: "قوطی و پروفیل",
    factory: "فولاد فایکو",
    unit: "شاخه ۶ متری",
    weight: "۱۴.۸ کیلوگرم",
    price: 39100,
    change: "same",
    delivery: "انبار تهران",
  },
  {
    name: "نبشی ۵×۵×۵",
    category: "angle",
    categoryName: "نبشی و ناودانی",
    factory: "فولاد ناب تبریز",
    unit: "شاخه ۶ متری",
    weight: "۲۲.۵ کیلوگرم",
    price: 35600,
    change: "up",
    delivery: "درب کارخانه",
  },
];

const categories = [
  { id: "all", title: "همه محصولات" },
  { id: "rebar", title: "میلگرد" },
  { id: "beam", title: "تیرآهن" },
  { id: "sheet", title: "ورق" },
  { id: "profile", title: "قوطی و پروفیل" },
  { id: "angle", title: "نبشی و ناودانی" },
];
---

<BaseLayout
  title="قیمت روز آهن و فولاد | ASIN STILL"
  description="جدول قیمت روز مقاطع فولادی، میلگرد، تیرآهن، ورق، پروفیل، نبشی و ناودانی"
>
  <main class="price-page" dir="rtl">

    <!-- HERO -->
    <section class="price-hero">
      <div class="hero-grid"></div>
      <div class="hero-glow"></div>

      <div class="container hero-container">

        <div class="hero-content">

          <div class="hero-topline">
            <span class="status-dot"></span>
            <span>مرکز استعلام قیمت فولاد</span>
          </div>

          <h1>
            قیمت روز
            <span>مقاطع فولادی</span>
          </h1>

          <p>
            بررسی قیمت میلگرد، تیرآهن، ورق، پروفیل و سایر مقاطع
            فولادی از کارخانه‌های معتبر کشور.
          </p>

          <div class="hero-info">

            <div class="info-item">
              <span class="info-label">آخرین بروزرسانی</span>
              <strong>امروز، ۱۲:۳۰</strong>
            </div>

            <div class="info-divider"></div>

            <div class="info-item">
              <span class="info-label">واحد قیمت</span>
              <strong>تومان / کیلوگرم</strong>
            </div>

            <div class="info-divider"></div>

            <div class="info-item">
              <span class="info-label">وضعیت بازار</span>
              <strong class="market-status">
                <span></span>
                فعال
              </strong>
            </div>

          </div>

        </div>

        <div class="hero-visual">
          <div class="visual-ring ring-one"></div>
          <div class="visual-ring ring-two"></div>
          <div class="visual-ring ring-three"></div>

          <div class="visual-center">
            <span>ASIN</span>
            <strong>STILL</strong>
          </div>

          <div class="visual-line line-one"></div>
          <div class="visual-line line-two"></div>
        </div>

      </div>
    </section>


    <!-- MAIN -->
    <section class="price-section">
      <div class="container">

        <!-- FILTER BOX -->
        <div class="filters-card">

          <div class="search-box">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>

            <input
              id="productSearch"
              type="text"
              placeholder="جستجوی محصول، سایز یا کارخانه..."
            />
          </div>

          <div class="factory-box">

            <span class="filter-label">کارخانه</span>

            <select id="factoryFilter">
              <option value="all">همه کارخانه‌ها</option>
              <option value="ذوب آهن اصفهان">ذوب آهن اصفهان</option>
              <option value="فولاد مبارکه">فولاد مبارکه</option>
              <option value="فولاد فایکو">فولاد فایکو</option>
              <option value="فولاد کویر یزد">فولاد کویر یزد</option>
              <option value="فولاد ناب تبریز">فولاد ناب تبریز</option>
            </select>

          </div>

        </div>


        <!-- CATEGORIES -->
        <div class="categories" id="categories">

          {categories.map((category, index) => (
            <button
              class:list={[
                "category-btn",
                { active: index === 0 },
              ]}
              data-category={category.id}
            >
              {category.title}
            </button>
          ))}

        </div>


        <!-- TABLE -->
        <div class="table-card">

          <div class="table-header">

            <div>
              <div class="section-kicker">
                <span></span>
                لیست قیمت
              </div>

              <h2>قیمت روز محصولات فولادی</h2>

              <p>
                <strong id="productCount">۹</strong>
                محصول در جدول نمایش داده می‌شود
              </p>
            </div>

            <div class="live-badge">
              <span></span>
              بروزرسانی آنلاین
            </div>

          </div>


          <div class="table-scroll">

            <table>

              <thead>
                <tr>
                  <th>محصول</th>
                  <th>کارخانه</th>
                  <th>مشخصات</th>
                  <th>قیمت</th>
                  <th>روند</th>
                  <th>تحویل</th>
                  <th>استعلام</th>
                </tr>
              </thead>

              <tbody id="productRows">

                {products.map((product) => (
                  <tr
                    data-category={product.category}
                    data-factory={product.factory}
                    data-name={product.name}
                  >

                    <td>
                      <div class="product-name">

                        <div class={`product-icon icon-${product.category}`}>
                          {product.category === "rebar" && "میل"}
                          {product.category === "beam" && "تیر"}
                          {product.category === "sheet" && "ورق"}
                          {product.category === "profile" && "پروف"}
                          {product.category === "angle" && "نبش"}
                        </div>

                        <div class="product-title">
                          <strong>{product.name}</strong>
                          <small>{product.categoryName}</small>
                        </div>

                      </div>
                    </td>


                    <td>
                      <div class="factory-name">
                        <span class="factory-mark"></span>
                        {product.factory}
                      </div>
                    </td>


                    <td>
                      <div class="unit-info">
                        <strong>{product.unit}</strong>
                        <span>{product.weight}</span>
                      </div>
                    </td>


                    <td>
                      <div class="price-box">
                        <strong>
                          {product.price.toLocaleString("fa-IR")}
                        </strong>
                        <span>تومان</span>
                      </div>
                    </td>


                    <td>

                      {product.change === "up" && (
                        <span class="trend trend-up">
                          <span>↑</span>
                          افزایشی
                        </span>
                      )}

                      {product.change === "down" && (
                        <span class="trend trend-down">
                          <span>↓</span>
                          کاهشی
                        </span>
                      )}

                      {product.change === "same" && (
                        <span class="trend trend-same">
                          <span>—</span>
                          ثابت
                        </span>
                      )}

                    </td>


                    <td>
                      <span class="delivery">
                        {product.delivery}
                      </span>
                    </td>


                    <td>
                      <button
                        class="quote-btn"
                        data-product={product.name}
                      >
                        استعلام
                        <span>←</span>
                      </button>
                    </td>

                  </tr>
                ))}

              </tbody>

            </table>

          </div>


          <!-- EMPTY -->
          <div id="emptyState" class="empty-state hidden">

            <div class="empty-icon">
              <svg
                width="25"
                height="25"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
              >
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m20 20-3.5-3.5"></path>
              </svg>
            </div>

            <h3>محصولی پیدا نشد</h3>

            <p>
              عبارت جستجو یا فیلتر کارخانه را تغییر دهید.
            </p>

          </div>

        </div>


        <!-- NOTE -->
        <div class="price-note">

          <div class="note-icon">!</div>

          <div>
            <strong>توجه درباره قیمت‌ها</strong>

            <p>
              قیمت‌های نمایش داده شده در این نسخه جهت نمونه و نمایش
              ساختار جدول هستند. قیمت نهایی پس از استعلام و تأیید
              واحد فروش اعلام خواهد شد.
            </p>
          </div>

        </div>

      </div>
    </section>

  </main>


  <!-- TOAST -->
  <div id="quoteToast" class="quote-toast">

    <div class="toast-check">✓</div>

    <div>
      <strong>درخواست استعلام</strong>
      <span id="toastProduct"></span>
    </div>

  </div>


  <script>
    const searchInput =
      document.getElementById("productSearch");

    const factoryFilter =
      document.getElementById("factoryFilter");

    const rows =
      Array.from(
        document.querySelectorAll("#productRows tr")
      );

    const categoryButtons =
      Array.from(
        document.querySelectorAll(".category-btn")
      );

    const count =
      document.getElementById("productCount");

    const emptyState =
      document.getElementById("emptyState");

    let selectedCategory = "all";


    function updateTable() {

      const search =
        searchInput.value.trim().toLowerCase();

      const factory =
        factoryFilter.value;

      let visible = 0;


      rows.forEach((row) => {

        const category =
          row.dataset.category;

        const rowFactory =
          row.dataset.factory;

        const name =
          row.dataset.name.toLowerCase();


        const categoryMatch =
          selectedCategory === "all" ||
          category === selectedCategory;


        const factoryMatch =
          factory === "all" ||
          rowFactory === factory;


        const searchMatch =
          !search ||
          name.includes(search) ||
          rowFactory.toLowerCase().includes(search);


        const show =
          categoryMatch &&
          factoryMatch &&
          searchMatch;


        row.style.display =
          show ? "" : "none";


        if (show) visible++;

      });


      count.textContent =
        visible.toLocaleString("fa-IR");


      emptyState.classList.toggle(
        "hidden",
        visible !== 0
      );

    }


    searchInput.addEventListener(
      "input",
      updateTable
    );


    factoryFilter.addEventListener(
      "change",
      updateTable
    );


    categoryButtons.forEach((button) => {

      button.addEventListener(
        "click",
        () => {

          categoryButtons.forEach((item) =>
            item.classList.remove("active")
          );

          button.classList.add("active");

          selectedCategory =
            button.dataset.category;

          updateTable();

        }
      );

    });


    document
      .querySelectorAll(".quote-btn")
      .forEach((button) => {

        button.addEventListener(
          "click",
          () => {

            const product =
              button.dataset.product;

            document.getElementById(
              "toastProduct"
            ).textContent =
              `محصول «${product}»`;


            const toast =
              document.getElementById(
                "quoteToast"
              );


            toast.classList.add("show");


            setTimeout(() => {
              toast.classList.remove("show");
            }, 3000);

          }
        );

      });
  </script>


  <style>

    /* =========================
       BASE
    ========================= */

    .price-page {
      direction: rtl;
      min-height: 100vh;
      background: #f5f7fa;
      color: #0b1220;
      font-family: inherit;
    }

    .price-page *,
    .price-page *::before,
    .price-page *::after {
      box-sizing: border-box;
    }

    .container {
      width: min(1380px, calc(100% - 36px));
      margin-inline: auto;
    }


    /* =========================
       HERO
    ========================= */

    .price-hero {
      position: relative;
      overflow: hidden;
      min-height: 390px;
      color: white;
      background:
        radial-gradient(
          circle at 15% 20%,
          rgba(37, 99, 235, .16),
          transparent 30%
        ),
        linear-gradient(
          135deg,
          #050b14 0%,
          #091522 48%,
          #0d1c2d 100%
        );
    }

    .hero-container {
      position: relative;
      min-height: 390px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .hero-grid {
      position: absolute;
      inset: 0;
      opacity: .12;
      background-image:
        linear-gradient(
          rgba(148,163,184,.15) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(148,163,184,.15) 1px,
          transparent 1px
        );
      background-size: 50px 50px;
      mask-image: linear-gradient(
        to left,
        black,
        transparent 75%
      );
    }

    .hero-glow {
      position: absolute;
      width: 500px;
      height: 500px;
      left: -180px;
      top: -150px;
      border-radius: 50%;
      background: rgba(37,99,235,.08);
      filter: blur(70px);
    }

    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 720px;
      padding: 70px 0;
    }

    .hero-topline {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 9px 14px;
      border: 1px solid rgba(148,163,184,.16);
      border-radius: 8px;
      background: rgba(15,23,42,.45);
      color: #a8b5c6;
      font-size: 13px;
      font-weight: 500;
      line-height: 1.7;
      margin-bottom: 24px;
    }

    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #22c55e;
      box-shadow: 0 0 14px rgba(34,197,94,.8);
    }

    .price-hero h1 {
      margin: 0;
      font-size: clamp(40px, 5vw, 64px);
      line-height: 1.3;
      letter-spacing: 0;
      font-weight: 800;
    }

    .price-hero h1 span {
      display: block;
      margin-top: 5px;
      color: #60a5fa;
    }

    .price-hero p {
      max-width: 620px;
      margin: 22px 0 0;
      color: #93a4b8;
      font-size: 16px;
      font-weight: 400;
      line-height: 2.1;
    }

    .hero-info {
      display: flex;
      align-items: center;
      gap: 24px;
      margin-top: 35px;
    }

    .info-item {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .info-label {
      color: #64748b;
      font-size: 11px;
      font-weight: 400;
      line-height: 1.7;
    }

    .info-item strong {
      color: #dbe4ef;
      font-size: 14px;
      font-weight: 600;
      line-height: 1.8;
    }

    .info-divider {
      width: 1px;
      height: 35px;
      background: #26384c;
    }

    .market-status {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .market-status span {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #22c55e;
    }


    /* HERO VISUAL */

    .hero-visual {
      position: relative;
      width: 440px;
      height: 440px;
      flex-shrink: 0;
      opacity: .72;
    }

    .visual-ring {
      position: absolute;
      border: 1px solid rgba(148,163,184,.17);
      border-radius: 50%;
    }

    .ring-one {
      width: 420px;
      height: 420px;
      top: 10px;
      left: 10px;
    }

    .ring-two {
      width: 300px;
      height: 300px;
      top: 70px;
      left: 70px;
      border-color: rgba(96,165,250,.2);
    }

    .ring-three {
      width: 175px;
      height: 175px;
      top: 132px;
      left: 132px;
      border-color: rgba(96,165,250,.28);
    }

    .visual-center {
      position: absolute;
      top: 165px;
      left: 165px;
      width: 110px;
      height: 110px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      border: 1px solid rgba(96,165,250,.35);
      border-radius: 50%;
      background: rgba(8,18,31,.8);
      box-shadow:
        0 0 50px rgba(37,99,235,.1),
        inset 0 0 30px rgba(37,99,235,.05);
    }

    .visual-center span {
      color: #94a3b8;
      font-size: 12px;
      letter-spacing: 2px;
    }

    .visual-center strong {
      color: #60a5fa;
      font-size: 18px;
      letter-spacing: 3px;
    }

    .visual-line {
      position: absolute;
      height: 1px;
      background: linear-gradient(
        to left,
        transparent,
        #475569,
        transparent
      );
    }

    .line-one {
      width: 560px;
      top: 220px;
      left: -60px;
      transform: rotate(32deg);
    }

    .line-two {
      width: 560px;
      top: 220px;
      left: -60px;
      transform: rotate(-32deg);
    }


    /* =========================
       MAIN
    ========================= */

    .price-section {
      padding: 55px 0 85px;
    }


    /* =========================
       FILTERS
    ========================= */

    .filters-card {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: 12px;
      padding: 10px;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      background: white;
      box-shadow:
        0 10px 35px rgba(15,23,42,.045);
    }

    .search-box,
    .factory-box {
      position: relative;
    }

    .search-box svg {
      position: absolute;
      right: 17px;
      top: 50%;
      transform: translateY(-50%);
      color: #64748b;
      pointer-events: none;
    }

    .search-box input,
    .factory-box select {
      width: 100%;
      height: 56px;
      border: 1px solid #e2e8f0;
      border-radius: 11px;
      outline: none;
      background: #f8fafc;
      color: #0f172a;
      font-family: inherit;
      font-size: 14px;
      font-weight: 400;
      transition: .2s;
    }

    .search-box input {
      padding: 0 52px 0 18px;
    }

    .factory-box select {
      padding: 0 15px;
    }

    .search-box input:focus,
    .factory-box select:focus {
      border-color: #2563eb;
      background: white;
      box-shadow:
        0 0 0 3px rgba(37,99,235,.08);
    }

    .filter-label {
      display: none;
    }


    /* =========================
       CATEGORIES
    ========================= */

    .categories {
      display: flex;
      gap: 8px;
      padding: 18px 0;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .categories::-webkit-scrollbar {
      display: none;
    }

    .category-btn {
      height: 44px;
      padding: 0 19px;
      flex-shrink: 0;
      border: 1px solid #e2e8f0;
      border-radius: 9px;
      background: white;
      color: #64748b;
      font-family: inherit;
      font-size: 13px;
      font-weight: 600;
      line-height: 1.7;
      cursor: pointer;
      transition: .2s;
    }

    .category-btn:hover {
      border-color: #94a3b8;
      color: #0f2744;
    }

    .category-btn.active {
      border-color: #102a43;
      background: #102a43;
      color: white;
      box-shadow:
        0 7px 20px rgba(15,39,68,.16);
    }


    /* =========================
       TABLE CARD
    ========================= */

    .table-card {
      overflow: hidden;
      border: 1px solid #e1e7ef;
      border-radius: 18px;
      background: white;
      box-shadow:
