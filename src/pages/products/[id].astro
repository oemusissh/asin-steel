              ))}

              <div class="article-subheading">
                <span></span>
                کاربردهای رایج
              </div>

              <ul class="application-list">
                {description.applications.map((item: string) => (
                  <li>
                    <span class="list-check">✓</span>
                    {item}
                  </li>
                ))}
              </ul>

              <div class="article-subheading">
                <span></span>
                نکات مهم پیش از خرید
              </div>

              <ul class="consideration-list">
                {description.considerations.map((item: string) => (
                  <li>{item}</li>
                ))}
              </ul>

              <div class="source-box">
                <div class="source-icon">i</div>
                <div>
                  <strong>منبع برای مطالعه بیشتر</strong>
                  <p>
                    برای آشنایی عمومی با موضوع این محصول می‌توانید مقاله مرتبط را مطالعه کنید.
                    اطلاعات نهایی خرید باید با استاندارد و مشخصات فنی محموله تطبیق داده شود.
                  </p>
                  <a
                    href={description.sourceUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {description.sourceTitle}
                    <span>↗</span>
                  </a>
                </div>
              </div>
            </div>

            <div class="description-fade" id="description-fade"></div>

            <button
              class="expand-description"
              id="toggle-description"
              type="button"
              aria-expanded="false"
              aria-controls="full-description"
            >
              <span id="toggle-description-text">مشاهده همه توضیحات</span>
              <span class="expand-icon" id="toggle-description-icon">⌄</span>
            </button>
          </article>

          <aside class="knowledge-sidebar">
            <div class="sidebar-card sidebar-highlight">
              <div class="sidebar-symbol">AS</div>
              <span class="sidebar-kicker">ASIN STILL</span>
              <h3>انتخاب آگاهانه، خرید مطمئن</h3>
              <p>
                پیش از ثبت سفارش، مشخصات محصول و نیاز پروژه خود را بررسی کنید.
                برای تطبیق مشخصات و دریافت اطلاعات تأمین با ما در ارتباط باشید.
              </p>
              <a href={`${base}contact/`}>
                ارتباط با کارشناسان
                <span>←</span>
              </a>
            </div>

            <div class="sidebar-card">
              <h3>چک‌لیست سفارش</h3>
              <ul class="checklist">
                <li><span>01</span> تعیین نوع و مشخصات مقطع</li>
                <li><span>02</span> مشخص‌کردن تناژ موردنیاز</li>
                <li><span>03</span> بررسی کارخانه و استاندارد</li>
                <li><span>04</span> هماهنگی محل تحویل</li>
              </ul>
            </div>
          </aside>
        </div>
      </section>

      {relatedProducts.length > 0 && (
        <section class="related-section">
          <div class="section-heading">
            <div>
              <span class="section-kicker">YOU MAY ALSO NEED</span>
              <h2>محصولات مرتبط</h2>
            </div>
            <a class="view-all" href={`${base}products/`}>
              مشاهده همه محصولات <span>←</span>
            </a>
          </div>

          <div class="related-grid">
            {relatedProducts.map((item: any) => (
              <a class="related-card" href={`${base}product/${item.id}/`}>
                <div class="related-image">
                  {item.image ? (
                    <img src={item.image} alt={item.name} loading="lazy" />
                  ) : (
                    <span>AS</span>
                  )}
                  <span class="related-arrow">↗</span>
                </div>
                <div class="related-info">
                  <small>{formatCategory(item.category)}</small>
                  <h3>{item.name}</h3>
                  <span class="related-link">مشاهده محصول ←</span>
