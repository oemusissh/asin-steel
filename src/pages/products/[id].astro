            مشخصات و مقدار موردنیاز خود را اعلام کنید تا برای بررسی سفارش و استعلام قیمت راهنمایی شوید.
          </p>
        </div>
        <a href={`${base}contact/`} class="cta-button">
          ثبت درخواست استعلام
          <span>←</span>
        </a>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  const mainImage = document.getElementById("main-product-image") as HTMLImageElement | null;
  const thumbnails = document.querySelectorAll<HTMLButtonElement>(".thumbnail");

  thumbnails.forEach((thumbnail) => {
    thumbnail.addEventListener("click", () => {
      const image = thumbnail.dataset.image;
      if (!mainImage || !image) return;

      mainImage.src = image;
      thumbnails.forEach((item) => item.classList.remove("active"));
      thumbnail.classList.add("active");
    });
  });

  const toggleButton = document.getElementById("toggle-description");
  const toggleText = document.getElementById("toggle-description-text");
  const toggleIcon = document.getElementById("toggle-description-icon");
  const descriptionBody = document.getElementById("full-description");
  const descriptionFade = document.getElementById("description-fade");

  toggleButton?.addEventListener("click", () => {
    const isExpanded = toggleButton.getAttribute("aria-expanded") === "true";
    const nextExpanded = !isExpanded;

    toggleButton.setAttribute("aria-expanded", String(nextExpanded));
    descriptionBody?.classList.toggle("expanded", nextExpanded);
    descriptionFade?.classList.toggle("hidden", nextExpanded);

    if (toggleText) {
      toggleText.textContent = nextExpanded
        ? "بستن توضیحات"
        : "مشاهده همه توضیحات";
    }

    if (toggleIcon) {
      toggleIcon.textContent = nextExpanded ? "⌃" : "⌄";
    }
  });
</script>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  .product-page {
    --navy: #102a43;
    --navy-dark: #071a2a;
    --navy-deep: #061421;
    --teal: #19aaa2;
    --mint: #75e2d4;
    --steel: #347e9d;
    --text: #e7f0f7;
    --muted: #a5bacb;
    --line: rgba(133, 171, 194, .22);

    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 100vh;
    padding: 24px 0 70px;
    color: var(--text);
    background:
      radial-gradient(ellipse at 12% 8%, rgba(25, 170, 162, .22), transparent 34%),
      radial-gradient(ellipse at 88% 35%, rgba(31, 105, 151, .23), transparent 38%),
      radial-gradient(ellipse at 48% 85%, rgba(12, 72, 103, .25), transparent 42%),
      linear-gradient(135deg, #061421 0%, #0a2033 45%, #071827 100%);
  }

  /* شبکه متحرک مهندسی */
  .animated-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(117, 226, 212, .055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(117, 226, 212, .055) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, #000 0%, rgba(0, 0, 0, .75) 50%, transparent 100%);
    animation: grid-drift 28s linear infinite;
  }

  .product-container {
    position: relative;
    z-index: 2;
    width: min(1180px, calc(100% - 36px));
    margin: 0 auto;
  }

  .page-glow,
  .ambient-light {
    position: absolute;
    z-index: 1;
    pointer-events: none;
    border-radius: 50%;
  }

  .page-glow {
    filter: blur(2px);
  }

  .glow-one {
    top: 360px;
    right: -180px;
    width: 360px;
    height: 360px;
    border: 1px solid rgba(25, 170, 162, .22);
    box-shadow:
      0 0 0 35px rgba(25, 170, 162, .035),
      0 0 0 70px rgba(25, 170, 162, .025);
    animation: ring-pulse 9s ease-in-out infinite alternate;
  }

  .glow-two {
    top: 1200px;
    left: -220px;
    width: 430px;
    height: 430px;
    border: 1px solid rgba(52, 126, 157, .24);
    box-shadow: 0 0 0 45px rgba(52, 126, 157, .035);
    animation: ring-pulse 12s ease-in-out infinite alternate-reverse;
  }

  .ambient-light {
    z-index: 0;
    filter: blur(55px);
    opacity: .55;
    will-change: transform;
  }

  .ambient-light-one {
    top: 100px;
    right: -160px;
    width: 340px;
    height: 340px;
    background: rgba(25, 170, 162, .38);
    animation: ambient-float-one 6s ease-in-out infinite alternate;
  }

  .ambient-light-two {
    top: 950px;
    left: -180px;
    width: 400px;
    height: 400px;
    background: rgba(38, 104, 164, .34);
    animation: ambient-float-two 8s ease-in-out infinite alternate;
  }


  @keyframes grid-drift {
    from {
      background-position: 0 0;
    }
    to {
      background-position: 24px 24px;
    }
  }


  @keyframes ambient-float-one {
    from {
      transform: translate3d(0, 0, 0) scale(.85);
    }
    to {
      transform: translate3d(-100px, 90px, 0) scale(1.2);
    }
  }

  @keyframes ambient-float-two {
    from {
      transform: translate3d(0, 0, 0) scale(1.15);
    }
    to {
      transform: translate3d(100px, -100px, 0) scale(.85);
    }
  }

  @keyframes ring-pulse {
    from {
      transform: scale(.92) rotate(0deg);
      opacity: .35;
    }
    to {
      transform: scale(1.08) rotate(8deg);
      opacity: .9;
    }
  }

