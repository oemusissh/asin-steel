    intro: "پروفیل قوطی فولادی با سطح مقطع بسته، معمولاً به شکل مربع یا مستطیل تولید می‌شود. این هندسه در ساخت قاب‌ها، شاسی‌ها و سازه‌های سبک و صنعتی کاربرد دارد.",
    paragraphs: [
      "مقاطع توخالی مربعی و مستطیلی به دلیل داشتن سطح مقطع بسته، می‌توانند در برابر پیچش عملکرد مناسبی داشته باشند. رفتار سازه‌ای آن‌ها به ابعاد بیرونی، ضخامت جداره، خواص مکانیکی فولاد، طول عضو و نحوه اتصال وابسته است.",
      "قوطی فولادی معمولاً از شکل‌دهی ورق و اتصال لبه‌ها تولید می‌شود. جزئیات فرایند ساخت، نوع درز، تلرانس ابعادی و استاندارد محصول بسته به روش تولید و رده محصول متفاوت است.",
      "ابعاد ۴۰ در ۴۰ میلی‌متر و ضخامت اسمی ۲ میلی‌متر، در صورت تأیید مشخصات محموله، به معرفی اندازه محصول کمک می‌کنند؛ اما برای طراحی عضو باید خواص مقطع و مشخصات مکانیکی واقعی نیز در نظر گرفته شوند.",
      "پیش از خرید، ابعاد بیرونی، ضخامت، راستایی، کیفیت جوش یا درز، طول شاخه و وضعیت سطح را بررسی کنید. در کاربردهای سازه‌ای، انتخاب مقطع باید بر اساس محاسبات و استاندارد مربوط صورت گیرد."
    ],
    applications: [
      "ساخت قاب‌ها و شاسی‌های فلزی",
      "تولید پایه‌ها و چارچوب‌های صنعتی",
      "ساخت قطعات و سازه‌های سبک با طراحی مناسب"
    ],
    considerations: [
      "ضخامت واقعی و ابعاد مقطع را کنترل کنید.",
      "کیفیت درز و راستایی پروفیل در ساخت اهمیت دارد.",
      "برای کاربرد باربر، تأیید مهندس طراح ضروری است."
    ],
    sourceTitle: "Hollow structural section — Wikipedia",
    sourceUrl: "https://en.wikipedia.org/wiki/Hollow_structural_section"
  },

  "angle-50-50-5": {
    intro: "نبشی فولادی، مقطعی با دو بال متصل به یکدیگر است که معمولاً زاویه‌ای نزدیک به ۹۰ درجه دارند. این مقطع در اتصالات، قاب‌ها، مهاربندی‌ها و ساخت قطعات فلزی مورد استفاده قرار می‌گیرد.",
    paragraphs: [
      "نبشی‌ها می‌توانند در آرایش‌های مختلف، به‌صورت تکی یا در ترکیب با مقاطع دیگر به کار روند. عملکرد آن‌ها به طول عضو، نحوه اتصال، جهت بارگذاری، شرایط تکیه‌گاهی و ویژگی‌های فولاد وابسته است.",
      "نبشی با بال‌های مساوی، در دو جهت ابعاد بال یکسانی دارد؛ در حالی که در نوع بال نامساوی، اندازه دو بال متفاوت است. اندازه بال، ضخامت و طول شاخه از مشخصات مهم برای شناسایی و سفارش محصول محسوب می‌شوند.",
      "نبشی ممکن است برای اتصال اجزای فولادی یا ساخت بخش‌هایی از قاب و تجهیزات استفاده شود. با این حال، ظرفیت باربری را نمی‌توان فقط از روی اندازه بال‌ها تعیین کرد؛ لاغری عضو، کمانش، خروج از مرکزیت و جزئیات اتصال نیز در طراحی مؤثرند.",
      "در زمان خرید، ابعاد بال‌ها، ضخامت، طول، وزن و استاندارد محصول را با سفارش تطبیق دهید. برای کاربردهای سازه‌ای، انتخاب و جزئیات اتصال باید مطابق محاسبات مهندسی و نقشه‌های مصوب باشد."
    ],
    applications: [
      "ساخت اتصالات و قاب‌های فولادی",
      "تولید پایه‌ها و مهاربندی‌های متناسب با طراحی",
      "ساخت قطعات و تجهیزات فلزی"
    ],
    considerations: [
      "بال مساوی یا نامساوی بودن مقطع را بررسی کنید.",
      "ضخامت و ابعاد واقعی باید با سفارش هماهنگ باشند.",
      "ظرفیت باربری و نوع اتصال باید مهندسی بررسی شوند."
    ],
    sourceTitle: "Structural steel — Wikipedia",
    sourceUrl: "https://en.wikipedia.org/wiki/Structural_steel"
  }
};

const genericDescription = {
  intro: p.description || `${p.name} یکی از مقاطع فولادی قابل تأمین برای پروژه‌های ساختمانی و صنعتی است. انتخاب محصول مناسب به مشخصات فنی، استاندارد موردنیاز و شرایط مصرف بستگی دارد.`,
  paragraphs: [
    `برای انتخاب ${p.name}، ابتدا مشخصات فنی موردنیاز پروژه را با ویژگی‌های محصول تطبیق دهید. ابعاد، ضخامت یا قطر، گرید فولاد، استاندارد تولید و کیفیت سطح از مواردی هستند که بسته به نوع مقطع باید بررسی شوند.`,
    "در سفارش‌های صنعتی، علاوه بر نام محصول، مشخص‌کردن کارخانه تولیدکننده، مقدار موردنیاز، طول یا ابعاد، شرایط تحویل و مدارک کیفیت به کاهش خطا در تأمین کمک می‌کند.",
    "در کاربردهای باربر و سازه‌ای، انتخاب نهایی باید مطابق نقشه‌های مصوب، استانداردهای مربوط و نظر متخصص واجد صلاحیت انجام شود."
  ],
  applications: [
    "پروژه‌های ساختمانی و صنعتی متناسب با مشخصات محصول",
    "تأمین مقاطع فولادی برای ساخت و تولید"
  ],
  considerations: [
    "مشخصات فنی و استاندارد محصول را بررسی کنید.",
    "ابعاد، وزن و مقدار محموله باید با سفارش مطابقت داشته باشد."
  ],
  sourceTitle: "Structural steel — Wikipedia",
  sourceUrl: "https://en.wikipedia.org/wiki/Structural_steel"
};

const description = descriptions[p.id] || genericDescription;

const imageList = Array.isArray(p.images) && p.images.length
  ? p.images
  : p.image
    ? [p.image]
    : [];

const specifications = Array.isArray(p.specifications)
  ? p.specifications
  : [];

const getSpecLabel = (spec: any) =>
  spec.label || spec.name || spec.title || "مشخصه";

const getSpecValue = (spec: any) =>
  spec.value ?? spec.description ?? "طبق سفارش";

const formatCategory = (category: string) => {
  const labels: Record<string, string> = {
    rebar: "میلگرد",
    beam: "تیرآهن",
    sheet: "ورق فولادی",
    profile: "پروفیل",
    angle: "نبشی"
  };
  return labels[category] || "مقاطع فولادی";
};
---

<BaseLayout title={`${p.name} | آسین استیل`}>
  <main class="product-page" dir="rtl">
    <div class="animated-grid" aria-hidden="true"></div>
    <div class="page-glow glow-one" aria-hidden="true"></div>
    <div class="page-glow glow-two" aria-hidden="true"></div>
    <div class="ambient-light ambient-light-one" aria-hidden="true"></div>
    <div class="ambient-light ambient-light-two" aria-hidden="true"></div>

    <div class="product-container">
      <nav class="breadcrumbs" aria-label="مسیر صفحه">
        <a href={base}>صفحه اصلی</a>
        <span>/</span>
        <a href={`${base}products/`}>محصولات</a>
        <span>/</span>
        <span class="current">{p.name}</span>
      </nav>

      <section class="product-hero">
        <div class="gallery-panel">
          <div class="gallery-badge">
            <span class="status-dot"></span>
