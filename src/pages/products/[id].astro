          {imageList.length > 0 ? (
            <>
              <div class="main-image-wrap">
                <img
                  id="main-product-image"
                  src={imageList[0]}
                  alt={p.name}
                  class="main-product-image"
                />
                <div class="image-watermark">ASIN STILL</div>
              </div>

              {imageList.length > 1 && (
                <div class="thumbnail-list">
                  {imageList.map((image: string, index: number) => (
                    <button
                      class={`thumbnail ${index === 0 ? "active" : ""}`}
                      type="button"
                      data-image={image}
                      aria-label={`نمایش تصویر ${index + 1}`}
                    >
                      <img
                        src={image}
                        alt={`${p.name} - تصویر ${index + 1}`}
                      />
                    </button>
                  ))}
                </div>
              )}
            </>
          ) : (
            <div class="no-image">
              <span class="no-image-icon">▧</span>
              <span>تصویر محصول به‌زودی اضافه می‌شود</span>
              <small>ASIN STILL</small>
            </div>
          )}

          <div class="gallery-footer">
            <span>کیفیت در تأمین</span>
            <span class="footer-line"></span>
            <span>اعتماد در معامله</span>
          </div>
        </div>

        <div class="product-summary">
          <div class="eyebrow">
            <span class="eyebrow-line"></span>
            معرفی محصول
          </div>

          <div class="category-pill">{formatCategory(p.category)}</div>

          <h1>{p.name}</h1>

          <p class="product-lead">{description.intro}</p>

          <div class="product-meta">
            {p.factory && (
              <div class="meta-item">
                <span class="meta-icon">▤</span>
                <div>
                  <small>کارخانه / برند</small>
