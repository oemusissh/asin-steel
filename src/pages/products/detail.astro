---
import BaseLayout from "../../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="جزئیات محصول | آسین استیل">
  <main class="product-page" dir="rtl">
    <div class="animated-grid" aria-hidden="true"></div>
    <div class="page-glow glow-one" aria-hidden="true"></div>
    <div class="page-glow glow-two" aria-hidden="true"></div>
    <div class="product-container">
      <nav class="breadcrumbs" aria-label="مسیر صفحه">
        <a href={base}>صفحه اصلی</a><span>/</span><a href={`${base}products/`}>محصولات</a><span>/</span><span id="breadcrumb-name" class="current">جزئیات محصول</span>
      </nav>
      <section id="product-loading" class="loading-panel">در حال دریافت اطلاعات محصول...</section>
      <section id="product-error" class="loading-panel" hidden>
        <h1>محصول پیدا نشد</h1><p id="product-error-message">ممکن است محصول حذف شده یا غیرفعال شده باشد.</p>
        <a class="button-primary" href={`${base}products/`}>بازگشت به محصولات</a>
      </section>
      <div id="product-content" hidden>
        <section class="product-hero">
          <div class="gallery-panel">
            <div class="gallery-badge"><span class="status-dot"></span> مقطع فولادی</div>
            <div id="product-image" class="no-image"><span class="no-image-icon">▧</span><span>تصویر محصول ثبت نشده</span><small>ASIN STEEL</small></div>
            <div id="product-gallery" class="product-gallery" hidden></div>
            <div class="gallery-footer"><span>کیفیت در تأمین</span><span class="footer-line"></span><span>اعتماد در معامله</span></div>
          </div>
          <div class="product-summary">
            <div class="eyebrow"><span class="eyebrow-line"></span> معرفی محصول</div>
            <div id="product-category" class="category-pill">مقاطع فولادی</div>
            <h1 id="product-name">جزئیات محصول</h1>
            <p id="product-description" class="product-lead"></p>
            <div class="product-meta">
              <div class="meta-item"><span class="meta-icon">▤</span><div><small>کارخانه / برند</small><strong id="product-factory">طبق سفارش</strong></div></div>
              <div class="meta-item" id="unit-meta" hidden><span class="meta-icon">◫</span><div><small>واحد عرضه</small><strong id="product-unit"></strong></div></div>
              <div class="meta-item" id="weight-meta" hidden><span class="meta-icon">⚖</span><div><small>وزن اعلامی</small><strong id="product-weight"></strong></div></div>
            </div>
            <div class="price-panel"><div class="price-panel-icon">↗</div><div class="price-panel-copy"><strong>استعلام قیمت و موجودی</strong><span id="product-price-description">قیمت نهایی با توجه به مشخصات سفارش و شرایط روز اعلام می‌شود.</span></div><span id="product-price" class="price-status">تماس بگیرید</span></div>
            <div class="hero-actions"><a class="button-primary" id="inquiry-link" href={`${base}contact/`}>درخواست استعلام <span>←</span></a><a class="button-secondary" href={`${base}Price-list/`}>مشاهده لیست قیمت</a></div>
            <div class="trust-line"><span>✓</span> تطبیق مشخصات سفارش پیش از تأمین</div>
          </div>
        </section>

        <section id="specifications-section" class="content-section specifications-section" hidden>
          <div class="section-heading"><div><span class="section-kicker">PRODUCT SPECIFICATIONS</span><h2>مشخصات فنی محصول</h2></div><span class="heading-mark">01</span></div>
          <div id="product-specifications" class="specifications-grid"></div>
        </section>

        <section class="content-section description-section">
          <div class="section-heading"><div><span class="section-kicker">PRODUCT KNOWLEDGE</span><h2 id="guide-title">راهنمای تخصصی محصول</h2><p class="section-subtitle">آشنایی با ویژگی‌ها، کاربردها و نکات مهم انتخاب محصول</p></div><span class="heading-mark">02</span></div>
          <div class="description-layout">
            <article class="description-card">
              <div class="article-topline"><span class="article-icon">✦</span><span>دانشنامه مقاطع فولادی</span><span class="article-divider"></span><span class="reading-time">راهنمای خرید</span></div>
              <div id="description-intro" class="description-intro"></div>
              <div id="full-description" class="description-body"></div>
              <div class="description-fade" id="description-fade"></div>
              <button class="expand-description" id="toggle-description" type="button" aria-expanded="false"><span id="toggle-description-text">مشاهده همه توضیحات</span><span id="toggle-description-icon" class="expand-icon">⌄</span></button>
              <div class="source-box"><div class="source-icon">i</div><div><strong>نکته مهم هنگام خرید</strong><p>مشخصات نهایی، استاندارد و تناژ موردنیاز را با نیاز پروژه و مدارک معتبر تطبیق دهید. انتخاب مقاطع باربر باید بر اساس نقشه‌های مصوب و نظر متخصص انجام شود.</p></div></div>
            </article>
            <aside class="knowledge-sidebar">
              <div class="sidebar-card sidebar-highlight"><div class="sidebar-symbol">AS</div><span class="sidebar-kicker">ASIN STEEL</span><h3>انتخاب آگاهانه، خرید مطمئن</h3><p>برای بررسی مشخصات سفارش و دریافت قیمت روز، با کارشناسان فروش آسین استیل در ارتباط باشید.</p><a id="sidebar-contact" href={`${base}contact/`}>ارتباط با کارشناسان <span>←</span></a></div>
              <div class="sidebar-card"><h3>چک‌لیست سفارش</h3><ul class="checklist"><li><span>01</span> تعیین نوع و مشخصات مقطع</li><li><span>02</span> مشخص‌کردن تناژ موردنیاز</li><li><span>03</span> بررسی کارخانه و استاندارد</li><li><span>04</span> هماهنگی محل تحویل</li></ul></div>
            </aside>
          </div>
        </section>

        <section id="related-section" class="content-section related-section" hidden>
          <div class="section-heading"><div><span class="section-kicker">YOU MAY ALSO NEED</span><h2>محصولات مرتبط</h2></div><a class="view-all" href={`${base}products/`}>مشاهده همه محصولات <span>←</span></a></div>
          <div id="related-grid" class="related-grid"></div>
        </section>

        <section class="final-cta"><div class="cta-pattern"></div><div class="cta-content"><span class="section-kicker">LET'S BUILD TOGETHER</span><h2 id="cta-title">برای تأمین این محصول آماده‌اید؟</h2><p>مشخصات و مقدار موردنیاز خود را اعلام کنید تا برای بررسی سفارش و استعلام قیمت راهنمایی شوید.</p></div><a id="cta-link" href={`${base}contact/`} class="cta-button">ثبت درخواست استعلام <span>←</span></a></section>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import { supabase } from "../../lib/supabase";

  const base = import.meta.env.BASE_URL;
  const byId = (id: string) => document.getElementById(id);
  const loading = byId("product-loading");
  const errorBox = byId("product-error");
  const errorMessage = byId("product-error-message");
  const content = byId("product-content");
  const categoryLabels: Record<string, string> = {
    rebar: "میلگرد", beam: "تیرآهن", sheet: "ورق فولادی", profile: "پروفیل", angle: "نبشی",
    channel: "ناودانی", pipe: "لوله", wire: "مفتولی", valve: "شیرآلات", fitting: "اتصالات",
    alloy: "فولاد آلیاژی", equipment: "تجهیزات", other: "مقاطع فولادی"
  };

  function setText(id: string, value: unknown, fallback = "") {
    const el = byId(id);
    if (el) el.textContent = value === null || value === undefined || value === "" ? fallback : String(value);
  }
  function showError(message: string) {
    if (loading) loading.hidden = true;
    if (content) content.hidden = true;
    if (errorMessage) errorMessage.textContent = message;
    if (errorBox) errorBox.hidden = false;
  }
  function safeImageUrl(value: unknown): string | null {
    if (typeof value !== "string" || !value.trim()) return null;
    const raw = value.trim();
    if (/^https?:\/\//i.test(raw)) return raw;
    if (raw.startsWith("/") && !raw.startsWith("//")) return raw;
    return null;
  }
  function normalizeImages(product: any): string[] {
    const values = [product.image, ...(Array.isArray(product.gallery) ? product.gallery : []), ...(Array.isArray(product.images) ? product.images : [])];
    return [...new Set(values.map(safeImageUrl).filter((value): value is string => Boolean(value)))];
  }
  function priceText(product: any) {
    const amount = Number(product.price);
    if (product.price_on_request || product.price === null || product.price === "" || !Number.isFinite(amount) || amount <= 0) return "استعلام قیمت";
    return `${new Intl.NumberFormat("fa-IR").format(amount)} تومان`;
  }
  function renderGallery(images: string[], name: string) {
    const holder = byId("product-image");
    const gallery = byId("product-gallery");
    if (!holder || !gallery) return;
    const showImage = (url: string) => {
      holder.replaceChildren();
      holder.className = "main-image-wrap";
      const img = document.createElement("img");
      img.className = "main-product-image"; img.src = url; img.alt = name;
      img.addEventListener("error", () => { holder.className = "no-image"; holder.replaceChildren(); const msg = document.createElement("span"); msg.textContent = "تصویر محصول در دسترس نیست"; holder.appendChild(msg); }, { once: true });
      const watermark = document.createElement("span"); watermark.className = "image-watermark"; watermark.textContent = "ASIN STEEL";
      holder.append(img, watermark);
      gallery.querySelectorAll<HTMLButtonElement>(".thumbnail").forEach((button) => button.classList.toggle("active", button.dataset.image === url));
    };
    gallery.replaceChildren();
    if (!images.length) {
      holder.className = "no-image"; holder.replaceChildren();
      const icon = document.createElement("span"); icon.className = "no-image-icon"; icon.textContent = "▧";
      const text = document.createElement("span"); text.textContent = "تصویر محصول ثبت نشده";
      const brand = document.createElement("small"); brand.textContent = "ASIN STEEL";
      holder.append(icon, text, brand); gallery.hidden = true; return;
    }
    showImage(images[0]);
    if (images.length > 1) {
      images.forEach((url, index) => {
        const button = document.createElement("button"); button.type = "button"; button.className = `thumbnail${index === 0 ? " active" : ""}`; button.dataset.image = url; button.setAttribute("aria-label", `نمایش تصویر ${index + 1}`);
        const img = document.createElement("img"); img.src = url; img.alt = `${name} - تصویر ${index + 1}`; img.loading = "lazy";
        button.appendChild(img); button.addEventListener("click", () => showImage(url)); gallery.appendChild(button);
      });
      gallery.hidden = false;
    } else gallery.hidden = true;
  }
  function renderSpecifications(specs: any[]) {
    const section = byId("specifications-section"); const grid = byId("product-specifications");
    if (!section || !grid) return;
    grid.replaceChildren();
    const valid = specs.filter((spec) => spec !== null && spec !== undefined && (typeof spec !== "object" || spec.value || spec.description || spec.label || spec.name || spec.title));
    if (!valid.length) { section.hidden = true; return; }
    valid.forEach((spec, index) => {
      const item = typeof spec === "object" ? spec : { value: spec };
      const card = document.createElement("div"); card.className = "spec-card";
      const number = document.createElement("span"); number.className = "spec-index"; number.textContent = String(index + 1).padStart(2, "0");
      const label = document.createElement("span"); label.className = "spec-label"; label.textContent = String(item.label || item.name || item.title || "مشخصه");
      const value = document.createElement("strong"); value.className = "spec-value"; value.textContent = String(item.value ?? item.description ?? "طبق سفارش");
      card.append(number, label, value); grid.appendChild(card);
    });
    section.hidden = false;
  }
  function renderGuide(product: any, category: string, description: string) {
    setText("description-intro", description);
    setText("guide-title", `راهنمای تخصصی ${product.name || "محصول"}`);
    const body = byId("full-description");
    if (!body) return;
    body.replaceChildren();
    const paragraphs: string[] = [
      `برای انتخاب ${product.name || "این محصول"}، مشخصات فنی موردنیاز پروژه را با ویژگی‌های محموله تطبیق دهید. ابعاد، ضخامت یا قطر، گرید فولاد، استاندارد تولید و کیفیت سطح از مواردی هستند که بسته به نوع مقطع باید بررسی شوند.`,
      "در سفارش‌های صنعتی، مشخص‌کردن کارخانه تولیدکننده، مقدار موردنیاز، طول یا ابعاد، شرایط تحویل و مدارک کیفیت به کاهش خطا در تأمین کمک می‌کند.",
      "برای سفارش پروژه‌ای، بهتر است تناژ، محل تحویل و زمان‌بندی موردنیاز پیش از نهایی‌کردن خرید مشخص شود. قیمت و موجودی نیز ممکن است با توجه به شرایط روز بازار تغییر کند."
    ];
    paragraphs.forEach((text) => { const p = document.createElement("p"); p.textContent = text; body.appendChild(p); });
    const makeList = (title: string, items: string[]) => {
      const heading = document.createElement("div"); heading.className = "article-subheading"; const mark = document.createElement("span"); heading.append(mark, document.createTextNode(title)); body.appendChild(heading);
      const ul = document.createElement("ul"); ul.className = "application-list";
      items.forEach((text) => { const li = document.createElement("li"); const check = document.createElement("span"); check.className = "list-check"; check.textContent = "✓"; li.append(check, document.createTextNode(text)); ul.appendChild(li); }); body.appendChild(ul);
    };
    const applications: Record<string, string[]> = {
      rebar: ["تأمین فولاد تقویتی پروژه‌های ساختمانی", "استفاده در اعضای بتن‌آرمه مطابق نقشه سازه", "خرید تناژی برای پیمانکاران و مجریان پروژه"],
      beam: ["تأمین تیرآهن برای سازه‌های فولادی", "ساخت قاب‌ها و اجزای صنعتی بر اساس طراحی", "تأمین مقاطع نوردشده برای پروژه‌های عمرانی"],
      sheet: ["ساخت قطعات و تجهیزات فلزی", "تولید سازه‌ها و اجزای صنعتی", "برش‌کاری مطابق نقشه تولید"],
      profile: ["ساخت قاب‌ها و شاسی‌های فلزی", "تولید پایه‌ها و چارچوب‌های صنعتی", "ساخت سازه‌های سبک با طراحی مناسب"],
      angle: ["ساخت اتصالات و قاب‌های فولادی", "تولید پایه‌ها و مهاربندی‌ها", "ساخت قطعات و تجهیزات فلزی"]
    };
    makeList("کاربردهای رایج", applications[product.category] || [`تأمین ${category} برای پروژه‌های ساختمانی و صنعتی`, "استفاده در ساخت و تولید متناسب با مشخصات محصول"]);
    makeList("نکات مهم پیش از خرید", ["گرید، استاندارد و مشخصات فنی را بررسی کنید.", "ابعاد، وزن و مقدار محموله را با سفارش تطبیق دهید.", "انتخاب مقاطع باربر را به نقشه مصوب و نظر متخصص بسپارید."]);
  }
  function renderRelated(products: any[], current: any) {
    const section = byId("related-section"); const grid = byId("related-grid");
    if (!section || !grid) return;
    grid.replaceChildren();
    const related = products.filter((item) => String(item.id) !== String(current.id) && item.active !== false && (!current.category || item.category === current.category)).slice(0, 3);
    if (!related.length) { section.hidden = true; return; }
    related.forEach((item) => {
      const link = document.createElement("a"); link.className = "related-card"; link.href = `${base}products/detail/?id=${encodeURIComponent(String(item.id))}`;
      const imageWrap = document.createElement("div"); imageWrap.className = "related-image";
      const url = normalizeImages(item)[0];
      if (url) { const img = document.createElement("img"); img.src = url; img.alt = item.name || "محصول فولادی"; img.loading = "lazy"; imageWrap.appendChild(img); }
      else { const placeholder = document.createElement("span"); placeholder.textContent = "AS"; imageWrap.appendChild(placeholder); }
      const arrow = document.createElement("span"); arrow.className = "related-arrow"; arrow.textContent = "↗"; imageWrap.appendChild(arrow);
      const info = document.createElement("div"); info.className = "related-info";
      const small = document.createElement("small"); small.textContent = categoryLabels[item.category] || "مقاطع فولادی";
      const title = document.createElement("h3"); title.textContent = item.name || "محصول فولادی";
      const action = document.createElement("span"); action.className = "related-link"; action.textContent = "مشاهده محصول ←";
      info.append(small, title, action); link.append(imageWrap, info); grid.appendChild(link);
    });
    section.hidden = false;
  }
  function setupDescriptionToggle() {
    const button = byId("toggle-description"); const body = byId("full-description"); const fade = byId("description-fade");
    button?.addEventListener("click", () => {
      const expanded = button.getAttribute("aria-expanded") === "true"; const next = !expanded;
      button.setAttribute("aria-expanded", String(next)); body?.classList.toggle("expanded", next); fade?.classList.toggle("hidden", next);
      setText("toggle-description-text", next ? "بستن توضیحات" : "مشاهده همه توضیحات"); setText("toggle-description-icon", next ? "⌃" : "⌄");
    });
  }
  async function loadProduct() {
    const id = new URLSearchParams(window.location.search).get("id");
    if (!id || !/^\d+$/.test(id)) { showError("شناسه محصول در آدرس صفحه وجود ندارد یا معتبر نیست."); return; }
    try {
      const { data: product, error } = await supabase.from("products").select("*").eq("id", Number(id)).eq("active", true).maybeSingle();
      if (error) { console.error("Supabase product error:", error); showError("دریافت اطلاعات محصول ناموفق بود. اتصال و دسترسی Supabase را بررسی کنید."); return; }
      if (!product) { showError("این محصول وجود ندارد یا در حال حاضر غیرفعال است."); return; }
      const name = product.name || "محصول فولادی";
      const category = categoryLabels[product.category] || "مقاطع فولادی";
      const description = product.description || `${name} از محصولات قابل تأمین آسین استیل است. برای اطلاع از قیمت و موجودی روز با کارشناسان فروش تماس بگیرید.`;
      document.title = `${name} | آسین استیل`;
      setText("breadcrumb-name", name); setText("product-name", name); setText("product-category", category); setText("product-description", description); setText("product-factory", product.factory, "طبق سفارش");
      setText("product-unit", product.unit, "طبق سفارش"); setText("product-weight", product.weight, "طبق سفارش");
      const unitMeta = byId("unit-meta"); if (unitMeta) unitMeta.hidden = !product.unit;
      const weightMeta = byId("weight-meta"); if (weightMeta) weightMeta.hidden = !product.weight;
      setText("product-price", priceText(product));
      setText("product-price-description", product.price_on_request || priceText(product) === "استعلام قیمت" ? "برای دریافت قیمت روز و موجودی با کارشناسان فروش تماس بگیرید." : "قیمت ثبت‌شده ممکن است با توجه به شرایط روز تغییر کند.");
      setText("cta-title", `برای تأمین ${name} آماده‌اید؟`);
      const inquiry = `${base}contact/?product=${encodeURIComponent(name)}`;
      ["inquiry-link", "cta-link", "sidebar-contact"].forEach((id) => { const el = byId(id) as HTMLAnchorElement | null; if (el) el.href = inquiry; });
      renderGallery(normalizeImages(product), name);
      renderSpecifications(Array.isArray(product.specifications) ? product.specifications : []);
      renderGuide(product, category, description);
      setupDescriptionToggle();
      const { data: related } = await supabase.from("products").select("id,name,category,image,gallery,active").eq("active", true).limit(40);
      renderRelated(Array.isArray(related) ? related : [], product);
      if (loading) loading.hidden = true; if (errorBox) errorBox.hidden = true; if (content) content.hidden = false;
    } catch (error) {
      console.error("Unexpected product loading error:", error);
      showError("خطایی هنگام دریافت اطلاعات محصول رخ داد. صفحه را دوباره بارگذاری کنید.");
    }
  }
  loadProduct();
</script>

<style>
  :global(html) { scroll-behavior: smooth; }
  .product-page, .product-page * { box-sizing: border-box; font-family: "Estedad", sans-serif !important; }
  .product-page { --navy:#102a43; --navy-dark:#071a2a; --navy-deep:#061421; --teal:#19aaa2; --mint:#75e2d4; --steel:#347e9d; --text:#e7f0f7; --muted:#a5bacb; --line:rgba(133,171,194,.22); position:relative; isolation:isolate; overflow:hidden; min-height:80vh; padding:24px 0 70px; color:var(--text); background:radial-gradient(ellipse at 12% 8%,rgba(25,170,162,.22),transparent 34%),radial-gradient(ellipse at 88% 35%,rgba(31,105,151,.23),transparent 38%),linear-gradient(135deg,#061421 0%,#0a2033 45%,#071827 100%); }
  .product-container { position:relative; z-index:2; width:min(1180px,calc(100% - 36px)); margin:0 auto; }
  .animated-grid { position:absolute; inset:0; z-index:0; pointer-events:none; background-image:linear-gradient(rgba(117,226,212,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(117,226,212,.055) 1px,transparent 1px); background-size:48px 48px; mask-image:linear-gradient(to bottom,#000,transparent 95%); animation:grid-drift 28s linear infinite; }
  .page-glow { position:absolute; z-index:1; pointer-events:none; border:1px solid rgba(25,170,162,.22); border-radius:50%; box-shadow:0 0 0 35px rgba(25,170,162,.035),0 0 0 70px rgba(25,170,162,.025); }
  .glow-one { top:360px; right:-180px; width:360px; height:360px; animation:ring-pulse 9s ease-in-out infinite alternate; }
