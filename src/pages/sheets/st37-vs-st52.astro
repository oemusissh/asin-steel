---
import SheetLayout from '../../layouts/SheetLayout.astro';
const rows: [string, string, string][] = [
  ['معادل استاندارد (تقریبی)', 'S235JR', 'نزدیک به S355'],
  ['حداقل تنش تسلیم (تقریبی)', 'حدود ۲۳۵ مگاپاسکال', 'حدود ۳۵۵ مگاپاسکال'],
  ['استحکام', 'متوسط', 'بیشتر'],
  ['جوش‌پذیری', 'ساده‌تر', 'نیاز به دقت بیشتر در رویه‌ی جوشکاری'],
  ['قیمت', 'معمولاً کمتر', 'معمولاً بیشتر'],
  ['کاربرد رایج', 'ساختمان، سوله، قطعات عمومی', 'سازه‌های سنگین، جرثقیل، شاسی، پل'],
];
const faq = [
  { q: 'ST52 بهتر از ST37 است؟', a: 'ST52 مقاوم‌تر است، ولی «بهتر» به کاربرد بستگی دارد. اگر استحکام بیشتر لازم نیست، ST37 اقتصادی‌تر و جوشکاری‌اش ساده‌تر است.' },
  { q: 'تفاوت ظاهری ST37 و ST52 چیست؟', a: 'از روی ظاهر قابل تشخیص نیست. تشخیص گرید با گواهی کارخانه و برچسب یا آزمون انجام می‌شود.' },
  { q: 'کدام را برای سوله انتخاب کنم؟', a: 'انتخاب با محاسبات مهندس سازه است. در بسیاری از سازه‌های سبک ST37 کافی است و برای بارهای سنگین‌تر ST52 در نظر گرفته می‌شود.' },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<SheetLayout
  title="تفاوت ورق ST37 و ST52؛ کدام را انتخاب کنیم؟"
  description="مقایسه‌ی ورق ST37 و ST52: استحکام، جوش‌پذیری، قیمت و کاربرد. راهنمای انتخاب گرید ورق سیاه از آسین استیل."
  crumbs={[{ name: 'انواع ورق', href: '/sheets/' }, { name: 'ST37 یا ST52' }]}
>
  <h1>تفاوت ورق ST37 و ST52</h1>
  <p class="sheet-answer">
    ST52 استحکام بیشتری از ST37 دارد و برای بارهای سنگین‌تر استفاده می‌شود؛ ST37 ارزان‌تر و برای جوشکاری ساده‌تر است
    و برای بسیاری از کارهای ساختمانی و عمومی کافی است. انتخاب نهایی با محاسبات مهندسی پروژه است.
  </p>

  <h2>مقایسه‌ی سریع</h2>
  <div class="sheet-table-wrap">
    <table class="sheet-table">
      <thead><tr><th>ویژگی</th><th>ST37</th><th>ST52</th></tr></thead>
      <tbody>
        {rows.map(([a, b, c]) => (<tr><th scope="row">{a}</th><td>{b}</td><td>{c}</td></tr>))}
      </tbody>
    </table>
  </div>
  <p class="sheet-note">مقادیر تقریبی‌اند و به ضخامت، استاندارد و کارخانه بستگی دارند؛ مرجع نهایی گواهی کارخانه است.</p>

  <h2>کدام را انتخاب کنم؟</h2>
  <ul>
    <li>اگر بار سازه متوسط است و صرفه‌جویی هزینه مهم است: ST37.</li>
    <li>اگر مقاومت بیشتر یا کاهش ضخامت لازم است: ST52.</li>
    <li>اگر پروژه نقشه و محاسبات دارد: همان گرید ذکرشده در نقشه.</li>
  </ul>

  <h2>سؤالات متداول</h2>
  <div class="sheet-faq">
    {faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
  </div>

  <p>
    <a class="sheet-cta" href="/sheets/black/">ورق سیاه</a>
    <a class="sheet-cta" href="/sheet-weight-calculator/">ماشین‌حساب وزن</a>
    <a class="sheet-cta" href="/contact/">استعلام قیمت</a>
  </p>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</SheetLayout>
