  min-width: 920px;
  border-collapse: separate;
  border-spacing: 0;
  text-align: right;
}

.table-scroll th {
  padding: 15px 16px;
  background: #f3f6fc;
  color: #465570;
  font-size: 11px;
  font-weight: 800;
  border-bottom: 1px solid #e0e7f1;
  white-space: nowrap;
}

:global(.admin-shell .table-scroll tbody td) {
  padding: 14px 16px;
  color: #374151 !important;
  -webkit-text-fill-color: #374151 !important;
  border-bottom: 1px solid #edf0f6;
  font-size: 12px;
  vertical-align: middle;
  line-height: 1.9;
  transition: background-color 0.15s ease;
}

:global(.admin-shell .table-scroll tbody tr:nth-child(even)) {
  background: #fafbfe;
}

:global(.admin-shell .table-scroll tbody tr:hover td) {
  background: #f0f5ff;
}

:global(.admin-shell .product-name) {
  display: flex;
  align-items: center;
  gap: 10px;
}

:global(.admin-shell .product-name strong) {
  color: #17243b !important;
  -webkit-text-fill-color: #17243b !important;
  font-size: 12px;
  font-weight: 800;
}

:global(.admin-shell .product-name small) {
  margin-top: 4px;
  color: #7b879b !important;
  -webkit-text-fill-color: #7b879b !important;
  font-size: 10px;
}

:global(.admin-shell .product-icon) {
  flex-shrink: 0;
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: #edf2ff;
  color: #315ee8 !important;
  -webkit-text-fill-color: #315ee8 !important;
}

:global(.admin-shell .table-scroll tbody td.price) {
  color: #176b4b !important;
  -webkit-text-fill-color: #176b4b !important;
  font-weight: 800;
}

:global(.admin-shell .table-scroll tbody td.quote-price) {
  color: #95620b !important;
  -webkit-text-fill-color: #95620b !important;
  font-weight: 800;
}

:global(.admin-shell .status) {
  padding: 6px 11px;
  border-radius: 7px;
  font-weight: 700;
  white-space: nowrap;
}

:global(.admin-shell .toggle) {
  min-width: 68px;
  padding: 8px 10px;
  border-radius: 8px;
  font-weight: 700;
}

:global(.admin-shell .actions) {
  display: flex;
  align-items: center;
  gap: 6px;
}

:global(.admin-shell .edit-button),
:global(.admin-shell .delete-button) {
  padding: 8px 11px;
  border-radius: 8px;
  font-size: 11px;
  font-weight: 700;
  transition: background 0.15s, border-color 0.15s;
}

:global(.admin-shell .edit-button:hover) {
  background: #edf2ff;
  border-color: #b6c7ff;
}

:global(.admin-shell .delete-button:hover) {
  background: #fff0f1;
  border-color: #f5bfc5;
}

@media (max-width: 720px) {
  .table-heading {
    padding: 16px 13px;
  }

  .table-scroll th,
  :global(.admin-shell .table-scroll tbody td) {
    padding: 12px 10px;
  }
}


:global(.admin-shell .product-name-details) {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 7px;
  min-width: 0;
}

:global(.admin-shell .product-name-details strong) {
  display: block;
  line-height: 1.8;
  overflow-wrap: anywhere;
}

:global(.admin-shell .product-name-details small) {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin: 0;
  padding: 3px 8px;
  border: 1px solid #e3e8f0;
  border-radius: 6px;
  background: #f6f8fb;
  color: #64748b !important;
  font-size: 10px;
}

:global(.admin-shell .product-name-details small bdi) {
  direction: ltr;
  color: #334155;
  font-weight: 700;
}


.table-heading-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
}

.export-excel {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 14px;
  border: 1px solid #b9dfca;
  border-radius: 9px;
  background: #edf8f1;
  color: #176b42;
  font-family: inherit;
  font-size: 12px;
  font-weight: 800;
  white-space: nowrap;
  transition: background 0.2s ease;
}

.export-excel:hover {
  background: #d9f0e2;
}

.export-excel:disabled {
  opacity: 0.6;
  cursor: wait;
}



/* نشان‌های پرفروش و تخفیف‌دار */
:global(.admin-shell .product-badges) {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 5px;
}

:global(.admin-shell .product-badge) {
  display: inline-flex;
  align-items: center;
  padding: 3px 8px;
  border-radius: 6px;
  font-size: 10px;
  font-weight: 800;
  line-height: 1.8;
}

:global(.admin-shell .product-badge.best-seller) {
  color: #80530a;
  background: #fff5d8;
  border: 1px solid #f0dfa5;
}

:global(.admin-shell .product-badge.discount) {
  color: #b4233b;
  background: #fff0f2;
  border: 1px solid #f5c7cf;
}



  </style>
</BaseLayout>
