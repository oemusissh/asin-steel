    async function exportAllProductsToExcel() {
  const button = $("export-excel");

  if (busy) {
    showToast("لطفاً صبر کن عملیات فعلی تمام شود.");
    return;
  }

  button.disabled = true;
  button.textContent = "در حال دریافت محصولات...";

  try {
    // دریافت تمام محصولات از دیتابیس، مستقل از جست‌وجوی جدول
    const allRows = [];
    const pageSize = 1000;
    let from = 0;

    while (true) {
      const { data, error } = await supabase
        .from("products")
        .select("*")
        .order("id", { ascending: true })
        .range(from, from + pageSize - 1);

      if (error) throw error;

      allRows.push(...(data || []));

      if (!data || data.length < pageSize) break;

      from += pageSize;
    }

    if (allRows.length === 0) {
      showToast("محصولی برای خروجی گرفتن وجود ندارد.");
      return;
    }

    const rows = allRows.map((p) => ({
      "شناسه": p.id,
      "نام محصول": p.name ?? "",
      "دسته‌بندی": categoryNames[p.category] || "سایر",
      "کد دسته‌بندی": p.category ?? "",
      "کارخانه": p.factory ?? "",
      "قیمت هر کیلو (تومان)": p.price_on_request
        ? "استعلام قیمت"
        : Number(p.price || 0),
      "نیازمند استعلام قیمت": p.price_on_request ? "بله" : "خیر",
      "موجودی": inventoryNames[p.inventory] || "استعلام موجودی",
      "وضعیت محصول": p.active ? "فعال" : "غیرفعال",
      "توضیحات": p.description ?? "",
      "تصویر اصلی": p.image ?? "",
      "گالری تصاویر": Array.isArray(p.gallery)
        ? p.gallery.join(" | ")
        : "",
      "مشخصات فنی": Array.isArray(p.specifications)
        ? p.specifications
            .map((item) => `${item.label}: ${item.value}`)
            .join(" | ")
        : "",
      "شناسه یکتا (Slug)": p.slug ?? "",
      "تاریخ ایجاد": p.created_at ?? "",
      "آخرین به‌روزرسانی": p.updated_at ?? "",
    }));

    const worksheet = XLSX.utils.json_to_sheet(rows);

    worksheet["!cols"] = [
      { wch: 12 },
      { wch: 30 },
      { wch: 20 },
      { wch: 18 },
      { wch: 24 },
      { wch: 24 },
      { wch: 20 },
      { wch: 20 },
      { wch: 16 },
      { wch: 45 },
      { wch: 35 },
      { wch: 45 },
      { wch: 45 },
      { wch: 28 },
      { wch: 24 },
      { wch: 24 },
    ];

    worksheet["!autofilter"] = {
      ref: XLSX.utils.encode_range({
        s: { r: 0, c: 0 },
        e: { r: rows.length, c: Object.keys(rows[0]).length - 1 },
      }),
    };

    const workbook = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(workbook, worksheet, "محصولات");

    const date = new Date().toISOString().slice(0, 10);
    XLSX.writeFile(workbook, `ASIN-STILL-products-${date}.xlsx`);

    showToast(`فایل اکسل ${formatNumber(rows.length)} محصول آماده شد.`);
  } catch (error) {
    showError("ساخت فایل اکسل ناموفق بود", error);
  } finally {
    button.disabled = false;
    button.innerHTML = "↓ دریافت فایل اکسل";
  }
}

