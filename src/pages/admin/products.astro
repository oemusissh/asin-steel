
---





import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;


---

<BaseLayout title="مدیریت محصولات | پنل مدیریت ASIN STILL">
  <div class="admin-shell" dir="rtl" data-base={base}>
    <aside class="sidebar">
      <a class="brand" href={`${base}admin/`}>
        <span class="brand-mark">A</span>
        <span>ASIN <b>STILL</b><small>پنل مدیریت</small></span>
      </a>

      <nav>
        <a href={`${base}admin/`}>▦ <span>داشبورد</span></a>
        <a class="selected" href={`${base}admin/products`}>▤ <span>مدیریت محصولات</span></a>
        <a href={`${base}admin/orders`}>▣ <span>سفارش‌ها</span></a>
        <a href={`${base}admin/customers`}>♙ <span>مشتریان</span></a>
        <a href={`${base}Price-list`}>↗ <span>لیست قیمت سایت</span></a>
      </nav>

      <a class="back-link" href={base}>← بازگشت به سایت</a>
    </aside>

    <section class="workspace">
      <header class="topbar">
        <div>
          <span class="eyebrow">مدیریت فروشگاه</span>
          <h1>مدیریت محصولات تست</h1>
          <p>محصولات فروشگاه را مشاهده و مدیریت کن.</p>
        </div>
        <div class="admin-actions">
  <span class="admin-chip"><span></span> پنل مدیریت</span>
  <button id="admin-sign-out" class="sign-out-button" type="button">
    خروج از حساب
  </button>
</div>
      </header>

      <section class="toolbar">
        <div class="search-wrap">
          <span>⌕</span>
          <input id="search" type="search" placeholder="جست‌وجوی نام محصول یا کارخانه..." />
        </div>
        <button id="add-product" class="primary">＋ افزودن محصول</button>
      </section>

      <section class="stats">
        <article class="stat-card">
          <span>کل محصولات</span>
          <strong id="total-count">۰</strong>
          <small>تمام محصولات ثبت‌شده</small>
        </article>
        <article class="stat-card">
          <span>محصولات فعال</span>
          <strong id="active-count">۰</strong>
          <small>قابل نمایش در فروشگاه</small>
        </article>
        <article class="stat-card">
          <span>استعلام قیمت</span>
          <strong id="quote-count">۰</strong>
          <small>قیمت نیازمند استعلام</small>
        </article>
        <article class="stat-card">
          <span>ناموجود</span>
          <strong id="unavailable-count">۰</strong>
          <small>وضعیت موجودی محصول</small>
        </article>
      </section>

      <section class="table-card">
        <div class="table-heading">
          <div>
            <h2>فهرست محصولات</h2>
            <p>برای تغییر مشخصات، گزینه ویرایش را انتخاب کن.</p>
          </div>
          <div class="table-heading-actions">
            <button id="export-excel" type="button" class="export-excel">
              ↓ دریافت فایل اکسل
            </button>
            <span id="result-count" class="result-count">۰ محصول</span>
          </div>
        </div>

        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>محصول</th>
                <th>دسته‌بندی</th>
                <th>کارخانه</th>
                <th>قیمت هر کیلو (تومان)</th>
                <th>موجودی</th>
                <th>وضعیت</th>
                <th>عملیات</th>
              </tr>
            </thead>
            <tbody id="products-body"></tbody>
          </table>
        </div>

        <div id="empty-state" class="empty-state" hidden>
          <span>▤</span>
          <strong>محصولی پیدا نشد</strong>
          <p>عبارت جست‌وجو را تغییر بده یا محصول جدیدی اضافه کن.</p>
        </div>
      </section>

      <p class="notice" id="connection-notice" role="status">
        در حال بررسی دسترسی مدیر و دریافت محصولات از پایگاه داده...
      </p>
    </section>
  </div>

  <div id="product-modal" class="modal" hidden>
    <div class="modal-backdrop" data-close></div>
    <section class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <header class="modal-header">
        <div>
          <span class="eyebrow">اطلاعات فروشگاه</span>
          <h2 id="modal-title">افزودن محصول</h2>
        </div>
        <button type="button" id="close-modal" class="icon-button" aria-label="بستن">×</button>
      </header>

      <form id="product-form">
        <input id="product-id" type="hidden" />

        <label>
          نام محصول
          <input id="product-name" required maxlength="100" placeholder="مثلاً میلگرد آجدار ۱۸" />
        </label>

        <div class="form-grid">
          <label>
            دسته‌بندی
            <select id="product-category" required>
              <option value="rebar">میلگرد</option>
              <option value="beam">تیرآهن</option>
              <option value="sheet">ورق</option>
              <option value="profile">پروفیل</option>
              <option value="angle">نبشی و ناودانی</option>
              <option value="pipe">لوله</option>
              <option value="other">سایر</option>
            </select>
          </label>

          <label>
            کارخانه
            <input id="product-factory" required maxlength="100" placeholder="نام کارخانه" />
          </label>
        </div>

        <label>
          نحوه نمایش قیمت
          <select id="product-price-mode">
            <option value="fixed">نمایش قیمت عددی</option>
            <option value="quote">استعلام قیمت</option>
          </select>
        </label>

        <label id="price-field">
          قیمت هر کیلو به تومان
          <input id="product-price" type="number" min="0" step="1" placeholder="مثلاً ۳۲۴۰۰" />
        </label>

        
<div class="form-grid">
  <label class="check-row">
    <input id="product-best-seller" type="checkbox" />
    محصول پرفروش است
  </label>

  <label class="check-row">
    <input id="product-discount-enabled" type="checkbox" />
    تخفیف برای محصول فعال باشد
  </label>
</div>

<label id="old-price-field" hidden>
  قیمت قبلی هر کیلو به تومان
  <input
    id="product-old-price"
    type="number"
    min="1"
    step="1"
    placeholder="مثلاً ۴۰۰۰۰"
  />
  <small>قیمت قبلی باید بیشتر از قیمت فعلی باشد.</small>
</label>



        
<label>
  توضیحات محصول
  <textarea
    id="product-description"
    rows="4"
    maxlength="2000"
    placeholder="توضیحات محصول، کاربرد و شرایط تأمین..."
  ></textarea>
</label>

<label>
  آدرس تصویر اصلی محصول
  <input
    id="product-image"
    type="url"
    placeholder="https://example.com/product.jpg"
  />
</label>

<label>
  آدرس تصاویر گالری
  <textarea
    id="product-gallery"
    rows="3"
    placeholder="آدرس هر تصویر را در یک خط وارد کن"
  ></textarea>
  <small>هر آدرس تصویر را در یک خط جداگانه وارد کن.</small>
</label>

<label>
  مشخصات فنی
  <textarea
    id="product-specifications"
    rows="5"
    placeholder="نوع محصول: میلگرد آجدار&#10;سایز: ۱۴ میلی‌متر&#10;گرید: A3"
  ></textarea>
  <small>هر خط را با قالب «عنوان: مقدار» وارد کن.</small>
</label>


        <label>
          وضعیت موجودی
          <select id="product-inventory">
            <option value="available">موجود</option>
            <option value="unavailable">ناموجود</option>
            <option value="inquire">استعلام موجودی</option>
          </select>
        </label>

        <label class="check-row">
          <input id="product-active" type="checkbox" checked />
          محصول فعال باشد
        </label>

        <div class="form-actions">
          <button type="button" id="cancel-modal" class="secondary">انصراف</button>
          <button type="submit" class="primary">ذخیره محصول</button>
        </div>
      </form>
    </section>
  </div>

  <div id="toast" class="toast" role="status" aria-live="polite"></div>

  <script>
    import { supabase } from "../../lib/supabase";
    import * as XLSX from "xlsx";

    const categoryNames = {
      rebar: "میلگرد",
      beam: "تیرآهن",
      sheet: "ورق",
      profile: "پروفیل",
      angle: "نبشی و ناودانی",
      pipe: "لوله",
      other: "سایر",
    };

    const inventoryNames = {
      available: "موجود",
      unavailable: "ناموجود",
      inquire: "استعلام موجودی",
    };

    const inventoryClasses = {
      available: "green",
      unavailable: "red",
      inquire: "amber",
    };

    const $ = (id) => document.getElementById(id);
    const modal = $("product-modal");
    const form = $("product-form");

    async function handleAdminSignOut() {
  const button = $("admin-sign-out");

  if (!window.confirm("از پنل مدیریت خارج می‌شوید؟")) {
    return;
  }

  button.disabled = true;
  button.textContent = "در حال خروج...";

  try {
    const { error } = await supabase.auth.signOut();

    if (error) {
      throw error;
    }

    const { data, error: sessionError } =
      await supabase.auth.getSession();

    if (sessionError) {
      throw sessionError;
    }

    if (data.session) {
      throw new Error("نشست کاربری هنوز فعال است.");
    }

    goTo("account/signin/");
  } catch (error) {
    console.error("Admin sign-out failed:", error);
    showError("خروج از حساب انجام نشد", error);

    button.disabled = false;
    button.textContent = "خروج از حساب";
  }
}

    const body = $("products-body");
    const base = document.querySelector(".admin-shell")?.dataset.base || "/";
    let products = [];
    let busy = false;

    function goTo(path) {
      const prefix = base.endsWith("/") ? base : `${base}/`;
      window.location.href = `${prefix}${path}`;
    }

    function formatNumber(value) {
      return Number(value || 0).toLocaleString("fa-IR");
    }

    function normalizeProduct(row) {
      return {
        ...row,
        id: Number(row.id),
        price: Number(row.price || 0),
        priceOnRequest: Boolean(row.price_on_request),
        categoryName: categoryNames[row.category] || "سایر",
      };
    }

    function priceText(product) {
      return product.priceOnRequest
        ? "استعلام قیمت"
        : `${formatNumber(product.price)} تومان`;
    }

    function setBusy(value) {
      busy = value;
      [$("add-product"), ...form.querySelectorAll("button")].forEach((button) => {
        if (button) button.disabled = value;
      });
    }

    function showToast(message) {
      const toast = $("toast");
      toast.textContent = message;
      toast.classList.add("visible");
      window.setTimeout(() => toast.classList.remove("visible"), 3000);
    }

    function showError(prefix, error) {
      console.error(prefix, error);
      showToast(`${prefix}${error?.message ? `: ${error.message}` : ""}`);
    }

    function escapeHTML(value) {
      return String(value ?? "").replace(/[&<>"']/g, (char) => ({
        "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
      })[char]);
    }

    function render() {
      const query = $("search").value.trim().toLocaleLowerCase("fa");
      const filtered = products.filter((product) =>
        `${product.name} ${product.factory} ${product.categoryName}`
          .toLocaleLowerCase("fa")
          .includes(query)
      );

      $("total-count").textContent = formatNumber(products.length);
      $("active-count").textContent = formatNumber(products.filter((p) => p.active).length);
      $("quote-count").textContent = formatNumber(products.filter((p) => p.priceOnRequest).length);
      $("unavailable-count").textContent = formatNumber(products.filter((p) => p.inventory === "unavailable").length);
      $("result-count").textContent = `${formatNumber(filtered.length)} محصول`;
      $("empty-state").hidden = filtered.length > 0;

      body.innerHTML = filtered.map((product) => `
        <tr>
          <td>
            <div class="product-name">
              <span class="product-icon">▤</span>
              <div class="product-name-details">
                
                <strong>${escapeHTML(product.name)}</strong>
                <div class="product-badges">
                  ${product.is_best_seller ? '<span class="product-badge best-seller">★ پرفروش</span>' : ""}
                  ${product.discount_enabled ? '<span class="product-badge discount">٪ تخفیف‌دار</span>' : ""}
                </div>

                <small><span>شناسه محصول</span><bdi>${product.id}</bdi></small>
              </div>
            </div>
          </td>
          <td>${escapeHTML(product.categoryName)}</td>
          <td>${escapeHTML(product.factory || "—")}</td>
          <td class="${product.priceOnRequest ? "quote-price" : "price"}">${escapeHTML(priceText(product))}</td>
          <td><span class="status ${inventoryClasses[product.inventory] || "amber"}">${inventoryNames[product.inventory] || "استعلام موجودی"}</span></td>
          <td><button class="toggle ${product.active ? "on" : ""}" data-toggle="${product.id}" aria-label="تغییر وضعیت فعال محصول">${product.active ? "فعال" : "غیرفعال"}</button></td>
          <td><div class="actions"><button class="edit-button" data-edit="${product.id}">ویرایش</button><button class="delete-button" data-delete="${product.id}">حذف</button></div></td>
        </tr>
      `).join("");
    }

    async function ensureAdmin() {
      const { data: { user }, error: userError } = await supabase.auth.getUser();
      if (userError) throw userError;
      if (!user) {
        goTo("account/signin/");
        return false;
      }

      const { data: profile, error: profileError } = await supabase
        .from("profiles")
        .select("role")
        .eq("id", user.id)
        .maybeSingle();

      if (profileError) throw profileError;
      if (profile?.role !== "admin") {
        showToast("این بخش فقط برای مدیر سایت قابل دسترسی است.");
        window.setTimeout(() => goTo(""), 1400);
        return false;
      }
      return true;
    }

    async function loadProducts() {
      setBusy(true);
      $("connection-notice").textContent = "در حال دریافت محصولات از Supabase...";
      try {
        const allowed = await ensureAdmin();
        if (!allowed) return;

        
      const { data, error } = await supabase
        .from("products")
        .select("*")
        .order("created_at", { ascending: false });

        if (error) throw error;

        products = (data || []).map(normalizeProduct);
        render();
        $("connection-notice").textContent = "اتصال به پایگاه داده برقرار است؛ تغییرات این صفحه مستقیماً در Supabase ذخیره می‌شوند.";
      } catch (error) {
        $("connection-notice").textContent = "دریافت محصولات ناموفق بود. تنظیمات Supabase و مجوزهای جدول products را بررسی کن.";
        showError("خطا در دریافت محصولات", error);
      } finally {
        setBusy(false);
      }
    }


      function updatePriceField() {
        const isQuote = $("product-price-mode").value === "quote";
        const discountEnabled = $("product-discount-enabled").checked;

        $("price-field").hidden = isQuote;
        $("product-price").required = !isQuote;

        $("old-price-field").hidden = isQuote || !discountEnabled;
        $("product-old-price").required = !isQuote && discountEnabled;
      }



function openModal(product = null) {
  form.reset();

  $("product-id").value = product?.id ?? "";
  $("modal-title").textContent = product ? "ویرایش محصول" : "افزودن محصول";

  $("product-name").value = product?.name ?? "";
  $("product-category").value = product?.category ?? "rebar";
  $("product-factory").value = product?.factory ?? "";

  $("product-price-mode").value = product?.priceOnRequest ? "quote" : "fixed";
  $("product-price").value = product?.price ?? "";

  
  $("product-best-seller").checked = product?.is_best_seller ?? false;
  $("product-discount-enabled").checked = product?.discount_enabled ?? false;
  $("product-old-price").value = product?.old_price ?? "";


  $("product-inventory").value = product?.inventory ?? "available";
  $("product-active").checked = product?.active ?? true;

  $("product-description").value = product?.description ?? "";
  $("product-image").value = product?.image ?? "";

  $("product-gallery").value = Array.isArray(product?.gallery)
    ? product.gallery.join("\n")
    : "";

  $("product-specifications").value = Array.isArray(product?.specifications)
    ? product.specifications
        .map((item) => `${item.label}: ${item.value}`)
        .join("\n")
    : "";

  updatePriceField();

  modal.hidden = false;
  document.body.classList.add("modal-open");
  $("product-name").focus();
}


    function closeModal() {
      modal.hidden = true;
      document.body.classList.remove("modal-open");
    }

    $("add-product").addEventListener("click", () => openModal());
    $("admin-sign-out").addEventListener("click", handleAdminSignOut);
    $("close-modal").addEventListener("click", closeModal);
    $("cancel-modal").addEventListener("click", closeModal);
    modal.querySelectorAll("[data-close]").forEach((el) => el.addEventListener("click", closeModal));
    $("search").addEventListener("input", render);
    $("export-excel").addEventListener("click", exportAllProductsToExcel);
    $("product-price-mode").addEventListener("change", updatePriceField);
    $("product-discount-enabled").addEventListener("change", updatePriceField);

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !modal.hidden) closeModal();
    });

    body.addEventListener("click", async (event) => {
      const editButton = event.target.closest("[data-edit]");
      const deleteButton = event.target.closest("[data-delete]");
      const toggleButton = event.target.closest("[data-toggle]");

      if (editButton) {
        const product = products.find((p) => String(p.id) === editButton.dataset.edit);
        if (product) openModal(product);
        return;
      }

      if (busy) return;

      if (deleteButton) {
        const product = products.find((p) => String(p.id) === deleteButton.dataset.delete);
        if (!product || !confirm(`محصول «${product.name}» حذف شود؟ این کار قابل بازگشت نیست.`)) return;
        setBusy(true);
        try {
          const { error } = await supabase.from("products").delete().eq("id", product.id);
          if (error) throw error;
          products = products.filter((p) => p.id !== product.id);
          render();
          showToast("محصول از پایگاه داده حذف شد.");
        } catch (error) {
          showError("حذف محصول انجام نشد", error);
        } finally {
          setBusy(false);
        }
      }

      if (toggleButton) {
        const product = products.find((p) => String(p.id) === toggleButton.dataset.toggle);
        if (!product) return;
        setBusy(true);
        try {
          const nextActive = !product.active;
          const { error } = await supabase.from("products")
            .update({ active: nextActive, updated_at: new Date().toISOString() })
            .eq("id", product.id);
          if (error) throw error;
          product.active = nextActive;
          render();
          showToast(nextActive ? "محصول فعال شد." : "محصول غیرفعال شد.");
        } catch (error) {
          showError("تغییر وضعیت محصول انجام نشد", error);
        } finally {
          setBusy(false);
        }
      }
    });

    
form.addEventListener("submit", async (event) => {
  event.preventDefault();
  if (busy) return;

  const idValue = $("product-id").value;
  const priceOnRequest = $("product-price-mode").value === "quote";
  const category = $("product-category").value;
  const parsedPrice = Number($("product-price").value || 0);
  const name = $("product-name").value.trim();
  const factory = $("product-factory").value.trim();

  if (!priceOnRequest && (!Number.isFinite(parsedPrice) || parsedPrice < 0)) {
    showToast("قیمت واردشده معتبر نیست.");
    return;
  }
  const discountEnabled = $("product-discount-enabled").checked;
const oldPrice = Number($("product-old-price").value || 0);

if (
  !priceOnRequest &&
  discountEnabled &&
  (!Number.isFinite(oldPrice) || oldPrice <= parsedPrice)
) {
  showToast("قیمت قبلی باید از قیمت فعلی بیشتر باشد.");
  return;
}

  if (!name || !factory) {
    showToast("نام محصول و کارخانه را وارد کن.");
    return;
  }

  const description = $("product-description").value.trim();
  const image = $("product-image").value.trim();

  const gallery = $("product-gallery").value
    .split(/\r?\n/)
    .map((url) => url.trim())
    .filter(Boolean);

  const specifications = $("product-specifications").value
    .split(/\r?\n/)
    .map((line) => {
      const separator = line.indexOf(":");
      if (separator === -1) return null;

      const label = line.slice(0, separator).trim();
      const value = line.slice(separator + 1).trim();

      return label && value ? { label, value } : null;
    })
    .filter(Boolean);

  const slug = idValue
    ? products.find((p) => String(p.id) === idValue)?.slug || ""
    : "";

  const payload = {
    name,
    category,
    factory,

    price: priceOnRequest ? 0 : parsedPrice,
    price_on_request: priceOnRequest,

    is_best_seller: $("product-best-seller").checked,

    discount_enabled:
      !priceOnRequest &&
      $("product-discount-enabled").checked,

    old_price:
      !priceOnRequest && $("product-discount-enabled").checked
        ? Number($("product-old-price").value)
        : null,

    inventory: $("product-inventory").value,

    active: $("product-active").checked,
    description,
    image,
    gallery,
    specifications,
    updated_at: new Date().toISOString(),
  };

  if (slug) {
    payload.slug = slug;
  }

  setBusy(true);

  try {
    if (idValue) {
      const { data, error } = await supabase
        .from("products")
        .update(payload)
        .eq("id", Number(idValue))
        .select("*")
        .single();

      if (error) throw error;

      const updated = normalizeProduct(data);
      products = products.map((p) => p.id === updated.id ? updated : p);
    } else {
      const { data, error } = await supabase
        .from("products")
        .insert(payload)
        .select("*")
        .single();

      if (error) throw error;

      products.unshift(normalizeProduct(data));
    }

    render();
    closeModal();
    showToast(
      idValue
        ? "تغییرات محصول در پایگاه داده ذخیره شد."
        : "محصول جدید در پایگاه داده ثبت شد."
    );
  } catch (error) {
    showError("ذخیره محصول انجام نشد", error);
  } finally {
    setBusy(false);
  }
});


