

---

import BaseLayout from "../layouts/BaseLayout.astro";


const base = import.meta.env.BASE_URL;

const categories = [
  { id: "rebar", name: "میلگرد" },
  { id: "beam", name: "تیرآهن" },
  { id: "sheet", name: "ورق فولادی" },
  { id: "profile", name: "پروفیل" },
  { id: "angle", name: "نبشی و ناودانی" },
  { id: "pipe", name: "لوله" },
  { id: "billet", name: "شمش فولادی" },
  { id: "alloy", name: "فولاد آلیاژی" },
  { id: "other", name: "سایر محصولات" },
];
---


<BaseLayout title="محصولات فولادی | ASIN STILL">
  <main dir="rtl" class="min-h-screen bg-gray-50 py-8 text-gray-900 dark:bg-dark-900 dark:text-white sm:py-12">
    <div class="container mx-auto px-4">

      <!-- Breadcrumb -->
      <nav class="mb-8 flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
        <a href={base} class="transition hover:text-primary-500">صفحه اصلی</a>
        <span>/</span>
        <span class="font-semibold text-gray-900 dark:text-white">محصولات فولادی</span>
      </nav>

      <!-- Hero -->
      <section class="relative mb-8 overflow-hidden rounded-3xl border border-slate-700 bg-gradient-to-l from-slate-950 via-slate-900 to-slate-800 px-6 py-10 text-white sm:px-10 sm:py-14">
        <div class="pointer-events-none absolute -left-12 -top-20 h-64 w-64 rounded-full bg-cyan-500/10 blur-3xl"></div>

        <div class="relative z-10 max-w-3xl">
          <span class="mb-4 inline-flex items-center gap-2 rounded-full border border-cyan-400/30 bg-cyan-400/10 px-4 py-2 text-xs font-semibold text-cyan-300">
            <span class="h-2 w-2 rounded-full bg-cyan-400"></span>
            کاتالوگ محصولات ASIN STILL
          </span>

          <h1 class="mb-4 text-3xl font-extrabold leading-tight sm:text-5xl">
            محصولات فولادی مورد نیازتان را پیدا کنید
          </h1>

          <p class="max-w-2xl text-sm leading-7 text-slate-300 sm:text-base">
            مشخصات محصولات، نوع مقطع و کارخانه تولیدکننده را بررسی کنید.
            برای اطلاع از قیمت روز و شرایط تأمین، با کارشناسان آسین استیل تماس بگیرید.
          </p>

          <div class="mt-7 flex flex-wrap gap-3">
            <a
              href={`${base}contact`}
              class="rounded-xl bg-cyan-500 px-6 py-3 text-sm font-bold text-slate-950 transition hover:bg-cyan-400"
            >
              درخواست استعلام قیمت
            </a>
            <span class="rounded-xl border border-white/15 bg-white/5 px-5 py-3 text-sm text-slate-200">
              محصولات ثبت‌شده در سامانه
            </span>
          </div>
        </div>
      </section>

      <!-- Search and filters -->
      <section class="mb-8 rounded-2xl border border-gray-200 bg-white p-4 shadow-sm dark:border-dark-700 dark:bg-dark-800 sm:p-6">
        <div class="grid grid-cols-1 gap-4 md:grid-cols-[minmax(0,1fr)_240px_auto] md:items-end">

          <div>
            <label for="product-search" class="mb-2 block text-sm font-bold">
              جست‌وجوی محصول
            </label>
            <div class="relative">
              <svg class="absolute right-4 top-1/2 h-5 w-5 -translate-y-1/2 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m16 16 4 4"></path>
              </svg>
              <input
                id="product-search"
                type="search"
                placeholder="مثلاً میلگرد، تیرآهن، ذوب آهن..."
                class="w-full rounded-xl border border-gray-200 bg-gray-50 py-3 pr-12 pl-4 text-sm outline-none transition focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/15 dark:border-dark-600 dark:bg-dark-900"
              />
            </div>
          </div>

          <div>
            <label for="product-category" class="mb-2 block text-sm font-bold">
              دسته‌بندی محصول
            </label>
            <select
              id="product-category"
              class="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 text-sm outline-none transition focus:border-cyan-500 dark:border-dark-600 dark:bg-dark-900"
            >
              <option value="">همه دسته‌ها</option>
              {categories.map((category) => (
                <option value={category.id}>{category.name}</option>
              ))}
            </select>
          </div>

          <button
            id="reset-filters"
            type="button"
            class="rounded-xl border border-gray-200 px-5 py-3 text-sm font-semibold transition hover:border-cyan-500 hover:text-cyan-600 dark:border-dark-600"
          >
            پاک کردن فیلترها
          </button>
        </div>
      </section>

      <!-- Results toolbar -->
      <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="text-xl font-extrabold sm:text-2xl">فهرست محصولات</h2>
          <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
            مشخصات محصولات را بررسی و برای قیمت روز استعلام کنید.
          </p>
        </div>

        <div class="flex items-center gap-2 text-sm">
          <span class="text-gray-500 dark:text-gray-400">تعداد نتایج:</span>
          <strong id="product-count" class="text-cyan-600 dark:text-cyan-400">0</strong>
        </div>
      </div>

      
      <!-- Products grid -->
      <div
        id="products-grid"
        class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"
      >

      </div>


      <!-- Empty state -->
      <div id="empty-state" class="hidden rounded-2xl border border-dashed border-gray-300 px-6 py-16 text-center dark:border-dark-600">
        <div class="mb-4 text-4xl">⌕</div>
        <h3 class="text-lg font-extrabold">محصولی پیدا نشد</h3>
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
          عبارت جست‌وجو یا دسته‌بندی انتخاب‌شده را تغییر دهید.
        </p>
        <button
          id="empty-reset"
          type="button"
          class="mt-5 rounded-xl bg-cyan-600 px-5 py-3 text-sm font-bold text-white hover:bg-cyan-500"
        >
          نمایش همه محصولات
        </button>
      </div>

      <!-- Inquiry note -->
      <section class="mt-10 rounded-2xl border border-cyan-500/20 bg-cyan-500/5 p-5 sm:p-7">
        <h2 class="text-lg font-extrabold">قیمت روز مقاطع فولادی</h2>
        <p class="mt-2 text-sm leading-7 text-gray-600 dark:text-gray-300">
          قیمت نهایی محصولات ممکن است با توجه به کارخانه، وزن، حجم سفارش و محل تحویل متفاوت باشد.
          برای دریافت قیمت معتبر و شرایط تأمین، درخواست استعلام خود را ثبت کنید.
        </p>
        <a
          href={`${base}/contact`}
          class="mt-4 inline-flex rounded-xl border border-cyan-600 px-5 py-3 text-sm font-bold text-cyan-700 transition hover:bg-cyan-600 hover:text-white dark:text-cyan-400"
        >
          ارتباط با کارشناسان
        </a>
      </section>
    </div>
  </main>


<script>
  import { supabase } from "../lib/supabase";

  
type Product = {
  id: number | string;
  name: string;
  category: string;
  factory?: string | null;
  price?: number | string | null;
  price_on_request?: boolean;
  is_best_seller?: boolean;
  discount_enabled?: boolean;
  old_price?: number | string | null;
  inventory?: string;
  active?: boolean;
  description?: string | null;
  image?: string | null;
  gallery?: string[] | null;
  specifications?: { label: string; value: string }[] | null;
  slug?: string | null;
};


  const searchInput = document.querySelector<HTMLInputElement>("#product-search");
  const categorySelect = document.querySelector<HTMLSelectElement>("#product-category");
  const productGrid = document.querySelector<HTMLElement>("#products-grid");
  const productCount = document.querySelector<HTMLElement>("#product-count");
  const emptyState = document.querySelector<HTMLElement>("#empty-state");
  const resetButton = document.querySelector<HTMLButtonElement>("#reset-filters");
  const emptyResetButton = document.querySelector<HTMLButtonElement>("#empty-reset");

  const base = import.meta.env.BASE_URL;

  function escapeHtml(value: unknown): string {
    return String(value ?? "").replace(/[&<>"']/g, (char) => {
      const entities: Record<string, string> = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      };
      return entities[char];
    });
  }

  const categoryNames: Record<string, string> = {
    rebar: "میلگرد",
    beam: "تیرآهن",
    sheet: "ورق فولادی",
    profile: "پروفیل",
    angle: "نبشی و ناودانی",
    pipe: "لوله",
    billet: "شمش فولادی",
    alloy: "فولاد آلیاژی",
    other: "سایر محصولات",
  };

  function renderProducts(products: Product[]) {
    if (!productGrid) return;

    productGrid.innerHTML = products.map((product) => {
      const name = escapeHtml(product.name);
      const category = escapeHtml(product.category);
      const categoryName = escapeHtml(categoryNames[product.category] || "سایر محصولات");
      const factory = escapeHtml(product.factory || "برای اطلاع تماس بگیرید");
      const description = escapeHtml(product.description || "برای دریافت مشخصات بیشتر با کارشناسان آسین استیل تماس بگیرید.");
      const image = escapeHtml(product.image || "");
      const specs = Array.isArray(product.specifications) ? product.specifications : [];
      
const currentPrice = Number(product.price ?? 0);
const oldPrice = Number(product.old_price ?? 0);

const priceOnRequest =
  product.price_on_request === true ||
  product.price == null ||
  product.price === "" ||
  !Number.isFinite(currentPrice) ||
  currentPrice <= 0;

const hasDiscount =
  !priceOnRequest &&
  product.discount_enabled === true &&
  Number.isFinite(oldPrice) &&
  oldPrice > currentPrice;

const formatPrice = (price: number) =>
  new Intl.NumberFormat("fa-IR").format(price);

const badgesHtml = `
  ${product.is_best_seller === true
    ? '<span class="inline-flex items-center rounded-lg border border-amber-200 bg-amber-50 px-2.5 py-1 text-xs font-bold text-amber-800">★ پرفروش</span>'
    : ""}
  ${hasDiscount
    ? '<span class="inline-flex items-center rounded-lg border border-rose-200 bg-rose-50 px-2.5 py-1 text-xs font-bold text-rose-700">٪ تخفیف‌دار</span>'
    : ""}
`;

const priceHtml = priceOnRequest
  ? '<p class="mt-1 text-sm font-extrabold text-cyan-700 dark:text-cyan-400">استعلام قیمت</p>'
  : hasDiscount
    ? `
      <div class="mt-1 flex flex-wrap items-center gap-2">
        <span class="text-base font-extrabold text-rose-600 dark:text-rose-400">
          ${formatPrice(currentPrice)} تومان
        </span>
        <span class="text-xs text-gray-400 line-through">
          ${formatPrice(oldPrice)} تومان
        </span>
      </div>
    `
    : `
      <p class="mt-1 text-sm font-extrabold text-cyan-700 dark:text-cyan-400">
        ${formatPrice(currentPrice)} تومان
      </p>
    `;


      // محصولات قبلی از مسیر اسلاگ و محصولات جدید از شناسه دیتابیس استفاده می‌کنند.
      
      const detailUrl = product.slug
        ? `${base}products/${encodeURIComponent(product.slug)}/`
        : `${base}products/detail/?id=${encodeURIComponent(String(product.id))}`;

      const specsHtml = specs.slice(0, 3).map((spec) => `
        <span class="rounded-lg bg-gray-100 px-2.5 py-1.5 text-xs text-gray-700 dark:bg-dark-900 dark:text-gray-300">
          ${escapeHtml(spec.label)}: ${escapeHtml(spec.value)}
        </span>
      `).join("");

      return `
        <article
          data-product-card
          data-name="${name}"
          data-category="${category}"
          data-factory="${factory}"
          class="group overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:border-cyan-500/50 hover:shadow-xl dark:border-dark-700 dark:bg-dark-800"
        >
          <a href="${detailUrl}" class="relative block aspect-[16/10] overflow-hidden bg-slate-100 dark:bg-dark-900" aria-label="مشاهده مشخصات ${name}">
            ${image
              ? `<img src="${image}" alt="${name}" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />`
              : `<div class="flex h-full items-center justify-center text-sm text-gray-400">تصویر محصول ثبت نشده</div>`}

              <span class="absolute right-3 top-3 rounded-lg border border-white/20 bg-slate-950/85 px-3 py-1.5 text-xs font-bold text-white backdrop-blur">${categoryName}</span>

              <div class="absolute bottom-3 right-3 flex flex-wrap gap-2">
                ${badgesHtml}
              </div>

              <span class="absolute bottom-3 left-3 rounded-lg border border-cyan-400/20 bg-slate-950/85 px-3 py-1.5 text-xs font-semibold text-cyan-300 backdrop-blur">
                ${priceOnRequest ? "استعلام قیمت" : "قیمت روز"}
              </span>

          </a>

          <div class="p-5">
            <div class="mb-3">
              <p class="mb-2 text-xs text-gray-500 dark:text-gray-400">${factory}</p>
              <h3 class="text-lg font-extrabold leading-8 transition group-hover:text-cyan-600 dark:group-hover:text-cyan-400">
                <a href="${detailUrl}">${name}</a>
              </h3>
              <p class="mt-2 line-clamp-2 min-h-12 text-sm leading-6 text-gray-600 dark:text-gray-300">${description}</p>
            </div>

            ${specsHtml ? `
              <div class="mb-5 border-t border-gray-100 pt-3 dark:border-dark-700">
                <p class="mb-2 text-xs font-bold text-gray-500 dark:text-gray-400">مشخصات اصلی</p>
                <div class="flex flex-wrap gap-2">${specsHtml}</div>
              </div>
            ` : ""}

            <div class="flex items-center justify-between gap-3 border-t border-gray-100 pt-4 dark:border-dark-700">
            <div class="min-w-0">
              <p class="text-xs text-gray-500 dark:text-gray-400">قیمت محصول</p>
              ${priceHtml}
            </div>
              <a href="${detailUrl}" class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-3 text-sm font-bold text-white transition hover:bg-cyan-600 dark:bg-slate-700 dark:hover:bg-cyan-600">
                جزئیات محصول
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M19 12H5"></path><path d="m12 19-7-7 7-7"></path>
                </svg>
              </a>
            </div>
          </div>
        </article>
      `;
    }).join("");

    filterProducts();
  }

  function filterProducts() {
    const query = (searchInput?.value ?? "").trim().toLocaleLowerCase();
    const category = categorySelect?.value ?? "";
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>("[data-product-card]")
    );
    let visibleCount = 0;

    cards.forEach((card) => {
      const name = (card.dataset.name ?? "").toLocaleLowerCase();
      const factory = (card.dataset.factory ?? "").toLocaleLowerCase();
      const cardCategory = card.dataset.category ?? "";
      const visible =
        (!query || name.includes(query) || factory.includes(query)) &&
        (!category || cardCategory === category);

      card.hidden = !visible;
      if (visible) visibleCount++;
    });

    if (productCount) productCount.textContent = String(visibleCount);
    emptyState?.classList.toggle("hidden", visibleCount !== 0);
  }

  function resetFilters() {
    if (searchInput) searchInput.value = "";
    if (categorySelect) categorySelect.value = "";
    filterProducts();
  }

  searchInput?.addEventListener("input", filterProducts);
  categorySelect?.addEventListener("change", filterProducts);
  resetButton?.addEventListener("click", resetFilters);
  emptyResetButton?.addEventListener("click", resetFilters);

  async function loadProducts() {
    if (productGrid) {
      productGrid.innerHTML = `
        <div class="col-span-full py-12 text-center text-sm text-gray-500">
          در حال دریافت محصولات...
        </div>
      `;
    }

    const { data, error } = await supabase
      .from("products")
      .select("*")
      .eq("active", true)
      .order("created_at", { ascending: false });

    if (error) {
      console.error("خطا در دریافت محصولات:", error);
      if (productGrid) {
        productGrid.innerHTML = `
          <div class="col-span-full rounded-2xl border border-red-200 bg-red-50 p-6 text-center text-sm leading-7 text-red-700">
            دریافت محصولات با خطا مواجه شد. لطفاً کمی بعد دوباره تلاش کنید.
          </div>
        `;
      }
      if (productCount) productCount.textContent = "0";
      emptyState?.classList.add("hidden");
      return;
    }

    const products = (data ?? []) as Product[];
    renderProducts(products);
  }

  loadProducts();
</script>


  <style>
    [data-product-card][hidden] {
      display: none !important;
    }
  </style>
</BaseLayout>
