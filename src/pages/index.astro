    @keyframes afp-ping2{0%{box-shadow:0 0 0 0 rgba(16,185,129,.65)}100%{box-shadow:0 0 0 9px rgba(16,185,129,0)}}

    .afp-body{position:relative;z-index:2;display:flex;flex:1;flex-direction:column;padding:1rem 1.1rem 1.1rem}
    .afp-cat{align-self:flex-start;padding:.2rem .65rem;border-radius:8px;background:color-mix(in srgb,var(--c) 12%,#fff);color:var(--c);font-size:.72rem;font-weight:800}
    .afp-body h3{margin:.6rem 0;font-size:1.02rem;font-weight:800;line-height:1.7;min-height:3.4em;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .afp-specs{display:flex;flex-wrap:wrap;gap:.35rem;margin:0 0 .9rem;padding:0;list-style:none}
    .afp-specs li{padding:.2rem .55rem;border:1px solid #dbe4f0;border-radius:6px;background:#f8fafc;color:#475569;font-size:.7rem;font-weight:700}
    .afp-pr{margin-top:auto;padding-top:.8rem;border-top:1px dashed #d5deea}
    .afp-pr del{display:block;font-size:.75rem;color:#94a3b8}
    .afp-pr b{font-size:1.15rem;font-weight:900;color:#0b1f3a}
    .afp-pr small{font-size:.68rem;font-weight:700;color:#64748b}
    .afp-inq{color:var(--c)!important;font-size:1rem!important}
    .afp-cta{position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;gap:.5rem;margin-top:.8rem;padding:.7rem;border-radius:12px;background:var(--c);color:#fff;font-size:.88rem;font-weight:800;transition:transform .4s,box-shadow .4s}
    .afp-cta::after{content:"";position:absolute;top:0;bottom:0;left:-60%;width:35%;transform:skewX(-20deg);background:linear-gradient(90deg,transparent,rgba(255,255,255,.5),transparent)}
    .afp-card:hover .afp-cta{transform:translateY(-2px);box-shadow:0 12px 22px -10px var(--c)}
    .afp-card:hover .afp-cta::after{animation:afp-shine .8s ease}
    .afp-card:hover .afp-cta svg{animation:afp-cart .6s ease}
    @keyframes afp-shine{to{left:130%}}
    @keyframes afp-cart{30%{transform:translateX(-4px) rotate(-12deg)}60%{transform:translateX(3px) rotate(8deg)}}

    .afp-draw *{stroke-dasharray:1;stroke-dashoffset:0}
    .afp-card.in .afp-draw *{animation:afp-draw 1.2s cubic-bezier(.6,0,.2,1) calc(var(--i)*70ms + 350ms) backwards}
    .afp-card:hover .afp-draw *{animation:afp-redraw 1.1s cubic-bezier(.6,0,.2,1) both}
    @keyframes afp-draw{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}
    @keyframes afp-redraw{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}

    @media(prefers-reduced-motion:reduce){
      .afp *,.afp *::before,.afp *::after{animation:none!important;transition-duration:.01ms!important}
      .afp-js .afp-card:not(.in){opacity:1}
      .afp-card{transform:none!important}
    }
  </style>

  <script>
    import { supabase } from '../lib/supabase';

    const afp = document.getElementById('afp');
    if (afp) {
      afp.classList.add('afp-js');
      const track = afp.querySelector<HTMLElement>('.afp-track')!;
      const prog = afp.querySelector<HTMLElement>('.afp-prog')!;
      const base = (afp.dataset.base || '/').replace(/\/$/, '');
      const fmt = (n: number) => n.toLocaleString('fa-IR');
      const escapeHTML = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      })[char]!);

      const categoryNames: Record<string, string> = {
        rebar: 'میلگرد', beam: 'تیرآهن', sheet: 'ورق', profile: 'پروفیل',
        angle: 'نبشی و ناودانی', pipe: 'لوله', other: 'سایر',
        rebar: 'میلگرد', channel: 'ناودانی',
      };
      const categoryIcons: Record<string, string> = {
        rebar: '<circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="2.5"/>',
        beam: '<path d="M5 4h14M5 20h14M12 4v16"/>',
        sheet: '<path d="M3 9l9-4.5L21 9l-9 4.5L3 9z"/><path d="M3 9v4l9 4.5 9-4.5V9"/>',
        profile: '<rect x="4.5" y="4.5" width="15" height="15" rx="1.5"/><rect x="9" y="9" width="6" height="6" rx=".5"/>',
        angle: '<path d="M6 4v16h12"/>',
        pipe: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4.5"/>',
        other: '<rect x="3" y="9" width="18" height="6" rx="1"/>',
      };

      const loading = track.querySelector<HTMLElement>('.afp-loading');

      function renderProduct(p: any, index: number) {
        const category = String(p.category || 'other');
        const cat = categoryNames[category] || category || 'سایر';
        const price = Number(p.price || 0);
        const quote = Boolean(p.price_on_request) || price <= 0;
        const inventory = String(p.inventory || 'inquire');
        const inStock = inventory === 'available';
        const oldPrice = Number(p.old_price || p.original_price || 0);
        const off = !quote && oldPrice > price ? Math.round((1 - price / oldPrice) * 100) : 0;
        const badge = p.badge || (p.is_featured ? 'ویژه' : '');
        const tags = [
          (p.is_featured || p.best_seller || p.bestseller) ? 'best' : '',
          off > 0 ? 'sale' : '',
          inStock ? 'stock' : '',
        ].filter(Boolean).join(' ');
        const color = category === 'rebar' ? '#ea580c' : category === 'beam' ? '#2563eb' :
          category === 'profile' ? '#e11d48' : category === 'pipe' ? '#059669' : '#4f46e5';
        const image = p.image_url || p.image || p.thumbnail || '';
        const href = `${base}/products/detail/?id=${encodeURIComponent(String(p.id))}`;
        const priceMarkup = quote
          ? '<div><b class="afp-inq">استعلام قیمت</b></div><small>قیمت روز را از کارشناسان فروش بپرسید</small>'
          : `${oldPrice > price ? `<del>${fmt(oldPrice)}</del>` : ''}<div><b data-price="${price}">${fmt(price)}</b> <small>تومان / کیلوگرم</small></div>`;

        return `
          <a class="afp-card${inStock ? '' : ' oos'}" href="${href}"
             style="--i:${index};--c:${color}" data-tags="${tags}" draggable="false">
            <div class="afp-media">
              <span class="afp-orb"></span>
              <svg class="afp-ghost afp-draw" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width=".7" stroke-linecap="round" stroke-linejoin="round">${categoryIcons[category] || categoryIcons.other}</svg>
              ${image ? `<img src="${escapeHTML(image)}" alt="${escapeHTML(p.name)}" loading="lazy" decoding="async" draggable="false" onerror="this.remove()" />` : ''}
              <div class="afp-badges">
                ${badge ? `<span class="afp-bd" style="background:${p.badge_color || '#2563eb'}">${escapeHTML(badge)}</span>` : ''}
                ${off > 0 ? `<span class="afp-off">${fmt(off)}٪ تخفیف</span>` : ''}
              </div>
              <span class="afp-stock ${inStock ? 'ok' : 'no'}"><i></i>${inStock ? 'موجود در انبار' : inventory === 'unavailable' ? 'ناموجود' : 'استعلام موجودی'}</span>
            </div>
            <div class="afp-body">
              <span class="afp-cat">${escapeHTML(cat)}</span>
              <h3>${escapeHTML(p.name || 'محصول فولادی')}</h3>
              <ul class="afp-specs">
                ${p.factory ? `<li>${escapeHTML(p.factory)}</li>` : ''}
                ${p.unit ? `<li>${escapeHTML(p.unit)}</li>` : ''}
                ${p.weight ? `<li>وزن ${escapeHTML(p.weight)}</li>` : ''}
              </ul>
              <div class="afp-pr">${priceMarkup}</div>
              <span class="afp-cta">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h2l2.4 10.2a1 1 0 001 .8h8.2a1 1 0 001-.7L19 8H6M10 19.5h.01M17 19.5h.01" /></svg>
                ${inStock ? (quote ? 'استعلام قیمت' : 'مشاهده محصول') : 'اطلاع از موجودی'}
              </span>
            </div>
          </a>`;
      }

      const reveal = (card: HTMLElement) => {
        card.classList.add('in');
        const el = card.querySelector<HTMLElement>('[data-price]');
        if (!el) return;
        const target = Number(el.dataset.price);
        const t0 = performance.now() + Number(card.style.getPropertyValue('--i')) * 70;
        const tick = (t: number) => {
          const r = Math.max(0, Math.min((t - t0) / 1200, 1));
          el.textContent = fmt(Math.round(target * (1 - Math.pow(1 - r, 3))));
          if (r < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };

      async function loadProducts() {
        try {
          const { data, error } = await supabase
            .from('products')
            .select('*')
            .eq('active', true)
            .order('created_at', { ascending: false })
            .limit(12);
          if (error) throw error;

          loading?.remove();
          if (!data?.length) {
            track.insertAdjacentHTML('beforeend', '<p class="afp-loading" role="status">فعلاً محصول فعالی برای نمایش ثبت نشده است.</p>');
            return;
          }
          track.insertAdjacentHTML('beforeend', data.map((p, i) => renderProduct(p, i)).join(''));

          const cards = Array.from(afp!.querySelectorAll<HTMLElement>('.afp-card'));
          const io = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                reveal(entry.target as HTMLElement);
                io.unobserve(entry.target);
              }
            });
          }, { threshold: 0.15 });

          cards.forEach((card) => {
            io.observe(card);
            card.addEventListener('pointermove', (e: PointerEvent) => {
              if (e.pointerType !== 'mouse') return;
              const r = card.getBoundingClientRect();
              card.style.setProperty('--mx', `${e.clientX - r.left}px`);
              card.style.setProperty('--my', `${e.clientY - r.top}px`);
              card.style.setProperty('--rx', `${(0.5 - (e.clientY - r.top) / r.height) * 7}deg`);
              card.style.setProperty('--ry', `${((e.clientX - r.left) / r.width - 0.5) * 7}deg`);
            });
            card.addEventListener('pointerleave', () => {
              card.style.setProperty('--rx', '0deg');
              card.style.setProperty('--ry', '0deg');
            });
          });

          const updateProg = () => {
            const max = track.scrollWidth - track.clientWidth;
            const p = max > 0 ? Math.min(Math.abs(track.scrollLeft) / max, 1) : 1;
            prog.style.setProperty('--p', String(0.12 + 0.88 * p));
          };
          track.addEventListener('scroll', updateProg, { passive: true });
          window.addEventListener('resize', updateProg);
          updateProg();

          afp!.querySelectorAll<HTMLButtonElement>('.afp-nav button').forEach((btn) => {
            btn.addEventListener('click', () => {
              const step = track.clientWidth * 0.8 * (btn.dataset.dir === 'next' ? -1 : 1);
              track.scrollBy({ left: step, behavior: 'smooth' });
            });
          });

          let down = false, moved = false, sx = 0, sl = 0;
          track.addEventListener('pointerdown', (e: PointerEvent) => {
            if (e.pointerType !== 'mouse') return;
            down = true; moved = false; sx = e.clientX; sl = track.scrollLeft;
          });
          window.addEventListener('pointermove', (e: PointerEvent) => {
            if (!down) return;
            const dx = e.clientX - sx;
            if (Math.abs(dx) > 5) { moved = true; track.classList.add('drag'); }
            track.scrollLeft = sl - dx;
          });
          window.addEventListener('pointerup', () => { down = false; track.classList.remove('drag'); });
          track.addEventListener('click', (e) => {
            if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; }
          }, true);
          track.addEventListener('dragstart', (e) => e.preventDefault());

          const tabs = afp!.querySelectorAll<HTMLButtonElement>('.afp-tabs button');
          tabs.forEach((btn) => {
            if (btn.dataset.f !== 'all' && !cards.some((card) =>
              (card.dataset.tags ?? '').split(' ').includes(btn.dataset.f || '')
            )) btn.hidden = true;
          });
          tabs.forEach((btn) => {
            btn.addEventListener('click', () => {
              tabs.forEach((b) => b.classList.remove('on'));
              btn.classList.add('on');
              const filter = btn.dataset.f ?? 'all';
              let k = 0;
              cards.forEach((card) => {
                io.unobserve(card);
                const show = filter === 'all' || (card.dataset.tags ?? '').split(' ').includes(filter);
                card.classList.toggle('afp-hide', !show);
                if (show) {
                  card.style.setProperty('--i', String(k++));
                  card.classList.remove('in');
                  void card.offsetWidth;
                  reveal(card);
                }
              });
              track.scrollTo({ left: 0, behavior: 'smooth' });
              updateProg();
            });
          });
        } catch (error) {
          console.error('خطا در دریافت محصولات صفحه اصلی از Supabase:', error);
          loading && (loading.textContent = 'دریافت محصولات ناموفق بود. اتصال Supabase و دسترسی خواندن جدول products را بررسی کنید.');
        }
      }

      void loadProducts();
    }
  </script>


