</section>


<!-- Value Proposition with Animated Icons and Enhanced Hover -->
<section class="w-full px-5 py-16 sm:px-10 lg:px-16 xl:px-24 2xl:px-32">
  <div class="text-center mb-12">
    <h2
      class="text-3xl md:text-4xl font-bold mb-4"
      style="color: #0366a4;"
    >
      چرا آسین استیل؟
    </h2>

    <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
      آسین استیل با تمرکز بر تأمین انواع آهن، فولاد و محصولات فلزی، سفارش‌ها را بر اساس نیاز و مشخصات مشتری بررسی و تأمین می کند.
    </p>
  </div>


  <div class="w-full">

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-12">
