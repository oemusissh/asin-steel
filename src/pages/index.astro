    /* کارت محصول */
    .afp-card{--mx:50%;--my:50%;--rx:0deg;--ry:0deg;position:relative;display:flex;flex-direction:column;overflow:hidden;isolation:isolate;background:#fff;border-radius:22px;color:#0b1f3a;text-decoration:none;
      box-shadow:0 18px 34px -22px rgba(0,0,0,.55);transform:perspective(900px) rotateX(var(--rx)) rotateY(var(--ry));
      transition:transform .35s ease-out,box-shadow .5s}
    .afp-card:hover{box-shadow:0 34px 52px -22px rgba(0,0,0,.65),0 0 0 3px var(--c)}
