    .afp-pstack svg{width:54px;height:54px;padding:10px;border-radius:14px;background:rgba(255,255,255,.2);animation:afp-float 2.6s ease-in-out infinite}
    .afp-pstack svg:nth-child(2){animation-delay:.3s}.afp-pstack svg:nth-child(3){animation-delay:.6s}
