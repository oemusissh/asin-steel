  <style is:global>
    .afp{position:relative;isolation:isolate;overflow:hidden;padding:9rem 0 4.5rem;color:#fff;
      background:linear-gradient(135deg,#0b2a57 0%,#1550a8 50%,#2b8be0 100%)}
    @media(min-width:1024px){.afp{padding-bottom:5.5rem}}
