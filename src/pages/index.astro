    /* اسلایدر */
    .afp-track{display:flex;gap:1.1rem;overflow-x:auto;padding:1.4rem .3rem 2rem;scroll-snap-type:x mandatory;scrollbar-width:none;cursor:grab;user-select:none;-webkit-user-select:none}
