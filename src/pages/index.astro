---

import BaseLayout from '../layouts/BaseLayout.astro';

import RecentlyViewed from '../components/RecentlyViewed.astro';
import AdvancedSteelCalculator from "../components/AdvancedSteelCalculator.astro";
import HomeLuxuryHero from "../components/HomeLuxuryHero.astro";


---

<BaseLayout title="ASIN STEEL - Premium Building Materials">


<!-- =========================
     ASIN STEEL CINEMATIC INTRO
========================= -->

<div id="asin-intro">

  <!-- Background -->
  <div class="intro-bg"></div>
  <div class="intro-grid"></div>

  <!-- Moving blue lights -->
  <div class="intro-glow intro-glow-1"></div>
  <div class="intro-glow intro-glow-2"></div>

  <!-- Scan line -->
  <div class="intro-scan"></div>

  <!-- Decorative HUD -->
  <div class="intro-hud intro-hud-top">
    <span>ASIN / STEEL</span>
    <span>EST. 2026</span>
  </div>

  <div class="intro-hud intro-hud-bottom">
    <span>INDUSTRIAL SUPPLY SYSTEM</span>
    <span>INITIALIZING...</span>
  </div>

  <!-- Main -->
  <div class="intro-center">

    <!-- Top line -->
    <div class="intro-line intro-line-top"></div>

    <!-- Small label -->
    <div class="intro-label">
      <span class="intro-dot"></span>
      INDUSTRIAL STEEL SUPPLY
      <span class="intro-dot"></span>
    </div>

    <!-- Logo -->
    <div class="intro-logo-wrap">

      <div class="intro-logo-shadow">
        ASIN STEEL
      </div>

      <div class="intro-logo">
        ASIN <span>STEEL</span>
      </div>

      <div class="intro-shine"></div>

    </div>

    <!-- Subtitle -->
    <div class="intro-subtitle">
      STEEL&nbsp;&nbsp;•&nbsp;&nbsp;INDUSTRIAL&nbsp;&nbsp;•&nbsp;&nbsp;SUPPLY
    </div>

    <!-- Bottom line -->
    <div class="intro-line intro-line-bottom"></div>

    <!-- Loading -->
    <div class="intro-loading">

      <div class="intro-loading-text">
        <span>LOADING SYSTEM</span>
        <span id="intro-percent">00%</span>
      </div>

      <div class="intro-loading-bar">
        <div id="intro-progress"></div>
      </div>

    </div>

  </div>

  <!-- Corner brackets -->
  <div class="intro-corner corner-tl"></div>
  <div class="intro-corner corner-tr"></div>
  <div class="intro-corner corner-bl"></div>
  <div class="intro-corner corner-br"></div>

</div>


<style>

  /* =====================================
     MAIN
  ===================================== */

  #asin-intro {
    position: fixed;
    inset: 0;
    z-index: 99999;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    background: #020617;

    color: white;

    animation:
      introFinalExit 1.1s cubic-bezier(.77,0,.175,1) 4.7s forwards;

    pointer-events: auto;
  }


  /* =====================================
     BACKGROUND
  ===================================== */

  .intro-bg {
    position: absolute;
    inset: 0;

    background:
      radial-gradient(
        circle at 50% 45%,
        rgba(37,99,235,.16),
        transparent 28%
      ),
      radial-gradient(
        circle at 15% 80%,
        rgba(30,64,175,.12),
        transparent 30%
      ),
      radial-gradient(
        circle at 85% 15%,
        rgba(59,130,246,.08),
        transparent 25%
      ),
      #020617;
  }


  /* =====================================
     GRID
  ===================================== */

  .intro-grid {
    position: absolute;
    inset: -100px;

    opacity: .12;

    background-image:
      linear-gradient(
        rgba(96,165,250,.18) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(96,165,250,.18) 1px,
        transparent 1px
      );

    background-size: 65px 65px;

    transform:
      perspective(700px)
      rotateX(58deg)
      scale(1.5);

    transform-origin: center bottom;

    animation: gridMove 8s linear infinite;
  }


  @keyframes gridMove {

    from {
      background-position:
        0 0,
        0 0;
    }

    to {
      background-position:
        0 65px,
        65px 0;
    }

  }


  /* =====================================
     BLUE GLOWS
  ===================================== */

  .intro-glow {
    position: absolute;

    border-radius: 999px;

    filter: blur(100px);

    pointer-events: none;
  }


  .intro-glow-1 {
    width: 420px;
    height: 420px;

    background: rgba(37,99,235,.16);

    top: -160px;
    right: -120px;

    animation: glowFloat1 5s ease-in-out infinite alternate;
  }


  .intro-glow-2 {
    width: 350px;
    height: 350px;

    background: rgba(59,130,246,.12);

    bottom: -180px;
    left: -100px;

    animation: glowFloat2 6s ease-in-out infinite alternate;
  }


  @keyframes glowFloat1 {

    from {
      transform: translate(0,0);
    }

    to {
      transform: translate(-80px,80px);
    }

  }


  @keyframes glowFloat2 {

    from {
      transform: translate(0,0);
    }

    to {
      transform: translate(80px,-70px);
    }

  }


  /* =====================================
     SCAN
  ===================================== */

  .intro-scan {
    position: absolute;

    left: 0;
    right: 0;

    height: 1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(96,165,250,.9),
        white,
        rgba(96,165,250,.9),
        transparent
      );

    box-shadow:
      0 0 12px rgba(59,130,246,.8),
      0 0 40px rgba(37,99,235,.4);

    opacity: 0;

    animation:
      scanMove 2.8s ease-in-out .5s infinite;
  }


  @keyframes scanMove {

    0% {
      top: -5%;
      opacity: 0;
    }

    10% {
      opacity: .8;
    }

    80% {
      opacity: .35;
    }

    100% {
      top: 105%;
      opacity: 0;
    }

  }


  /* =====================================
     CENTER
  ===================================== */

  .intro-center {
    position: relative;
    z-index: 5;

    width: min(900px, 90vw);

    text-align: center;
  }


  /* =====================================
     LINES
  ===================================== */

  .intro-line {
    width: 0;
    height: 1px;

    margin-left: auto;
    margin-right: auto;

    background:
      linear-gradient(
        90deg,
        transparent,
        #60a5fa,
        #dbeafe,
        #60a5fa,
        transparent
      );

    box-shadow:
      0 0 10px rgba(96,165,250,.8),
      0 0 30px rgba(37,99,235,.4);

    animation:
      introLineReveal .9s cubic-bezier(.16,1,.3,1) .2s forwards;
  }


  .intro-line-bottom {
    margin-top: 22px;

    animation-delay: 1.8s;
  }


  @keyframes introLineReveal {

    from {
      width: 0;
      opacity: 0;
    }

    to {
      width: min(600px, 75vw);
      opacity: 1;
    }

  }


  /* =====================================
     LABEL
  ===================================== */

  .intro-label {

    margin-top: 25px;

    display: flex;

    justify-content: center;
    align-items: center;

    gap: 12px;

    color: rgba(191,219,254,.7);

    font-size: 10px;
    font-weight: 700;

    letter-spacing: .45em;

    opacity: 0;

    transform: translateY(10px);

    animation:
      introFadeUp .7s ease-out .35s forwards;
  }


  .intro-dot {

    width: 5px;
    height: 5px;

    border-radius: 50%;

    background: #60a5fa;

    box-shadow:
      0 0 8px #60a5fa,
      0 0 18px rgba(59,130,246,.8);

    animation: dotPulse 1.4s ease-in-out infinite alternate;
  }


  @keyframes dotPulse {

    from {
      opacity: .35;
      transform: scale(.8);
    }

    to {
      opacity: 1;
      transform: scale(1.2);
    }

  }


  /* =====================================
     LOGO
  ===================================== */

  .intro-logo-wrap {

    position: relative;

    display: inline-block;

    margin-top: 28px;

    overflow: hidden;
  }


  .intro-logo {

    position: relative;

    font-size: clamp(
      3.2rem,
      10vw,
      7.5rem
    );

    line-height: .95;

    font-weight: 900;

    letter-spacing: .16em;

    color: #f8fafc;

    opacity: 0;

    transform:
      translateY(30px)
      scale(.82);

    filter: blur(12px);

    animation:
      logoReveal 1.2s cubic-bezier(.16,1,.3,1) .65s forwards,
      logoPulse 2.8s ease-in-out 2s infinite alternate;
  }


  .intro-logo span {

    color: #60a5fa;

    text-shadow:
      0 0 18px rgba(96,165,250,.35),
      0 0 55px rgba(37,99,235,.2);
  }


  /* Ghost logo behind */

  .intro-logo-shadow {

    position: absolute;

    inset: 0;

    display: flex;

    justify-content: center;
    align-items: center;

    font-size: inherit;

    font-weight: 900;

    letter-spacing: .16em;

    color: transparent;

    -webkit-text-stroke:
      1px rgba(96,165,250,.07);

    transform: scale(1.08);

    filter: blur(2px);

    pointer-events: none;
  }


  /* Shine */

  .intro-shine {

    position: absolute;

    top: -20%;
    left: -80%;

    width: 35%;
    height: 150%;

    transform: skewX(-20deg);

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(255,255,255,.8),
        transparent
      );

    filter: blur(8px);

    animation:
      shineMove 2.8s ease-in-out 1.8s infinite;
  }


  @keyframes shineMove {

    0% {
      left: -80%;
    }

    55% {
      left: 140%;
    }

    100% {
      left: 140%;
    }

  }


  @keyframes logoReveal {

    0% {
      opacity: 0;
      transform:
        translateY(30px)
        scale(.82);
      filter: blur(12px);
    }

    65% {
      opacity: 1;
      transform:
        translateY(-7px)
        scale(1.02);
      filter: blur(0);
    }

    100% {
      opacity: 1;
      transform:
        translateY(0)
        scale(1);
      filter: blur(0);
    }

  }


  @keyframes logoPulse {

    from {

      text-shadow:
        0 0 0 rgba(96,165,250,0);

    }

    to {

      text-shadow:
        0 0 20px rgba(96,165,250,.25),
        0 0 60px rgba(37,99,235,.15);

    }

  }


  /* =====================================
     SUBTITLE
  ===================================== */

  .intro-subtitle {

    margin-top: 20px;

    color: rgba(191,219,254,.72);

    font-size: 10px;

    font-weight: 600;

    letter-spacing: .65em;

    opacity: 0;

    transform: translateY(14px);

    animation:
      introFadeUp .8s ease-out 1.65s forwards;
  }


  @keyframes introFadeUp {

    to {

      opacity: 1;

      transform: translateY(0);

    }

  }


  /* =====================================
     LOADING
  ===================================== */

  .intro-loading {

    width: min(360px, 65vw);

    margin:
      28px auto 0;

    opacity: 0;

    animation:
      introFadeUp .7s ease-out 2s forwards;
  }


  .intro-loading-text {

    display: flex;

    justify-content: space-between;

    margin-bottom: 7px;

    color: rgba(148,163,184,.55);

    font-size: 8px;

    font-weight: 700;

    letter-spacing: .25em;
  }


  .intro-loading-bar {

    width: 100%;
    height: 2px;

    overflow: hidden;

    background: rgba(148,163,184,.1);

    border-radius: 999px;
  }


  #intro-progress {

    width: 0%;
    height: 100%;

    background:
      linear-gradient(
        90deg,
        #1d4ed8,
        #60a5fa,
        #dbeafe
      );

    box-shadow:
      0 0 10px rgba(96,165,250,.8);

    animation:
      progressLoad 3s cubic-bezier(.16,1,.3,1) 1.7s forwards;
  }


  @keyframes progressLoad {

    0% {
      width: 0%;
    }

    100% {
      width: 100%;
    }

  }


  /* =====================================
     HUD
  ===================================== */

  .intro-hud {

    position: absolute;

    z-index: 5;

    left: 35px;
    right: 35px;

    display: flex;

    justify-content: space-between;

    color: rgba(148,163,184,.32);

    font-size: 8px;

    font-weight: 700;

    letter-spacing: .28em;

    opacity: 0;

    animation:
      hudReveal .8s ease-out 1.2s forwards;
  }


  .intro-hud-top {
    top: 28px;
  }


  .intro-hud-bottom {
    bottom: 28px;
  }


  @keyframes hudReveal {

    to {
      opacity: 1;
    }

  }


  /* =====================================
     CORNERS
  ===================================== */

  .intro-corner {

    position: absolute;

    width: 42px;
    height: 42px;

    border-color: rgba(96,165,250,.35);

    opacity: 0;

    animation:
      cornerReveal .8s ease-out .4s forwards;
  }


  .corner-tl {

    top: 28px;
    left: 28px;

    border-top: 1px solid;
    border-left: 1px solid;
  }


  .corner-tr {

    top: 28px;
    right: 28px;

    border-top: 1px solid;
    border-right: 1px solid;
  }


  .corner-bl {

    bottom: 28px;
    left: 28px;

    border-bottom: 1px solid;
    border-left: 1px solid;
  }


  .corner-br {

    bottom: 28px;
    right: 28px;

    border-bottom: 1px solid;
    border-right: 1px solid;
  }


  @keyframes cornerReveal {

    from {
      opacity: 0;
      transform: scale(.7);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }

  }


  /* =====================================
     EXIT
  ===================================== */

  @keyframes introFinalExit {

    0% {

      opacity: 1;

      transform:
        scale(1);

      filter: blur(0);

    }

    60% {

      opacity: 1;

      transform:
        scale(1.015);

    }

    100% {

      opacity: 0;

      transform:
        scale(1.06);

      filter: blur(8px);

      visibility: hidden;

      pointer-events: none;

    }

  }


  /* =====================================
     MOBILE
  ===================================== */

  @media (max-width: 640px) {

    .intro-hud {

      left: 18px;
      right: 18px;

      font-size: 7px;
    }

    .intro-corner {

      width: 28px;
      height: 28px;
    }

    .corner-tl,
    .corner-tr {

      top: 18px;
    }

    .corner-bl,
    .corner-br {

      bottom: 18px;
    }

    .corner-tl,
    .corner-bl {

      left: 18px;
    }

    .corner-tr,
    .corner-br {

      right: 18px;
    }

    .intro-label {

      font-size: 7px;

      letter-spacing: .28em;
    }

    .intro-subtitle {

      font-size: 7px;

      letter-spacing: .4em;
    }

    .intro-loading {

      width: 70vw;
    }

  }

</style>


<script>

  const progress =
    document.getElementById("intro-progress");

  const percent =
    document.getElementById("intro-percent");

  if (progress && percent) {

    const start = performance.now();

    const duration = 3000;

    function updateProgress(now) {

      const elapsed =
        now - start;

      const ratio =
        Math.min(elapsed / duration, 1);

      const value =
        Math.floor(ratio * 100);

      percent.textContent =
        `${String(value).padStart(2, "0")}%`;

      if (ratio < 1) {

        requestAnimationFrame(updateProgress);

      }

    }

    requestAnimationFrame(updateProgress);

  }

</script>



<!-- =========================================================
     ASIN STILL — ISOLATED HERO SECTION
========================================================= -->

<div id="asin-home-hero">
  <HomeLuxuryHero />
</div>





<div class="asin-steel-divider" aria-hidden="true">
  <svg viewBox="0 0 1440 100" preserveAspectRatio="none">
    <path
      d="M0 43 C180 85 300 8 490 40 S790 83 970 39 S1260 12 1440 42 L1440 100 L0 100 Z"
      fill="#020617"
    />
    <path
      d="M0 43 C180 85 300 8 490 40 S790 83 970 39 S1260 12 1440 42"
      fill="none"
      stroke="#9bb8d8"
      stroke-width="2"
    />
  </svg>
</div>



<!-- =========================================================
     TRUST & CERTIFICATIONS
========================================================= -->

<section
  id="asin-trust-section"
  class="relative z-10 w-full bg-slate-950 px-5 pt-8 pb-10 sm:px-10 lg:px-16 xl:px-24 2xl:px-32"
  dir="rtl"
>
  <div class="mx-auto max-w-[1500px]">

    <div class="grid gap-4 md:grid-cols-4">

      <!-- =================================================
           1. QUALITY CERTIFICATE
      ================================================== -->

      <div
        class="flex items-center gap-4 rounded-2xl border border-slate-800 bg-slate-900 px-5 py-3 shadow-lg shadow-black/10 transition-all duration-300 hover:-translate-y-1 hover:border-amber-400/20"
      >

        <div
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-amber-500/10 text-amber-400"
        >

          <svg
            class="h-6 w-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 3l2.1 4.25 4.69.68-3.4 3.31.8 4.67L12 13.7l-4.19 2.21.8-4.67-3.4-3.31 4.69-.68L12 3z"
            />

            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 18h6M10 21h4"
            />
          </svg>

        </div>

        <div class="min-w-0">

          <h4 class="text-sm font-bold text-white">
            گواهی آنالیز کیفیت
          </h4>

          <p class="mt-1 text-xs leading-5 text-slate-400">
            ارائه سرتیفیکیت آزمایشگاه کارخانه
          </p>

        </div>

      </div>


      <!-- =================================================
           2. OFFICIAL INVOICE
      ================================================== -->

