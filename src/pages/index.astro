    .asc-price{display:inline-flex;align-items:center;gap:.4rem;padding:.3rem .65rem;border-radius:999px;background:#ecfdf5;color:#0f766e;font-size:.74rem;font-weight:800}
    .asc-price i{width:7px;height:7px;border-radius:50%;background:#10b981;animation:asc-ping2 1.6s infinite}
    @keyframes asc-ping2{0%{box-shadow:0 0 0 0 rgba(16,185,129,.65)}100%{box-shadow:0 0 0 9px rgba(16,185,129,0)}}
    .asc-cta{display:inline-flex;align-items:center;gap:.35rem;padding:.4rem .8rem;border:1.5px solid var(--c);border-radius:10px;color:var(--c);font-size:.8rem;font-weight:800;transition:all .4s}
    .asc-cta svg{transition:transform .4s}
    .asc-card:hover .asc-cta{background:var(--c);color:#fff}
    .asc-card:hover .asc-cta svg{transform:translateX(-4px)}

    /* رسم شدن خطوط مقطع */
    .asc-draw *{stroke-dasharray:1;stroke-dashoffset:0}
    .asc-card.in .asc-draw *{animation:asc-draw 1.2s cubic-bezier(.6,0,.2,1) calc(var(--i)*70ms + 350ms) backwards}
    .asc-card:hover .asc-draw *{animation:asc-redraw 1.1s cubic-bezier(.6,0,.2,1) both}
    @keyframes asc-draw{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}
    @keyframes asc-redraw{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}

    /* نوار استعلام */
    .asc-bar{position:relative;overflow:hidden;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1rem;margin-top:2rem;padding:1.4rem 1.6rem;border-radius:18px;
      background:linear-gradient(120deg,#0b1f3a,#12335f 55%,#1d4f91);color:#fff}
    .asc-bar::before{content:"";position:absolute;top:0;bottom:0;left:-40%;width:30%;transform:skewX(-20deg);background:linear-gradient(90deg,transparent,rgba(255,255,255,.14),transparent);animation:asc-bar 5s ease-in-out infinite}
    @keyframes asc-bar{to{left:140%}}
    .asc-bar div{position:relative}
    .asc-bar strong{display:block;font-size:1.05rem;font-weight:800}
    .asc-bar span{display:block;margin-top:.25rem;font-size:.85rem;color:#bcd4f1}
    .asc-bar-btn{position:relative;padding:.8rem 1.5rem;border-radius:12px;background:linear-gradient(135deg,#fb923c,#ea580c);color:#fff;font-weight:800;font-size:.9rem;text-decoration:none;transition:all .4s}
    .asc-bar-btn:hover{transform:translateY(-3px) scale(1.03);box-shadow:0 14px 26px -10px rgba(234,88,12,.8)}

    @media(prefers-reduced-motion:reduce){
      .asc *,.asc *::before,.asc *::after{animation:none!important;transition-duration:.01ms!important}
      .asc-js .asc-card:not(.in){opacity:1}
    }
  </style>

  <script>
    const sec = document.getElementById('asc');
    if (sec) {
      sec.classList.add('asc-js');

      const reveal = (card: HTMLElement) => {
        card.classList.add('in');
        const el = card.querySelector<HTMLElement>('[data-count]');
        if (!el) return;
        const target = Number(el.dataset.count);
        setTimeout(() => {
          const t0 = performance.now();
          const tick = (t: number) => {
            const r = Math.min((t - t0) / 1400, 1);
            const v = Math.round(target * (1 - Math.pow(1 - r, 3)));
            el.textContent = `${v.toLocaleString('fa-IR')}+ محصول`;
            if (r < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }, Number(card.dataset.i) * 70);
      };

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              reveal(e.target as HTMLElement);
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.15 }
      );

      sec.querySelectorAll<HTMLElement>('.asc-card').forEach((card) => {
        io.observe(card);
        card.addEventListener('pointermove', (e: PointerEvent) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${e.clientX - r.left}px`);
          card.style.setProperty('--my', `${e.clientY - r.top}px`);
        });
      });
    }
  </script>

