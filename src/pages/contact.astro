---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const image = (name) => `${base}images/${name}`;

const advisors = [
  {
    name: "نام مشاور اول",
    role: "مشاور فروش مقاطع فولادی",
    phone: "09120000001",
    displayPhone: "۰۹۱۲ ۰۰۰ ۰۰۰۱",
    specialty: "استعلام قیمت و ثبت سفارش",
    initials: "م۱",
  },
  {
    name: "نام مشاور دوم",
    role: "مشاور فروش و پیگیری سفارش",
    phone: "09120000002",
    displayPhone: "۰۹۱۲ ۰۰۰ ۰۰۰۲",
    specialty: "هماهنگی تأمین و ارسال بار",
    initials: "م۲",
  },
];

const gallery = [
  {
    title: "میلگرد و محصولات ساختمانی",
    description: "تأمین مقاطع فولادی موردنیاز پروژه‌ها",
    image: "rebar.jpg",
    number: "01",
  },
  {
    title: "تیرآهن و مقاطع صنعتی",
    description: "انتخاب مقطع متناسب با مشخصات پروژه",
    image: "steel-beams.jpg",
    number: "02",
  },
  {
    title: "انبار و آماده‌سازی سفارش",
    description: "هماهنگی سفارش و فرایند تحویل",
    image: "steel-warehouse.jpg",
    number: "03",
  },
];

const officeAddress =
  "استان، شهر، خیابان، نام ساختمان، طبقه و واحد دفتر";

const officeMapUrl = "";
const officeMapEmbedUrl = "";
---

<BaseLayout
  title="تماس با ما | ASIN STILL"
  description="برای استعلام قیمت، دریافت مشاوره و هماهنگی تأمین مقاطع فولادی با مجموعه ASIN STILL در ارتباط باشید."
>
  <main class="contact-page" dir="rtl">
    <!-- HERO -->
    <section class="contact-hero">
      <div class="hero-grid"></div>
      <div class="hero-glow hero-glow-one"></div>
      <div class="hero-glow hero-glow-two"></div>

      <div class="hero-inner">
        <div class="hero-copy">
          <div class="eyebrow hero-eyebrow">
            <span class="status-dot"></span>
            ارتباط مستقیم با تیم فروش
          </div>

          <h1>
            برای تأمین فولاد پروژه‌تان،
            <span class="hero-highlight">کنار شما هستیم.</span>
          </h1>

          <p class="hero-description">
            از استعلام قیمت تا هماهنگی تأمین و ارسال؛
            برای انتخاب بهتر مقاطع فولادی، با تیم فروش ASIN STILL در ارتباط باشید.
          </p>

          <div class="hero-actions">
            <a href="#contact-form" class="button button-primary">
              <span>ثبت درخواست مشاوره</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 12H5M12 19l-7-7 7-7" />
              </svg>
            </a>

            <a href="#sales-advisors" class="button button-ghost">
              ارتباط با مشاوران
            </a>
          </div>

          <div class="hero-trust">
            <div class="trust-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 3 4.5 6v5.5c0 4.4 3.2 7.7 7.5 9.5 4.3-1.8 7.5-5.1 7.5-9.5V6L12 3Z" />
                <path d="m8.5 12 2.2 2.2 4.8-4.8" />
              </svg>
            </div>
            <div>
              <strong>همراه مطمئن پروژه شما</strong>
              <span>مشاوره، استعلام و هماهنگی تأمین</span>
            </div>
          </div>
        </div>

        <!-- Persian steel supply animation: only the hero visual is replaced -->
        <div class="hero-visual" aria-label="نمایش متحرک تأمین و ارسال مقاطع فولادی">
          <div class="visual-topline">
            <span class="visual-label">آسین استیل | تأمین فولاد</span>
            <span class="visual-live"><i></i> آماده همکاری</span>
          </div>

          <div class="visual-blueprint supply-scene">
            <div class="scene-glow"></div>
            <div class="scene-orbit orbit-a"></div>
            <div class="scene-orbit orbit-b"></div>
            <div class="scene-spark spark-a"></div>
            <div class="scene-spark spark-b"></div>
            <div class="scene-spark spark-c"></div>

            <div class="scene-heading">
              <span class="scene-kicker">از انتخاب تا تحویل</span>
              <strong>فولاد موردنیاز پروژه‌تان</strong>
              <small>در سه قدم ساده</small>
            </div>

            <div class="steel-stack" aria-hidden="true">
              <div class="steel-bar bar-back"></div>
              <div class="steel-bar bar-mid"></div>
              <div class="steel-bar bar-front"></div>
              <div class="bar-shine"></div>
            </div>

            <div class="scene-step step-order">
              <span class="step-icon">۱</span>
              <span>انتخاب محصول</span>
            </div>
            <div class="scene-step step-supply">
              <span class="step-icon">۲</span>
              <span>آماده‌سازی بار</span>
            </div>

            <div class="scene-road">
              <span class="road-dash dash-one"></span>
              <span class="road-dash dash-two"></span>
              <span class="road-dash dash-three"></span>
            </div>

            <div class="delivery-truck" aria-hidden="true">
              <div class="truck-load">
                <i></i><i></i><i></i>
              </div>
              <div class="truck-cab">
                <span class="truck-window"></span>
                <span class="truck-light"></span>
              </div>
              <div class="truck-body"></div>
              <div class="truck-wheel wheel-one"><i></i></div>
              <div class="truck-wheel wheel-two"><i></i></div>
            </div>

            <div class="scene-step step-delivery">
              <span class="step-icon">۳</span>
              <span>هماهنگی ارسال</span>
            </div>

            <div class="scene-bottom-note">
              <span class="note-check">✓</span>
              <span>از استعلام قیمت تا هماهنگی تحویل</span>
            </div>
          </div>

          <div class="visual-footer">
            <span>انتخاب آسان</span>
            <span class="visual-footer-line"></span>
            <span>تأمین فولاد</span>
            <span class="visual-footer-line"></span>
            <span>هماهنگی ارسال</span>
          </div>
        </div>
      </div>

      <div class="hero-bottom-line">
        <span>ASIN STILL</span>
        <span>راه ارتباطی شما با دنیای مقاطع فولادی</span>
        <a href="#contact-details">
          اطلاعات تماس
          <span>↓</span>
        </a>
      </div>
    </section>

    <!-- INTRO -->
    <section class="section intro-section" id="contact-details">
      <div class="section-heading">
        <span class="eyebrow">
          <span class="eyebrow-line"></span>
          در ارتباط باشیم
        </span>
        <h2>شروع یک همکاری، با یک <span>گفت‌وگو</span></h2>
        <p>
          برای دریافت اطلاعات محصولات، استعلام قیمت یا هماهنگی سفارش،
          راه‌های ارتباطی زیر را بررسی کنید یا درخواست خود را ثبت کنید.
        </p>
      </div>

      <div class="contact-info-grid">
        <article class="info-card info-card-featured">
          <div class="info-card-top">
            <div class="info-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 8.9a16 16 0 0 0 6 6l1.2-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.8 2.1Z" />
              </svg>
            </div>
            <span class="card-index">01 / CONTACT</span>
          </div>

          <h3>تماس با واحد فروش</h3>
          <p>
            برای دریافت مشاوره و پیگیری درخواست‌های خود، با شماره تماس
            تأییدشده مجموعه ارتباط بگیرید.
          </p>
          <span class="info-note">شماره تماس مجموعه را در این قسمت وارد کنید.</span>
        </article>

        <article class="info-card">
          <div class="info-card-top">
            <div class="info-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="m3 7 9 6 9-6" />
              </svg>
            </div>
            <span class="card-index">02 / EMAIL</span>
          </div>
          <h3>ارتباط از طریق ایمیل</h3>
          <p>
            برای ارسال درخواست‌های رسمی، مشخصات فنی و اطلاعات موردنیاز
            پروژه، ایمیل مجموعه را در این بخش قرار دهید.
          </p>
          <span class="info-note">نشانی ایمیل رسمی هنوز باید اضافه شود.</span>
        </article>

        <article class="info-card">
          <div class="info-card-top">
            <div class="info-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" />
                <circle cx="12" cy="10" r="2.5" />
              </svg>
            </div>
            <span class="card-index">03 / LOCATION</span>
          </div>
          <h3>موقعیت دفتر</h3>
          <p>
            نشانی دفتر مجموعه را بررسی کنید و برای هماهنگی مراجعه حضوری،
            از قبل با واحد فروش تماس بگیرید.
          </p>
          <a class="text-link" href="#office-location">
            مشاهده اطلاعات دفتر
            <span>←</span>
          </a>
        </article>
      </div>
    </section>

    <!-- CONTACT FORM -->
    <section class="section request-section" id="contact-form">
      <div class="request-layout">
        <div class="request-copy">
          <span class="eyebrow">
            <span class="eyebrow-line"></span>
            درخواست خود را ثبت کنید
          </span>

          <h2>نیاز پروژه شما،<br /><span>نقطه شروع ماست.</span></h2>

          <p>
            اطلاعات اولیه را وارد کنید تا درخواست شما برای بررسی و پیگیری
            آماده باشد. برای دریافت پاسخ واقعی، فرم باید به سامانه ارسال
            اطلاعات متصل شود.
          </p>

          <div class="request-points">
            <div class="request-point">
              <span class="point-check">✓</span>
              <div>
                <strong>مشخصات درخواست</strong>
                <p>نوع مقطع و مقدار موردنیاز را مشخص کنید.</p>
              </div>
            </div>

            <div class="request-point">
              <span class="point-check">✓</span>
              <div>
                <strong>اطلاعات تماس</strong>
                <p>شماره همراه خود را برای پیگیری وارد کنید.</p>
              </div>
            </div>

            <div class="request-point">
              <span class="point-check">✓</span>
              <div>
                <strong>بررسی نیاز پروژه</strong>
                <p>جزئیات تکمیلی را در بخش توضیحات بنویسید.</p>
              </div>
            </div>
          </div>

          <div class="request-decoration">
            <span class="decoration-line"></span>
            <span>YOUR PROJECT. OUR PRIORITY.</span>
          </div>
        </div>

        <div class="form-panel">
          <div class="form-panel-heading">
            <div>
              <span class="form-overline">CONTACT FORM / 01</span>
              <h3>فرم درخواست مشاوره</h3>
            </div>
            <div class="form-heading-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" />
                <path d="M14 2v6h6M8 13h8M8 17h8" />
              </svg>
            </div>
          </div>

          <form id="contact-request-form" class="contact-form">
            <div class="form-row">
              <label class="form-field">
                <span>نام و نام خانوادگی <b>*</b></span>
                <input
                  type="text"
                  name="name"
                  placeholder="نام خود را وارد کنید"
                  autocomplete="name"
                  required
                />
              </label>

              <label class="form-field">
                <span>شماره همراه <b>*</b></span>
                <input
                  type="tel"
                  name="mobile"
                  placeholder="مثلاً ۰۹۱۲۱۲۳۴۵۶۷"
                  autocomplete="tel"
                  inputmode="tel"
                  pattern="[0-9۰-۹+\s()-]{10,20}"
                  required
                />
              </label>
            </div>

            <div class="form-row">
              <label class="form-field">
                <span>محصول موردنیاز</span>
                <select name="product">
                  <option value="">انتخاب نوع مقطع</option>
                  <option value="rebar">میلگرد</option>
                  <option value="beam">تیرآهن</option>
                  <option value="sheet">ورق فولادی</option>
                  <option value="profile">قوطی و پروفیل</option>
                  <option value="channel">ناودانی و نبشی</option>
                  <option value="other">سایر مقاطع فولادی</option>
                </select>
              </label>

              <label class="form-field">
                <span>شهر محل تحویل</span>
                <input
                  type="text"
                  name="city"
                  placeholder="شهر مقصد را وارد کنید"
                  autocomplete="address-level2"
                />
              </label>
            </div>

            <label class="form-field">
              <span>مقدار موردنیاز</span>
              <input
                type="text"
                name="quantity"
                placeholder="مثلاً ۵ تن یا ۱۰۰ شاخه"
              />
            </label>

            <label class="form-field">
              <span>توضیحات تکمیلی</span>
              <textarea
                name="message"
                rows="4"
                placeholder="ابعاد، گرید، استاندارد یا سایر جزئیات موردنیاز..."
              ></textarea>
            </label>

            <button type="submit" class="button button-primary submit-button">
              <span>ثبت درخواست</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 12H5M12 19l-7-7 7-7" />
              </svg>
            </button>

            <p
              id="form-status"
              class="form-status"
              role="status"
              aria-live="polite"
            ></p>

            <p class="form-privacy">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="4" y="10" width="16" height="11" rx="2" />
                <path d="M8 10V7a4 4 0 1 1 8 0v3" />
              </svg>
              این فرم در حال حاضر به سامانه دریافت درخواست متصل نیست.
            </p>
          </form>
        </div>
      </div>
    </section>

    <!-- SALES ADVISORS -->
    <section class="section advisors-section" id="sales-advisors">
      <div class="section-heading section-heading-row">
        <div>
          <span class="eyebrow">
            <span class="eyebrow-line"></span>
            تیم فروش
          </span>
          <h2>ارتباط مستقیم با <span>مشاوران فروش</span></h2>
          <p>
            اطلاعات اعضای تیم را در این قسمت قرار دهید تا مشتریان بتوانند
            برای پیگیری سفارش و استعلام قیمت با فرد موردنظر ارتباط بگیرند.
          </p>
        </div>

        <div class="heading-side-mark">
          <span>AS</span>
          <i></i>
          <small>SALES TEAM</small>
        </div>
      </div>

      <div class="advisors-grid">
        {advisors.map((advisor, index) => (
          <article class="advisor-card">
            <div class="advisor-top">
              <span class="advisor-number">
                ADVISOR / 0{index + 1}
              </span>
              <span class="advisor-status">
                <i></i>
                واحد فروش
              </span>
            </div>

            <div class="advisor-profile">
              <div class="advisor-avatar">
                <span>{advisor.initials}</span>
                <div class="avatar-orbit"></div>
              </div>

              <div class="advisor-info">
                <h3>{advisor.name}</h3>
                <p>{advisor.role}</p>
              </div>
            </div>

            <div class="advisor-specialty">
              <span class="specialty-icon">↗</span>
              <span>{advisor.specialty}</span>
            </div>

            <a
              href={`tel:${advisor.phone}`}
              class="advisor-call"
              aria-label={`تماس با ${advisor.name}`}
            >
              <span>تماس با مشاور</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 8.9a16 16 0 0 0 6 6l1.2-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.8 2.1Z" />
              </svg>
            </a>
          </article>
        ))}
      </div>

      <div class="advisor-warning">
        <span>!</span>
        شماره‌ها و نام‌های بالا نمونه هستند؛ پیش از انتشار سایت، اطلاعات واقعی را جایگزین کنید.
      </div>
    </section>

    <!-- OFFICE -->
    <section class="section office-section" id="office-location">
      <div class="office-layout">
        <div class="office-copy">
          <span class="eyebrow">
            <span class="eyebrow-line"></span>
            موقعیت مکانی
          </span>

          <h2>از نزدیک،<br /><span>در دسترس شما هستیم.</span></h2>

          <p>
            نشانی دفتر و اطلاعات مراجعه حضوری را در این بخش قرار دهید.
            برای جلوگیری از مراجعه اشتباه، آدرس نهایی را پیش از انتشار
            بررسی و تکمیل کنید.
          </p>

          <div class="office-detail">
            <div class="office-detail-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" />
                <circle cx="12" cy="10" r="2.5" />
              </svg>
            </div>
            <div>
              <span>نشانی دفتر</span>
              <strong>{officeAddress}</strong>
            </div>
          </div>

          <div class="office-detail">
            <div class="office-detail-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v5l3 2" />
              </svg>
            </div>
            <div>
              <span>زمان مراجعه</span>
              <strong>ساعات کاری را با مجموعه هماهنگ کنید.</strong>
            </div>
          </div>

          {officeMapUrl && (
            <a
              href={officeMapUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="button button-primary office-map-button"
            >
              مشاهده روی نقشه
              <span>↗</span>
            </a>
          )}
        </div>

        <div class="office-map-card">
          <div class="map-topbar">
            <div>
              <span class="map-overline">LOCATION / ASIN STILL</span>
              <strong>موقعیت دفتر مجموعه</strong>
            </div>
            <span class="map-coordinate">MAP 01</span>
          </div>

          {officeMapEmbedUrl ? (
            <iframe
              src={officeMapEmbedUrl}
              title="موقعیت دفتر ASIN STILL روی نقشه"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
          ) : (
            <div class="map-placeholder">
              <div class="map-contour contour-one"></div>
              <div class="map-contour contour-two"></div>
              <div class="map-contour contour-three"></div>
              <div class="map-road road-one"></div>
              <div class="map-road road-two"></div>
              <div class="map-road road-three"></div>

              <div class="map-marker">
                <span class="marker-pulse"></span>
                <div class="marker-pin">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" />
                    <circle cx="12" cy="10" r="2.5" />
                  </svg>
                </div>
              </div>

              <div class="map-label">
                <strong>ASIN STILL</strong>
                <span>موقعیت دفتر پس از ثبت آدرس نمایش داده می‌شود.</span>
              </div>

              <span class="map-grid-label map-grid-a">N 35°</span>
              <span class="map-grid-label map-grid-b">E 51°</span>
              <span class="map-grid-label map-grid-c">LOCATION DATA</span>
            </div>
          )}

          <div class="map-bottom">
            <span class="map-bottom-dot"></span>
