  </main>

  <style>
    :root {
      --contact-bg: #07111f;
      --contact-bg-deep: #050b14;
      --contact-panel: #0d1a2b;
      --contact-panel-light: #10233a;
      --contact-border: rgba(138, 180, 225, 0.15);
      --contact-blue: #3299ff;
      --contact-blue-light: #8bceff;
      --contact-text: #f0f6ff;
      --contact-muted: #a1b1c6;
      --contact-dim: #6f829c;
    }

    .contact-page {
      overflow: hidden;
      background: var(--contact-bg);
      color: var(--contact-text);
      font-family: inherit;
      line-height: 1.9;
    }

    .contact-page *,
    .contact-page *::before,
    .contact-page *::after {
      box-sizing: border-box;
    }

    .contact-page a {
      color: inherit;
      text-decoration: none;
    }

    .contact-page button,
    .contact-page input,
    .contact-page select,
    .contact-page textarea {
      font: inherit;
    }

    .contact-page svg {
      width: 24px;
      height: 24px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.7;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .section {
      width: min(1200px, calc(100% - 48px));
      margin-inline: auto;
      padding-block: 100px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      color: var(--contact-blue-light);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.3px;
    }

    .eyebrow-line {
      display: inline-block;
      width: 25px;
      height: 2px;
      background: var(--contact-blue);
      box-shadow: 0 0 12px rgba(50, 153, 255, 0.65);
    }

    .section-heading {
      max-width: 760px;
      margin: 0 auto 44px;
      text-align: center;
    }

    .section-heading h2,
    .request-copy h2,
    .office-copy h2,
    .delivery-copy h2,
    .faq-intro h2 {
      margin: 15px 0;
      color: var(--contact-text);
      font-size: clamp(27px, 3.3vw, 39px);
      font-weight: 850;
      line-height: 1.65;
      letter-spacing: -1.2px;
    }

    .section-heading h2 span,
    .request-copy h2 span,
    .office-copy h2 span,
    .delivery-copy h2 span,
    .faq-intro h2 span {
      color: var(--contact-blue-light);
    }

    .section-heading > p,
    .section-heading-row > div:first-child > p {
      max-width: 650px;
      margin: 0 auto;
      color: var(--contact-muted);
      font-size: 14px;
      line-height: 2.2;
    }

    .section-heading-row {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 28px;
      max-width: none;
      text-align: right;
    }

    .section-heading-row h2 {
      margin-bottom: 8px;
    }

    .section-heading-row > div:first-child > p {
      margin-inline: 0;
    }

    /* HERO */

    .contact-hero {
      position: relative;
      isolation: isolate;
      min-height: 640px;
      overflow: hidden;
      padding: 75px max(24px, calc((100% - 1200px) / 2)) 0;
      background:
        radial-gradient(ellipse at 77% 42%, rgba(24, 94, 163, 0.19), transparent 38%),
        linear-gradient(130deg, #081321 0%, #07111e 50%, #09182a 100%);
      border-bottom: 1px solid rgba(91, 159, 224, 0.2);
    }

    .hero-grid,
    .delivery-grid,
    .cta-grid {
      position: absolute;
      z-index: -1;
      inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(116, 169, 222, 0.055) 1px, transparent 1px),
        linear-gradient(90deg, rgba(116, 169, 222, 0.055) 1px, transparent 1px);
      background-size: 42px 42px;
      mask-image: linear-gradient(to bottom, black, transparent 95%);
    }

    .hero-glow {
      position: absolute;
      z-index: -1;
      width: 350px;
      height: 350px;
      border-radius: 50%;
      filter: blur(100px);
      pointer-events: none;
    }

    .hero-glow-one {
      top: 100px;
      left: 16%;
      background: rgba(19, 105, 206, 0.15);
    }

    .hero-glow-two {
      right: 8%;
      bottom: 30px;
      background: rgba(39, 139, 242, 0.08);
    }

    .hero-inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 40px;
      width: 100%;
      max-width: 1200px;
      min-height: 490px;
      margin: auto;
      padding-bottom: 40px;
    }

    .hero-copy {
      position: relative;
      z-index: 2;
      padding-block: 20px;
      animation: hero-copy-enter 0.8s ease both;
    }

    .hero-eyebrow {
      padding: 7px 12px;
      border: 1px solid rgba(113, 179, 243, 0.2);
      border-radius: 100px;
      background: rgba(35, 92, 149, 0.12);
    }

    .status-dot,
    .advisor-status i,
    .map-bottom-dot {
      width: 7px;
      height: 7px;
      flex: 0 0 7px;
      border-radius: 50%;
      background: #55c6ff;
      box-shadow: 0 0 12px rgba(85, 198, 255, 0.85);
    }

    .hero-copy h1 {
      max-width: 590px;
      margin: 25px 0 15px;
      color: #f5f9ff;
      font-size: clamp(32px, 4.2vw, 53px);
      font-weight: 900;
      line-height: 1.65;
      letter-spacing: -1.7px;
    }

    .hero-highlight {
      display: inline-block;
      color: var(--contact-blue-light);
      text-shadow: 0 0 30px rgba(71, 163, 255, 0.16);
    }

    .hero-description {
      max-width: 520px;
      margin: 0;
      color: #a7b7cb;
      font-size: 15px;
      line-height: 2.25;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
      margin-top: 27px;
    }

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      min-height: 50px;
      padding: 12px 21px;
      border: 1px solid transparent;
      border-radius: 8px;
      cursor: pointer;
      font-size: 13px;
      font-weight: 800;
      transition:
        transform 0.25s ease,
        background 0.25s ease,
        border-color 0.25s ease,
        box-shadow 0.25s ease;
    }

    .button svg {
      width: 19px;
      height: 19px;
      transition: transform 0.25s ease;
    }

    .button:hover {
      transform: translateY(-3px);
    }

    .button:hover svg {
      transform: translateX(-3px);
    }

    .button-primary {
      color: white !important;
      background: linear-gradient(120deg, #1679df, #328fff);
      box-shadow: 0 8px 26px rgba(24, 119, 226, 0.18);
    }

    .button-primary:hover {
      background: linear-gradient(120deg, #268cf2, #58a9ff);
      box-shadow: 0 12px 34px rgba(24, 119, 226, 0.3);
    }

    .button-ghost {
      border-color: rgba(150, 187, 226, 0.22);
      color: #dbe9fa !important;
      background: rgba(255, 255, 255, 0.025);
    }

    .button-ghost:hover {
      border-color: rgba(97, 174, 255, 0.55);
      background: rgba(51, 133, 213, 0.1);
    }

    .hero-trust {
      display: flex;
      align-items: center;
      gap: 13px;
      margin-top: 36px;
    }

    .trust-icon {
      display: grid;
      width: 43px;
      height: 43px;
      place-items: center;
      border: 1px solid rgba(94, 173, 255, 0.24);
      border-radius: 12px;
      color: var(--contact-blue-light);
      background: rgba(49, 138, 225, 0.1);
    }

    .trust-icon svg {
      width: 23px;
      height: 23px;
    }

    .hero-trust strong,
    .hero-trust span {
      display: block;
    }

    .hero-trust strong {
      color: #e7f1ff;
      font-size: 13px;
    }

    .hero-trust div:last-child span {
      color: #8094ae;
      font-size: 11px;
    }

    /* HERO INDUSTRIAL VISUAL */

    .hero-visual {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 550px;
      margin-inline: auto;
      animation: visual-enter 1s ease both;
    }

    .visual-topline,
    .visual-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      color: #6887a9;
      font-family: monospace;
      font-size: 9px;
      letter-spacing: 1px;
    }

    .visual-live {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 5px 9px;
      border: 1px solid rgba(89, 165, 237, 0.2);
      border-radius: 4px;
      color: #9ecfff;
      background: rgba(44, 112, 178, 0.08);
    }

    .visual-live i {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: #48b9ff;
      box-shadow: 0 0 8px #48b9ff;
    }

    .visual-blueprint {
      position: relative;
      min-height: 365px;
      overflow: hidden;
      margin-block: 12px;
      border: 1px solid rgba(106, 165, 225, 0.19);
      border-radius: 14px;
      background:
        radial-gradient(ellipse at 50% 55%, rgba(32, 111, 195, 0.16), transparent 55%),
        linear-gradient(145deg, rgba(14, 37, 62, 0.78), rgba(5, 16, 29, 0.94));
      box-shadow:
        0 30px 80px rgba(0, 0, 0, 0.2),
        inset 0 0 70px rgba(26, 99, 168, 0.08);
    }

    .visual-blueprint::before {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(93, 154, 210, 0.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(93, 154, 210, 0.07) 1px, transparent 1px);
      background-size: 24px 24px;
      content: "";
      mask-image: linear-gradient(135deg, black, transparent 95%);
    }

    .visual-blueprint::after {
      position: absolute;
      inset: 12px;
      border: 1px solid rgba(95, 157, 215, 0.08);
      border-radius: 8px;
      pointer-events: none;
      content: "";
    }

    .steel-beam-svg {
      position: absolute;
      z-index: 2;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    .beam-model {
      transform-origin: 260px 180px;
      animation: beam-float 5s ease-in-out infinite;
    }

    .beam-scan {
      stroke-dasharray: 120 600;
      animation: beam-scan 4.5s ease-in-out infinite;
    }

    .blueprint-cross {
      position: absolute;
      z-index: 1;
      width: 15px;
      height: 15px;
      opacity: 0.5;
    }

    .blueprint-cross::before,
    .blueprint-cross::after {
      position: absolute;
      background: #6fb7f5;
      content: "";
    }

    .blueprint-cross::before {
      top: 7px;
      left: 0;
      width: 15px;
      height: 1px;
    }

    .blueprint-cross::after {
      top: 0;
      left: 7px;
      width: 1px;
      height: 15px;
    }

    .cross-one {
      top: 50px;
      right: 50px;
    }

    .cross-two {
      bottom: 55px;
      left: 42px;
    }

    .blueprint-ring {
      position: absolute;
      z-index: 1;
      border: 1px solid rgba(85, 157, 226, 0.18);
      border-radius: 50%;
    }

    .ring-one {
      top: 50%;
      left: 50%;
      width: 280px;
      height: 280px;
      transform: translate(-50%, -50%);
    }

    .ring-two {
      top: 50%;
      left: 50%;
      width: 220px;
      height: 220px;
      border-style: dashed;
      transform: translate(-50%, -50%);
      animation: ring-rotate 30s linear infinite;
    }

    .visual-tag {
      position: absolute;
      z-index: 3;
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 9px 12px;
      border: 1px solid rgba(108, 176, 242, 0.2);
      border-radius: 7px;
      background: rgba(5, 19, 34, 0.88);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.17);
      backdrop-filter: blur(12px);
    }

    .tag-top {
      top: 34px;
      left: 23px;
    }

    .tag-bottom {
      right: 22px;
      bottom: 35px;
    }

    .visual-tag strong,
    .visual-tag small {
      display: block;
    }

    .visual-tag strong {
      color: #d9edff;
      font-family: monospace;
      font-size: 10px;
      letter-spacing: 0.6px;
    }

    .visual-tag small {
      color: #7897b8;
      font-size: 9px;
    }

    .tag-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #59b7ff;
      box-shadow: 0 0 12px #278fff;
    }

    .tag-number {
      display: grid;
      width: 31px;
      height: 31px;
      place-items: center;
      border-radius: 5px;
      color: #bce2ff;
      background: rgba(45, 139, 229, 0.18);
      font-family: monospace;
      font-size: 12px;
    }

    .visual-coordinate {
      position: absolute;
      right: 17px;
      top: 15px;
      z-index: 3;
      color: rgba(145, 195, 241, 0.56);
      font-family: monospace;
      font-size: 8px;
      letter-spacing: 0.6px;
    }

    .visual-footer {
      justify-content: center;
      gap: 12px;
      padding-block: 5px;
      color: #7896b5;
      font-size: 8px;
    }

    .visual-footer-line {
      width: 22px;
      height: 1px;
      background: #28496d;
    }

    .hero-bottom-line {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      min-height: 57px;
      border-top: 1px solid rgba(124, 169, 215, 0.13);
      color: #758ca8;
      font-size: 10px;
    }

    .hero-bottom-line > span:first-child {
      color: #a5c9ee;
      font-family: monospace;
      font-size: 11px;
      letter-spacing: 1px;
    }

    .hero-bottom-line a {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      color: #b4c9e2;
      transition: color 0.2s ease;
    }

    .hero-bottom-line a:hover {
      color: white;
    }

    .hero-bottom-line a span {
      color: #55afff;
      font-size: 16px;
    }

    /* CONTACT INFORMATION */

    .intro-section {
      padding-top: 95px;
    }

    .contact-info-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 17px;
    }

    .info-card {
      position: relative;
      min-width: 0;
      padding: 25px;
      overflow: hidden;
      border: 1px solid var(--contact-border);
      border-radius: 13px;
      background: linear-gradient(145deg, #0d1c2e, #0a1625);
      transition:
        transform 0.25s ease,
        border-color 0.25s ease,
        background 0.25s ease;
    }

    .info-card::after {
      position: absolute;
      right: 0;
      bottom: 0;
      left: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, #318ff0, transparent);
      opacity: 0;
      content: "";
      transition: opacity 0.25s ease;
    }

    .info-card:hover {
      transform: translateY(-5px);
      border-color: rgba(79, 157, 235, 0.4);
      background: linear-gradient(145deg, #10233a, #0b192a);
    }

    .info-card:hover::after {
      opacity: 1;
    }

    .info-card-featured {
      border-color: rgba(64, 149, 236, 0.3);
      background:
        radial-gradient(ellipse at 100% 0%, rgba(39, 129, 224, 0.12), transparent 60%),
        linear-gradient(145deg, #10243b, #0b1829);
    }

    .info-card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 25px;
    }

    .info-icon {
      display: grid;
      width: 49px;
      height: 49px;
      place-items: center;
      border: 1px solid rgba(86, 163, 239, 0.24);
      border-radius: 12px;
      color: #80c3ff;
      background: rgba(43, 128, 213, 0.12);
    }

    .info-icon svg {
      width: 23px;
      height: 23px;
    }

    .card-index {
      color: #637d9b;
      font-family: monospace;
      font-size: 9px;
      letter-spacing: 0.6px;
    }

    .info-card h3 {
      margin: 0 0 9px;
      color: #edf5ff;
      font-size: 17px;
      font-weight: 800;
    }

    .info-card > p {
      min-height: 78px;
      margin: 0;
      color: #92a6bf;
      font-size: 12px;
      line-height: 2.2;
    }

    .info-note {
      display: inline-block;
      margin-top: 16px;
      color: #78baff;
      font-size: 10px;
    }

    .text-link {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-top: 16px;
      color: #83c2ff !important;
      font-size: 12px;
      font-weight: 700;
    }

    .text-link span {
      transition: transform 0.2s ease;
    }

    .text-link:hover span {
      transform: translateX(-4px);
    }

    /* FORM */

    .request-section {
      width: 100%;
      max-width: none;
      padding-inline: max(24px, calc((100% - 1200px) / 2));
      background:
        radial-gradient(ellipse at 5% 60%, rgba(26, 90, 159, 0.1), transparent 36%),
        #091522;
      border-block: 1px solid rgba(114, 164, 216, 0.1);
    }

    .request-layout {
      display: grid;
      grid-template-columns: 0.88fr 1.12fr;
      align-items: start;
      gap: 65px;
      max-width: 1200px;
      margin: auto;
    }

    .request-copy {
      padding-top: 25px;
    }

    .request-copy h2 {
      margin-block: 20px 12px;
      font-size: clamp(30px, 3.6vw, 43px);
    }

    .request-copy > p,
    .office-copy > p,
    .delivery-copy > p,
    .faq-intro > p {
      color: var(--contact-muted);
      font-size: 13px;
      line-height: 2.3;
    }

    .request-points {
      display: grid;
      gap: 22px;
      margin-top: 32px;
    }

    .request-point {
      display: flex;
      align-items: flex-start;
      gap: 13px;
    }

    .point-check {
      display: grid;
      width: 27px;
      height: 27px;
      flex: 0 0 27px;
      place-items: center;
      border: 1px solid rgba(72, 157, 242, 0.3);
      border-radius: 50%;
      color: #84c6ff;
      background: rgba(48, 129, 209, 0.13);
      font-size: 13px;
    }

    .request-point strong {
      display: block;
      color: #e1edfc;
      font-size: 13px;
    }

    .request-point p {
      margin: 2px 0 0;
      color: #8196b0;
      font-size: 11px;
    }

    .request-decoration {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 45px;
      color: #496987;
      font-family: monospace;
      font-size: 9px;
      letter-spacing: 1.3px;
    }

    .decoration-line {
      width: 36px;
      height: 1px;
      background: #328de9;
    }

    .form-panel {
      padding: 31px;
      border: 1px solid rgba(117, 171, 228, 0.18);
      border-radius: 15px;
      background: linear-gradient(145deg, #101f32, #0b1726);
      box-shadow: 0 24px 65px rgba(0, 0, 0, 0.16);
    }

    .form-panel-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      padding-bottom: 22px;
      border-bottom: 1px solid rgba(130, 170, 215, 0.12);
    }

    .form-overline {
      display: block;
      color: #649bd2;
      font-family: monospace;
      font-size: 9px;
      letter-spacing: 1px;
    }

    .form-panel-heading h3 {
      margin: 4px 0 0;
      color: #f0f6ff;
      font-size: 20px;
      font-weight: 850;
    }

    .form-heading-icon {
      display: grid;
      width: 47px;
      height: 47px;
      place-items: center;
      border: 1px solid rgba(77, 158, 241, 0.23);
      border-radius: 11px;
      color: #83c4ff;
      background: rgba(38, 121, 206, 0.1);
    }

    .form-heading-icon svg {
      width: 24px;
      height: 24px;
    }

    .contact-form {
      display: grid;
      gap: 17px;
      padding-top: 22px;
    }

    .form-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .form-field {
      display: grid;
      align-content: start;
      gap: 8px;
      min-width: 0;
    }

    .form-field > span {
      color: #c8d8ea;
      font-size: 12px;
      font-weight: 700;
    }

    .form-field b {
      color: #69baff;
    }

    .form-field input,
    .form-field select,
    .form-field textarea {
      width: 100%;
      min-width: 0;
      border: 1px solid rgba(130, 171, 214, 0.16);
      border-radius: 7px;
      outline: none;
      color: #ecf5ff;
      background: #0a1523;
      font-size: 12px;
      transition:
        border-color 0.2s ease,
        background 0.2s ease,
        box-shadow 0.2s ease;
    }

    .form-field input,
    .form-field select {
      min-height: 47px;
      padding: 10px 13px;
    }

    .form-field textarea {
      min-height: 110px;
      padding: 12px 13px;
      resize: vertical;
    }

    .form-field input::placeholder,
    .form-field textarea::placeholder {
      color: #5e728b;
    }

    .form-field select {
      color-scheme: dark;
      cursor: pointer;
    }

    .form-field input:focus,
    .form-field select:focus,
    .form-field textarea:focus {
      border-color: rgba(74, 163, 255, 0.75);
      background: #0c1b2c;
      box-shadow: 0 0 0 3px rgba(48, 139, 229, 0.09);
    }

    .submit-button {
      width: 100%;
      margin-top: 2px;
    }

    .form-status {
      display: none;
      margin: 0;
      padding: 11px 13px;
      border: 1px solid rgba(87, 173, 255, 0.26);
      border-radius: 7px;
      color: #b8ddff;
      background: rgba(39, 120, 205, 0.1);
      font-size: 11px;
      line-height: 1.9;
    }

    .form-status.is-visible {
      display: block;
    }

    .form-privacy {
      display: flex;
      align-items: center;
      gap: 8px;
      margin: 0;
      color: #70849d;
      font-size: 10px;
      line-height: 1.9;
    }

    .form-privacy svg {
      width: 15px;
      height: 15px;
      flex: 0 0 15px;
      color: #5c9ddc;
    }

    /* ADVISORS */

    .heading-side-mark {
      display: flex;
      flex: 0 0 auto;
      align-items: center;
      gap: 9px;
      color: #5b7ea5;
    }

    .heading-side-mark > span {
      color: #244e79;
      font-family: monospace;
      font-size: 36px;
      font-weight: 900;
      letter-spacing: -3px;
    }

    .heading-side-mark > i {
      width: 24px;
      height: 2px;
      background: #328fe9;
    }

    .heading-side-mark small {
      font-family: monospace;
      font-size: 9px;
      letter-spacing: 1px;
    }

    .advisors-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .advisor-card {
      position: relative;
      padding: 24px;
      overflow: hidden;
      border: 1px solid var(--contact-border);
      border-radius: 13px;
      background: linear-gradient(145deg, #102037, #0b1726);
      transition:
        transform 0.25s ease,
        border-color 0.25s ease;
    }

    .advisor-card::before {
      position: absolute;
      top: -55px;
      left: -55px;
      width: 160px;
      height: 160px;
      border: 1px solid rgba(77, 151, 225, 0.1);
      border-radius: 50%;
      box-shadow: 0 0 0 18px rgba(77, 151, 225, 0.025), 0 0 0 36px rgba(77, 151, 225, 0.02);
      content: "";
      pointer-events: none;
    }

    .advisor-card:hover {
      transform: translateY(-4px);
      border-color: rgba(80, 163, 246, 0.38);
    }

    .advisor-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding-bottom: 20px;
      border-bottom: 1px solid rgba(127, 170, 215, 0.12);
    }

    .advisor-number {
      color: #6984a3;
      font-family: monospace;
      font-size: 9px;
      letter-spacing: 0.7px;
    }

    .advisor-status {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      color: #8fa9c5;
      font-size: 10px;
    }

    .advisor-status i {
      width: 6px;
      height: 6px;
      flex-basis: 6px;
    }

    .advisor-profile {
      display: flex;
      align-items: center;
      gap: 18px;
      padding-block: 22px;
    }

    .advisor-avatar {
      position: relative;
      display: grid;
      width: 73px;
      height: 73px;
      flex: 0 0 73px;
      place-items: center;
      border: 1px solid rgba(95, 170, 242, 0.4);
      border-radius: 50%;
      color: #c3e3ff;
      background:
        radial-gradient(circle at 35% 25%, rgba(90, 170, 255, 0.28), transparent 60%),
        #102c4a;
      font-size: 22px;
      font-weight: 850;
    }

    .advisor-avatar::before,
    .advisor-avatar::after {
      position: absolute;
      border: 1px solid rgba(81, 162, 242, 0.18);
      border-radius: 50%;
      content: "";
    }

    .advisor-avatar::before {
      inset: -6px;
    }

    .advisor-avatar::after {
      inset: 8px;
    }

    .advisor-avatar span {
      position: relative;
      z-index: 1;
    }

    .avatar-orbit {
      position: absolute;
      inset: -10px;
      border: 1px dashed rgba(103, 182, 255, 0.25);
      border-radius: 50%;
      animation: ring-rotate 30s linear infinite;
    }

    .advisor-info h3 {
      margin: 0;
      color: #f0f6ff;
      font-size: 18px;
      font-weight: 850;
    }

    .advisor-info p {
      margin: 4px 0 0;
      color: #91a7c0;
      font-size: 11px;
    }

    .advisor-specialty {
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 12px;
      border: 1px solid rgba(127, 170, 215, 0.1);
      border-radius: 7px;
      color: #a9bed5;
      background: rgba(255, 255, 255, 0.018);
      font-size: 11px;
    }

    .specialty-icon {
      color: #69b7ff;
      font-size: 17px;
    }

    .advisor-call {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-top: 14px;
      padding: 13px 15px;
      border: 1px solid rgba(71, 152, 233, 0.23);
      border-radius: 7px;
      color: #b7dcff !important;
      background: rgba(41, 126, 206, 0.09);
      font-size: 12px;
      font-weight: 800;
      transition: background 0.2s ease;
    }

    .advisor-call:hover {
      background: rgba(41, 126, 206, 0.18);
    }

    .advisor-call svg {
      width: 18px;
      height: 18px;
    }

    .advisor-warning {
      display: flex;
      align-items: center;
      gap: 9px;
      margin-top: 17px;
      color: #8297b0;
      font-size: 10px;
    }

    .advisor-warning > span {
      display: grid;
      width: 20px;
      height: 20px;
      flex: 0 0 20px;
      place-items: center;
      border: 1px solid rgba(91, 157, 225, 0.3);
      border-radius: 50%;
      color: #82bfff;
    }

    /* OFFICE */

    .office-section {
      width: 100%;
      max-width: none;
      padding-inline: max(24px, calc((100% - 1200px) / 2));
      background:
        radial-gradient(ellipse at 90% 60%, rgba(23, 93, 159, 0.09), transparent 45%),
        #091522;
      border-block: 1px solid rgba(117, 164, 213, 0.1);
    }

    .office-layout {
      display: grid;
      grid-template-columns: 0.8fr 1.2fr;
      align-items: center;
      gap: 55px;
      max-width: 1200px;
      margin: auto;
    }

    .office-copy h2 {
      margin-top: 17px;
    }

    .office-detail {
      display: flex;
      align-items: flex-start;
      gap: 13px;
      margin-top: 25px;
    }

    .office-detail-icon {
      display: grid;
      width: 43px;
      height: 43px;
      flex: 0 0 43px;
      place-items: center;
      border: 1px solid rgba(82, 158, 237, 0.22);
      border-radius: 10px;
      color: #85c4ff;
      background: rgba(44, 126, 204, 0.1);
    }

    .office-detail-icon svg {
      width: 21px;
      height: 21px;
    }

    .office-detail > div:last-child {
      min-width: 0;
    }

    .office-detail span,
    .office-detail strong {
      display: block;
    }

    .office-detail span {
      margin-bottom: 3px;
      color: #6e8ba9;
      font-size: 10px;
    }

    .office-detail strong {
      color: #d5e4f5;
      font-size: 12px;
      font-weight: 650;
      line-height: 2;
      overflow-wrap: anywhere;
    }

    .office-map-button {
      margin-top: 25px;
    }

    .office-map-card {
      overflow: hidden;
      border: 1px solid rgba(119, 171, 224, 0.19);
      border-radius: 13px;
      background: #0c1929;
      box-shadow: 0 22px 55px rgba(0, 0, 0, 0.13);
    }

    .map-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      padding: 17px 20px;
      border-bottom: 1px solid rgba(128, 174, 219, 0.13);
    }

    .map-topbar strong,
    .map-overline {
      display: block;
    }

    .map-overline {
      color: #6194c6;
      font-family: monospace;
      font-size: 8px;
      letter-spacing: 1px;
    }

    .map-topbar strong {
      margin-top: 3px;
      color: #e3efff;
      font-size: 13px;
    }

    .map-coordinate {
      color: #6886a5;
      font-family: monospace;
      font-size: 9px;
    }

    .office-map-card iframe {
      display: block;
      width: 100%;
      min-height: 330px;
      border: 0;
      filter: grayscale(0.75) invert(0.88) hue-rotate(170deg) contrast(0.85);
    }

    .map-placeholder {
      position: relative;
      min-height: 330px;
      overflow: hidden;
      background:
        radial-gradient(ellipse at 50% 50%, rgba(38, 112, 180, 0.14), transparent 50%),
        #0b1928;
    }

    .map-placeholder::before {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(95, 155, 211, 0.08) 1px, transparent 1px),
        linear-gradient(90deg, rgba(95, 155, 211, 0.08) 1px, transparent 1px);
      background-size: 28px 28px;
      content: "";
    }

    .map-contour {
      position: absolute;
      border: 1px solid rgba(66, 132, 192, 0.17);
      border-radius: 48%;
      transform: rotate(-25deg);
    }

    .contour-one {
      top: 25px;
      left: 10%;
      width: 75%;
      height: 250px;
    }

    .contour-two {
      top: 40px;
      left: 18%;
      width: 65%;
      height: 210px;
      transform: rotate(28deg);
    }

    .contour-three {
      top: 70px;
      left: 24%;
      width: 55%;
      height: 150px;
      transform: rotate(-5deg);
    }

    .map-road {
      position: absolute;
      height: 8px;
      border: 1px solid rgba(113, 165, 214, 0.2);
      border-right: 0;
      border-left: 0;
      background: rgba(50, 98, 146, 0.13);
    }

    .road-one {
      top: 45%;
      left: -5%;
      width: 115%;
      transform: rotate(-18deg);
    }

    .road-two {
      top: 40%;
      left: -12%;
      width: 120%;
      transform: rotate(39deg);
    }

    .road-three {
      top: 65%;
      left: 10%;
      width: 90%;
      transform: rotate(-55deg);
    }

    .map-marker {
      position: absolute;
      top: 43%;
      left: 50%;
      display: grid;
      width: 60px;
      height: 60px;
      place-items: center;
      transform: translate(-50%, -50%);
    }

    .marker-pulse {
      position: absolute;
      inset: 0;
      border: 1px solid rgba(69, 163, 255, 0.55);
      border-radius: 50%;
      animation: marker-pulse 2.5s ease-out infinite;
    }

    .marker-pin {
      position: relative;
      z-index: 1;
      display: grid;
      width: 41px;
      height: 41px;
      place-items: center;
      border: 1px solid #80c9ff;
      border-radius: 50%;
      color: white;
      background: #1679d6;
      box-shadow: 0 0 28px rgba(37, 141, 242, 0.38);
    }

    .marker-pin svg {
      width: 21px;
      height: 21px;
    }

    .map-label {
      position: absolute;
      top: calc(43% + 43px);
      left: 50%;
      width: max-content;
      max-width: calc(100% - 35px);
      padding: 9px 14px;
      border: 1px solid rgba(100, 167, 231, 0.2);
      border-radius: 7px;
      background: rgba(6, 20, 35, 0.91);
      text-align: center;
      transform: translateX(-50%);
    }

    .map-label strong,
    .map-label span {
      display: block;
    }

    .map-label strong {
      color: #cce8ff;
      font-size: 12px;
    }

    .map-label span {
      color: #7f99b7;
      font-size: 9px;
    }

    .map-grid-label {
      position: absolute;
      color: #5b7897;
      font-family: monospace;
      font-size: 8px;
      letter-spacing: 0.5px;
    }

    .map-grid-a {
      top: 17px;
      right: 17px;
    }

    .map-grid-b {
      bottom: 17px;
      left: 17px;
    }

    .map-grid-c {
      right: 17px;
      bottom: 17px;
    }

    .map-bottom {
      display: flex;
      align-items: center;
      gap: 9px;
      min-height: 46px;
      padding: 10px 17px;
      border-top: 1px solid rgba(128, 174, 219, 0.12);
      color: #7f95af;
      font-size: 10px;
    }

    /* SERVICES */

    .services-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 15px;
    }

    .service-card {
      position: relative;
      min-width: 0;
      padding: 23px 19px;
      overflow: hidden;
      border: 1px solid var(--contact-border);
      border-radius: 12px;
      background: linear-gradient(145deg, #102037, #0a1726);
      transition:
        transform 0.25s ease,
        border-color 0.25s ease;
    }

    .service-card::before {
      position: absolute;
      top: -25px;
      left: -25px;
      width: 90px;
      height: 90px;
      border: 1px solid rgba(80, 153, 223, 0.1);
      border-radius: 50%;
      box-shadow: 0 0 0 12px rgba(80, 153, 223, 0.025);
      content: "";
    }

    .service-card:hover {
      transform: translateY(-5px);
      border-color: rgba(77, 159, 241, 0.4);
    }

    .service-icon {
      display: grid;
      width: 47px;
      height: 47px;
      place-items: center;
      border: 1px solid rgba(81, 159, 238, 0.23);
      border-radius: 11px;
      color: #83c4ff;
      background: rgba(46, 126, 207, 0.12);
    }

    .service-icon svg {
      width: 23px;
      height: 23px;
    }

    .service-number {
      position: absolute;
      top: 26px;
      left: 19px;
      color: #365779;
      font-family: monospace;
      font-size: 15px;
      font-weight: 700;
    }

    .service-card h3 {
      margin: 22px 0 8px;
      color: #e8f2ff;
      font-size: 15px;
      font-weight: 850;
    }

    .service-card p {
      min-height: 82px;
      margin: 0;
      color: #91a6bf;
      font-size: 11px;
      line-height: 2.1;
    }

    .service-card > a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-top: 18px;
      padding-top: 13px;
      border-top: 1px solid rgba(130, 172, 217, 0.12);
      color: #83c2ff !important;
      font-size: 10px;
      font-weight: 800;
    }

    .service-card > a span {
      font-size: 15px;
      transition: transform 0.2s ease;
    }

    .service-card > a:hover span {
      transform: translateX(-4px);
    }

    /* DELIVERY */

    .delivery-section {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      padding: 75px 24px;
      border-block: 1px solid rgba(101, 165, 228, 0.16);
      background:
        radial-gradient(ellipse at 15% 50%, rgba(22, 99, 176, 0.18), transparent 45%),
        linear-gradient(110deg, #0d2137, #091522 65%);
    }

    .delivery-grid {
      opacity: 0.6;
      mask-image: linear-gradient(90deg, black, transparent);
    }

    .delivery-inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 65px;
      width: 100%;
      max-width: 1200px;
      margin: auto;
    }

    .delivery-copy h2 {
      font-size: clamp(28px, 3.3vw, 39px);
    }

    .delivery-copy .button {
      margin-top: 17px;
    }

    .delivery-steps {
      display: grid;
      gap: 0;
    }

    .delivery-step {
      display: grid;
      grid-template-columns: 48px 1px 1fr;
      align-items: stretch;
      gap: 17px;
      min-height: 105px;
    }

    .step-number {
      display: grid;
      width: 43px;
      height: 43px;
      place-items: center;
      border: 1px solid rgba(85, 166, 243, 0.28);
      border-radius: 10px;
      color: #91cbff;
      background: rgba(39, 122, 203, 0.13);
      font-family: monospace;
      font-size: 13px;
    }

    .step-line {
      width: 1px;
      background: linear-gradient(to bottom, #2e8ce9, rgba(46, 140, 233, 0.04));
    }

    .delivery-step:last-child .step-line {
      background: transparent;
    }

    .delivery-step h3 {
      margin: 0 0 5px;
      color: #e2efff;
      font-size: 14px;
      font-weight: 800;
    }

    .delivery-step p {
      margin: 0;
      color: #8fa5bf;
      font-size: 11px;
      line-height: 2.1;
    }

    /* GALLERY */

    .gallery-counter {
      display: flex;
      flex: 0 0 auto;
      align-items: center;
      gap: 12px;
      color: #6383a6;
      font-family: monospace;
      font-size: 9px;
      letter-spacing: 0.7px;
    }

    .gallery-counter strong {
      color: #6abaff;
      font-size: 30px;
      font-weight: 800;
    }

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }

    .gallery-card {
      min-width: 0;
      overflow: hidden;
      border: 1px solid var(--contact-border);
      border-radius: 12px;
      background: #0c1929;
      transition:
        transform 0.25s ease,
        border-color 0.25s ease;
    }

    .gallery-card:hover {
      transform: translateY(-5px);
      border-color: rgba(76, 160, 242, 0.4);
    }

    .gallery-image {
      position: relative;
      height: 230px;
      overflow: hidden;
      background:
        radial-gradient(ellipse at 50% 45%, rgba(48, 132, 209, 0.3), transparent 55%),
        linear-gradient(135deg, #1a3550, #0a1624);
    }

    .gallery-image::before {
      position: absolute;
      z-index: 1;
      inset: 0;
      background-image:
        linear-gradient(rgba(123, 175, 224, 0.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(123, 175, 224, 0.06) 1px, transparent 1px);
      background-size: 24px 24px;
      content: "";
      pointer-events: none;
    }

    .gallery-image img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s ease;
    }

    .gallery-card:hover .gallery-image img {
      transform: scale(1.06);
    }

    .gallery-image-overlay {
      position: absolute;
      z-index: 1;
      inset: 0;
      background: linear-gradient(to top, rgba(4, 12, 22, 0.72), transparent 65%);
      pointer-events: none;
    }

    .gallery-index,
    .gallery-corner {
      position: absolute;
      z-index: 2;
      top: 13px;
      color: #d8edff;
      font-family: monospace;
      font-size: 10px;
    }

    .gallery-index {
      right: 13px;
      display: grid;
      width: 30px;
      height: 30px;
      place-items: center;
      border: 1px solid rgba(151, 203, 255, 0.25);
      border-radius: 5px;
      background: rgba(7, 23, 39, 0.72);
    }

    .gallery-corner {
      left: 13px;
      color: #91b5d9;
      font-size: 8px;
      letter-spacing: 1px;
    }

    .gallery-content {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 18px;
    }

    .gallery-content h3 {
      margin: 0;
      color: #e7f2ff;
      font-size: 14px;
      font-weight: 800;
    }

    .gallery-content p {
      margin: 5px 0 0;
      color: #859ab4;
      font-size: 10px;
      line-height: 1.9;
    }

    .gallery-arrow {
      display: grid;
      width: 34px;
      height: 34px;
      flex: 0 0 34px;
      place-items: center;
      border: 1px solid rgba(78, 155, 235, 0.23);
      border-radius: 50%;
      color: #83c3ff;
      background: rgba(47, 124, 202, 0.08);
      font-size: 16px;
      transition:
        color 0.2s ease,
        background 0.2s ease;
    }

    .gallery-card:hover .gallery-arrow {
      color: white;
      background: #237ed6;
    }

    .gallery-image.image-missing::after {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      color: rgba(177, 216, 255, 0.75);
      font-family: monospace;
      font-size: 12px;
      letter-spacing: 2px;
      content: "ASIN STILL / STEEL";
    }

    /* FAQ */

    .faq-section {
      border-top: 1px solid rgba(111, 163, 217, 0.1);
    }

    .faq-layout {
      display: grid;
      grid-template-columns: 0.72fr 1.28fr;
      align-items: start;
      gap: 60px;
    }

    .faq-intro h2 {
      margin-top: 18px;
    }

    .faq-side-mark {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 40px;
      color: #5d7c9d;
      font-family: monospace;
      font-size: 8px;
      letter-spacing: 0.8px;
    }

    .faq-side-mark > span {
      color: #24517e;
      font-size: 36px;
      font-weight: 900;
    }

    .faq-side-mark > i {
      width: 25px;
      height: 1px;
      background: #328fe9;
    }

    .faq-list {
      border-top: 1px solid rgba(130, 171, 214, 0.16);
    }

    .faq-item {
      border-bottom: 1px solid rgba(130, 171, 214, 0.16);
    }

    .faq-item summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      padding: 19px 0;
      color: #dce9f8;
      cursor: pointer;
      list-style: none;
      font-size: 13px;
      font-weight: 750;
    }

    .faq-item summary::-webkit-details-marker {
      display: none;
    }

    .faq-plus {
      position: relative;
      display: grid;
      width: 29px;
      height: 29px;
      flex: 0 0 29px;
      place-items: center;
      border: 1px solid rgba(86, 158, 230, 0.24);
      border-radius: 7px;
      color: #80c3ff;
      background: rgba(46, 122, 196, 0.09);
      transition:
        transform 0.2s ease,
        background 0.2s ease;
    }

    .faq-plus::before,
    .faq-plus::after {
      position: absolute;
      width: 10px;
      height: 1px;
      background: currentColor;
      content: "";
    }

    .faq-plus::after {
      transform: rotate(90deg);
      transition: transform 0.2s ease;
    }

    .faq-item[open] .faq-plus {
      background: rgba(46, 122, 196, 0.2);
    }

    .faq-item[open] .faq-plus::after {
      transform: rotate(0);
    }

    .faq-answer {
      padding: 0 0 19px;
      color: #91a6bf;
      font-size: 12px;
      line-height: 2.25;
      animation: faq-open 0.25s ease;
    }

    /* FINAL CTA */

    .final-cta {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      padding: 40px 24px;
      border-top: 1px solid rgba(95, 162, 229, 0.22);
      background:
        radial-gradient(ellipse at 80% 50%, rgba(38, 119, 198, 0.2), transparent 50%),
        linear-gradient(110deg, #102944, #0b1c30);
    }

    .cta-grid {
      opacity: 0.4;
      mask-image: linear-gradient(90deg, transparent, black, transparent);
    }

    .cta-glow {
      position: absolute;
      z-index: -1;
      top: -100px;
      right: 30%;
      width: 300px;
      height: 300px;
      border-radius: 50%;
      background: rgba(29, 121, 211, 0.13);
      filter: blur(90px);
    }

    .final-cta-inner {
      display: flex;
      align-items: center;
      gap: 25px;
      width: 100%;
      max-width: 1200px;
      margin: auto;
    }

    .cta-symbol {
      position: relative;
      display: grid;
      width: 68px;
      height: 68px;
      flex: 0 0 68px;
      place-items: center;
      border: 1px solid rgba(112, 184, 250, 0.35);
      border-radius: 12px;
      color: #a6d6ff;
      background: rgba(41, 123, 199, 0.13);
      font-family: monospace;
      font-size: 23px;
      font-weight: 900;
    }

    .cta-symbol i {
      position: absolute;
      right: -1px;
      bottom: -1px;
      width: 15px;
      height: 15px;
      border-right: 2px solid #5fb4ff;
      border-bottom: 2px solid #5fb4ff;
    }

    .cta-copy {
      flex: 1;
      min-width: 0;
    }

    .cta-overline {
      color: #72baff;
      font-family: monospace;
      font-size: 9px;
      letter-spacing: 1px;
    }

    .cta-copy h2 {
      margin: 4px 0;
      color: #f0f6ff;
      font-size: clamp(18px, 2.3vw, 26px);
      font-weight: 850;
      line-height: 1.8;
    }

    .cta-copy p {
      margin: 0;
      color: #9cb2cc;
      font-size: 11px;
    }

    .button-light {
      flex: 0 0 auto;
      color: #09213a !important;
      background: #d9edff;
    }

    .button-light:hover {
      background: white;
      box-shadow: 0 8px 25px rgba(107, 181, 246, 0.17);
    }

    /* ANIMATIONS */

    @keyframes hero-copy-enter {
      from {
        opacity: 0;
        transform: translateY(18px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes visual-enter {
      from {
        opacity: 0;
        transform: translateY(12px) scale(0.98);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @keyframes beam-float {
      0%, 100% {
        transform: translateY(0) rotate(0deg);
      }
      50% {
        transform: translateY(-7px) rotate(0.5deg);
      }
    }

    @keyframes beam-scan {
      0% {
        stroke-dashoffset: 350;
        opacity: 0;
      }
      20% {
        opacity: 0.9;
      }
      70% {
        opacity: 0.9;
      }
      100% {
        stroke-dashoffset: -350;
        opacity: 0;
      }
    }

    @keyframes ring-rotate {
      from {
        transform: translate(-50%, -50%) rotate(0deg);
      }
      to {
        transform: translate(-50%, -50%) rotate(360deg);
      }
    }

    @keyframes marker-pulse {
      0% {
        opacity: 0.8;
        transform: scale(0.65);
      }
      100% {
        opacity: 0;
        transform: scale(1.5);
      }
    }

    @keyframes faq-open {
      from {
        opacity: 0;
        transform: translateY(-4px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* RESPONSIVE */

    @media (min-width: 1500px) {
      .contact-hero {
        padding-inline: max(32px, calc((100% - 1300px) / 2));
      }
    }

    @media (max-width: 1050px) {
      .hero-inner {
        gap: 20px;
      }

      .hero-copy h1 {
        font-size: 40px;
      }

      .visual-blueprint {
        min-height: 320px;
      }

      .request-layout,
      .office-layout {
        gap: 35px;
      }

      .services-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .service-card p {
        min-height: 55px;
      }

      .gallery-image {
        height: 195px;
      }

      .faq-layout {
        gap: 35px;
      }
    }

    @media (max-width: 760px) {
      .section {
        width: calc(100% - 36px);
        padding-block: 68px;
      }

      .section-heading {
        margin-bottom: 30px;
      }

      .section-heading h2,
      .request-copy h2,
      .office-copy h2,
      .delivery-copy h2,
      .faq-intro h2 {
        font-size: 29px;
        letter-spacing: -0.7px;
      }

      .section-heading > p,
      .section-heading-row > div:first-child > p {
        font-size: 12px;
      }

      .contact-hero {
        padding: 45px 20px 0;
      }

      .hero-inner {
        grid-template-columns: 1fr;
        gap: 12px;
        min-height: auto;
        padding-bottom: 27px;
      }

      .hero-copy {
        padding-top: 5px;
      }

      .hero-copy h1 {
        max-width: 540px;
        margin-top: 18px;
        font-size: clamp(31px, 7vw, 42px);
        line-height: 1.7;
      }

      .hero-description {
        font-size: 13px;
      }

      .hero-trust {
        margin-top: 23px;
      }

      .hero-visual {
        width: min(100%, 510px);
        margin-top: 8px;
      }

      .visual-blueprint {
        min-height: clamp(270px, 65vw, 350px);
      }

      .hero-bottom-line {
        min-height: 52px;
        gap: 10px;
        font-size: 9px;
      }

      .hero-bottom-line > span:nth-child(2) {
        max-width: 180px;
        text-align: center;
      }

      .contact-info-grid {
        grid-template-columns: 1fr;
        gap: 12px;
      }

      .info-card {
        padding: 21px;
      }

      .info-card-top {
        margin-bottom: 15px;
      }

      .info-card > p {
        min-height: auto;
      }

      .request-section,
      .office-section {
        padding: 65px 18px;
      }

      .request-layout,
      .office-layout,
      .delivery-inner,
      .faq-layout {
        grid-template-columns: 1fr;
        gap: 35px;
      }

      .request-copy {
        padding-top: 0;
      }

      .request-points {
        gap: 17px;
        margin-top: 24px;
      }

      .request-decoration {
        margin-top: 25px;
      }

      .form-panel {
        padding: 23px 18px;
      }

      .section-heading-row {
        align-items: flex-start;
        gap: 12px;
      }

      .heading-side-mark {
        display: none;
      }

      .advisors-grid {
        grid-template-columns: 1fr;
        gap: 13px;
      }

      .office-layout {
        gap: 28px;
      }

      .office-map-card iframe,
      .map-placeholder {
        min-height: 280px;
      }

      .delivery-section {
        padding: 60px 20px;
      }

      .delivery-inner {
        gap: 30px;
      }

      .delivery-steps {
        padding-top: 5px;
      }

      .gallery-grid {
        grid-template-columns: 1fr;
        gap: 15px;
      }

      .gallery-image {
        height: clamp(200px, 57vw, 300px);
      }

      .gallery-content {
        padding: 16px;
      }

      .faq-layout {
        gap: 25px;
      }

      .faq-side-mark {
        margin-top: 20px;
      }

      .faq-item summary {
        font-size: 12px;
      }

      .final-cta {
        padding: 32px 20px;
      }

      .final-cta-inner {
        flex-wrap: wrap;
        gap: 17px;
      }

      .cta-symbol {
        width: 55px;
        height: 55px;
        flex-basis: 55px;
        font-size: 19px;
      }

      .cta-copy {
        flex-basis: calc(100% - 75px);
      }

      .cta-copy h2 {
        font-size: 18px;
      }

      .cta-copy p {
        font-size: 10px;
      }

      .button-light {
        width: 100%;
      }
    }

    @media (max-width: 430px) {
      .section {
        width: calc(100% - 30px);
      }

      .contact-hero {
        padding-inline: 15px;
      }

      .hero-actions {
        align-items: stretch;
      }

      .hero-actions .button {
        flex: 1 1 auto;
        padding-inline: 13px;
        font-size: 11px;
      }

      .visual-topline,
      .visual-footer {
        font-size: 7px;
      }

      .visual-blueprint {
        min-height: 260px;
      }

      .tag-top {
        top: 20px;
        left: 12px;
      }

      .tag-bottom {
        right: 12px;
        bottom: 20px;
      }

      .visual-tag {
        padding: 7px 9px;
      }

      .visual-tag strong {
        font-size: 8px;
      }

      .visual-tag small {
        font-size: 8px;
      }

      .visual-coordinate {
        font-size: 7px;
      }

      .form-row {
        grid-template-columns: 1fr;
      }

      .form-panel-heading h3 {
        font-size: 17px;
      }

      .service-card {
        padding: 20px 16px;
      }

      .services-grid {
        gap: 10px;
      }

      .service-card h3 {
        font-size: 13px;
      }

      .service-card p {
        font-size: 10px;
      }

      .gallery-counter {
        gap: 6px;
      }

      .gallery-counter strong {
        font-size: 24px;
      }

      .gallery-counter span {
        font-size: 7px;
      }

      .hero-bottom-line > span:nth-child(2) {
        display: none;
      }

      .hero-bottom-line {
        justify-content: space-between;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .contact-page *,
      .contact-page *::before,
      .contact-page *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
      }
    }


    /* Hero animation replacement — intentionally scoped to the visual beside the headline */
    .hero-visual .visual-topline,
    .hero-visual .visual-footer {
      font-family: inherit;
      letter-spacing: 0;
      font-size: 11px;
    }

    .hero-visual .visual-label {
      color: #b5d9ff;
      font-weight: 800;
    }

    .hero-visual .visual-live {
      color: #c5e7ff;
      border-radius: 999px;
      padding: 6px 11px;
    }

    .hero-visual .visual-blueprint.supply-scene {
      min-height: 365px;
      isolation: isolate;
      background:
        radial-gradient(ellipse at 50% 45%, rgba(37, 139, 255, .25), transparent 48%),
        linear-gradient(145deg, #102c49 0%, #071523 72%, #06101c 100%);
    }

    .supply-scene .scene-glow {
      position: absolute;
      width: 230px;
      height: 180px;
      left: 50%;
      top: 43%;
      transform: translate(-50%, -50%);
      border-radius: 50%;
      background: rgba(33, 135, 255, .18);
      filter: blur(36px);
      animation: scene-glow-pulse 4s ease-in-out infinite;
    }

    .supply-scene .scene-orbit {
      position: absolute;
      left: 50%;
      top: 45%;
      border: 1px solid rgba(115, 190, 255, .18);
      border-radius: 50%;
      transform: translate(-50%, -50%);
      pointer-events: none;
    }

    .supply-scene .orbit-a {
      width: 300px;
      height: 190px;
      animation: orbit-breathe 6s ease-in-out infinite;
    }

    .supply-scene .orbit-b {
      width: 245px;
      height: 145px;
      border-style: dashed;
      animation: orbit-turn 26s linear infinite;
    }

    .supply-scene .scene-heading {
      position: absolute;
      z-index: 3;
      top: 22px;
      right: 22px;
      display: flex;
      flex-direction: column;
      gap: 2px;
      text-align: right;
    }

    .supply-scene .scene-kicker {
      color: #78c5ff;
      font-size: 11px;
      font-weight: 800;
    }

    .supply-scene .scene-heading strong {
      color: #f2f8ff;
      font-size: clamp(15px, 2vw, 20px);
      font-weight: 900;
      line-height: 1.7;
    }

    .supply-scene .scene-heading small {
      color: #9ab4d0;
      font-size: 11px;
    }

    .supply-scene .steel-stack {
      position: absolute;
      z-index: 2;
      width: 220px;
      height: 125px;
      top: 115px;
      left: 50%;
      transform: translateX(-50%);
      animation: steel-stack-float 4.8s ease-in-out infinite;
    }

    .supply-scene .steel-bar {
      position: absolute;
      left: 10px;
      width: 195px;
      height: 28px;
      border: 1px solid rgba(205, 235, 255, .72);
      border-radius: 4px;
      background: linear-gradient(180deg, #c2e6ff 0%, #579bd6 35%, #1c4b78 100%);
      box-shadow: 0 9px 18px rgba(0, 0, 0, .23), inset 0 2px 0 rgba(255,255,255,.45);
      transform: skewY(-9deg);
    }

    .supply-scene .bar-back {
      top: 4px;
      left: 25px;
      opacity: .78;
      background: linear-gradient(180deg, #82bce8, #245580);
    }

    .supply-scene .bar-mid {
      top: 31px;
      left: 17px;
      background: linear-gradient(180deg, #d3edff, #5597d0 45%, #214e7c);
    }

    .supply-scene .bar-front {
      top: 58px;
      background: linear-gradient(180deg, #f0f9ff, #6bb0e9 38%, #285b8b);
    }

    .supply-scene .bar-shine {
      position: absolute;
      z-index: 2;
      top: 58px;
      left: -10px;
      width: 250px;
      height: 3px;
      border-radius: 50%;
      background: #e5f6ff;
      box-shadow: 0 0 14px 4px rgba(105, 194, 255, .5);
      transform: rotate(-9deg);
      animation: bar-shine-pass 3.6s ease-in-out infinite;
    }

    .supply-scene .scene-step {
      position: absolute;
      z-index: 4;
      display: flex;
      align-items: center;
      gap: 7px;
      padding: 7px 10px;
      color: #e5f3ff;
      border: 1px solid rgba(116, 187, 255, .24);
      border-radius: 9px;
      background: rgba(5, 19, 34, .88);
      box-shadow: 0 8px 24px rgba(0,0,0,.2);
      font-size: 10px;
      font-weight: 800;
      white-space: nowrap;
      backdrop-filter: blur(8px);
    }

    .supply-scene .step-icon {
      display: grid;
      place-items: center;
      width: 23px;
      height: 23px;
      flex: 0 0 23px;
      border-radius: 7px;
      color: #061728;
      background: linear-gradient(135deg, #b8e5ff, #4bafff);
      font-size: 12px;
      font-weight: 900;
    }

    .supply-scene .step-order {
      top: 118px;
      right: 18px;
      animation: step-pop 5s ease-in-out infinite;
    }

    .supply-scene .step-supply {
      top: 203px;
      left: 15px;
      animation: step-pop 5s ease-in-out 1.2s infinite;
    }

    .supply-scene .step-delivery {
      right: 18px;
      bottom: 60px;
      animation: step-pop 5s ease-in-out 2.4s infinite;
    }

    .supply-scene .scene-road {
      position: absolute;
      z-index: 1;
      right: 0;
      bottom: 43px;
      left: 0;
      height: 44px;
      border-top: 1px solid rgba(117, 184, 245, .2);
      border-bottom: 1px solid rgba(117, 184, 245, .13);
      background: linear-gradient(180deg, rgba(22, 53, 82, .2), rgba(4, 13, 23, .75));
    }

    .supply-scene .road-dash {
      position: absolute;
      top: 21px;
      width: 38px;
      height: 2px;
      border-radius: 4px;
      background: #4b8fca;
      opacity: .65;
    }

    .supply-scene .dash-one { left: 10%; animation: road-move 2.4s linear infinite; }
    .supply-scene .dash-two { left: 48%; animation: road-move 2.4s linear .8s infinite; }
    .supply-scene .dash-three { left: 82%; animation: road-move 2.4s linear 1.6s infinite; }

    .supply-scene .delivery-truck {
      position: absolute;
      z-index: 5;
      left: 50%;
      bottom: 50px;
      width: 120px;
      height: 68px;
      transform: translateX(-50%);
      animation: truck-bob 2.8s ease-in-out infinite;
    }

    .supply-scene .truck-body {
      position: absolute;
      right: 28px;
      bottom: 12px;
      width: 70px;
      height: 30px;
      border: 1px solid #9bd4ff;
      border-radius: 4px 2px 2px 4px;
      background: linear-gradient(180deg, #4a9de1, #145087);
      box-shadow: inset 0 3px 0 rgba(255,255,255,.25), 0 5px 12px rgba(0,0,0,.25);
    }

    .supply-scene .truck-cab {
      position: absolute;
      right: 4px;
      bottom: 12px;
      width: 34px;
      height: 27px;
      border: 1px solid #a9dcff;
      border-radius: 4px 7px 2px 2px;
      background: linear-gradient(135deg, #bfe7ff, #438fc9 68%, #1c5487);
      clip-path: polygon(0 0, 70% 0, 100% 45%, 100% 100%, 0 100%);
    }

    .supply-scene .truck-window {
      position: absolute;
      top: 4px;
      right: 4px;
      width: 15px;
      height: 9px;
      border-radius: 2px;
      background: #0b2b48;
      transform: skewY(15deg);
    }

    .supply-scene .truck-light {
      position: absolute;
      right: 0;
      bottom: 5px;
      width: 4px;
      height: 5px;
      border-radius: 2px;
      background: #d8f3ff;
      box-shadow: 0 0 8px #70c8ff;
    }

    .supply-scene .truck-load {
      position: absolute;
      z-index: 2;
      right: 31px;
      bottom: 43px;
      display: flex;
      gap: 4px;
      transform: rotate(-3deg);
    }

    .supply-scene .truck-load i {
      display: block;
      width: 58px;
      height: 6px;
      border: 1px solid #d4edff;
      border-radius: 2px;
      background: linear-gradient(180deg, #d8efff, #4e91c7);
      box-shadow: 0 0 7px rgba(112, 190, 255, .18);
    }

    .supply-scene .truck-wheel {
      position: absolute;
      z-index: 4;
      bottom: 2px;
      width: 19px;
      height: 19px;
      display: grid;
      place-items: center;
      border: 3px solid #13283c;
      border-radius: 50%;
      background: #07111d;
      box-shadow: 0 0 0 1px #70b7ec;
      animation: wheel-turn 1.5s linear infinite;
    }

    .supply-scene .wheel-one { right: 62px; }
    .supply-scene .wheel-two { right: 10px; }

    .supply-scene .truck-wheel i {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: #91cfff;
    }

    .supply-scene .scene-bottom-note {
      position: absolute;
      z-index: 6;
      right: 50%;
      bottom: 12px;
      display: flex;
      align-items: center;
      gap: 7px;
      width: max-content;
      max-width: calc(100% - 24px);
      color: #b6d7f5;
      font-size: 10px;
      transform: translateX(50%);
    }

    .supply-scene .note-check {
      display: grid;
      place-items: center;
      width: 17px;
      height: 17px;
      border-radius: 50%;
      color: #061727;
      background: #79d8b0;
      font-size: 11px;
      font-weight: 900;
    }

    .supply-scene .scene-spark {
      position: absolute;
      z-index: 2;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: #bde8ff;
      box-shadow: 0 0 12px 3px rgba(85, 177, 255, .42);
      animation: spark-blink 2.6s ease-in-out infinite;
    }

    .supply-scene .spark-a { top: 95px; left: 22%; }
    .supply-scene .spark-b { top: 185px; right: 16%; animation-delay: .8s; }
    .supply-scene .spark-c { bottom: 102px; left: 24%; animation-delay: 1.5s; }

    .hero-visual .visual-footer {
      color: #91abc7;
      font-size: 10px;
    }

    .hero-visual .visual-footer-line {
      width: 16px;
      background: #3a6389;
    }

    @keyframes steel-stack-float {
      0%, 100% { transform: translate(-50%, 0) rotate(0deg); }
      50% { transform: translate(-50%, -7px) rotate(-1deg); }
    }

    @keyframes bar-shine-pass {
      0%, 100% { opacity: .25; transform: translateX(-15px) rotate(-9deg); }
      50% { opacity: .95; transform: translateX(15px) rotate(-9deg); }
    }

    @keyframes scene-glow-pulse {
      0%, 100% { opacity: .55; transform: translate(-50%, -50%) scale(.9); }
      50% { opacity: 1; transform: translate(-50%, -50%) scale(1.12); }
    }

    @keyframes orbit-breathe {
      0%, 100% { opacity: .35; transform: translate(-50%, -50%) scale(.96); }
      50% { opacity: .8; transform: translate(-50%, -50%) scale(1.04); }
    }

    @keyframes orbit-turn {
      from { transform: translate(-50%, -50%) rotate(0deg); }
      to { transform: translate(-50%, -50%) rotate(360deg); }
    }

    @keyframes step-pop {
      0%, 100% { filter: brightness(1); }
      50% { filter: brightness(1.28); }
    }

    @keyframes road-move {
      from { transform: translateX(18px); opacity: .15; }
      30% { opacity: .75; }
      to { transform: translateX(-45px); opacity: .1; }
    }

    @keyframes truck-bob {
      0%, 100% { margin-left: 0; }
      50% { margin-left: 3px; }
    }

    @keyframes wheel-turn {
      to { transform: rotate(360deg); }
    }

    @keyframes spark-blink {
      0%, 100% { opacity: .3; transform: scale(.7); }
      50% { opacity: 1; transform: scale(1.35); }
    }

    @media (max-width: 760px) {
      .supply-scene .scene-heading { top: 18px; right: 16px; }
      .supply-scene .steel-stack { top: 122px; transform: translateX(-50%) scale(.84); }
      .supply-scene .step-order { top: 120px; right: 10px; }
      .supply-scene .step-supply { top: 205px; left: 8px; }
      .supply-scene .step-delivery { right: 10px; bottom: 59px; }
      .supply-scene .scene-step { gap: 5px; padding: 5px 7px; font-size: 9px; }
      .supply-scene .step-icon { width: 20px; height: 20px; flex-basis: 20px; }
      .supply-scene .delivery-truck { transform: translateX(-50%) scale(.88); }
      .supply-scene .scene-bottom-note { font-size: 9px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .supply-scene *,
      .supply-scene *::before,
      .supply-scene *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
      }
    }
  </style>

  <script>
    const contactForm = document.querySelector("#contact-request-form");
    const formStatus = document.querySelector("#form-status");

    if (
      contactForm instanceof HTMLFormElement &&
      formStatus instanceof HTMLElement
    ) {
      contactForm.addEventListener("submit", (event) => {
        event.preventDefault();

        formStatus.textContent =
          "فرم هنوز به سامانه ارسال اطلاعات متصل نیست؛ اطلاعات شما ارسال یا ذخیره نشد. برای ثبت واقعی درخواست، باید فرم به یک سرویس سمت سرور متصل شود.";

        formStatus.classList.add("is-visible");
      });
    }

    // Smooth scrolling for internal section links.
    document.querySelectorAll('.contact-page a[href^="#"]').forEach((link) => {
      link.addEventListener("click", (event) => {
        const href = link.getAttribute("href");

        if (!href || href === "#") return;

        const target = document.querySelector(href);

        if (!target) return;

        event.preventDefault();

        target.scrollIntoView({
          behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
            ? "auto"
            : "smooth",
          block: "start",
        });
      });
    });
  </script>
</BaseLayout>
