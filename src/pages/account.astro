---
import BaseLayout from '../layouts/BaseLayout.astro';

// مقادیر نمایشی اولیه؛ اطلاعات حساب پس از بررسی نشست از Supabase بارگذاری می‌شود.
const user = {
  name: 'کاربر',
  email: '',
  phone: '',
  avatar: 'https://i.pravatar.cc/150?img=12',
  memberSince: 'حساب کاربری آسین استیل',
  totalOrders: 0,
  totalSpent: 0
};

const recentOrders = [];
const addresses = [];
---

<BaseLayout title="My Account - ASIN STEEL" description="Manage your ASIN STEEL account, orders, and preferences">
  <!-- Page Header - Clean & Premium -->
  <section class="relative bg-gradient-to-br from-gray-900 via-gray-950 to-black text-white py-6 overflow-hidden border-b border-gray-800" style="animation: fadeIn 0.4s ease-out;">
    <!-- Subtle Radial Glow -->
    <div class="absolute top-1/2 left-1/4 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-gray-700/5 rounded-full blur-3xl"></div>

    <div class="container mx-auto px-4 relative z-10">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <img src={user.avatar} alt="تصویر پروفایل" class="w-12 h-12 rounded-full border-2 border-gray-700 shadow-lg" />
          <div>
            <h1 id="account-welcome" class="text-xl font-bold mb-0.5">خوش آمدید</h1>
            <p id="account-email" data-account-email class="text-xs text-gray-400"></p>
            <div class="flex items-center gap-2 text-xs">
              <p id="account-member-since" class="text-gray-400">حساب کاربری آسین استیل</p>
              <span class="inline-flex items-center gap-1 px-1.5 py-0.5 bg-white/10 text-gray-200 text-xs font-medium rounded">
                <svg class="w-2 h-2" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                حساب عادی
              </span>
            </div>
          </div>
        </div>
        <button id="sign-out-btn" class="hidden md:flex items-center gap-2 px-3 py-1.5 bg-white/5 hover:bg-white/10 rounded-lg border border-white/10 hover:border-white/20 transition-all duration-300 text-xs font-medium">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          <span>Sign Out</span>
        </button>
      </div>
    </div>
  </section>

  <!-- Horizontal Navigation -->
  <section class="container mx-auto px-4 pt-4 pb-6">
    <nav class="bg-white dark:bg-dark-800 rounded-lg border border-gray-200 dark:border-dark-700 shadow-sm overflow-x-auto">
      <div class="flex items-center">
        {[
          { icon: '📊', label: 'Dashboard', active: true },
          { icon: '📦', label: 'Orders', active: false },
          { icon: '❤️', label: 'Wishlist', active: false },
          { icon: '📍', label: 'Addresses', active: false },
          { icon: '👤', label: 'Profile', active: false },
          { icon: '⚙️', label: 'Settings', active: false }
        ].map((item, i) => (
          <a href={`${import.meta.env.BASE_URL}account/${item.label.toLowerCase()}`} class={`group flex items-center gap-2 px-5 py-2.5 transition-all duration-300 whitespace-nowrap ${item.active ? 'bg-gray-900 dark:bg-gray-800 text-white' : 'hover:bg-gray-50 dark:hover:bg-dark-700 text-gray-700 dark:text-gray-300'} ${i > 0 ? 'border-l border-gray-100 dark:border-dark-700' : ''}`}>
            <span class="text-base">{item.icon}</span>
            <span class="font-medium text-sm">{item.label}</span>
          </a>
        ))}
        <!-- Mobile Sign Out Button -->
        <button id="sign-out-btn-mobile" class="md:hidden flex items-center gap-2 px-5 py-2.5 transition-all duration-300 whitespace-nowrap hover:bg-red-50 dark:hover:bg-red-900/20 text-red-600 dark:text-red-400 border-l border-gray-100 dark:border-dark-700 ml-auto">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          <span class="font-medium text-sm">Sign Out</span>
        </button>
      </div>
    </nav>
  </section>

  <!-- Main Content -->
  <section class="container mx-auto px-4 pb-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Main Content Area - Left Column (70%) -->
      <div class="lg:col-span-8">
        <!-- Stats Cards - Ultra Compact -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
          {[
            { label: 'Total Orders', value: user.totalOrders, icon: '📦' },
            { label: 'Total Spent', value: `$${user.totalSpent.toLocaleString()}`, icon: '💰' },
            { label: 'Reward Points', value: '—', icon: '⭐' }
          ].map((stat, i) => (
            <div class="group bg-white dark:bg-dark-800 rounded-lg border border-gray-200 dark:border-dark-700 p-3.5 hover:border-gray-300 dark:hover:border-dark-600 hover:shadow-sm transition-all duration-300 hover:-translate-y-0.5">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-gray-100 dark:bg-dark-700 flex items-center justify-center text-lg flex-shrink-0">
                  {stat.icon}
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-xs text-gray-600 dark:text-gray-400 mb-0.5">{stat.label}</p>
                  <p class="text-lg font-bold text-gray-900 dark:text-white">{stat.value}</p>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Recent Orders - Clean & Compact -->
        <div class="bg-white dark:bg-dark-800 rounded-lg border border-gray-200 dark:border-dark-700 mb-4 shadow-sm overflow-hidden">
          <div class="px-4 py-2.5 border-b border-gray-200 dark:border-dark-700 flex items-center justify-between">
            <h2 class="text-base font-bold">Recent Orders</h2>
            <a href={`${import.meta.env.BASE_URL}account/orders`} class="text-xs text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white font-medium transition-colors">View All →</a>
          </div>
          <div class="divide-y divide-gray-100 dark:divide-dark-700">
            {recentOrders.length === 0 && (
              <p class="px-4 py-8 text-center text-sm text-gray-500 dark:text-gray-400">هنوز سفارشی برای این حساب ثبت نشده است.</p>
            )}
            {recentOrders.map((order, i) => (
              <div class="group px-4 py-2.5 hover:bg-gray-50 dark:hover:bg-dark-700/30 transition-colors duration-200">
                <div class="flex items-center justify-between gap-4 mb-1">
                  <div class="flex items-center gap-2 flex-1 min-w-0">
                    <h3 class="font-semibold text-sm">{order.id}</h3>
                    <span class={`inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-xs font-medium ${
                      order.statusColor === 'green' ? 'bg-green-50 text-green-700 dark:bg-green-900/20 dark:text-green-400' :
                      order.statusColor === 'blue' ? 'bg-blue-50 text-blue-700 dark:bg-blue-900/20 dark:text-blue-400' :
                      'bg-yellow-50 text-yellow-700 dark:bg-yellow-900/20 dark:text-yellow-400'
                    }`}>
                      <span class={`w-1 h-1 rounded-full ${
                        order.statusColor === 'green' ? 'bg-green-500' :
                        order.statusColor === 'blue' ? 'bg-blue-500' :
                        'bg-yellow-500'
                      }`}></span>
                      {order.status}
                    </span>
                  </div>
                  <p class="text-sm font-bold text-gray-900 dark:text-white">${order.total}</p>
                </div>
                <div class="flex items-center justify-between text-xs text-gray-500 dark:text-gray-400">
                  <div class="flex items-center gap-2">
                    <span>{new Date(order.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</span>
                    <span>•</span>
                    <span>{order.items} items</span>
                  </div>
                  <div class="flex items-center gap-2">
                    {order.statusColor === 'blue' && (
                      <button class="font-medium text-blue-600 dark:text-blue-400 hover:underline">Track</button>
                    )}
                    <a href={`${import.meta.env.BASE_URL}account/orders/${order.id}`} class="font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white">Details</a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Saved Addresses - Unified Style -->
        <div class="bg-white dark:bg-dark-800 rounded-lg border border-gray-200 dark:border-dark-700 shadow-sm overflow-hidden">
          <div class="px-4 py-3 border-b border-gray-200 dark:border-dark-700 flex items-center justify-between">
            <h2 class="text-lg font-bold">Saved Addresses</h2>
            <button class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-900 hover:bg-gray-800 dark:bg-gray-800 dark:hover:bg-gray-700 text-white rounded-lg transition-colors duration-300 text-xs font-medium">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              Add New
            </button>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 p-4">
            {addresses.length === 0 && (
              <p class="col-span-full py-6 text-center text-sm text-gray-500 dark:text-gray-400">هنوز نشانی‌ای ثبت نشده است.</p>
            )}
            {addresses.map((addr, i) => (
              <div class="group relative border border-gray-200 dark:border-dark-700 rounded-lg p-4 hover:border-gray-300 dark:hover:border-dark-600 hover:shadow-sm transition-all duration-300">
                {addr.isDefault && (
                  <span class="absolute top-3 right-3 inline-flex items-center gap-1 px-2 py-0.5 bg-gray-900 dark:bg-gray-800 text-white text-xs font-medium rounded">
                    <svg class="w-2.5 h-2.5" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    Default
                  </span>
                )}
                
                <div class="mb-3">
                  <div class="flex items-center gap-2 mb-2">
                    <div class="w-8 h-8 rounded-lg bg-gray-900 dark:bg-gray-800 flex items-center justify-center text-base">
                      {addr.type === 'Home' ? '🏠' : '🏢'}
                    </div>
                    <h3 class="font-bold text-sm">{addr.type}</h3>
                  </div>
                  <p class="font-semibold text-xs text-gray-900 dark:text-white mb-1.5">{addr.name}</p>
                  <div class="space-y-0.5 text-xs text-gray-600 dark:text-gray-400">
                    <p>{addr.address}</p>
                    <p>{addr.city}</p>
                    <p>{addr.phone}</p>
                  </div>
                </div>
                
                <div class="flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  <button class="flex-1 flex items-center justify-center gap-1 px-2 py-1.5 border border-gray-200 dark:border-dark-700 hover:border-gray-300 dark:hover:border-dark-600 hover:bg-gray-50 dark:hover:bg-dark-700 rounded text-xs font-medium transition-colors">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                    Edit
                  </button>
                  <button class="flex-1 flex items-center justify-center gap-1 px-2 py-1.5 border border-gray-200 dark:border-dark-700 hover:border-red-300 dark:hover:border-red-800 hover:bg-red-50 dark:hover:bg-red-900/10 hover:text-red-600 dark:hover:text-red-400 rounded text-xs font-medium transition-colors">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                    Delete
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Sidebar - Clean & Unified (30%) -->
      <aside class="lg:col-span-4 space-y-4">
        <!-- Quick Actions -->
        <div class="bg-white dark:bg-dark-800 rounded-lg border border-gray-200 dark:border-dark-700 p-3.5 shadow-sm">
          <h3 class="text-sm font-bold mb-2.5">Quick Actions</h3>
          <div class="space-y-2">
            {[
              { icon: '🔄', label: 'Reorder', desc: 'Buy again' },
              { icon: '📍', label: 'Track Shipment', desc: 'Live tracking' },
              { icon: '📄', label: 'Download Invoice', desc: 'Get receipts' }
            ].map((action, i) => (
              <button class="group w-full flex items-center gap-2.5 p-2.5 rounded-lg border border-gray-200 dark:border-dark-700 hover:border-gray-300 dark:hover:border-dark-600 hover:bg-gray-50 dark:hover:bg-dark-700 transition-all duration-300 hover:-translate-y-0.5">
                <div class="w-8 h-8 rounded-lg bg-gray-100 dark:bg-dark-700 flex items-center justify-center text-base flex-shrink-0">
                  {action.icon}
                </div>
                <div class="flex-1 text-left">
                  <p class="font-semibold text-xs text-gray-900 dark:text-white">{action.label}</p>
                  <p class="text-xs text-gray-500 dark:text-gray-400">{action.desc}</p>
                </div>
                <svg class="w-3.5 h-3.5 text-gray-400 group-hover:text-gray-600 dark:group-hover:text-gray-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </button>
            ))}
          </div>
        </div>

        <!-- Account Status -->
        <div class="bg-gray-900 dark:bg-gray-800 rounded-lg p-3.5 text-white shadow-sm">
          <div class="flex items-center justify-between mb-2.5">
            <h3 class="text-sm font-bold">Membership</h3>
            <span class="inline-flex items-center gap-1 px-1.5 py-0.5 bg-yellow-500/10 text-yellow-400 text-xs font-medium rounded">
              <svg class="w-2 h-2" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
              Premium
            </span>
          </div>
          <p class="text-xs text-gray-400 mb-2.5">Member since {user.memberSince}</p>
          
          <div class="mb-1.5">
            <div class="flex items-center justify-between text-xs mb-1">
              <span class="font-medium text-gray-300">Reward Points</span>
              <span class="font-bold">—</span>
            </div>
            <div class="h-1.5 bg-white/10 rounded-full overflow-hidden">
              <div class="h-full bg-gray-400 rounded-full" style="width: 0%; transition: width 1s ease-out;"></div>
            </div>
            <p class="text-xs text-gray-400 mt-1">امتیازها هنوز فعال نشده‌اند.</p>
          </div>
        </div>

        <!-- Recommendations -->
        <div class="bg-white dark:bg-dark-800 rounded-lg border border-gray-200 dark:border-dark-700 p-3.5 shadow-sm">
          <h3 class="text-sm font-bold mb-2.5">Frequently Reordered</h3>
          <div class="space-y-2">
            <p class="py-4 text-center text-xs text-gray-500 dark:text-gray-400">پیشنهادها پس از اتصال سابقه خرید نمایش داده می‌شوند.</p>
            {([] as { name: string; price: number; image: string }[]).map((product, i) => (
              <div class="group flex items-center gap-2.5 p-2 rounded-lg border border-gray-200 dark:border-dark-700 hover:border-gray-300 dark:hover:border-dark-600 hover:bg-gray-50 dark:hover:bg-dark-700 transition-all duration-300 cursor-pointer hover:-translate-y-0.5">
                <img src={product.image} alt={product.name} class="w-10 h-10 rounded-lg object-cover flex-shrink-0" />
                <div class="flex-1 min-w-0">
                  <p class="font-semibold text-xs text-gray-900 dark:text-white truncate">{product.name}</p>
                  <p class="text-xs font-bold text-gray-900 dark:text-white">${product.price}</p>
                </div>
                <button class="w-6 h-6 rounded-lg bg-gray-900 hover:bg-gray-800 dark:bg-gray-800 dark:hover:bg-gray-700 text-white flex items-center justify-center transition-colors flex-shrink-0">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                  </svg>
                </button>
              </div>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>


<script>
  import { supabase } from '../lib/supabase';

  const baseUrl = import.meta.env.BASE_URL.endsWith('/')
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;
  const signInUrl = `${baseUrl}account/signin/`;
  const homeUrl = baseUrl;

  const welcome = document.getElementById('account-welcome');
  const emailElement = document.getElementById('account-email');
  const memberSince = document.getElementById('account-member-since');
  const signOutBtn = document.getElementById('sign-out-btn');
  const signOutBtnMobile = document.getElementById('sign-out-btn-mobile');

  async function loadAccount() {
    const { data, error } = await supabase.auth.getUser();

    if (error || !data.user) {
      window.location.replace(signInUrl);
      return;
    }

    const authUser = data.user;
    const metadata = authUser.user_metadata ?? {};
    let fullName = metadata.full_name || metadata.fullname || metadata.name || ''; 
    let phone = metadata.phone || '';

    const { data: profile, error: profileError } = await supabase
      .from('profiles')
      .select('full_name, phone, created_at')
      .eq('id', authUser.id)
      .maybeSingle();

    if (!profileError && profile) {
      fullName = profile.full_name || fullName;
      phone = profile.phone || phone;

      if (profile.created_at && memberSince) {
        const joined = new Date(profile.created_at);
        if (!Number.isNaN(joined.getTime())) {
          memberSince.textContent = `عضویت از ${joined.toLocaleDateString('fa-IR')}`;
        }
      }
    }

    if (welcome) {
      const displayName = fullName.trim();
      welcome.textContent = displayName
        ? `خوش آمدید، ${displayName}`
        : 'خوش آمدید';
    }

    if (emailElement) emailElement.textContent = authUser.email || '';

    // شماره تلفن برای استفاده در صفحه ویرایش پروفایل نگه داشته می‌شود.
    if (phone) document.documentElement.dataset.accountPhone = phone;
  }

  
async function handleSignOut() {
  const confirmed = window.confirm('از حساب کاربری خارج می‌شوید؟');
  if (!confirmed) return;

  [signOutBtn, signOutBtnMobile].forEach((button) => {
    if (button) {
      button.setAttribute('disabled', 'true');
      button.textContent = 'در حال خروج...';
    }
  });

  try {
    const { error } = await supabase.auth.signOut();

    if (error) {
      console.error('Supabase sign-out failed:', error);
      window.alert('خروج ناموفق بود. لطفاً دوباره تلاش کنید.');
      return;
    }

    const { data, error: sessionError } =
      await supabase.auth.getSession();

    if (sessionError || data.session) {
      console.error('Session still exists after sign-out:', sessionError);
      window.alert('نشست هنوز پاک نشده است. لطفاً کنسول را بررسی کنید.');
      return;
    }

    window.location.replace(signInUrl);
  } catch (error) {
    console.error('Unexpected sign-out error:', error);
    window.alert('هنگام خروج خطایی رخ داد. کنسول را بررسی کنید.');
  } finally {
    [signOutBtn, signOutBtnMobile].forEach((button) => {
      if (button) {
        button.removeAttribute('disabled');
        button.textContent = 'Sign Out';
      }
    });
  }
}


  signOutBtn?.addEventListener('click', handleSignOut);
  signOutBtnMobile?.addEventListener('click', handleSignOut);

  loadAccount().catch((error) => {
    console.error('Account loading failed:', error);
    window.location.replace(signInUrl);
  });
</script>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
